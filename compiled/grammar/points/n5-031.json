{"id":"n5-031","title":"Noun と～","romaji":"Noun to～","jlptLevel":5,"shortExplanation":"Express 'with', 'and' or 'together with' when connecting nouns.","longExplanation":"The Noun と grammar point is used to express a connection between two or more nouns, indicating 'with', 'and', or 'together with' in English. It functions as a particle that is used to simply list multiple items or express companionship.","formation":"Noun1 + と + Noun2","examples":[{"jp":"リンゴとバナナを買いました。","romaji":"Ringo to banana wo kaimashita.","en":"I bought apples and bananas.","words":[{"surface":"リンゴ","vocabId":"1555480","reading":"りんご"},{"surface":"と","vocabId":null},{"surface":"バナナ","vocabId":null},{"surface":"を","vocabId":null},{"surface":"買いました","vocabId":"1473740","reading":"かいました","baseForm":"買う"},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"友達と映画を見に行きます。","romaji":"Tomodachi to eiga wo mi ni ikimasu.","en":"I will go to watch a movie with my friend.","words":[{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"と","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"を","vocabId":null},{"surface":"見","vocabId":"1259290","reading":"み","baseForm":"見る"},{"surface":"に","vocabId":null},{"surface":"行きます","vocabId":"1578850","reading":"いきます","baseForm":"行く"},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"父と母と一緒に旅行しました。","romaji":"Chichi to haha to issho ni ryokou shimashita.","en":"I traveled together with my father and mother.","words":[{"surface":"父","vocabId":"1497610","reading":"ちち"},{"surface":"と","vocabId":null},{"surface":"母","vocabId":"1514990","reading":"はは"},{"surface":"と","vocabId":null},{"surface":"一緒に","vocabId":"1163420","reading":"いっしょに"},{"surface":"旅行","vocabId":"1553170","reading":"りょこう"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"彼と彼女は