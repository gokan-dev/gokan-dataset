{"id":"n5-115","title":"なに～ (nani~)","jlptLevel":5,"shortExplanation":"Asking about 'what' or 'which' in Japanese","longExplanation":"The なに～ grammar point is used to ask questions about 'what' or 'which' in Japanese. It can be combined with various parts of speech to create different questions. The formation differs depending on whether it's used with a verb, い-adjective, な-adjective, or noun.","formation":"Verb + なに, い-Adjective + なに, な-Adjective + なに, Noun + なに","examples":[{"jp":"これはなにですか。","romaji":"Kore wa nani desu ka?","en":"What is this?","words":[{"surface":"これ","vocabId":"1628530","reading":"これ"},{"surface":"は","vocabId":null},{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"です","vocabId":null},{"surface":"か","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"あの人はなにをしているのですか？","romaji":"Ano hito wa nani wo shite iru no desu ka?","en":"What is that person doing?","words":[{"surface":"あの","vocabId":null},{"surface":"人","vocabId":"1580640","reading":"ひと"},{"surface":"は","vocabId":null},{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"を","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"いる","vocabId":"1577980","reading":"いる"},{"surface":"の","vocabId":"1537250","reading":"の"},{"surface":"です","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[3]},{"jp":"なにが好きですか？","romaji":"Nani ga suki desu ka?","en":"What do you like?","words":[{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"が","vocabId":null},{"surface":"好き","vocabId":"1277450","reading":"すき"},{"surface":"です","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[0]},{"jp":"今日の天気はなにですか？","romaji":"Kyou no tenki wa nani desu ka?","en":"What is today's weather?","words":[{"surface":"今日","vocabId":"1579110","reading":"きょう"},{"surface":"の","vocabId":null},{"surface":"天気