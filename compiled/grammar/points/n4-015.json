{"id":"n4-015","title":"Nounをくださる","jlptLevel":4,"shortExplanation":"Used to express someone doing something as a favor or for the benefit of the speaker.","longExplanation":"The grammar point 'Nounをくださる' is a polite expression used to say that someone is giving or doing something for the benefit of the speaker. It is often used when referring to people who have a higher social status or when expressing gratitude for their actions.","formation":"Noun + を + くださる","examples":[{"jp":"先生が資料をくださった。","romaji":"Sensei ga shiryou wo kudasatta.","en":"The teacher gave me the materials.","words":[{"surface":"先生","vocabId":"1387990","reading":"せんせい"},{"surface":"が","vocabId":null},{"surface":"資料","vocabId":"1312820","reading":"しりょう"},{"surface":"を","vocabId":null},{"surface":"くださっ","vocabId":"1184280","reading":"くださる","baseForm":"くださる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"お母さんがおやつをくださる。","romaji":"Okaasan ga oyatsu wo kudasaru.","en":"My mother gives me snacks.","words":[{"surface":"お母さん","vocabId":"1002650","reading":"おかあさん"},{"surface":"が","vocabId":null},{"surface":"お","vocabId":null},{"surface":"やつ","vocabId":"1445640","reading":"やつ"},{"surface":"を","vocabId":null},{"surface":"くださる","vocabId":"1184280","reading":"くださる"},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5]},{"jp":"上司がアドバイスをくださいました。","romaji":"Joushi ga adobaisu wo kudasaimashita.","en":"My boss gave me advice.","words":[{"surface":"上司","vocabId":"1353260","reading":"じょうし"},{"surface":"が","vocabId":null},{"surface":"アドバイス","vocabId":null},{"surface":"を","vocabId":null},{"surface":"ください","vocabId":"1184280","reading":"くださる","baseForm":"くださる"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"友達がプレゼントをくださった。","romaji":"Tomodachi ga purezento wo kudasatta.","en":"My friend gave me a present.","words":[{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"が","vocabId":null},{"surface":"プレゼント","vocabId":null},{"surface":"を","vocabId":null},{"surface":"くださっ","vocabId":"1184280","reading":"くださる","baseForm":"くださる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]}],"formalityLevel":"polite","usageNote":"Honorific - someone of higher status giving to the speaker, as a favor.","family":{"id":"giving","name":"Giving (Benefactive Register)","relatedPoints":["n4-013","n5-123","n4-016","n5-076","n4-017"],"axis":"constraint"},"kind":"construction"}