{"id":"n5-032","title":"Noun に～","romaji":"Noun ni～","jlptLevel":5,"shortExplanation":"Express a specific direction, target or purpose; 'to', 'toward', 'for'.","longExplanation":"The 'Noun に' grammar point is used to express a specific direction, target, or purpose in relation to a noun. It can be translated as 'to', 'toward', or 'for' in English. The に particle is added directly after the noun which indicates direction, target or purpose.","formation":"Noun + に","examples":[{"jp":"彼女にプレゼントをあげました。","romaji":"Kanojo ni purezento wo agemashita.","en":"I gave a present to her.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"に","vocabId":null},{"surface":"プレゼント","vocabId":null},{"surface":"を","vocabId":null},{"surface":"あげ","vocabId":"1352300","reading":"あげ","baseForm":"あげる"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"日本に行きます。","romaji":"Nihon ni ikimasu.","en":"I am going to Japan.","words":[{"surface":"日本","vocabId":"1582710","reading":"にっぽん"},{"surface":"に","vocabId":null},{"surface":"行きます","vocabId":"1578850","reading":"いきます","baseForm":"行く"},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"6時に集合しましょう。","romaji":"Roku-ji ni shuugou shimashou.","en":"Let's meet at 6 o'clock.","words":[{"surface":"6","vocabId":null},{"surface":"時に","vocabId":"2021540","reading":"じに"},{"surface":"集合","vocabId":"1333680","reading":"しゅうごう"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ましょ","vocabId":null,"baseForm":"ます"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"友達に手紙を書きます。","romaji":"Tomodachi ni tegami wo kakimasu.","en":"I will write a letter to my friend.","words":[{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"に","vocabId":null},{"surface":"手紙","vocabId":"1327720","reading":"てがみ"},{"surface":"を","vocabId":null},{"surface":"書きます","vocabI