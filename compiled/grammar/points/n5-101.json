{"id":"n5-101","title":"どこ～","romaji":"doko～","jlptLevel":5,"shortExplanation":"Express 'where', used with question words for asking about locations.","longExplanation":"The どこ～ grammar point is used to express 'where', primarily for asking about locations or places. It is often combined with question words such as どこへ (doko e), どこで (doko de), and どこに (doko ni) to ask about destinations, locations of actions, and existence, respectively.","formation":"どこ + question particle","examples":[{"jp":"駅はどこですか？","romaji":"Eki wa doko desu ka?","en":"Where is the station?","words":[{"surface":"駅","vocabId":"1175140","reading":"えき"},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"です","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[2]},{"jp":"どこで映画を見ましたか？","romaji":"Doko de eiga wo mimashita ka?","en":"Where did you watch the movie?","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"で","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"を","vocabId":null},{"surface":"見","vocabId":"1259290","reading":"みる","baseForm":"見る"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[0]},{"jp":"どこに住んでいますか？","romaji":"Doko ni sunde imasu ka?","en":"Where do you live?","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"に","vocabId":null},{"surface":"住ん","vocabId":"1334040","reading":"すむ","baseForm":"住む"},{"surface":"で","vocabId":null},{"surface":"い","vocabId":"1158500","reading":"い","baseForm":"いる"},{"surface":"ます","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[0]},{"jp":"どこへ行きたいですか？","romaji":"Doko e ikitai desu ka?","en":"Where do you want to go?","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"へ","vocabId":null},{"surface":"行き","vocabId":"1578790","reading":"いき","baseForm":"行く"},{"surface":"たい","vocabId":null},{"surface":"です","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[0]}]}