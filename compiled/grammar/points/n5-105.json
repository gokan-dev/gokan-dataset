{"id":"n5-105","title":"どこにも + Verb + ません","romaji":"doko ni mo + Verb + masen","jlptLevel":5,"shortExplanation":"Express 'not anywhere' or 'nowhere' with a negative verb.","longExplanation":"The どこにも～ません grammar point is used to express that something doesn't exist, appear, or happen anywhere. It means 'not anywhere' or 'nowhere' when used with a negative verb. The formation is quite simple as you just need to add どこにも before the negative verb.","formation":"どこにも + Verb-negative","examples":[{"jp":"どこにもあの猫がいません。","romaji":"Doko ni mo ano neko ga imasen.","en":"The cat is not anywhere.","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"に","vocabId":null},{"surface":"も","vocabId":null},{"surface":"あの","vocabId":null},{"surface":"猫","vocabId":"1467640","reading":"ねこ"},{"surface":"が","vocabId":null},{"surface":"い","vocabId":null,"baseForm":"いる"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0,1,2]},{"jp":"どこにもお金を置いていません。","romaji":"Doko ni mo okane wo oiteimasen.","en":"I didn't put the money anywhere.","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"に","vocabId":null},{"surface":"も","vocabId":null},{"surface":"お金","vocabId":"1001820","reading":"おかね"},{"surface":"を","vocabId":null},{"surface":"置いていません","vocabId":"1421850","reading":"おいていません","baseForm":"置く"},{"surface":"。","vocabId":null}],"patternWordIndices":[0,1,2]},{"jp":"この町にはどこにも美味しいラーメン屋がありません。","romaji":"Kono machi ni wa doko ni mo oishii raamenya ga arimasen.","en":"There are no delicious ramen shops anywhere in this town.","words":[{"surface":"この","vocabId":null},{"surface":"町","vocabId":"1603990","reading":"まち"},{"surface":"に","vocabId":null},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"に","vocabId":null},{"surface":"も","vocabId":null},{"surface":"美味しい","vocabId":"1486650","reading":"おいしい"},{"surface":"ラーメン屋","vocabId":"2688030","reading":"らーめんや"},{"surface":"が","vocabId":null},{"surface":"あり","vocabId":null,"baseForm":"ある"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6]},{"jp":"どこにも彼女の名前が書いていません。","romaji":"Doko ni mo kanojo no namae ga kaiteimasen.","en":"Her name is not written anywhere.","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"に","vocabId":null},{"surface":"も","vocabId":null},{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"の","vocabId":null},{"surface":"名前","vocabId":"1531710","reading":"なまえ"},{"surface":"が","vocabId":null},{"surface":"書いていません","vocabId":"1343950","reading":"かいていません","baseForm":"書く"},{"surface":"。","vocabId":null}],"patternWordIndices":[0,1,2]}],"formalityLevel":"polite","usageNote":"Standard polite negative - \"not anywhere\".","family":{"id":"nowhere","name":"Nowhere (Not Anywhere)","relatedPoints":["n5-109","n5-108","n5-104","n5-106","n5-107"],"axis":"register"},"kind":"construction"}