{"id":"n5-054","title":"Verb ましょう","romaji":"mashou","jlptLevel":5,"shortExplanation":"Making a suggestion or invitation; 'let's' or 'shall we'.","longExplanation":"The ましょう grammar point is used to suggest or invite someone to do something in a polite and friendly way. It can be translated as 'let's' or 'shall we' in English. This grammar point is formed by attaching ましょう to the stem of the verb (i.e. remove ます).","formation":"Verb (ます-stem) + ましょう","examples":[{"jp":"一緒に映画を見ましょう。","romaji":"Issho ni eiga wo mimashou.","en":"Let's watch a movie together.","words":[{"surface":"一緒に","vocabId":"1163420","reading":"いっしょに"},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"を","vocabId":null},{"surface":"見","vocabId":"1259290","reading":"みる","baseForm":"見る"},{"surface":"ましょ","vocabId":null,"baseForm":"ます"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5]},{"jp":"散歩しましょう。","romaji":"Sanpo shimashou.","en":"Let's take a walk.","words":[{"surface":"散歩","vocabId":"1303620","reading":"さんぽ"},{"surface":"し","vocabId":null,"baseForm":"する"},{"surface":"ましょ","vocabId":null,"baseForm":"ます"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3]},{"jp":"今晩、食事に行きましょう。","romaji":"Konban, shokuji ni ikimashou.","en":"Let's go out for dinner tonight.","words":[{"surface":"今晩","vocabId":"1289470","reading":"こんばん"},{"surface":"、","vocabId":null},{"surface":"食事","vocabId":"1358490","reading":"しょくじ"},{"surface":"に","vocabId":null},{"surface":"行き","vocabId":"1578790","reading":"いき","baseForm":"行く"},{"surface":"ましょ","vocabId":null,"baseForm":"ます"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6]},{"jp":"明日勉強しましょう。","romaji":"Ashita benkyou shimashou.","en":"Let's study tomorrow.","words":[{"surface":"明日","vocabId":"1584660","reading":"あした"},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"し","vocabId":null,"baseForm":"する"},{"surface":"ましょ","vocabId":null,"baseForm":"ます"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]}],"formalityLevel":"polite","usageNote":"Neutral, direct \"let's...\" - a plain suggestion/invitation.","family":{"id":"invitation","name":"Invitation (Let's / Shall We)","relatedPoints":["n5-055","n5-056","n5-065"],"axis":"register"},"kind":"construction"}