{"id":"n5-082","title":"ぜんぜん～","romaji":"zenzen～","jlptLevel":5,"shortExplanation":"Used to express 'not at all' or 'completely' in negative sentences.","longExplanation":"The ぜんぜん grammar point is used to emphasize a negative statement and can be translated as 'not at all' or 'completely (in negative sense)'. It is commonly used with negative verbs or negative forms of adjectives, placed before the negative part.","formation":"ぜんぜん + [Negative verb/adjective]","examples":[{"jp":"彼はぜんぜん話さない。","romaji":"Kare wa zenzen hanasanai.","en":"He doesn't talk at all.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"ぜんぜん","vocabId":"1395620","reading":"ぜんぜん"},{"surface":"話さない","vocabId":"1562350","reading":"はなさない","baseForm":"話す"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"この部屋はぜんぜん暗くない。","romaji":"Kono heya wa zenzen kurakunai.","en":"This room is not dark at all.","words":[{"surface":"この","vocabId":null},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"は","vocabId":null},{"surface":"ぜんぜん","vocabId":"1395620","reading":"ぜんぜん"},{"surface":"暗くない","vocabId":"1154330","reading":"くらくない","baseForm":"暗い"},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼女はぜんぜん疲れていない。","romaji":"Kanojo wa zenzen tsukarete inai.","en":"She is not tired at all.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"ぜんぜん","vocabId":"1395620","reading":"ぜんぜん"},{"surface":"疲れていない","vocabId":"1483740","reading":"つかれていない","baseForm":"疲れる"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"その映画はぜんぜん面白くなかった。","romaji":"Sono eiga wa zenzen omoshirokunakatta.","en":"That movie was not interesting at all.","words":[{"surface":"その","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"は","vocabId":null},{"surface":"ぜんぜん","vocabId":"1395620","reading":"ぜんぜん"},{"surface":"面白くなかった","vocabId":"1533580","reading":"おもし