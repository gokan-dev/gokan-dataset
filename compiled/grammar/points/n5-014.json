{"id":"n5-014","title":"い-Adjective く + Verb","romaji":"i-Adjective + ku + Verb","jlptLevel":5,"shortExplanation":"Used to connect an い-adjective to a verb, modifying the verb (adverbial usage).","longExplanation":"The い-Adjective + く + Verb grammar point transforms an い-adjective into its adverbial form, describing how the verb is performed. In English, this often corresponds to '-ly' adverbs (e.g., 'quickly', 'slowly').","formation":"い-Adjective (remove い) + く + Verb","examples":[{"jp":"彼は速く走りました。","romaji":"Kare wa hayaku hashirimashita.","en":"He ran quickly.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"速く","vocabId":null,"baseForm":"速い"},{"surface":"走りました","vocabId":"1402540","reading":"はしりました","baseForm":"走る"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"この料理は美味しく食べました。","romaji":"Kono ryouri wa oishiku tabemashita.","en":"I enjoyed eating this dish.","words":[{"surface":"この","vocabId":null},{"surface":"料理","vocabId":"1554310","reading":"りょうり"},{"surface":"は","vocabId":null},{"surface":"美味しく","vocabId":"1486650","reading":"おいしく","baseForm":"美味しい"},{"surface":"食べました","vocabId":"1358280","reading":"たべました","baseForm":"食べる"},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼女は優しく話します。","romaji":"Kanojo wa yasashiku hanashimasu.","en":"She speaks kindly.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"優しく","vocabId":"1539040","reading":"やさしく","baseForm":"優しい"},{"surface":"話します","vocabId":"1562350","reading":"はなします","baseForm":"話す"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"母は忙しく仕事をしています。","romaji":"Haha wa isogashiku shigoto o shite imasu.","en":"My mother is working busily.","words":[{"surface":"母","vocabId":"1514990","reading":"はは"},{"surface":"は","vocabId":null},{"surface":"忙しく","vocabId":"1519290","reading":"いそがしく","baseForm":"忙しい"},{"surface":"仕事","vocabId":"1304970","reading":"しごと"},{"