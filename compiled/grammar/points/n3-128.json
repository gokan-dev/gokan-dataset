{"id":"n3-128","title":"～上げる","romaji":"〜ageru","jlptLevel":3,"shortExplanation":"Indicates to finish doing something completely.","longExplanation":"The ～上げる grammar point is used to express that an action has been completed or finished entirely. It's often used with verbs that have a ます stem, and can be translated as 'to finish (doing something)', 'to complete', or 'to get something done'.","formation":"Verb-ますstem + 上げる","examples":[{"jp":"レポートを書き上げるまで、寝られません。","romaji":"Repooto o kakiageru made, neraremasen.","en":"I cannot sleep until I finish writing the report.","words":[{"surface":"レポート","vocabId":null},{"surface":"を","vocabId":null},{"surface":"書き上げる","vocabId":"1653990","reading":"かきあげる"},{"surface":"まで","vocabId":null},{"surface":"、","vocabId":null},{"surface":"寝","vocabId":"1360010","reading":"ね","baseForm":"寝る"},{"surface":"られ","vocabId":null,"baseForm":"られる"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"彼女は早速部屋の掃除を始め、一時間で掃除をやり上げた。","romaji":"Kanojo wa sassoku heya no souji o hajime, ichijikan de souji o yariageta.","en":"She started cleaning the room right away and finished cleaning it in an hour.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"早速","vocabId":"1400300","reading":"さっそく"},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"の","vocabId":null},{"surface":"掃除","vocabId":"1399790","reading":"そうじ"},{"surface":"を","vocabId":null},{"surface":"始め","vocabId":"1307550","reading":"はじめ","baseForm":"始める"},{"surface":"、","vocabId":null},{"surface":"一時間","vocabId":"1162940","reading":"いちじかん"},{"surface":"で","vocabId":null},{"surface":"掃除","vocabId":"1399790","reading":"そうじ"},{"surface":"を","vocabId":null},{"surface":"やり","vocabId":null,"baseForm":"やる"},{"surface":"上げた","vocabId":"1352320","reading":"あげた","baseForm":"上げる"},{"surface":"。","vocabId":null}],"patternWordIndices":[14]},{"jp":