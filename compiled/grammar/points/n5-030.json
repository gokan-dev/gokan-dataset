{"id":"n5-030","title":"Nounで～","romaji":"Noun de ~","jlptLevel":5,"shortExplanation":"Indicate a place or means for an action or situation; 'at, in, on', 'using', or 'by means of'.","longExplanation":"The で grammar point is used to indicate a location, method, or tool for doing an action or for being in a situation. It can be translated as 'at, in, on', 'using', or 'by means of' in English. Nounで is formed by adding で after a noun.","formation":"Noun + で","examples":[{"jp":"図書館で勉強します。","romaji":"Toshokan de benkyou shimasu.","en":"I study at the library.","words":[{"surface":"図書館","vocabId":"1370420","reading":"としょかん"},{"surface":"で","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"バスで学校に行きます。","romaji":"Basu de gakkou ni ikimasu.","en":"I go to school by bus.","words":[{"surface":"バス","vocabId":null},{"surface":"で","vocabId":null},{"surface":"学校","vocabId":"1206730","reading":"がっこう"},{"surface":"に","vocabId":null},{"surface":"行きます","vocabId":"1578850","reading":"いきます","baseForm":"行く"},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"鉛筆で書きました。","romaji":"Enpitsu de kakimashita.","en":"I wrote it using a pencil.","words":[{"surface":"鉛筆","vocabId":"1178590","reading":"えんぴつ"},{"surface":"で","vocabId":null},{"surface":"書きました","vocabId":"1343950","reading":"かきました","baseForm":"書く"},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"英語で話しましょう。","romaji":"Eigo de hanashimashou.","en":"Let's talk in English.","words":[{"surface":"英語","vocabId":"1174420","reading":"えいご"},{"surface":"で","vocabId":null},{"surface":"話しましょう","vocabId":"1562350","reading":"はなしましょう","baseForm":"話す"},{"surface":"。","vocabId":null}],"patternWordIndices":[1]}],"kind":"construction"}