{"id":"n1-124","title":"Verb そばから (〜soba kara)","jlptLevel":1,"shortExplanation":"Expresses that as soon as one action finishes, another begins immediately.","longExplanation":"The 〜そばから grammar point is used to indicate that right after a certain action is completed, another action takes place—often suggesting a repetitive or frustrating cycle.","formation":"Verb-ますstem + そばから","examples":[{"jp":"掃除をするそばから子供たちが散らかす。","romaji":"Sōji o suru soba kara kodomo-tachi ga chirakasu.","en":"As soon as I clean, the kids mess it up.","words":[{"surface":"掃除","vocabId":"1399790","reading":"そうじ"},{"surface":"を","vocabId":null},{"surface":"する","vocabId":"1595910","reading":"する"},{"surface":"そば","vocabId":"1238460","reading":"そば"},{"surface":"から","vocabId":null},{"surface":"子供","vocabId":"1307850","reading":"こども"},{"surface":"たち","vocabId":"1416220","reading":"たち"},{"surface":"が","vocabId":null},{"surface":"散らかす","vocabId":"1303420","reading":"ちらかす"},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"仕事を終えるそばから新たな仕事が舞い込んできた。","romaji":"Shigoto o oeru soba kara aratana shigoto ga maikonde kita.","en":"As soon as I finished my work, a new task came in.","words":[{"surface":"仕事","vocabId":"1304970","reading":"しごと"},{"surface":"を","vocabId":null},{"surface":"終える","vocabId":"1332760","reading":"おえる"},{"surface":"そば","vocabId":"1238460","reading":"そば"},{"surface":"から","vocabId":null},{"surface":"新た","vocabId":"1361510","reading":"あらた"},{"surface":"な","vocabId":null,"baseForm":"だ"},{"surface":"仕事","vocabId":"1304970","reading":"しごと"},{"surface":"が","vocabId":null},{"surface":"舞い込ん","vocabId":"1499070","reading":"まいこむ","baseForm":"舞い込む"},{"surface":"で","vocabId":null},{"surface":"き","vocabId":"1221520","reading":"き","baseForm":"くる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"それを解決するそばからまた別の問題が出てきた。","romaji":"Sore o kaiketsu suru soba kara mata betsu no mondai ga detekita.","en":"As soon as we solve that, another problem arises.","words":[{"surface":"それ","vocabId":null},{"surface":"を","vocabId":null},{"surface":"解決","vocabId":"1198960","reading":"かいけつ"},{"surface":"する","vocabId":"1595910","reading":"する"},{"surface":"そば","vocabId":"1238460","reading":"そば"},{"surface":"から","vocabId":null},{"surface":"また","vocabId":"1524930","reading":"また"},{"surface":"別","vocabId":"1509430","reading":"べつ"},{"surface":"の","vocabId":null},{"surface":"問題","vocabId":"1536010","reading":"もんだい"},{"surface":"が","vocabId":null},{"surface":"出","vocabId":"1896380","reading":"で","baseForm":"出る"},{"surface":"て","vocabId":null},{"surface":"き","vocabId":"1221520","reading":"き","baseForm":"くる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5]},{"jp":"眠りにつくそばから電話が鳴った。","romaji":"Nemuri ni tsuku soba kara denwa ga natta.","en":"The phone rang as soon as I fell asleep.","words":[{"surface":"眠り","vocabId":"1529370","reading":"ねむり"},{"surface":"に","vocabId":null},{"surface":"つく","vocabId":"1422970","reading":"つく"},{"surface":"そば","vocabId":"1238460","reading":"そば"},{"surface":"から","vocabId":null},{"surface":"電話","vocabId":"1443840","reading":"でんわ"},{"surface":"が","vocabId":null},{"surface":"鳴っ","vocabId":"1532910","reading":"なる","baseForm":"鳴る"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]}]}