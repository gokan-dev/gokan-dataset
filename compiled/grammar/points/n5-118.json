{"id":"n5-118","title":"なにも～ません","romaji":"nanimo~masen","jlptLevel":5,"shortExplanation":"Used to express 'not anything', 'nothing'.","longExplanation":"The grammar point なにも～ません is used to express the idea of 'not anything' or 'nothing' in negative sentences. It is placed before the verb in its negative form (～ません).","formation":"なにも + Verb-ます form + ません","examples":[{"jp":"昨日はなにも食べませんでした。","romaji":"Kinou wa nanimo tabemasen deshita.","en":"I didn't eat anything yesterday.","words":[{"surface":"昨日","vocabId":"1579260","reading":"きのう"},{"surface":"は","vocabId":null},{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"も","vocabId":null},{"surface":"食べ","vocabId":"1358280","reading":"たべる","baseForm":"食べる"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"でし","vocabId":null,"baseForm":"です"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3,5,6]},{"jp":"彼はなにも話しません。","romaji":"Kare wa nanimo hanashimasen.","en":"He doesn't say anything.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"も","vocabId":null},{"surface":"話し","vocabId":"1562350","reading":"はなす","baseForm":"話す"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3,5,6]},{"jp":"この部屋ではなにも見えません。","romaji":"Kono heya de wa nanimo miemasen.","en":"I cannot see anything in this room.","words":[{"surface":"この","vocabId":null},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"で","vocabId":null},{"surface":"は","vocabId":null},{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"も","vocabId":null},{"surface":"見え","vocabId":"1259140","reading":"みえる","baseForm":"見える"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,7,8]},{"jp":"彼女はなにも買いませんでした。","romaji":"Kanojo wa nanimo kaimasen deshita.","en":"She didn't buy anything.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"なに","vocabId":"1577100","reading":"なに"},{"surface":"も","vocabId":null},{"surface":"買い","vocabId":"1636070","reading":"かい","baseForm":"買う"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"でし","vocabId":null,"baseForm":"です"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3,5,6]}],"kind":"construction"}