{"id":"n3-119","title":"～られた","romaji":"〜rareta","jlptLevel":3,"shortExplanation":"Express a passive action, 'was/were', 'has/have been'.","longExplanation":"The ～られた grammar point is used to express a passive action or situation. It is formed by conjugating the verb into its passive form in the past tense, which can be translated into English as 'was/were' or 'has/have been'. This grammar is used in situations where the subject is affected by an action rather than performing the action itself.","formation":"Verb (passive form, past tense) + られた","examples":[{"jp":"この本はたくさんの人に読まれた。","romaji":"Kono hon wa takusan no hito ni yomareta.","en":"This book was read by many people.","words":[{"surface":"この","vocabId":null},{"surface":"本","vocabId":"1522150","reading":"ほん"},{"surface":"は","vocabId":null},{"surface":"たくさん","vocabId":"1415870","reading":"たくさん"},{"surface":"の","vocabId":null},{"surface":"人","vocabId":"1580640","reading":"ひと"},{"surface":"に","vocabId":null},{"surface":"読ま","vocabId":"1456360","reading":"よま","baseForm":"読む"},{"surface":"れ","vocabId":null,"baseForm":"れる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[]},{"jp":"彼は友達に騙された。","romaji":"Kare wa tomodachi ni damasareta.","en":"He was deceived by his friend.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"に","vocabId":null},{"surface":"騙さ","vocabId":"1574550","reading":"だまさ","baseForm":"騙す"},{"surface":"れ","vocabId":null,"baseForm":"れる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[]},{"jp":"昨日、私の財布が盗まれました。","romaji":"Kinou, watashi no saifu ga nusumaremashita.","en":"Yesterday, my wallet was stolen.","words":[{"surface":"昨日","vocabId":"1579260","reading":"きのう"},{"surface":"、","vocabId":null},{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"の","vocabId":null},{"surface":"財布","vocabId":"1296970","reading":"さいふ"},{"surface":"が","vocabId":null},{"surface":"盗ま","vocabId":"1448440","reading":"ぬすま","baseForm":"盗む"},{"surface":"れ","vocabId":null,"baseForm":"れる"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[]},{"jp":"彼女は映画に感動させられた。","romaji":"Kanojo wa eiga ni kandou saserareta.","en":"She was deeply moved by the movie.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"に","vocabId":null},{"surface":"感動","vocabId":"1212570","reading":"かんどう"},{"surface":"さ","vocabId":"1291070","reading":"さ","baseForm":"する"},{"surface":"せ","vocabId":"2147990","reading":"せ","baseForm":"せる"},{"surface":"られ","vocabId":null,"baseForm":"られる"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[7,8]}],"kind":"construction"}