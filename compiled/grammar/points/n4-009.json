{"id":"n4-009","title":"Noun に なる (Noun ni naru)","jlptLevel":4,"shortExplanation":"To become; to change into; to turn into.","longExplanation":"The 'Noun に なる' grammar point is used to show a change or a transformation from one state or form into another. In English, it can be translated as 'to become', 'to change into', or 'to turn into'. It is often used with nouns that indicate profession, status, or condition.","formation":"Noun + に + なる","examples":[{"jp":"彼は医者になりました。","romaji":"Kare wa isha ni narimashita.","en":"He became a doctor.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"医者","vocabId":"1159980","reading":"いしゃ"},{"surface":"に","vocabId":null},{"surface":"なり","vocabId":"1899440","reading":"なり","baseForm":"なる"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"子供の頃、私は先生になりたかったです。","romaji":"Kodomo no koro, watashi wa sensei ni naritakatta desu.","en":"When I was a child, I wanted to become a teacher.","words":[{"surface":"子供","vocabId":"1307850","reading":"こども"},{"surface":"の","vocabId":null},{"surface":"頃","vocabId":"1579080","reading":"ころ"},{"surface":"、","vocabId":null},{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"先生","vocabId":"1387990","reading":"せんせい"},{"surface":"に","vocabId":null},{"surface":"なり","vocabId":"1899440","reading":"なり","baseForm":"なる"},{"surface":"たかっ","vocabId":null,"baseForm":"たい"},{"surface":"た","vocabId":null},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[7,8]},{"jp":"彼女は緊張して顔が赤くなりました。","romaji":"Kanojo wa kinchou shite kao ga akaku narimashita.","en":"She got nervous, and her face turned red.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"緊張","vocabId":"1241880","reading":"きんちょう"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"顔","vocabId":"1217730","reading":"かお"},{"surface":"が","vocabId":null},{"surface":"赤く","vocabId":"1383240","reading":"あかい","baseForm":"赤い"},{"surface":"なり","vocabId":"1899440","reading":"なり","baseForm":"なる"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[8]},{"jp":"春になると桜が咲きます。","romaji":"Haru ni naru to sakura ga sakimasu.","en":"When it becomes spring, cherry blossoms bloom.","words":[{"surface":"春","vocabId":"1341000","reading":"はる"},{"surface":"に","vocabId":null},{"surface":"なる","vocabId":"1532910","reading":"なる"},{"surface":"と","vocabId":null},{"surface":"桜","vocabId":"1593710","reading":"さくら"},{"surface":"が","vocabId":null},{"surface":"咲き","vocabId":"1297210","reading":"さく","baseForm":"咲く"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2]}]}