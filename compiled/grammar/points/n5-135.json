{"id":"n5-135","title":"よく～","romaji":"yoku ~","jlptLevel":5,"shortExplanation":"Often used to express 'doing something well' or 'often'.","longExplanation":"The よく～ grammar point is used to express that someone does something well, frequently, or often. It is often placed before the verb and can also mean 'well done' or 'good job' when praising someone's action.","formation":"よく + Verb-casual","examples":[{"jp":"彼はよく勉強します。","romaji":"Kare wa yoku benkyou shimasu.","en":"He studies often.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"よく","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"し","vocabId":null,"baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"彼女はよく料理を作ります。","romaji":"Kanojo wa yoku ryouri o tsukurimasu.","en":"She often cooks.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"よく","vocabId":null},{"surface":"料理","vocabId":"1554310","reading":"りょうり"},{"surface":"を","vocabId":null},{"surface":"作ります","vocabId":"1597890","reading":"つくります","baseForm":"作る"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"昔の友達とよく遊んでいました。","romaji":"Mukashi no tomodachi to yoku asonde imashita.","en":"I used to play a lot with my old friends.","words":[{"surface":"昔","vocabId":"1382370","reading":"むかし"},{"surface":"の","vocabId":null},{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"と","vocabId":null},{"surface":"よく","vocabId":null},{"surface":"遊んでいました","vocabId":"1542160","reading":"あそんでいました","baseForm":"遊ぶ"},{"surface":"。","vocabId":null}],"patternWordIndices":[4]},{"jp":"よくできました！","romaji":"Yoku dekimashita!","en":"Well done!","words":[{"surface":"よく","vocabId":null},{"surface":"でき","vocabId":null,"baseForm":"できる"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"！","vocabId":null}],"patternWordIndices":[0]}],"kind":"construction"}