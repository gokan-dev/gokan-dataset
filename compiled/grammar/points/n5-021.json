{"id":"n5-021","title":"な-Adjective に なります","romaji":"na-Adjective ni narimasu","jlptLevel":5,"shortExplanation":"Express a change or transformation into a state described by the な-adjective.","longExplanation":"The な-Adjective + に + なります grammar point is used to express a change or transformation into the state described by the な-adjective. It translates to 'become' or 'turn into' along with the meaning of the な-adjective.","formation":"な-Adjective (remove な) + に + なります","examples":[{"jp":"この部屋は静かになります。","romaji":"Kono heya wa shizuka ni narimasu.","en":"This room becomes quiet.","words":[{"surface":"この","vocabId":null},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"は","vocabId":null},{"surface":"静かに","vocabId":"2119870","reading":"しずかに"},{"surface":"なり","vocabId":"1899440","reading":"なり","baseForm":"なる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]},{"jp":"彼女はきれいになります。","romaji":"Kanojo wa kirei ni narimasu.","en":"She becomes beautiful.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"きれい","vocabId":"1591900","reading":"きれい"},{"surface":"に","vocabId":null},{"surface":"なり","vocabId":"1899440","reading":"なり","baseForm":"なる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]},{"jp":"彼は元気になります。","romaji":"Kare wa genki ni narimasu.","en":"He becomes energetic.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"元気","vocabId":"1260720","reading":"げんき"},{"surface":"に","vocabId":null},{"surface":"なり","vocabId":"1899440","reading":"なり","baseForm":"なる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]},{"jp":"町はにぎやかになります。","romaji":"Machi wa nigiyaka ni narimasu.","en":"The town becomes lively.","words":[{"surface":"町","vocabId":"1603990","reading":"まち"},{"surface":"は","vocabId":null},{"surface":"にぎやか","vocabId":"1