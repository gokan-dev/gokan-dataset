{"id":"n5-107","title":"どこへも Verb ません","romaji":"doko e mo + Verb + masen","jlptLevel":5,"shortExplanation":"Nowhere; Not to any place","longExplanation":"The grammar point どこへも is used to express the idea of 'nowhere' or 'not to any place'. It is combined with the negative form of a verb to indicate that the action does not happen to any place or destination.","formation":"どこへも + Verb-negative","examples":[{"jp":"今日はどこへも行きません。","romaji":"Kyou wa doko e mo ikimasen.","en":"I won't go anywhere today.","words":[{"surface":"今日は","vocabId":"1289400","reading":"きょうは"},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"へ","vocabId":null},{"surface":"も","vocabId":null},{"surface":"行きません","vocabId":"1578850","reading":"いきません","baseForm":"行く"},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"彼はどこへも走りませんでした。","romaji":"Kare wa doko e mo hashirimasen deshita.","en":"He didn't run anywhere.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"へ","vocabId":null},{"surface":"も","vocabId":null},{"surface":"走りませんでした","vocabId":"1402540","reading":"はしりませんでした","baseForm":"走る"},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3,4]},{"jp":"どこへも買い物に行きませんでした。","romaji":"Doko e mo kaimono ni ikimasen deshita.","en":"I didn't go shopping anywhere.","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"へ","vocabId":null},{"surface":"も","vocabId":null},{"surface":"買い物","vocabId":"1589730","reading":"かいもの"},{"surface":"に","vocabId":null},{"surface":"行きませんでした","vocabId":"1578850","reading":"いきませんでした","baseForm":"行く"},{"surface":"。","vocabId":null}],"patternWordIndices":[0,1,2]},{"jp":"彼女はどこへも連れて行かせません。","romaji":"Kanojo wa doko e mo tsurete ikasemasen.","en":"She won't take me anywhere.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"へ","vocabId":null},{"surface":"も","vocabId":null},{"surface":"連れて行か","vocabId":"1559290","reading":"つれていか","baseForm":"連れる"},{"surface":"せ","vocabId":null,"baseForm":"せる"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3,4]}],"formalityLevel":"neutral","usageNote":"Standard polite negative - \"not anywhere\". (どこへも variant, ません form.)","family":{"id":"nowhere","name":"Nowhere (Not Anywhere)","relatedPoints":["n5-105","n5-109","n5-108","n5-104","n5-106"],"axis":"register"},"kind":"construction"}