{"id":"n4-084","title":"～そうだ","romaji":"〜sou da","jlptLevel":4,"shortExplanation":"Express the appearance, seeming, or feeling of something; 'looks like', 'seems', 'appears'.","longExplanation":"The ～そうだ grammar point is used to describe the appearance or feeling of something based on what is observed or inferred. It can be translated as 'looks like', 'seems', or 'appears' in English. The formation differs depending on whether it is used with a verb, い-adjective, or な-adjective.","formation":"Verb-ますstem + そうだ, い-Adjective (without い) + そうだ, な-Adjective + そうだ","examples":[{"jp":"その花はとてもきれいそうだ。","romaji":"Sono hana wa totemo kirei sou da.","en":"That flower looks very beautiful.","words":[{"surface":"その","vocabId":null},{"surface":"花","vocabId":"1194500","reading":"はな"},{"surface":"は","vocabId":null},{"surface":"とても","vocabId":null},{"surface":"きれい","vocabId":"1591900","reading":"きれい"},{"surface":"そう","vocabId":null},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6]},{"jp":"彼は疲れそうだ。","romaji":"Kare wa tsukare sou da.","en":"He looks tired.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"疲れ","vocabId":"1483740","reading":"つかれ","baseForm":"疲れる"},{"surface":"そう","vocabId":null},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"この本は面白そうだ。","romaji":"Kono hon wa omoshiro sou da.","en":"This book looks interesting.","words":[{"surface":"この","vocabId":null},{"surface":"本","vocabId":"1522150","reading":"ほん"},{"surface":"は","vocabId":null},{"surface":"面白","vocabId":"1533580","reading":"おもしろ","baseForm":"面白い"},{"surface":"そう","vocabId":null},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5]},{"jp":"雨が降りそうだ。","romaji":"Ame ga furi sou da.","en":"It looks like it's going to rain.","words":[{"surface":"雨","vocabId":"1171900","reading":"あめ"},{"surface":"が","vocabId":null},{"surface":"降り","vocabId":"1589500","reading":"おり","baseForm":"降りる"},{"surface":"そう","vocabId":null},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]}],"formalityLevel":"neutral","usageNote":"ます stem + そうだ: looks like, judged from what you see (おいしそう).","family":{"id":"inference","name":"Inference (It Seems / Probably)","relatedPoints":["n4-091","n4-119","n3-118","n3-055","n3-126","n4-077","n3-106","n1-205","n1-207","n2-146","n2-126"],"axis":"constraint"},"kind":"construction"}