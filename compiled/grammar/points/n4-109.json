{"id":"n4-109","title":"～に","romaji":"〜ni","jlptLevel":4,"shortExplanation":"Indicates direction, destination, purpose, or time.","longExplanation":"The ～に grammar point is one of the most versatile Japanese particles. It is commonly used to indicate the direction or destination of an action, to show the purpose of an action or item, or to specify a point in time. Depending on the context, it can be translated as 'to', 'at', 'in', 'on', or 'for' in English.","formation":"Noun + に","examples":[{"jp":"母は私にケーキを作りました。","romaji":"Haha wa watashi ni keiki wo tsukurimashita.","en":"My mother made a cake for me.","words":[{"surface":"母","vocabId":"1514990","reading":"はは"},{"surface":"は","vocabId":null},{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"に","vocabId":null},{"surface":"ケーキ","vocabId":null},{"surface":"を","vocabId":null},{"surface":"作り","vocabId":"1297250","reading":"つくり","baseForm":"作る"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼女は東京に引っ越しました。","romaji":"Kanojo wa Toukyou ni hikkoshimashita.","en":"She moved to Tokyo.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"東京","vocabId":"1447690","reading":"とうきょう"},{"surface":"に","vocabId":null},{"surface":"引っ越し","vocabId":"1601880","reading":"ひっこし","baseForm":"引っ越す"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"銀行にお金を預けます。","romaji":"Ginkou ni okane wo azukemasu.","en":"I deposit money in the bank.","words":[{"surface":"銀行","vocabId":"1243490","reading":"ぎんこう"},{"surface":"に","vocabId":null},{"surface":"お金","vocabId":"1001820","reading":"おかね"},{"surface":"を","vocabId":null},{"surface":"預け","vocabId":"1544990","reading":"あずける","baseForm":"預ける"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"私は７時に起きます。","romaji":"Watashi wa shichi ji ni okimasu.","en":"I wake up at 7 o'clock.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"７","vocabId":null},{"surface":"時","vocabId":"1315840","reading":"とき"},{"surface":"に","vocabId":null},{"surface":"起き","vocabId":"1223640","reading":"おきる","baseForm":"起きる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4]}]}