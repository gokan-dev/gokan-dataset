{"id":"n5-080","title":"さっき～ (sakki～)","jlptLevel":5,"shortExplanation":"Refers to a short time ago or just now.","longExplanation":"The word さっき (sakki) is an adverb used to express that something happened or was done a short time ago or just now. It can be combined with verbs or other phrases to convey that meaning.","formation":"さっき + verb / さっき + phrase","examples":[{"jp":"さっき電話がありました。","romaji":"Sakki denwa ga arimashita.","en":"There was a phone call just now.","words":[{"surface":"さっき","vocabId":"1299060","reading":"さっき"},{"surface":"電話","vocabId":"1443840","reading":"でんわ"},{"surface":"が","vocabId":null},{"surface":"あり","vocabId":"1225940","reading":"あり","baseForm":"ある"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"さっき部屋を掃除しました。","romaji":"Sakki heya wo souji shimashita.","en":"I cleaned the room a short while ago.","words":[{"surface":"さっき","vocabId":"1299060","reading":"さっき"},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"を","vocabId":null},{"surface":"掃除","vocabId":"1399790","reading":"そうじ"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"さっき彼に会いました。","romaji":"Sakki kare ni aimashita.","en":"I met him just now.","words":[{"surface":"さっき","vocabId":"1299060","reading":"さっき"},{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"に","vocabId":null},{"surface":"会い","vocabId":"1198180","reading":"あう","baseForm":"会う"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"さっきのニュースを見ましたか？","romaji":"Sakki no nyuusu wo mimashita ka?","en":"Did you watch the news a short time ago?","words":[{"surface":"さっき","vocabId":"1299060","reading":"さっき"},{"surface":"の","vocabId":null},{"surface":"ニュース","vo