{"id":"n5-071","title":"～が","romaji":"〜ga","jlptLevel":5,"shortExplanation":"Particle indicating the subject of a sentence or expressing 'but'.","longExplanation":"The ～が grammar point is a particle that is used to indicate the subject of a sentence or to express a contrast similar to 'but' in English. It has various functions depending on the context.","formation":"Noun + が / い-Adjective + が / な-Adjective + が / Verb + が","examples":[{"jp":"私が学生です。","romaji":"Watashi ga gakusei desu.","en":"I am a student.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"が","vocabId":null},{"surface":"学生","vocabId":"1206900","reading":"がくせい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"このりんごが美味しい。","romaji":"Kono ringo ga oishii.","en":"This apple is delicious.","words":[{"surface":"この","vocabId":null},{"surface":"りんご","vocabId":"1555480","reading":"りんご"},{"surface":"が","vocabId":null},{"surface":"美味しい","vocabId":"1486650","reading":"おいしい"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"彼は頭がいいが、性格が悪い。","romaji":"Kare wa atama ga ii ga, seikaku ga warui.","en":"He is smart but has a bad personality.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"頭がいい","vocabId":"2146840","reading":"あたまがいい"},{"surface":"が","vocabId":null},{"surface":"、","vocabId":null},{"surface":"性格","vocabId":"1375290","reading":"せいかく"},{"surface":"が","vocabId":null},{"surface":"悪い","vocabId":"1151260","reading":"わるい"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"走りたいが、足が痛い。","romaji":"Hashiritai ga, ashi ga itai.","en":"I want to run, but my leg hurts.","words":[{"surface":"走りたいが","vocabId":"1402540","reading":"はしりたいが","baseForm":"走る"},{"surface":"、","vocabId":null},{"surface":"足","vocabId":"1404630","reading":"あし"},{"surface":"が","vocabId":null},{"surface":"痛い","vocabId":"1432680","reading":"いたい"},{"surface":"。","vocabId":null}],"patternWordIndices":[0]}],"formalityLevel":"neutral","usageNote":"The plain particle \"but\"; natural in both speech and writing, softer/more neutral-sounding than けど.","family":{"id":"contradiction","name":"Contradiction (But / However)","relatedPoints":["n5-008","n5-077","n3-033","n5-078","n2-016","n2-012","n2-017","n2-024","n5-003","n2-018","n2-156","n5-002"],"axis":"register"}}