{"id":"n1-094","title":"Noun も兼ねて","romaji":"~mo kanete","jlptLevel":1,"shortExplanation":"Used to express 'as well as', 'also', or 'at the same time'.","longExplanation":"The も兼ねて grammar point indicates that two actions or purposes are being served simultaneously. The noun before も兼ねて tells what the additional action or purpose is.","formation":"Noun + も兼ねて","examples":[{"jp":"散歩も兼ねて、公園に行きました。","romaji":"Sanpo mo kanete, kouen ni ikimashita.","en":"I went to the park, also for a walk.","words":[{"surface":"散歩","vocabId":"1303620","reading":"さんぽ"},{"surface":"も","vocabId":null},{"surface":"兼ね","vocabId":"1256520","reading":"かねる","baseForm":"兼ねる"},{"surface":"て","vocabId":null},{"surface":"、","vocabId":null},{"surface":"公園","vocabId":"1273270","reading":"こうえん"},{"surface":"に","vocabId":null},{"surface":"行き","vocabId":"1578790","reading":"いき","baseForm":"行く"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"今日は日本語の勉強も兼ねて、日本の映画を見ます。","romaji":"Kyou wa Nihongo no benkyou mo kanete, Nihon no eiga wo mimasu.","en":"Today, I will watch a Japanese movie, also to study Japanese.","words":[{"surface":"今日","vocabId":"1579110","reading":"きょう"},{"surface":"は","vocabId":null},{"surface":"日本語","vocabId":"1464530","reading":"にほんご"},{"surface":"の","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"も","vocabId":null},{"surface":"兼ね","vocabId":"1256520","reading":"かねる","baseForm":"兼ねる"},{"surface":"て","vocabId":null},{"surface":"、","vocabId":null},{"surface":"日本","vocabId":"1582710","reading":"にほん"},{"surface":"の","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"を","vocabId":null},{"surface":"見","vocabId":"1259290","reading":"みる","baseForm":"見る"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7]},{"jp":"仕事も兼ねて、海外に行く予定です。","romaji":"Shigoto mo kanete, kaigai ni iku yotei desu.","en":"I plan to go abroad, also for work.","words":[{"surface":"仕事","vocabId":"1304970","reading":"しごと"},{"surface":"も","vocabId":null},{"surface":"兼ね","vocabId":"1256520","reading":"かねる","baseForm":"兼ねる"},{"surface":"て","vocabId":null},{"surface":"、","vocabId":null},{"surface":"海外","vocabId":"1201260","reading":"かいがい"},{"surface":"に","vocabId":null},{"surface":"行く","vocabId":"1578850","reading":"いく"},{"surface":"予定","vocabId":"1543240","reading":"よてい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"旅行も兼ねて、友人の結婚式に出席します。","romaji":"Ryokou mo kanete, yuujin no kekkonshiki ni shusseki shimasu.","en":"I will attend a friend's wedding, also as a trip.","words":[{"surface":"旅行","vocabId":"1553170","reading":"りょこう"},{"surface":"も","vocabId":null},{"surface":"兼ね","vocabId":"1256520","reading":"かねる","baseForm":"兼ねる"},{"surface":"て","vocabId":null},{"surface":"、","vocabId":null},{"surface":"友人","vocabId":"1540150","reading":"ゆうじん"},{"surface":"の","vocabId":null},{"surface":"結婚式","vocabId":"1254810","reading":"けっこんしき"},{"surface":"に","vocabId":null},{"surface":"出席","vocabId":"1339460","reading":"しゅっせき"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]}],"formalityLevel":"very-formal-literary","usageNote":"Formal, literary \"doubling as/also serving as\" - describes one action serving two purposes.","family":{"id":"also","name":"Also (In Addition, Too)","relatedPoints":["n4-118","n5-041","n3-030"]}}