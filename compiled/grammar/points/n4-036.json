{"id":"n4-036","title":"Verb ている間に (te iru aida ni)","jlptLevel":4,"shortExplanation":"Expresses 'while' or 'during the time' something is happening.","longExplanation":"The ～ている間に grammar point is used to express that an action or event occurs during the time another action or event is happening. It is often translated to 'while' or 'during the time' in English. It is formed by combining the て-form of a verb with いる and adding 間に.","formation":"Verb-て form + いる + 間に","examples":[{"jp":"映画を見ている間に、彼は寝てしまった。","romaji":"Eiga o mite iru aida ni, kare wa nete shimatta.","en":"While watching the movie, he fell asleep.","words":[{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"を","vocabId":null},{"surface":"見","vocabId":"1259290","reading":"みる","baseForm":"見る"},{"surface":"て","vocabId":null},{"surface":"いる","vocabId":"1577980","reading":"いる"},{"surface":"間","vocabId":"1215230","reading":"あいだ"},{"surface":"に","vocabId":null},{"surface":"、","vocabId":null},{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"寝","vocabId":"1642760","reading":"ね","baseForm":"寝る"},{"surface":"て","vocabId":null},{"surface":"しまっ","vocabId":null,"baseForm":"しまう"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6]},{"jp":"子供が遊んでいる間に、私は料理を作ります。","romaji":"Kodomo ga asonde iru aida ni, watashi wa ryouri o tsukurimasu.","en":"While the children are playing, I'll cook.","words":[{"surface":"子供","vocabId":"1307850","reading":"こども"},{"surface":"が","vocabId":null},{"surface":"遊ん","vocabId":"1542160","reading":"あそぶ","baseForm":"遊ぶ"},{"surface":"で","vocabId":null},{"surface":"いる","vocabId":"1577980","reading":"いる"},{"surface":"間","vocabId":"1215230","reading":"あいだ"},{"surface":"に","vocabId":null},{"surface":"、","vocabId":null},{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"料理","vocabId":"1554310","reading":"りょうり"},{"surface":"を","vocabId":null},{"surface":"作り","vocabId":"1297250","reading":"つくり","baseForm":"作る"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6]},{"jp":"会議が行われている間に、雨が降り始めた。","romaji":"Kaigi ga okonawarete iru aida ni, ame ga furihajimeta.","en":"While the meeting was being held, it started raining.","words":[{"surface":"会議","vocabId":"1198360","reading":"かいぎ"},{"surface":"が","vocabId":null},{"surface":"行わ","vocabId":"1589060","reading":"おこなう","baseForm":"行う"},{"surface":"れ","vocabId":null,"baseForm":"れる"},{"surface":"て","vocabId":null},{"surface":"いる","vocabId":"1577980","reading":"いる"},{"surface":"間","vocabId":"1215230","reading":"あいだ"},{"surface":"に","vocabId":null},{"surface":"、","vocabId":null},{"surface":"雨","vocabId":"1171900","reading":"あめ"},{"surface":"が","vocabId":null},{"surface":"降り","vocabId":"1631470","reading":"ふり","baseForm":"降る"},{"surface":"始め","vocabId":"1342540","reading":"はじめ","baseForm":"始める"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7]},{"jp":"彼が仕事をしている間に、私たちは買い物に行く。","romaji":"Kare ga shigoto o shite iru aida ni, watashitachi wa kaimono ni iku.","en":"While he is working, we'll go shopping.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"が","vocabId":null},{"surface":"仕事","vocabId":"1304970","reading":"しごと"},{"surface":"を","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"いる","vocabId":"1577980","reading":"いる"},{"surface":"間","vocabId":"1215230","reading":"あいだ"},{"surface":"に","vocabId":null},{"surface":"、","vocabId":null},{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"たち","vocabId":"1416220","reading":"たち"},{"surface":"は","vocabId":null},{"surface":"買い物","vocabId":"1589730","reading":"かいもの"},{"surface":"に","vocabId":null},{"surface":"行く","vocabId":"1578850","reading":"いく"},{"surface":"。","vocabId":null}],"patternWordIndices":[6,7,8]}],"formalityLevel":"neutral","usageNote":"\"While (an ongoing action continues)\" - pairs with an ongoing verb.","family":{"id":"time-window","name":"Time Window (During / While It Lasts)","relatedPoints":["n2-040","n3-002","n4-011"]}}