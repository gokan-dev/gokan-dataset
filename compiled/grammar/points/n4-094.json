{"id":"n4-094","title":"～でしょう (〜deshou)","jlptLevel":4,"shortExplanation":"A conjecture or probability; 'probably', 'I think', 'it seems'.","longExplanation":"The ～でしょう grammar point is used to indicate a conjecture or probability. It can be translated as 'probably', 'I think', or 'it seems' in English. It can be used with verbs, い-adjectives, な-adjectives, and nouns.","formation":"Verb-ますstem + でしょう, い-Adjective + でしょう, な-Adjective + でしょう, Noun + でしょう","examples":[{"jp":"明日は晴れでしょう。","romaji":"Ashita wa hare deshou.","en":"It will probably be sunny tomorrow.","words":[{"surface":"明日","vocabId":"1584660","reading":"あした"},{"surface":"は","vocabId":null},{"surface":"晴れ","vocabId":"1376460","reading":"はれ"},{"surface":"でしょ","vocabId":null,"baseForm":"です"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"彼は元気でしょう。","romaji":"Kare wa genki deshou.","en":"He is probably fine.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"元気","vocabId":"1260720","reading":"げんき"},{"surface":"でしょ","vocabId":null,"baseForm":"です"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"この本は面白いでしょう。","romaji":"Kono hon wa omoshiroi deshou.","en":"This book is probably interesting.","words":[{"surface":"この","vocabId":null},{"surface":"本","vocabId":"1522150","reading":"ほん"},{"surface":"は","vocabId":null},{"surface":"面白い","vocabId":"1533580","reading":"おもしろい"},{"surface":"でしょ","vocabId":null,"baseForm":"です"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5]},{"jp":"彼女は医者でしょう。","romaji":"Kanojo wa isha deshou.","en":"She is probably a doctor.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"医者","vocabId":"1159980","reading":"いしゃ"},{"surface":"でしょ","vocabId":null,"baseForm":"です"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]}],"formalityLevel":"polite","usageNote":"Polite conjecture - \"probably/I think\", softer and more polite than だろう.","family":{"id":"inference","name":"Inference (It Seems / Probably)","relatedPoints":["n4-091","n4-119","n3-118","n3-055","n3-126","n4-077","n3-106","n1-205","n1-207","n2-146"]}}