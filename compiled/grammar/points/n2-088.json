{"id":"n2-088","title":"～てはならない (〜te wa naranai)","jlptLevel":2,"shortExplanation":"Express prohibition; 'must not', 'cannot', 'should not'.","longExplanation":"The ～てはならない grammar point is used to express a strong prohibition. It is often more formal or strict and can be translated as 'must not', 'cannot', or 'should not.'","formation":"Verb-て form + はならない","examples":[{"jp":"ここでタバコを吸ってはならない。","romaji":"Koko de tabako o sutte wa naranai.","en":"You must not smoke here.","words":[{"surface":"ここ","vocabId":"1288810","reading":"ここ"},{"surface":"で","vocabId":null},{"surface":"タバコ","vocabId":null},{"surface":"を","vocabId":null},{"surface":"吸っ","vocabId":"1228260","reading":"すう","baseForm":"吸う"},{"surface":"て","vocabId":null},{"surface":"は","vocabId":null},{"surface":"なら","vocabId":"2827768","reading":"なら","baseForm":"なる"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[6,7,8]},{"jp":"秘密を他人に話してはならない。","romaji":"Himitsu o tanin ni hanashite wa naranai.","en":"You cannot reveal this secret to others.","words":[{"surface":"秘密","vocabId":"1484150","reading":"ひみつ"},{"surface":"を","vocabId":null},{"surface":"他人","vocabId":"1581400","reading":"たにん"},{"surface":"に","vocabId":null},{"surface":"話し","vocabId":"1562350","reading":"はなす","baseForm":"話す"},{"surface":"て","vocabId":null},{"surface":"は","vocabId":null},{"surface":"なら","vocabId":"2827768","reading":"なら","baseForm":"なる"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[6,7,8]},{"jp":"この部屋に入ってはならない。","romaji":"Kono heya ni haitte wa naranai.","en":"You must not enter this room.","words":[{"surface":"この","vocabId":null},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"に","vocabId":null},{"surface":"入っ","vocabId":"1465590","reading":"はいる","baseForm":"入る"},{"surface":"て","vocabId":null},{"surface":"は","vocabId":null},{"surface":"なら","vocabId":"2827768","reading":"なら","baseForm":"なる"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7]},{"jp":"飲酒運転をしてはならない。","romaji":"Inshu unten o shite wa naranai.","en":"You must not drink and drive.","words":[{"surface":"飲酒","vocabId":"1169900","reading":"いんしゅ"},{"surface":"運転","vocabId":"1172830","reading":"うんてん"},{"surface":"を","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"は","vocabId":null},{"surface":"なら","vocabId":"2827768","reading":"なら","baseForm":"なる"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7]}]}