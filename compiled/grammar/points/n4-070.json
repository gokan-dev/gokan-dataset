{"id":"n4-070","title":"Verb 出す","romaji":"~dasu","jlptLevel":4,"shortExplanation":"Express the action of taking something out, starting an action, or emphasizing a verb.","longExplanation":"The verb 出す (~dasu) is used to express the action of taking something out, starting an action, or emphasizing the verb it is attached to. To form this grammar point, simply attach 出す (~dasu) to the stem of the verb.","formation":"Verb stem + 出す (~dasu)","examples":[{"jp":"急に雨が降り出しました。","romaji":"Kyuu ni ame ga furidashimashita.","en":"It suddenly started to rain.","words":[{"surface":"急に","vocabId":"2269050","reading":"きゅうに"},{"surface":"雨","vocabId":"1171900","reading":"あめ"},{"surface":"が","vocabId":null},{"surface":"降り出し","vocabId":"1282770","reading":"ふりだし","baseForm":"降り出す"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"赤ちゃんが泣き出した。","romaji":"Akachan ga nakidashita.","en":"The baby burst out crying.","words":[{"surface":"赤ちゃん","vocabId":"1383260","reading":"あかちゃん"},{"surface":"が","vocabId":null},{"surface":"泣き","vocabId":"1229840","reading":"なき","baseForm":"泣く"},{"surface":"出し","vocabId":"1338180","reading":"だし","baseForm":"出す"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼女は歌い出しました。","romaji":"Kanojo wa utaidashimashita.","en":"She started singing.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"歌い","vocabId":"1588120","reading":"うたい","baseForm":"歌う"},{"surface":"出し","vocabId":"1338180","reading":"だし","baseForm":"出す"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"話を聞いて、みんなが笑い出した。","romaji":"Hanashi o kiite, minna ga waraidashita.","en":"Hearing the story, everyone burst out laughing.","words":[{"surface":"話","vocabId":"1600900","reading":"はなし"},{"surface":"を","vocabId":null},{"surface":"聞いて","vocabId":"1591110","reading":"きいて","baseForm":"聞く"},{"surface":"、","vocabId":null},{"surface":"みんな","vocabId":null},{"surface":"が","vocabId":null},{"surface":"笑い","vocabId":"1351360","reading":"わらい","baseForm":"笑う"},{"surface":"出し","vocabId":"1338180","reading":"だし","baseForm":"出す"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[7]}],"formalityLevel":"neutral","usageNote":"ます stem + 出す: suddenly start (泣き出す).","family":{"id":"aspect-verbs","name":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","relatedPoints":["n4-073","n4-072","n3-128","n3-129","n2-180","n1-074"],"axis":"constraint"},"kind":"construction"}