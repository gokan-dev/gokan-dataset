{"id":"n5-022","title":"Noun か Noun か～","romaji":"Noun ka Noun ka～","jlptLevel":5,"shortExplanation":"Expresses choice or alternatives; 'either', 'or'.","longExplanation":"The Noun か Noun か～ grammar point is used to present two or more alternatives for a choice. It can be translated to 'either', 'or' in English. It is formed by placing the particle か in between two nouns or noun phrases.","formation":"Noun1 + か + Noun2 + か～","examples":[{"jp":"今日、映画を見るか、散歩するかどちらにしますか？","romaji":"Kyou, eiga wo miru ka, sanpo suru ka dochira ni shimasu ka?","en":"Will we watch a movie or go for a walk today?","words":[{"surface":"今日","vocabId":"1579110","reading":"きょう"},{"surface":"、","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"を","vocabId":null},{"surface":"見る","vocabId":"1259290","reading":"みる"},{"surface":"か","vocabId":null},{"surface":"、","vocabId":null},{"surface":"散歩","vocabId":"1303620","reading":"さんぽ"},{"surface":"する","vocabId":"1595910","reading":"する"},{"surface":"か","vocabId":null},{"surface":"どちら","vocabId":null},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"か","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[5,9]},{"jp":"コーヒーか紅茶か、一つだけ選んでください。","romaji":"Koohii ka koucha ka, hitotsu dake erande kudasai.","en":"Please choose only one, either coffee or tea.","words":[{"surface":"コーヒー","vocabId":null},{"surface":"か","vocabId":null},{"surface":"紅茶","vocabId":"1280770","reading":"こうちゃ"},{"surface":"か","vocabId":null},{"surface":"、","vocabId":null},{"surface":"一つ","vocabId":"1160820","reading":"ひとつ"},{"surface":"だけ","vocabId":null},{"surface":"選んでください","vocabId":"1588730","reading":"えらんでください","baseForm":"選ぶ"},{"surface":"。","vocabId":null}],"patternWordIndices":[1,3]},{"jp":"電車かバスを使って、学校に行くつもりです。","romaji":"Densha ka basu o tsukatte, gakkou ni iku tsumori desu.","en":"I plan to go to school using either the train or the bus.","words":[{"surface":"電車","vocabId":"1443530","reading":"でんしゃ"},{"surface":"か","vocabId":null},{"surface":"バス","vocabId":null},{"surface":"を","vocabId":null},{"surface":"使って","vocabId":"1305990","reading":"つかって","baseForm":"使う"},{"surface":"、","vocabId":null},{"surface":"学校","vocabId":"1206730","reading":"がっこう"},{"surface":"に","vocabId":null},{"surface":"行く","vocabId":"1578850","reading":"いく"},{"surface":"つもり","vocabId":null},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,4]},{"jp":"週末は山に登るか海に行くか、まだ決めていません。","romaji":"Shuumatsu wa yama ni noboru ka umi ni iku ka, mada kimete imasen.","en":"I haven't decided whether to climb the mountain or go to the beach this weekend.","words":[{"surface":"週末","vocabId":"1333520","reading":"しゅうまつ"},{"surface":"は","vocabId":null},{"surface":"山","vocabId":"1302680","reading":"やま"},{"surface":"に","vocabId":null},{"surface":"登る","vocabId":"1352570","reading":"のぼる"},{"surface":"か","vocabId":null},{"surface":"海","vocabId":"1201190","reading":"うみ"},{"surface":"に","vocabId":null},{"surface":"行く","vocabId":"1578850","reading":"いく"},{"surface":"か","vocabId":null},{"surface":"、","vocabId":null},{"surface":"まだ","vocabId":"1527110","reading":"まだ"},{"surface":"決めていません","vocabId":"1254180","reading":"きめていません","baseForm":"決める"},{"surface":"。","vocabId":null}],"patternWordIndices":[5,9]}],"formalityLevel":"neutral","usageNote":"Neutral, everyday \"A or B\" for simple choices.","family":{"id":"or-choice","name":"Or (Alternatively)","relatedPoints":["n3-031"],"axis":"register"},"kind":"construction"}