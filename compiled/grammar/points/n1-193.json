{"id":"n1-193","title":"～といったらありはしない","romaji":"〜to ittara ari wa shinai","jlptLevel":1,"shortExplanation":"Express extreme exclamation; 'extremely', 'unbelievable', 'unsurpassed'.","longExplanation":"The ～といったらありはしない grammar point is used to express an extreme degree of something, often surprise or admiration. It can be loosely translated as 'unbelievably...' or 'incredibly...'.","formation":"Noun + といったらありはしない / な-Adjective + といったらありはしない","examples":[{"jp":"彼の英語の上手さといったらありはしない。","romaji":"Kare no eigo no jouzusa to ittara ari wa shinai.","en":"His English is unbelievably good.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"の","vocabId":null},{"surface":"英語","vocabId":"1174420","reading":"えいご"},{"surface":"の","vocabId":null},{"surface":"上手","vocabId":"1353320","reading":"じょうず"},{"surface":"さ","vocabId":"1291070","reading":"さ"},{"surface":"と","vocabId":null},{"surface":"いっ","vocabId":null,"baseForm":"いう"},{"surface":"たら","vocabId":null,"baseForm":"た"},{"surface":"あり","vocabId":"1225940","reading":"あり","baseForm":"ある"},{"surface":"は","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[6,7,8,9,10,11,12]},{"jp":"このスイーツの美味しさといったらありはしない。","romaji":"Kono suiitsu no oishisa to ittara ari wa shinai.","en":"These sweets are unbelievably delicious.","words":[{"surface":"この","vocabId":null},{"surface":"スイーツ","vocabId":null},{"surface":"の","vocabId":null},{"surface":"美味し","vocabId":"1486650","reading":"おいしい","baseForm":"美味しい"},{"surface":"さ","vocabId":"1291070","reading":"さ"},{"surface":"と","vocabId":null},{"surface":"いっ","vocabId":null,"baseForm":"いう"},{"surface":"たら","vocabId":null,"baseForm":"た"},{"surface":"あり","vocabId":"1225940","reading":"あり","baseForm":"ある"},{"surface":"は","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIn