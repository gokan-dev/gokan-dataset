{"id":"n5-043","title":"Noun を〜","romaji":"Noun wo〜","jlptLevel":5,"shortExplanation":"Indicates the direct object of a verb.","longExplanation":"The を (wo) particle is used to mark the direct object of a verb in a sentence. It shows the noun that the action (verb) is performed on. The particle を is usually pronounced as 'o' in spoken Japanese.","formation":"Noun + を + Verb","examples":[{"jp":"私は本を読みます。","romaji":"Watashi wa hon wo yomimasu.","en":"I read a book.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"本","vocabId":"1522150","reading":"ほん"},{"surface":"を","vocabId":null},{"surface":"読みます","vocabId":"1456360","reading":"よみます","baseForm":"読む"},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼はケーキを食べました。","romaji":"Kare wa keeki wo tabemashita.","en":"He ate a cake.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"ケーキ","vocabId":null},{"surface":"を","vocabId":null},{"surface":"食べました","vocabId":"1358280","reading":"たべました","baseForm":"食べる"},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"母はコーヒーを飲むのが好きです。","romaji":"Haha wa koohii wo nomu no ga suki desu.","en":"My mother likes to drink coffee.","words":[{"surface":"母","vocabId":"1514990","reading":"はは"},{"surface":"は","vocabId":null},{"surface":"コーヒー","vocabId":null},{"surface":"を","vocabId":null},{"surface":"飲む","vocabId":"1169870","reading":"のむ"},{"surface":"の","vocabId":"1537250","reading":"の"},{"surface":"が","vocabId":null},{"surface":"好き","vocabId":"1277450","reading":"すき"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"友達が私のペンを使いました。","romaji":"Tomodachi ga watashi no pen wo tsukaimashita.","en":"My friend used my pen.","words":[{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"が","vocabId":null},{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"の","vocabId":null},{"surface":"ペン","vocabId":null},{"surface":"を","vocabId":null},{"surface":"使いました","vocabId":"1305990","reading":"つかいました","baseForm":"使う"},{"surface":"。","vocabId":null}],"patternWordIndices":[5]}]}