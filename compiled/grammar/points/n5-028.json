{"id":"n5-028","title":"Noun ごろ～ (Noun + goro～)","jlptLevel":5,"shortExplanation":"Expresses 'around' or 'about' a certain time or age.","longExplanation":"The ごろ grammar point is used to indicate 'around' or 'about' a certain time or age. It is commonly used with time-related expressions and age-related expressions to give an approximate time or age.","formation":"Noun + ごろ","examples":[{"jp":"昼ごろに電話してください。","romaji":"Hiru goro ni denwa shite kudasai.","en":"Please call me around noon.","words":[{"surface":"昼","vocabId":"1426250","reading":"ひる"},{"surface":"ごろ","vocabId":"1271230","reading":"ごろ"},{"surface":"に","vocabId":null},{"surface":"電話","vocabId":"1443840","reading":"でんわ"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"ください","vocabId":"1184270","reading":"ください","baseForm":"くださる"},{"surface":"。","vocabId":null}],"patternWordIndices":[1]},{"jp":"彼は10歳ごろに日本に来ました。","romaji":"Kare wa juu-sai goro ni Nihon ni kimashita.","en":"He came to Japan around the age of 10.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"10","vocabId":null},{"surface":"歳","vocabId":"1294940","reading":"さい"},{"surface":"ごろ","vocabId":"1271230","reading":"ごろ"},{"surface":"に","vocabId":null},{"surface":"日本","vocabId":"1582710","reading":"にほん"},{"surface":"に","vocabId":null},{"surface":"来","vocabId":"1547710","reading":"らい","baseForm":"来る"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4]},{"jp":"午後３時ごろに会いましょう。","romaji":"Gogo san-ji goro ni aimashou.","en":"Let's meet around 3 PM.","words":[{"surface":"午後","vocabId":"1268990","reading":"ごご"},{"surface":"３","vocabId":"1579350","reading":"さん"},{"surface":"時","vocabId":"1315840","reading":"とき"},{"surface":"ごろ","vocabId":"1271230","reading":"ごろ"},{"surface":"に","vocabId":null},{"surface":"会い","vocabId":"1198180","reading":"あう","baseForm":"会う"},{"surface":"ましょ","vocabId":null,"baseForm":"ます"},{"surface":"う","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"昨日の夜8時ごろに帰りました。","romaji":"Kinou no yoru hachi-ji goro ni kaerimashita.","en":"I returned home last night around 8 o'clock.","words":[{"surface":"昨日","vocabId":"1579260","reading":"きのう"},{"surface":"の","vocabId":null},{"surface":"夜","vocabId":"1536350","reading":"よる"},{"surface":"8","vocabId":null},{"surface":"時","vocabId":"1315840","reading":"とき"},{"surface":"ごろ","vocabId":"1271230","reading":"ごろ"},{"surface":"に","vocabId":null},{"surface":"帰り","vocabId":"1221250","reading":"かえり","baseForm":"帰る"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5]}],"formalityLevel":"neutral","usageNote":"Same idea as くらい/ぐらい but specifically for a POINT IN TIME (\"around 3 o'clock\"), not a quantity - doesn't substitute for くらい/ぐらい on quantities.","family":{"id":"approximation","name":"Approximation (About / Approximately)","relatedPoints":["n5-027","n3-012","n5-026","n5-086"]}}