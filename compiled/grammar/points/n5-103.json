{"id":"n5-103","title":"どこでも～","romaji":"dokodemo～","jlptLevel":5,"shortExplanation":"Express 'anywhere' or 'everywhere' in Japanese.","longExplanation":"The grammar point どこでも is used to express 'anywhere' or 'everywhere' in Japanese. It is usually used in sentences to indicate that an action or situation could happen or exist in any location.","formation":"Simply use the word どこでも in the sentence as an adverb to indicate 'anywhere' or 'everywhere'.","examples":[{"jp":"どこでも好きな場所で勉強できます。","romaji":"Dokodemo sukina basho de benkyou dekimasu.","en":"You can study anywhere you like.","words":[{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"でも","vocabId":null},{"surface":"好き","vocabId":"1277450","reading":"すき"},{"surface":"な","vocabId":null,"baseForm":"だ"},{"surface":"場所","vocabId":"1355850","reading":"ばしょ"},{"surface":"で","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"でき","vocabId":null,"baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0,1]},{"jp":"このノートパソコンは便利なので、どこでもインターネットが使えます。","romaji":"Kono nootopasokon wa benri nano de, dokodemo intaanetto ga tsukaemasu.","en":"This laptop is convenient, so you can use the internet anywhere.","words":[{"surface":"この","vocabId":null},{"surface":"ノート","vocabId":null},{"surface":"パソコン","vocabId":null},{"surface":"は","vocabId":null},{"surface":"便利","vocabId":"1512610","reading":"べんり"},{"surface":"な","vocabId":null,"baseForm":"だ"},{"surface":"ので","vocabId":null},{"surface":"、","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"でも","vocabId":null},{"surface":"インターネット","vocabId":null},{"surface":"が","vocabId":null},{"surface":"使えます","vocabId":"1607180","reading":"つかえます","baseForm":"使える"},{"surface":"。","vocabId":null}],"patternWordIndices":[8,9]},{"jp":"彼はどこでも寝ることができます。","romaji":"Kare wa dokodemo neru koto ga dekimasu.","en":"He can sleep anywhere.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"でも","vocabId":null},{"surface":"寝る","vocabId":"1360010","reading":"ねる"},{"surface":"こと","vocabId":null},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":null,"baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3]},{"jp":"彼女はどこでも歌うのが大好きです。","romaji":"Kanojo wa dokodemo utau no ga daisuki desu.","en":"She loves singing anywhere.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"でも","vocabId":null},{"surface":"歌う","vocabId":"1588120","reading":"うたう"},{"surface":"の","vocabId":null},{"surface":"が","vocabId":null},{"surface":"大好き","vocabId":"1413660","reading":"だいすき"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3]}],"kind":"construction"}