{"id":"n5-023","title":"Noun が できます","romaji":"Noun ga dekimasu","jlptLevel":5,"shortExplanation":"Express the ability to do something.","longExplanation":"The Noun が できます grammar point is used to express the ability to do something. In this grammar pattern, the noun is the activity that the speaker or subject can do. It translates as 'can do' or 'able to do' in English.","formation":"Noun + が + できます","examples":[{"jp":"英語ができます。","romaji":"Eigo ga dekimasu.","en":"I can speak English.","words":[{"surface":"英語","vocabId":"1174420","reading":"えいご"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"料理ができます。","romaji":"Ryouri ga dekimasu.","en":"I can cook.","words":[{"surface":"料理","vocabId":"1554310","reading":"りょうり"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"彼は泳ぎができます。","romaji":"Kare wa oyogi ga dekimasu.","en":"He can swim.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"泳ぎ","vocabId":"1613570","reading":"およぎ"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]},{"jp":"彼女はピアノができます。","romaji":"Kanojo wa piano ga dekimasu.","en":"She can play the piano.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"ピアノ","vocabId":null},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]}],"kind":"construction"}