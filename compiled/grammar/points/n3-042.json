{"id":"n3-042","title":"～っけ？","romaji":"〜kke?","jlptLevel":3,"shortExplanation":"Used to express that one is trying to recall some information.","longExplanation":"The ～っけ？ grammar point is added at the end of a sentence when the speaker is trying to recall something or confirm a memory. It can be used with verbs, adjectives, or nouns in casual form.","formation":"Verb-casual + っけ?, い-Adjective + かったっけ?, な-Adjective/Noun + だっけ?","examples":[{"jp":"彼は何時に来るっけ？","romaji":"Kare wa nanji ni kuru kke?","en":"What time is he coming again?","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"何時","vocabId":"1188770","reading":"なんじ"},{"surface":"に","vocabId":null},{"surface":"来る","vocabId":"1547720","reading":"くる"},{"surface":"っけ","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[5]},{"jp":"この映画、面白かったっけ？","romaji":"Kono eiga, omoshirokatta kke?","en":"Was this movie interesting?","words":[{"surface":"この","vocabId":null},{"surface":"映画","vocabId":"1173720","reading":"えいが"},{"surface":"、","vocabId":null},{"surface":"面白かった","vocabId":"1533580","reading":"おもしろかった","baseForm":"面白い"},{"surface":"っけ","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"彼女は学生だっけ？","romaji":"Kanojo wa gakusei dakke?","en":"She was a student, right?","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"学生","vocabId":"1206900","reading":"がくせい"},{"surface":"だ","vocabId":null},{"surface":"っけ","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"すし屋はどこだっけ？","romaji":"Sushiya wa doko dakke?","en":"Where was the sushi place again?","words":[{"surface":"すし","vocabId":"1595650","reading":"すし"},{"surface":"屋","vocabId":"2082160","reading":"や"},{"surface":"は","vocabId":null},{"surface":"どこ","vocabId":"1577140","reading":"どこ"},{"surface":"だ","vocabId":null},{"surface":"っけ","vocabId":null},{"surface":"？","vocabId":null}],"patternWordIndices":[4,5]}],"kind":"construction"}