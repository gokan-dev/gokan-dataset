{"id":"n5-018","title":"な-Adjective に + Verb","jlptLevel":5,"shortExplanation":"Turn a な-adjective into an adverb by adding に.","longExplanation":"To make a な-adjective modify a verb, remove the な and add に. This form describes how an action is performed. For instance, 静か（な） → 静かに, 親切（な） → 親切に.","formation":"な-Adjective (remove な) + に + Verb","examples":[{"jp":"彼は静かに話す。","romaji":"Kare wa shizuka ni hanasu.","en":"He speaks quietly.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"静かに","vocabId":"2119870","reading":"しずかに"},{"surface":"話す","vocabId":"1562350","reading":"はなす"},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"部屋をきれいに掃除した。","romaji":"Heya o kirei ni souji shita.","en":"I cleaned the room neatly.","words":[{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"を","vocabId":null},{"surface":"きれい","vocabId":"1591900","reading":"きれい"},{"surface":"に","vocabId":null},{"surface":"掃除","vocabId":"1399790","reading":"そうじ"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼女は元気に働いています。","romaji":"Kanojo wa genki ni hataraite imasu.","en":"She works energetically.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"元気","vocabId":"1260720","reading":"げんき"},{"surface":"に","vocabId":null},{"surface":"働いています","vocabId":"1451150","reading":"はたらいています","baseForm":"働く"},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"先生は親切に説明してくれる。","romaji":"Sensei wa shinsetsu ni setsumei shite kureru.","en":"The teacher explains kindly.","words":[{"surface":"先生","vocabId":"1387990","reading":"せんせい"},{"surface":"は","vocabId":null},{"surface":"親切","vocabId":"1365250","reading":"しんせつ"},{"surface":"に","vocabId":null},{"surface":"説明","vocabId":"1386460","reading":"せつめい"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"