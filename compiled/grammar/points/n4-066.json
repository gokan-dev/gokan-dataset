{"id":"n4-066","title":"Verb ることにする (〜ru koto ni suru)","jlptLevel":4,"shortExplanation":"Decide to do something, make a decision.","longExplanation":"The ～ることにする grammar point is used to express that someone has made a decision to do something or has decided on a specific course of action. It is formed by attaching ことにする to the verb in its る form.","formation":"Verb-る + ことにする","examples":[{"jp":"来週、ジムに行くことにしました。","romaji":"Raishuu, jimu ni iku koto ni shimashita.","en":"I decided to go to the gym next week.","words":[{"surface":"来週","vocabId":"1548010","reading":"らいしゅう"},{"surface":"、","vocabId":null},{"surface":"ジム","vocabId":"1314270","reading":"じむ"},{"surface":"に","vocabId":null},{"surface":"行く","vocabId":"1578850","reading":"いく"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7]},{"jp":"この靴を買うことにしました。","romaji":"Kono kutsu wo kau koto ni shimashita.","en":"I decided to buy these shoes.","words":[{"surface":"この","vocabId":null},{"surface":"靴","vocabId":"1246700","reading":"くつ"},{"surface":"を","vocabId":null},{"surface":"買う","vocabId":"1473740","reading":"かう"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6]},{"jp":"毎日、散歩をすることにしました。","romaji":"Mainichi, sanpo wo suru koto ni shimashita.","en":"I decided to take a walk every day.","words":[{"surface":"毎日","vocabId":"1524720","reading":"まいにち"},{"surface":"、","vocabId":null},{"surface":"散歩","vocabId":"1303620","reading":"さんぽ"},{"surface":"を","vocabId":null},{"surface":"する","vocabId":"1595910","reading":"する"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6,7]},{"jp":"彼に電話をかけることにします。","romaji":"Kare ni denwa wo kakeru koto ni shimasu.","en":"I’ve decided to call him.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"に","vocabId":null},{"surface":"電話","vocabId":"1443840","reading":"でんわ"},{"surface":"を","vocabId":null},{"surface":"かける","vocabId":"1207610","reading":"かける"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6,7]}]}