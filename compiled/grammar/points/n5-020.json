{"id":"n5-020","title":"な-Adjective に します (na-Adjective ni shimasu)","jlptLevel":5,"shortExplanation":"Expressing a decision or preference with a な-adjective.","longExplanation":"The な-adjective に します pattern is used to express a decision or choice based on a な-adjective. It often translates as 'I’ll make it ...,' 'I will choose ...,' or 'I’ve decided on ...'.","formation":"な-Adjective + に + します","examples":[{"jp":"静かにします。","romaji":"Shizuka ni shimasu.","en":"I will be quiet.","words":[{"surface":"静か","vocabId":"1381820","reading":"しずか"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"部屋をきれいにします。","romaji":"Heya o kirei ni shimasu.","en":"I will make the room clean.","words":[{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"を","vocabId":null},{"surface":"きれい","vocabId":"1591900","reading":"きれい"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]},{"jp":"明日の会議は簡単にします。","romaji":"Ashita no kaigi wa kantan ni shimasu.","en":"I will make tomorrow’s meeting simple.","words":[{"surface":"明日","vocabId":"1584660","reading":"あした"},{"surface":"の","vocabId":null},{"surface":"会議","vocabId":"1198360","reading":"かいぎ"},{"surface":"は","vocabId":null},{"surface":"簡単","vocabId":"1214330","reading":"かんたん"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7]},{"jp":"健康的な食事にします。","romaji":"Kenkou-teki na shokuji ni shimasu.","en":"I will choose a healthy meal.","words":[{"surface":"健康","vocabId":"1256170","reading":"けんこう"},{"surface":"的","vocabId":"1437260","reading":"てき"},{"surface":"な","vocabId":null,"baseForm":"だ"},{"surface":"食事","vocabId":"1358490","reading":"しょくじ"},{"surface":"に","vocabId":null},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6]}]}