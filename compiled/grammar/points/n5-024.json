{"id":"n5-024","title":"Noun がほしいです","romaji":"〜ga hoshii desu","jlptLevel":5,"shortExplanation":"Express a desire or wanting something; 'I want', 'I would like'.","longExplanation":"The がほしいです grammar point is used to express a desire or the act of wanting something in polite form. It can be translated as 'I want' or 'I would like' in English. It is used with a noun and the particle が.","formation":"Noun + が + ほしいです","examples":[{"jp":"新しい車がほしいです。","romaji":"Atarashii kuruma ga hoshii desu.","en":"I want a new car.","words":[{"surface":"新しい","vocabId":"1361490","reading":"あたらしい"},{"surface":"車","vocabId":"1323080","reading":"くるま"},{"surface":"が","vocabId":null},{"surface":"ほしい","vocabId":"1547330","reading":"ほしい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3,4]},{"jp":"コーヒーがほしいです。","romaji":"Koohii ga hoshii desu.","en":"I would like some coffee.","words":[{"surface":"コーヒー","vocabId":null},{"surface":"が","vocabId":null},{"surface":"ほしい","vocabId":"1547330","reading":"ほしい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]},{"jp":"彼女は花がほしいです。","romaji":"Kanojo wa hana ga hoshii desu.","en":"She wants flowers.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"花","vocabId":"1194500","reading":"はな"},{"surface":"が","vocabId":null},{"surface":"ほしい","vocabId":"1547330","reading":"ほしい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4,5]},{"jp":"友達がほしいです。","romaji":"Tomodachi ga hoshii desu.","en":"I want a friend.","words":[{"surface":"友達","vocabId":"1540170","reading":"ともだち"},{"surface":"が","vocabId":null},{"surface":"ほしい","vocabId":"1547330","reading":"ほしい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[1,2,3]}],"kind":"construction"}