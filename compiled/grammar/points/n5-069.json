{"id":"n5-069","title":"いつも～ (itsumo～)","jlptLevel":5,"shortExplanation":"Expressing 'always' or 'usually' in a sentence.","longExplanation":"The grammar point いつも (itsumo) is used to express the meaning of 'always' or 'usually' when describing a habitual action or situation. It is often used with the present tense or past tense to show that something is done on a regular basis or has been happening consistently.","formation":"いつも + Verb / Adjective / Noun","examples":[{"jp":"彼はいつも遅刻します。","romaji":"Kare wa itsumo chikoku shimasu.","en":"He is always late.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"いつも","vocabId":"1188890","reading":"いつも"},{"surface":"遅刻","vocabId":"1422050","reading":"ちこく"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"私はいつも優しい犬が好きです。","romaji":"Watashi wa itsumo yasashii inu ga suki desu.","en":"I always like gentle dogs.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"いつも","vocabId":"1188890","reading":"いつも"},{"surface":"優しい","vocabId":"1539040","reading":"やさしい"},{"surface":"犬","vocabId":"1258330","reading":"いぬ"},{"surface":"が","vocabId":null},{"surface":"好き","vocabId":"1277450","reading":"すき"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"彼女はいつも静かな場所で勉強します。","romaji":"Kanojo wa itsumo shizuka na basho de benkyou shimasu.","en":"She always studies in a quiet place.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"いつも","vocabId":"1188890","reading":"いつも"},{"surface":"静か","vocabId":"1381820","reading":"しずか"},{"surface":"な","vocabId":null,"baseForm":"だ"},{"surface":"場所","vocabId":"1355850","reading":"ばしょ"},{"surface":"で","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"いつも朝ご飯を食べます。","romaji":"Itsumo asagohan wo tabemasu.","en":"I always eat breakfast.","words":[{"surface":"いつも","vocabId":"1188890","reading":"いつも"},{"surface":"朝","vocabId":"1428280","reading":"あさ"},{"surface":"ご飯","vocabId":"1270590","reading":"ごはん"},{"surface":"を","vocabId":null},{"surface":"食べ","vocabId":"1358280","reading":"たべる","baseForm":"食べる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0]}],"formalityLevel":"neutral","usageNote":"\"Always/usually\" - describes a habitual state or repeated occurrence.","family":{"id":"always","name":"Always (Anytime)","relatedPoints":["n5-068"]}}