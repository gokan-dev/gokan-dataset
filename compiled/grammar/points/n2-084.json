{"id":"n2-084","title":"～でたまらない (〜de tamaranai)","jlptLevel":2,"shortExplanation":"Express extremely strong feelings or sensations; 'can't stand', 'unbearably'.","longExplanation":"The ～でたまらない grammar point is used to convey very strong emotion or sensation—so strong it’s almost unbearable. It’s common with expressions like 暑くてたまらない, うれしくてたまらない, etc.","formation":"い-Adjective (く) + てたまらない / な-Adjective + でたまらない / Verb-て form + たまらない","examples":[{"jp":"この暑さは本当に暑くてたまらない。","romaji":"Kono atsusa wa hontō ni atsukute tamaranai.","en":"This heat is absolutely unbearable.","words":[{"surface":"この","vocabId":null},{"surface":"暑","vocabId":"1343460","reading":"あつい","baseForm":"暑い"},{"surface":"さ","vocabId":"1291070","reading":"さ"},{"surface":"は","vocabId":null},{"surface":"本当に","vocabId":"1611580","reading":"ほんとうに"},{"surface":"暑く","vocabId":"1343460","reading":"あつい","baseForm":"暑い"},{"surface":"て","vocabId":null},{"surface":"たまらない","vocabId":"1211340","reading":"たまらない"},{"surface":"。","vocabId":null}],"patternWordIndices":[6,7]},{"jp":"彼女のことが好きでたまらない。","romaji":"Kanojo no koto ga suki de tamaranai.","en":"I like her so much I can hardly stand it.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"の","vocabId":null},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"が","vocabId":null},{"surface":"好き","vocabId":"1277450","reading":"すき"},{"surface":"で","vocabId":null,"baseForm":"だ"},{"surface":"たまらない","vocabId":"1211340","reading":"たまらない"},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6]},{"jp":"この部屋は寒くてたまらない。","romaji":"Kono heya wa samukute tamaranai.","en":"This room is unbearably cold.","words":[{"surface":"この","vocabId":null},{"surface":"部屋","vocabId":"1499320","reading":"へや"},{"surface":"は","vocabId":null},{"surface":"寒く","vocabId":"1210360","reading":"さむい","baseForm":"寒い"},{"surface":"て","vocabId":null},{"surface":"たまらない","vocabId":"1211340","reading":"たまらない"},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5]},{"jp":"彼の態度を見ていると、腹が立ってたまらない。","romaji":"Kare no taido o mite iru to, hara ga tatte tamaranai.","en":"Seeing his attitude makes me extremely angry.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"の","vocabId":null},{"surface":"態度","vocabId":"1410780","reading":"たいど"},{"surface":"を","vocabId":null},{"surface":"見","vocabId":"1259290","reading":"みる","baseForm":"見る"},{"surface":"て","vocabId":null},{"surface":"いる","vocabId":"1577980","reading":"いる"},{"surface":"と","vocabId":null},{"surface":"、","vocabId":null},{"surface":"腹","vocabId":"1501110","reading":"はら"},{"surface":"が","vocabId":null},{"surface":"立っ","vocabId":"1597040","reading":"たつ","baseForm":"立つ"},{"surface":"て","vocabId":null},{"surface":"たまらない","vocabId":"1211340","reading":"たまらない"},{"surface":"。","vocabId":null}],"patternWordIndices":[12,13]}],"formalityLevel":"neutral","usageNote":"\"Unbearably.../can't stand it\" - an intense physical or emotional sensation.","family":{"id":"cant-help-but","name":"Can't Help But (Overwhelming Feeling)","relatedPoints":["n2-079","n1-137","n1-121"]}}