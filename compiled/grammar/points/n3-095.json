{"id":"n3-095","title":"～べきだ (〜beki da)","jlptLevel":3,"shortExplanation":"Express an obligation or something that should be done (mainly with verbs).","longExplanation":"The ～べきだ grammar point is used to express a sense of obligation or to indicate something that should be done. In modern Japanese, it is almost always used with verbs in the dictionary form. In English, it can be translated as 'should' or 'ought to'.","formation":"Verb-dictionary form + べきだ","examples":[{"jp":"勉強するべきだ。","romaji":"Benkyou suru beki da.","en":"You should study.","words":[{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"する","vocabId":"1595910","reading":"する"},{"surface":"べき","vocabId":null,"baseForm":"べし"},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3]},{"jp":"早く寝るべきだ。","romaji":"Hayaku neru beki da.","en":"You should sleep early.","words":[{"surface":"早く","vocabId":"1400150","reading":"はやく","baseForm":"早い"},{"surface":"寝る","vocabId":"1360010","reading":"ねる"},{"surface":"べき","vocabId":null,"baseForm":"べし"},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2,3]},{"jp":"静かにするべきだ。","romaji":"Shizuka ni suru beki da.","en":"You should be quiet.","words":[{"surface":"静か","vocabId":"1381820","reading":"しずか"},{"surface":"に","vocabId":null},{"surface":"する","vocabId":"1595910","reading":"する"},{"surface":"べき","vocabId":null,"baseForm":"べし"},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]},{"jp":"彼に謝るべきだ。","romaji":"Kare ni ayamaru beki da.","en":"You should apologize to him.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"に","vocabId":null},{"surface":"謝る","vocabId":"1323010","reading":"あやまる"},{"surface":"べき","vocabId":null,"baseForm":"べし"},{"surface":"だ","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3,4]}]}