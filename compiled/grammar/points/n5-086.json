{"id":"n5-086","title":"だいたい〜","romaji":"daitai〜","jlptLevel":5,"shortExplanation":"Expresses 'roughly', 'approximately', or 'almost'.","longExplanation":"The だいたい〜 (daitai〜) grammar point is used to express a rough estimate or generalization, meaning 'roughly', 'approximately', or 'almost' in English. It can be used before numbers, amounts, or percentages to show that the value is not exact.","formation":"だいたい + Number/Amount/Percentage","examples":[{"jp":"だいたい１００人がパーティーに参加しました。","romaji":"Daitai hyaku-nin ga paatii ni sanka shimashita.","en":"Approximately 100 people attended the party.","words":[{"surface":"だいたい","vocabId":"1414470","reading":"だいたい"},{"surface":"１","vocabId":"1160790","reading":"いち"},{"surface":"０","vocabId":null},{"surface":"０","vocabId":null},{"surface":"人","vocabId":"1580640","reading":"ひと"},{"surface":"が","vocabId":null},{"surface":"パーティー","vocabId":null},{"surface":"に","vocabId":null},{"surface":"参加","vocabId":"1302090","reading":"さんか"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"彼女はだいたい２時間でその仕事を終えます。","romaji":"Kanojo wa daitai ni-jikan de sono shigoto o oemasu.","en":"She finishes that work in roughly two hours.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"だいたい","vocabId":"1414470","reading":"だいたい"},{"surface":"２","vocabId":"1461140","reading":"に"},{"surface":"時間","vocabId":"1315920","reading":"じかん"},{"surface":"で","vocabId":null},{"surface":"その","vocabId":null},{"surface":"仕事","vocabId":"1304970","reading":"しごと"},{"surface":"を","vocabId":null},{"surface":"終え","vocabId":"1332760","reading":"おえる","baseForm":"終える"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]},{"jp":"だいたい８０％の生徒が試験に合格しました。","romaji":"Daitai hachijuu-paasento no seito ga shiken ni goukaku shimashita.","en":"About 80% of the students passed the exam.","words":[{"surface":"だいたい","vocabId":"1414470","reading":"だいたい"},{"surface":"８","vocabId":"1583090","reading":"はち"},{"surface":"０","vocabId":null},{"surface":"％","vocabId":null},{"surface":"の","vocabId":null},{"surface":"生徒","vocabId":"1379380","reading":"せいと"},{"surface":"が","vocabId":null},{"surface":"試験","vocabId":"1312350","reading":"しけん"},{"surface":"に","vocabId":null},{"surface":"合格","vocabId":"1284600","reading":"ごうかく"},{"surface":"し","vocabId":"1310720","reading":"し","baseForm":"する"},{"surface":"まし","vocabId":null,"baseForm":"ます"},{"surface":"た","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[0]},{"jp":"今日はだいたい３０度の暑さです。","romaji":"Kyou wa daitai sanjuu-do no atsusa desu.","en":"Today is almost 30 degrees hot.","words":[{"surface":"今日","vocabId":"1579110","reading":"きょう"},{"surface":"は","vocabId":null},{"surface":"だいたい","vocabId":"1414470","reading":"だいたい"},{"surface":"３","vocabId":"1579350","reading":"さん"},{"surface":"０","vocabId":null},{"surface":"度","vocabId":"1445160","reading":"ど"},{"surface":"の","vocabId":null},{"surface":"暑","vocabId":"1343460","reading":"あつい","baseForm":"暑い"},{"surface":"さ","vocabId":"1291070","reading":"さ"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[2]}],"formalityLevel":"casual","usageNote":"A freestanding adverb (\"roughly, for the most part\"), not attached to a number like くらい/ぐらい - broader, less precise approximation.","family":{"id":"approximation","name":"Approximation (About / Approximately)","relatedPoints":["n5-027","n3-012","n5-026","n5-028","n3-096","n1-040"]}}