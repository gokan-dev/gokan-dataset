{"id":"n2-023","title":"A。なおB。","romaji":"A. Nao B.","jlptLevel":2,"shortExplanation":"Provides additional information; 'moreover', 'besides', 'in addition'.","longExplanation":"The なお grammar point is used to provide additional information or emphasize an existing fact. It can be translated as 'moreover', 'besides', or 'in addition' in English. なお is placed between two sentences to connect them and provide supplementary information.","formation":"A (sentence) + なお + B (sentence)","examples":[{"jp":"明日は休みです。なお、月曜日も休みです。","romaji":"Ashita wa yasumi desu. Nao, getsuyoubi mo yasumi desu.","en":"Tomorrow is a holiday. Moreover, Monday is also a holiday.","words":[{"surface":"明日","vocabId":"1584660","reading":"あした"},{"surface":"は","vocabId":null},{"surface":"休み","vocabId":"1227500","reading":"やすみ"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null},{"surface":"なお","vocabId":null},{"surface":"、","vocabId":null},{"surface":"月曜日","vocabId":"1255890","reading":"げつようび"},{"surface":"も","vocabId":null},{"surface":"休みです","vocabId":"1227560","reading":"やすみです","baseForm":"休む"},{"surface":"。","vocabId":null}],"patternWordIndices":[5]},{"jp":"彼は頭が良いです。なお、スポーツも得意です。","romaji":"Kare wa atama ga yoi desu. Nao, supootsu mo tokui desu.","en":"He is smart. Besides, he is also good at sports.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"頭","vocabId":"1582310","reading":"あたま"},{"surface":"が","vocabId":null},{"surface":"良いです","vocabId":"1605820","reading":"よいです","baseForm":"良い"},{"surface":"。","vocabId":null},{"surface":"なお","vocabId":null},{"surface":"、","vocabId":null},{"surface":"スポーツ","vocabId":null},{"surface":"も","vocabId":null},{"surface":"得意","vocabId":"1454510","reading":"とくい"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[6]},{"jp":"この本は面白いです。なお、安いです。","romaji":"Kono hon wa omoshiroi desu. Nao, yasui desu.","en":"This book is interesting. In addition, it is cheap.","words":[{"surface":"この","vocabId":null},{"surface":"本","vocabId":"1522150","reading":"ほん"},{"surface":"は","vocabId":null},{"surface":"面白いです","vocabId":"1533580","reading":"おもしろいです","baseForm":"面白い"},{"surface":"。","vocabId":null},{"surface":"なお","vocabId":null},{"surface":"、","vocabId":null},{"surface":"安いです","vocabId":"1153670","reading":"やすいです","baseForm":"安い"},{"surface":"。","vocabId":null}],"patternWordIndices":[5]},{"jp":"私は日本語を勉強しています。なお、韓国語も勉強しています。","romaji":"Watashi wa nihongo wo benkyou shiteimasu. Nao, kankokugo mo benkyou shiteimasu.","en":"I am studying Japanese. Moreover, I am also studying Korean.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"日本語","vocabId":"1464530","reading":"にほんご"},{"surface":"を","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"し","vocabId":null,"baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"い","vocabId":null,"baseForm":"いる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null},{"surface":"なお","vocabId":null},{"surface":"、","vocabId":null},{"surface":"韓国語","vocabId":"1216180","reading":"かんこくご"},{"surface":"も","vocabId":null},{"surface":"勉強","vocabId":"1512670","reading":"べんきょう"},{"surface":"し","vocabId":null,"baseForm":"する"},{"surface":"て","vocabId":null},{"surface":"い","vocabId":null,"baseForm":"いる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[10]}],"formalityLevel":"formal","usageNote":"Formal, written \"additionally/note that\" - common in official notices and documents.","family":{"id":"addition","name":"Addition (Besides / Moreover)","relatedPoints":["n2-002","n2-176","n3-001","n4-121","n2-004"],"axis":"register"},"kind":"construction"}