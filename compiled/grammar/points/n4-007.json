{"id":"n4-007","title":"Noun しか～ない (Noun shika~nai)","jlptLevel":4,"shortExplanation":"Expresses 'only', 'nothing but', or 'no other'.","longExplanation":"The grammar point Noun しか～ない is used to emphasize the small quantity or exclusiveness of something. It can be translated as 'only', 'nothing but', or 'no other' in English. It is used with a negative verb to convey the meaning.","formation":"Noun + しか + Negative Verb","examples":[{"jp":"私はリンゴしか食べない。","romaji":"Watashi wa ringo shika tabenai.","en":"I eat only apples.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"リンゴ","vocabId":"1555480","reading":"りんご"},{"surface":"しか","vocabId":null},{"surface":"食べ","vocabId":"1358280","reading":"たべる","baseForm":"食べる"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"電車で行くしかないです。","romaji":"Densha de iku shika nai desu.","en":"There is no other way but to go by train.","words":[{"surface":"電車","vocabId":"1443530","reading":"でんしゃ"},{"surface":"で","vocabId":null},{"surface":"行く","vocabId":"1578850","reading":"いく"},{"surface":"しか","vocabId":null},{"surface":"ない","vocabId":"2098290","reading":"ない"},{"surface":"です","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[3]},{"jp":"彼は一冊の本しか持っていない。","romaji":"Kare wa isatsu no hon shika motte inai.","en":"He has only one book.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"一","vocabId":"1160790","reading":"いち"},{"surface":"冊","vocabId":"1298520","reading":"さつ"},{"surface":"の","vocabId":null},{"surface":"本","vocabId":"1522150","reading":"ほん"},{"surface":"しか","vocabId":null},{"surface":"持っ","vocabId":"1315720","reading":"もつ","baseForm":"持つ"},{"surface":"て","vocabId":null},{"surface":"い","vocabId":"1158500","reading":"い","baseForm":"いる"},{"surface":"ない","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[6]},{"jp":"この店にはビールしかない。","romaji":"Kono mise ni wa biiru shika nai.","en":"There is nothing but beer in this store.","words":[{"surface":"この","vocabId":null},{"surface":"店","vocabId":"1582120","reading":"みせ"},{"surface":"に","vocabId":null},{"surface":"は","vocabId":null},{"surface":"ビール","vocabId":null},{"surface":"しか","vocabId":null},{"surface":"ない","vocabId":"2098290","reading":"ない"},{"surface":"。","vocabId":null}],"patternWordIndices":[5]}]}