{"id":"n5-058","title":"Verb る こと が できます (ru koto ga dekimasu)","jlptLevel":5,"shortExplanation":"Express the potential form, or the ability to do something.","longExplanation":"The 〜ることができます grammar point is used to express that someone is capable of doing something or that something is possible. It is essentially the potential form of the verb. The formation is made by changing the verb to a noun phrase with こと and then adding ができます.","formation":"Verb (dictionary form) + ことができます","examples":[{"jp":"この問題を解くことができます。","romaji":"Kono mondai o toku koto ga dekimasu.","en":"I can solve this problem.","words":[{"surface":"この","vocabId":null},{"surface":"問題","vocabId":"1536010","reading":"もんだい"},{"surface":"を","vocabId":null},{"surface":"解く","vocabId":"1198890","reading":"とく"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[4,5,6,7]},{"jp":"彼は英語を話すことができます。","romaji":"Kare wa eigo o hanasu koto ga dekimasu.","en":"He can speak English.","words":[{"surface":"彼","vocabId":"1483070","reading":"かれ"},{"surface":"は","vocabId":null},{"surface":"英語","vocabId":"1174420","reading":"えいご"},{"surface":"を","vocabId":null},{"surface":"話す","vocabId":"1562350","reading":"はなす"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7,8]},{"jp":"私は高い所に登ることができません。","romaji":"Watashi wa takai tokoro ni noboru koto ga dekimasen.","en":"I can't climb to high places.","words":[{"surface":"私","vocabId":"1311110","reading":"わたし"},{"surface":"は","vocabId":null},{"surface":"高い","vocabId":"1283190","reading":"たかい"},{"surface":"所","vocabId":"1343100","reading":"ところ"},{"surface":"に","vocabId":null},{"surface":"登る","vocabId":"1352570","reading":"のぼる"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ませ","vocabId":null,"baseForm":"ます"},{"surface":"ん","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[6,7,8,9]},{"jp":"彼女はピアノを弾くことができます。","romaji":"Kanojo wa piano o hiku koto ga dekimasu.","en":"She can play the piano.","words":[{"surface":"彼女","vocabId":"1483150","reading":"かのじょ"},{"surface":"は","vocabId":null},{"surface":"ピアノ","vocabId":null},{"surface":"を","vocabId":null},{"surface":"弾く","vocabId":"1419370","reading":"ひく"},{"surface":"こと","vocabId":"1313580","reading":"こと"},{"surface":"が","vocabId":null},{"surface":"でき","vocabId":"1340430","reading":"でき","baseForm":"できる"},{"surface":"ます","vocabId":null},{"surface":"。","vocabId":null}],"patternWordIndices":[5,6,7,8]}]}