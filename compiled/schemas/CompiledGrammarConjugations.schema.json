            "vocabId": {
              "type": "string"
            },
            "lemma": {
              "type": "string"
            },
            "lemmaReading": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "targetReading": {
              "type": "string"
            },
            "alternatives": {
