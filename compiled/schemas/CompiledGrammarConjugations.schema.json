                "godan",
                "ichidan",
                "irregular",
                "i-adjective",
                "na-adjective"
              ]
            }
          },
          "required": [
            "vocabId",
            "lemma",
            "lemmaReading",
            "target",
            "targetReading",
            "wordClass"
          ],
          "additionalProperties": false
