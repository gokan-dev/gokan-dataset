{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "writtenForm": {
      "type": "object",
      "properties": {
        "kanji": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "containedKanji": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kanji",
        "alternatives",
        "containedKanji"
      ],
      "additionalProperties": false
    },
    "reading": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "primary",
        "alternatives"
      ],
      "additionalProperties": false
    },
    "frequency": {
      "type": "object",
      "properties": {
        "kanjiRank": {
          "type": "number"
        },
        "kanaRank": {
          "type": "number"
        }
      },
      "required": [
        "kanjiRank"
      ],
      "additionalProperties": false
    },
    "jlptLevel": {
      "type": "number"
    },
    "jlptLevelFrom": {
      "type": "string"
    },
    "textbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "book": {
            "type": "string",
            "enum": [
              "genki",
              "intermediate-japanese"
            ]
          },
          "lesson": {
            "type": "number"
          }
        },
        "required": [
          "book",
          "lesson"
        ],
        "additionalProperties": false
      }
    },
    "progression": {
      "type": "object",
      "properties": {
        "kklcStep": {
          "type": "number"
        }
      },
      "required": [
        "kklcStep"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usageHints": {
      "type": "object",
      "properties": {
        "examplePattern": {
          "type": "string"
        },
        "requiresContext": {
          "type": "boolean"
        }
      },
      "required": [
        "requiresContext"
      ],
      "additionalProperties": false
    },
    "isCommon": {
      "type": "boolean"
    },
    "mergedVocabs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "isBase": {
            "type": "boolean"
          },
          "originalPrimaryReading": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "isBase",
          "originalPrimaryReading"
        ],
        "additionalProperties": false
      }
    },
    "usuallyKana": {
      "type": "boolean",
      "const": true
    },
    "audio": {
      "type": "object",
      "properties": {
        "clip": {
          "type": "string"
        }
      },
      "required": [
        "clip"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "writtenForm",
    "reading",
    "frequency",
    "progression",
    "pos",
    "isCommon"
  ],
  "additionalProperties": false,
  "definitions": {},
  "$id": "schemas/CompiledVocab.schema.json"
}
