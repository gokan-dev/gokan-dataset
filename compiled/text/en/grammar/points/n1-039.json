{"kind":"grammar","lang":"en","entities":{"n1-039":{"renderings":[{"id":"237329c318e271bf","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-039"},"match":"id","status":"imported","value":"Used to express a generic concept: 'all ~', 'any ~ of that kind'."},{"id":"19a465097ee50dcc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-039"},"match":"id","status":"imported","value":"The grammar pattern 'Noun + というもの' refers to the entirety or general nature of that noun - often implying 'all of this category' or 'this thing called...'. It can also highlight a universal truth about the noun mentioned."},{"id":"305eefab3578844e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-039"},"match":"id","status":"imported","value":"Noun + というもの"},{"id":"349fef33149498ff","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-039"},"match":"id","status":"reviewed","value":"Noun というもの: things of that kind in general (親というものは)."},{"id":"71737f2ed7047fb3","role":"label","field":"family","source":{"source":"gokan","ref":"quoting"},"match":"id","status":"reviewed","value":"Called / Quoting (Named / They Say)","of":{"kind":"family","id":"quoting"}}]},"n1-039#9b7d3dc5cdac":{"renderings":[{"id":"d82a25bc64dffd7c","role":"translation","source":{"source":"hanabira","ref":"n1-039"},"match":"id","status":"imported","value":"Children, as a group, play a lot every day."}]},"n1-039#7c92cd97bcc9":{"renderings":[{"id":"8286dba10cf9da94","role":"translation","source":{"source":"hanabira","ref":"n1-039"},"match":"id","status":"imported","value":"University students spend a lot of time on research."}]},"n1-039#3f1faab4bda8":{"renderings":[{"id":"eed399a902485027","role":"translation","source":{"source":"hanabira","ref":"n1-039"},"match":"id","status":"imported","value":"Japanese culture is a mixture of traditional and new."}]},"n1-039#dbc2c7948b88":{"renderings":[{"id":"ebca75f0cf884058","role":"tr