{"kind":"grammar","lang":"en","entities":{"n1-054":{"renderings":[{"id":"60cd011d2d598eed","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"Indicates even a small amount or degree; 'at least', 'even a little'."},{"id":"8ed155c3dcc768b7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"Noun + なりとも is used to show that even a small amount or degree is valuable or needed. It translates as 'at least' or 'even a little' in English."},{"id":"9bfe849bac919d2b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"Noun + なりとも"},{"id":"a2efc4f45790262a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-054"},"match":"id","status":"reviewed","value":"Formal, literary \"at least/even a little\" - emphasizes a minimal but real amount."},{"id":"0c034cef5eafeed5","role":"label","field":"family","source":{"source":"gokan","ref":"at-least"},"match":"id","status":"reviewed","value":"At Least (A Minimal Amount)","of":{"kind":"family","id":"at-least"}}]},"n1-054#fa04f184c4b8":{"renderings":[{"id":"ac3a759c9127c898","role":"translation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"Since time is limited, you should practice for at least an hour."}]},"n1-054#3fc546daacf5":{"renderings":[{"id":"0683cfd97cdf7bbc","role":"translation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"I’d like to hear at least a word of apology from him."}]},"n1-054#80f4f24613e0":{"renderings":[{"id":"bb4556389addbe02","role":"translation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"We need at least one member for this project."}]},"n1-054#ee06a1c5d086":{"renderings":[{"id":"2d08e7643a2a7697","role":"translation","source":{"source":"hanabira","ref":"n1-054"},"match":"id","status":"imported","value":"I want to offer at least a word of gratitude to you."}]}}}