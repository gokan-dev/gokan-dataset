{"kind":"grammar","lang":"en","entities":{"n4-012":{"renderings":[{"id":"330837ab014dca6b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"Expresses 'only', 'nothing but', 'always', or 'just'."},{"id":"cb61f2ccd8f0c3b3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"The ばかり grammar point is used to express that something is only, nothing but, just, or always. It can be attached to nouns, verbs, or adjectives, and has various meanings based on the context."},{"id":"eb4f8a75ea827cf3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"Noun + ばかり, Verb-casual + ばかり, い-Adjective + ばかり, な-Adjective + だ ばかり"},{"id":"4ed42bb47ff8fc2c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-012"},"match":"id","status":"reviewed","value":"Often implies excess or repetition - \"always doing X/nothing but X\" - can sound like a complaint. (Near-duplicate of n3-087 - same word, taught at both N3 and N4.)"},{"id":"0a7eb6991316e0ea","role":"label","field":"family","source":{"source":"gokan","ref":"exclusivity"},"match":"id","status":"reviewed","value":"Exclusivity (Only / Nothing But)","of":{"kind":"family","id":"exclusivity"}}]},"n4-012#33a2b885bb98":{"renderings":[{"id":"757e09d09c969a56","role":"translation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"He talks about nothing but money."}]},"n4-012#101450dee037":{"renderings":[{"id":"40fa455cdedccac2","role":"translation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"She is always studying."}]},"n4-012#51397bc066e0":{"renderings":[{"id":"f859230551f47495","role":"translation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"There are only expensive items in the department store."}]},"n4-012#b930247d5a72":{"renderings":[{"id":"4786b582e2a182bb","role":"translation","source":{"source":"hanabira","ref":"n4-012"},"match":"id","status":"imported","value":"This room is nothing but small."}]}}}