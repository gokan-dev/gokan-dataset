{"kind":"grammar","lang":"en","entities":{"n2-189":{"renderings":[{"id":"264a36eda3c2e3be","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-189"},"match":"id","status":"imported","value":"Indicates a slight feeling or tendency toward a particular state."},{"id":"f911fd3dee74396f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-189"},"match":"id","status":"imported","value":"The suffix ～気味 generally attaches to nouns (or nominalized words) to express a slight feeling, tendency, or inclination toward a particular state. It often translates to '-ish' or 'a bit' in English (e.g., 'sleep-deprived-ish', 'nervous-ish')."},{"id":"a2cd093c68d34a24","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-189"},"match":"id","status":"imported","value":"Noun + 気味 (e.g., 風邪気味, 寝不足気味, 緊張気味)"},{"id":"c4c80ee1da915566","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-189"},"match":"id","status":"reviewed","value":"気味: a slight touch of (風邪気味)."},{"id":"327bbb1b37deacf0","role":"label","field":"family","source":{"source":"gokan","ref":"tendency"},"match":"id","status":"reviewed","value":"Tendency (Tend To / -ish / A Touch Of)","of":{"kind":"family","id":"tendency"}}]},"n2-189#604c51f559ce":{"renderings":[{"id":"396b5e13c3c1c731","role":"translation","source":{"source":"hanabira","ref":"n2-189"},"match":"id","status":"imported","value":"Lately, I'm feeling somewhat sleep-deprived and a bit tired."}]},"n2-189#3681ed05f27a":{"renderings":[{"id":"0c549f770a9add01","role":"translation","source":{"source":"hanabira","ref":"n2-189"},"match":"id","status":"imported","value":"This room is a bit dark, so let's install brighter lighting."}]},"n2-189#829bd3679e9c":{"renderings":[{"id":"2bae786cf3cb4efc","role":"translation","source":{"source":"hanabira","ref":"n2-189"},"match":"id","status":"imported","value":"She was speaking somewhat nervously."}]},"n2-189#956d3c826f71":{"renderings":[{