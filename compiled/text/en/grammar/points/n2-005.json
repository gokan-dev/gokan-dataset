{"kind":"grammar","lang":"en","entities":{"n2-005":{"renderings":[{"id":"e9d891d3d8c1e275","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"Express a cause-and-effect relationship; 'therefore', 'consequently', 'so'."},{"id":"b6618d653d828425","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"The したがって grammar point is used to express a cause-and-effect relationship between two sentences, where 'A' is the cause and 'B' is the effect, result or conclusion. It can be translated as 'therefore', 'consequently', or 'so' in English."},{"id":"f26fb2188b22f090","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"A + したがって + B"},{"id":"bdaf851ac9941c07","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-005"},"match":"id","status":"reviewed","value":"Formal, literary \"therefore/consequently\" - written, academic, or formal speech."},{"id":"a369fa147f888d6d","role":"label","field":"family","source":{"source":"gokan","ref":"therefore"},"match":"id","status":"reviewed","value":"Therefore (Formal Cause-Result)","of":{"kind":"family","id":"therefore"}}]},"n2-005#3682609e9172":{"renderings":[{"id":"0d63bc9bf734789a","role":"translation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"It is raining today. Therefore, let's bring an umbrella."}]},"n2-005#06567ae67c83":{"renderings":[{"id":"5f7d33d030236f2b","role":"translation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"He is busy. Consequently, let's not contact him."}]},"n2-005#63b41c9b0ba3":{"renderings":[{"id":"bc8a89d8f91ffbbf","role":"translation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"That restaurant is popular. Therefore, there might be no seats if you don't make a reservation."}]},"n2-005#3bdff81d2027":{"renderings":[{"id":"d7175b5b6cfd2fc2","role":"translation","source":{"source":"hanabira","ref":"n2-005"},"match":"id","status":"imported","value":"The exam is coming up soon. Consequently, let's focus on studying."}]}}}