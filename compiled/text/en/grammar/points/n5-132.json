{"kind":"grammar","lang":"en","entities":{"n5-132":{"renderings":[{"id":"486229c7cb43949a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"Expresses 'already', 'anymore', or 'soon'."},{"id":"a4e7d0e184da39da","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"The もう grammar point is used to express the idea of 'already', 'anymore', or 'soon' in English. It indicates that something has already happened, won't happen anymore, or will happen soon. It can be used with verbs, adjectives, or nouns depending on context."},{"id":"10046f7c9ff2a538","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"もう + Verb / もう + Adjective / もう + Noun"},{"id":"9853b4d486cf0d7d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-132"},"match":"id","status":"reviewed","value":"'Already' (もう食べた); with a negative, 'not anymore' (もう行かない)."},{"id":"d2065b19e1abd29f","role":"label","field":"family","source":{"source":"gokan","ref":"already-still"},"match":"id","status":"reviewed","value":"Already / Still / Not Yet","of":{"kind":"family","id":"already-still"}}]},"n5-132#d4061dc13732":{"renderings":[{"id":"ca3203e28320a7d2","role":"translation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"I already ate lunch."}]},"n5-132#3f72a9cc9dc1":{"renderings":[{"id":"219687ec9f5f6162","role":"translation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"I won't work here anymore."}]},"n5-132#82b65aafcbcc":{"renderings":[{"id":"4e2b89f450b683b5","role":"translation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"Summer vacation is coming soon, isn't it?"}]},"n5-132#ce9cdac9265c":{"renderings":[{"id":"53555b1ac81cae17","role":"translation","source":{"source":"hanabira","ref":"n5-132"},"match":"id","status":"imported","value":"It's already enough."}]}}}