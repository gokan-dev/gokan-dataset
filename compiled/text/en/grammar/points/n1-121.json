{"kind":"grammar","lang":"en","entities":{"n1-121":{"renderings":[{"id":"22b4475c638a0410","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"'Cannot do without...', 'unavoidable', 'have to'."},{"id":"a29304ef1a9d39ea","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"The grammar point ずにはすまない is used when something must be done due to social/moral obligation, necessity, or rules. It implies that there is no way around taking that action."},{"id":"63233db7ee1b2f2d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"Verb-ない form (remove ない) + ずにはすまない"},{"id":"7566c9ce6953961a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-121"},"match":"id","status":"reviewed","value":"Formal, literary \"cannot get away without doing X/is unavoidable\"."},{"id":"140b3ceb8a829c1f","role":"label","field":"family","source":{"source":"gokan","ref":"cant-help-but"},"match":"id","status":"reviewed","value":"Can't Help But (Overwhelming Feeling)","of":{"kind":"family","id":"cant-help-but"}}]},"n1-121#394196137504":{"renderings":[{"id":"49aefa049174dfa5","role":"translation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"Since this issue will affect the entire society if not resolved, we cannot do without solving it."}]},"n1-121#98deace539d8":{"renderings":[{"id":"3e22df2ea9dab2b2","role":"translation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"For the sake of the children’s future, we cannot avoid carrying out educational reforms."}]},"n1-121#6c71f95be73e":{"renderings":[{"id":"4ba641f8f965e47b","role":"translation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"Regarding this matter, I can’t do without apologizing to him."}]},"n1-121#28f0dfd41ab0":{"renderings":[{"id":"51f7659a4aeab023","role":"translation","source":{"source":"hanabira","ref":"n1-121"},"match":"id","status":"imported","value":"If you attend a wedding, you have to bring a gift."}]}}}