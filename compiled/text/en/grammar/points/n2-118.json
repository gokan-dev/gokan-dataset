{"kind":"grammar","lang":"en","entities":{"n2-118":{"renderings":[{"id":"4a77bb739ef8c2ee","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"Indicates the reason, method, or means by which something happens; 'by', 'through', 'due to'."},{"id":"20a9ef98fdf438e5","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"The ～により grammar point is used to indicate the reason, method, or means by which something happens or is done. It can be often translated as 'by', 'through', or 'due to' in English. It can be attached directly to nouns or verbs in plain form."},{"id":"91946dfe98f9f13f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"Noun + により, Verb + により"},{"id":"1bd227a386cec994","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-118"},"match":"id","status":"reviewed","value":"Formal \"by means of/due to\" - method or cause, common in formal/written contexts."},{"id":"847d6f1b7ffb4bde","role":"label","field":"family","source":{"source":"gokan","ref":"through"},"match":"id","status":"reviewed","value":"Through (Via / Over A Range)","of":{"kind":"family","id":"through"}}]},"n2-118#8199f11198b1":{"renderings":[{"id":"92eb6cb6b62cf54c","role":"translation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"This accident occurred due to the driver's carelessness."}]},"n2-118#64c345cfc629":{"renderings":[{"id":"d670db5b216fd79c","role":"translation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"The movie was produced based on the novel."}]},"n2-118#dc5521d16fcf":{"renderings":[{"id":"7f186983f042d67c","role":"translation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"The criminal was arrested by the police."}]},"n2-118#24e809145114":{"renderings":[{"id":"fb95924e56ae12d4","role":"translation","source":{"source":"hanabira","ref":"n2-118"},"match":"id","status":"imported","value":"The company's growth was achieved through the efforts of its employees."}]}}}