{"kind":"grammar","lang":"en","entities":{"n2-109":{"renderings":[{"id":"89772847173fb8c4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"Indicates a specific area or aspect in which someone or something excels."},{"id":"c3a6e7eb7e152668","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"The grammar point ～にかけては is used to emphasize a particular area or aspect in which someone or something excels or is exceptional. This structure is often used with positive connotations regarding the subject's expertise or outstanding qualities."},{"id":"3f55b34ecf587f3d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"Noun + にかけては"},{"id":"ea1039c0d6e181dc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-109"},"match":"id","status":"reviewed","value":"にかけては: when it comes to X (a skill), nobody beats them."},{"id":"ca66816e0e22c5d0","role":"label","field":"family","source":{"source":"gokan","ref":"speaking-of"},"match":"id","status":"reviewed","value":"Speaking Of (When It Comes To)","of":{"kind":"family","id":"speaking-of"}}]},"n2-109#a2462ab6c007":{"renderings":[{"id":"ec999281e3c49b24","role":"translation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"When it comes to cooking skills, she is second to none."}]},"n2-109#a30674f4fa5b":{"renderings":[{"id":"776354dbcd18e77d","role":"translation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"As far as this town is concerned, his store sells the most delicious ramen."}]},"n2-109#06a22a97289f":{"renderings":[{"id":"ee0a4399d42285bd","role":"translation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"When it comes to music knowledge, he is the most knowledgeable among us."}]},"n2-109#6965b325bfdb":{"renderings":[{"id":"2e72a3a2029dd835","role":"translation","source":{"source":"hanabira","ref":"n2-109"},"match":"id","status":"imported","value":"When it comes to sports, he excels in any competition."}]}}}