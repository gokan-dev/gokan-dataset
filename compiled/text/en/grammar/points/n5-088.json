{"kind":"grammar","lang":"en","entities":{"n5-088":{"renderings":[{"id":"30d9c1c21b707408","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"Express reason or cause; 'because', 'so', 'therefore'."},{"id":"a13840a91e6b7c28","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"The 文A。だから 文B grammar point is used to indicate that the reason or cause of an action or event expressed in the second sentence (文B) is a result or consequence of the situation described in the first sentence (文A). It can be translated as 'because', 'so', or 'therefore' in English."},{"id":"80f3d4cd4dfc1569","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"Sentence A + だから + Sentence B"},{"id":"128652b4e1821045","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-088"},"match":"id","status":"reviewed","value":"Blunt, conversational \"so\"; can sound abrupt or child-like if overused in formal contexts."},{"id":"d295acbaf3aeb59b","role":"label","field":"family","source":{"source":"gokan","ref":"causality"},"match":"id","status":"reviewed","value":"Causality (Because / Since / Due to)","of":{"kind":"family","id":"causality"}}]},"n5-088#e73ba05e6924":{"renderings":[{"id":"260ffc3d76d39a97","role":"translation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"Tomorrow is the exam, so I have to study today."}]},"n5-088#4539734c2c33":{"renderings":[{"id":"52082621cd0d411f","role":"translation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"This dish is simple, so even beginners can make it."}]},"n5-088#5cffa0a571c0":{"renderings":[{"id":"a9d4b1e9ab8f658f","role":"translation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"He is sick, so he will take a day off from school today."}]},"n5-088#8870b1c4d596":{"renderings":[{"id":"f3d264794dbff924","role":"translation","source":{"source":"hanabira","ref":"n4-124"},"match":"id","status":"imported","value":"The station is far, so it's better to go by taxi."}]}}}