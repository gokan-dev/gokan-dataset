{"kind":"grammar","lang":"en","entities":{"n5-043":{"renderings":[{"id":"4db8fe39b0b31583","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"Indicates the direct object of a verb."},{"id":"40a589976a64a71f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"The を (wo) particle is used to mark the direct object of a verb in a sentence. It shows the noun that the action (verb) is performed on. The particle を is usually pronounced as 'o' in spoken Japanese."},{"id":"2b3e8ae16c33319b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"Noun + を + Verb"}]},"n5-043#317bb7efd292":{"renderings":[{"id":"11a1d0cd140c2dae","role":"translation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"I read a book."}]},"n5-043#4c1fb6e07a45":{"renderings":[{"id":"59ee6b43dfe14d98","role":"translation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"He ate a cake."}]},"n5-043#0ab678f84764":{"renderings":[{"id":"950dea303e4f7008","role":"translation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"My mother likes to drink coffee."}]},"n5-043#3e33b9e574c3":{"renderings":[{"id":"b309729e42852ca1","role":"translation","source":{"source":"hanabira","ref":"n5-043"},"match":"id","status":"imported","value":"My friend used my pen."}]}}}