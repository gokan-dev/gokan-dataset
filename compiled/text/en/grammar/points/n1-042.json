{"kind":"grammar","lang":"en","entities":{"n1-042":{"renderings":[{"id":"b02120ef9b315f91","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"Expresses strong feelings about a topic; 'speaking of', 'when it comes to'."},{"id":"3f3ce91b7fdf0a18","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"Noun + ときたら emphasizes strong feelings - often frustration, admiration, or surprise - about that noun. It can translate as 'when it comes to...', 'speaking of...', or 'honestly, about...'."},{"id":"82b48fb4ad580815","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"Noun + ときたら"},{"id":"9a82cba5111110de","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-042"},"match":"id","status":"reviewed","value":"Formal, literary, often exasperated - \"when it comes to X (with strong feelings)\"."},{"id":"ca66816e0e22c5d0","role":"label","field":"family","source":{"source":"gokan","ref":"speaking-of"},"match":"id","status":"reviewed","value":"Speaking Of (When It Comes To)","of":{"kind":"family","id":"speaking-of"}}]},"n1-042#aa87299e3002":{"renderings":[{"id":"a7d79c2d41314e16","role":"translation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"When it comes to sushi, he can't eat anything."}]},"n1-042#c65559887b05":{"renderings":[{"id":"70f3ff63c0ad5004","role":"translation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"When it comes to math problems, she's always struggling."}]},"n1-042#17c84f73e7dc":{"renderings":[{"id":"69aa2cfc21d632f9","role":"translation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"Speaking of that shop's hamburgers, they're really delicious."}]},"n1-042#31a6ae09d014":{"renderings":[{"id":"21ca70a8aa8e4cb0","role":"translation","source":{"source":"hanabira","ref":"n1-042"},"match":"id","status":"imported","value":"Speaking of his usual attitude, it's truly problematic."}]}}}