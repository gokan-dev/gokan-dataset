{"kind":"grammar","lang":"en","entities":{"n5-101":{"renderings":[{"id":"ea2597299f44df34","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"Express 'where', used with question words for asking about locations."},{"id":"1fb115ec369b834e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"The どこ～ grammar point is used to express 'where', primarily for asking about locations or places. It is often combined with question words such as どこへ (doko e), どこで (doko de), and どこに (doko ni) to ask about destinations, locations of actions, and existence, respectively."},{"id":"a276e3a2ba42da10","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"どこ + question particle"},{"id":"e54b18ec5c658f0e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-101"},"match":"id","status":"reviewed","value":"'Where': asks for a place (どこに行きますか). Polite: どちら."},{"id":"7fa850bc8a152d1f","role":"label","field":"family","source":{"source":"gokan","ref":"nowhere"},"match":"id","status":"reviewed","value":"Where (Somewhere / Anywhere / Nowhere)","of":{"kind":"family","id":"nowhere"}}]},"n5-101#4bf4c788889d":{"renderings":[{"id":"622a2c74f8172250","role":"translation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"Where is the station?"}]},"n5-101#41f8a704dd1c":{"renderings":[{"id":"2d3411ceb5948d69","role":"translation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"Where did you watch the movie?"}]},"n5-101#ef0b4435add8":{"renderings":[{"id":"03501d1e028c2bc9","role":"translation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"Where do you live?"}]},"n5-101#f6e24e9a9bfb":{"renderings":[{"id":"72af692bd4021da2","role":"translation","source":{"source":"hanabira","ref":"n5-101"},"match":"id","status":"imported","value":"Where do you want to go?"}]}}}