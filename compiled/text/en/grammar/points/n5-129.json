{"kind":"grammar","lang":"en","entities":{"n5-129":{"renderings":[{"id":"4cbc01dcc36cc329","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"Indicates something has not yet happened or is still happening; 'still', 'not yet'."},{"id":"f561c385b6006671","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"The まだ〜 grammar point is used to express that something has not yet occurred or is still in progress. It can be translated as 'still' or 'not yet' in English. Depending on the context or if expressing the negative, まだ can be used with different combinations of verb, adjective, or noun."},{"id":"7d166e324176e787","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"まだ + Verb (non-past / negative / te-form), まだ + い-adjective, まだ + な-adjective + じゃない/ではない, まだ + Noun + じゃない/ではない"},{"id":"37c688c8c922e3a9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-129"},"match":"id","status":"reviewed","value":"'Still', with an affirmative verb (まだ寝ている)."},{"id":"d2065b19e1abd29f","role":"label","field":"family","source":{"source":"gokan","ref":"already-still"},"match":"id","status":"reviewed","value":"Already / Still / Not Yet","of":{"kind":"family","id":"already-still"}}]},"n5-129#13d307fcf7bc":{"renderings":[{"id":"1cb135eb67913ed3","role":"translation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"I haven't eaten lunch yet."}]},"n5-129#f3b5ba24c8fb":{"renderings":[{"id":"1ce891982535f398","role":"translation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"Yamada-san has not arrived yet."}]},"n5-129#ff649ba89fb2":{"renderings":[{"id":"cfe50127472d131b","role":"translation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"This room is still hot."}]},"n5-129#d81aabf26e9b":{"renderings":[{"id":"91206f7f9c390fa4","role":"translation","source":{"source":"hanabira","ref":"n5-129"},"match":"id","status":"imported","value":"He is not a student yet."}]}}}