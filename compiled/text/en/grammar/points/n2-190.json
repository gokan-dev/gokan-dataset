{"kind":"grammar","lang":"en","entities":{"n2-190":{"renderings":[{"id":"516cba00f89aab15","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-190"},"match":"id","status":"imported","value":"Expresses 'as long as', 'while', or 'to the extent that' a certain condition holds true."},{"id":"22ef108c5c65debc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-190"},"match":"id","status":"imported","value":"The phrase ～限り is used to indicate that something continues or is true 'as long as' or 'while' a certain condition is met. It can also mean 'to the extent that'."},{"id":"039acda2c6310bc7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-190"},"match":"id","status":"imported","value":"Verb-casual + 限り, い-Adjective + 限り, な-Adjective + な限り, Noun + の限り"},{"id":"df6b785796082488","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-190"},"match":"id","status":"reviewed","value":"Neutral, common \"as long as/to the extent that\"."},{"id":"8eb0b4b0b42b219f","role":"label","field":"family","source":{"source":"gokan","ref":"as-long-as"},"match":"id","status":"reviewed","value":"As Long As (To That Extent)","of":{"kind":"family","id":"as-long-as"}}]},"n2-190#48b56a492039":{"renderings":[{"id":"2bffa60c49842626","role":"translation","source":{"source":"hanabira","ref":"n2-190"},"match":"id","status":"imported","value":"As long as I'm healthy, I'll keep exercising."}]},"n2-190#5de32974665b":{"renderings":[{"id":"50c4031d2f76562f","role":"translation","source":{"source":"hanabira","ref":"n2-190"},"match":"id","status":"imported","value":"As long as I have money, I'd like to travel."}]},"n2-190#e2c16d186c1e":{"renderings":[{"id":"85dc33d3b6697fb8","role":"translation","source":{"source":"hanabira","ref":"n2-190"},"match":"id","status":"imported","value":"As long as he keeps talking about it, the benefits of this project will be conveyed."}]},"n2-190#b77531f9da5d":{"renderings":