{"kind":"grammar","lang":"en","entities":{"n1-043":{"renderings":[{"id":"fae022d0c6a6c6f0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"Indicates something is not comparable; 'beyond comparison'."},{"id":"8cbb68687d1a4472","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"Use とは比べものにならない to emphasize that two things differ so greatly they cannot be compared - one is vastly superior or different in scale, quality, etc."},{"id":"e9333c1436cb620f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"Noun + とは比べものにならない"},{"id":"df69f3b730970541","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-043"},"match":"id","status":"reviewed","value":"とは比べものにならない: can't even be compared (比べものにならないほど上手)."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n1-043#44f36075e0fb":{"renderings":[{"id":"e282368cfdf18e2b","role":"translation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"The speed of the new car is not comparable to the old one."}]},"n1-043#1790e953f826":{"renderings":[{"id":"405853a7f94cd9fd","role":"translation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"His English skills are beyond comparison with mine."}]},"n1-043#78a142b1c0ae":{"renderings":[{"id":"4556af11cc03a179","role":"translation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"Japan's technology is not comparable to that of other countries."}]},"n1-043#7cdb46d876c1":{"renderings":[{"id":"609c3d920960dd3c","role":"translation","source":{"source":"hanabira","ref":"n1-043"},"match":"id","status":"imported","value":"The damage from this earthquake is incomparable to the previous one."}]}}}