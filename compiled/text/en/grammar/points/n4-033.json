{"kind":"grammar","lang":"en","entities":{"n4-033":{"renderings":[{"id":"284821d63e880086","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"A polite request; 'Could you please...', 'Would you mind...'"},{"id":"ddf7a85321f466d7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"The て いただけませんか grammar point is used to make a polite request to someone. It is a more polite form of て くれませんか, and can be translated as 'Could you please...' or 'Would you mind...' in English. To use it, change the verb to its て-form and add いただけませんか."},{"id":"3077e24cbde8135e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"Verb-て form + いただけませんか"},{"id":"e5c1b7c20c02a07b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-033"},"match":"id","status":"reviewed","value":"The most formal/humble request form - \"could you possibly...\"."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-033#9466a50eef3a":{"renderings":[{"id":"c67ff32a1f42ee72","role":"translation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"Could you please mail this letter for me?"}]},"n4-033#808e5d58c793":{"renderings":[{"id":"998d198dcbe2a2e6","role":"translation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"Could you please carry this luggage for me?"}]},"n4-033#e068d2507e37":{"renderings":[{"id":"44890536cb037f3d","role":"translation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"Could you please ask the person next door to be quiet?"}]},"n4-033#d2b47407d448":{"renderings":[{"id":"f337ab487b1ef9e0","role":"translation","source":{"source":"hanabira","ref":"n4-033"},"match":"id","status":"imported","value":"Could you please read the instruction manual?"}]}}}