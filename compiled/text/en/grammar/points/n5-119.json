{"kind":"grammar","lang":"en","entities":{"n5-119":{"renderings":[{"id":"2aa43d529463b889","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"Used to form interrogative questions and emphasize the question word for 'what', 'how'."},{"id":"2b74f3a86a5ff82a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"The なん～ grammar point is used to form interrogative questions and emphasize the question word for 'what' or 'how'. It is an abbreviation of '何' meaning 'what'. Its usage can vary depending on whether it is used with a counter, verb, or adjective."},{"id":"d2b59f2f8df041b5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"なん + Counter / なん + Verb / なん + Adjective"},{"id":"92c45291a5597739","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-119"},"match":"id","status":"reviewed","value":"なん before です, a counter, or で/の/と (なんですか, なん歳). Elsewhere, なに."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-119#a5ac9928adda":{"renderings":[{"id":"1d50c965196cd414","role":"translation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"How old are you?"}]},"n5-119#90a14a5af0e5":{"renderings":[{"id":"2bea590a204a08e2","role":"translation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"What is this?"}]},"n5-119#d06383843f69":{"renderings":[{"id":"0b4fc9110c1bd8af","role":"translation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"Why did he come?"}]},"n5-119#b1857ee0c5f1":{"renderings":[{"id":"eba2c45ec8b59489","role":"translation","source":{"source":"hanabira","ref":"n5-119"},"match":"id","status":"imported","value":"What is the name of that restaurant?"}]}}}