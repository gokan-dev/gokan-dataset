{"kind":"grammar","lang":"en","entities":{"n4-068":{"renderings":[{"id":"a931979cf09236a0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"Describes the time when a certain action takes place; 'when', 'at the time'."},{"id":"5c0bb66186644a44","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"The ～るときに grammar point is used to indicate the time when a certain action or event happens. It can be translated as 'when' or 'at the time' in English. The formation involves attaching ときに to the verb in its dictionary (る) form."},{"id":"f5e530dd5fe687b9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"Verb-る + ときに"},{"id":"e110eaa8f175011a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-068"},"match":"id","status":"reviewed","value":"Non-past form of とき - not a different register, just a different verb tense."},{"id":"56016b0b240964ae","role":"label","field":"family","source":{"source":"gokan","ref":"temporal-when"},"match":"id","status":"reviewed","value":"Temporal When (Verb Tense Variants)","of":{"kind":"family","id":"temporal-when"}}]},"n4-068#c381a53d9da7":{"renderings":[{"id":"b8e73a0f3919ccc0","role":"translation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"When I watch a movie, I eat popcorn."}]},"n4-068#550b4b30e4b9":{"renderings":[{"id":"dac1ed852e9b26c6","role":"translation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"When I go to bed, I turn off the room lights."}]},"n4-068#e837e49af54e":{"renderings":[{"id":"bcf2a40166af1849","role":"translation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"When exercising, it's important to stay hydrated."}]},"n4-068#0ff0bda001a8":{"renderings":[{"id":"fdfd78d06659ef9c","role":"translation","source":{"source":"hanabira","ref":"n4-068"},"match":"id","status":"imported","value":"When I travel, I like to bring a camera."}]}}}