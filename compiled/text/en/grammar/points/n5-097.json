{"kind":"grammar","lang":"en","entities":{"n5-097":{"renderings":[{"id":"37deead1de96f185","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"Ask 'how' something is done or how to do something."},{"id":"890f5cd95b8d9acd","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"The grammar point どうやって is used to ask how something is done or how to do something, and is translated as 'how' in English. It is often used in combination with verbs to inquire about the method or process someone goes through to complete a task or action."},{"id":"8d5ba5feb858227a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"どうやって + Verb-casual"},{"id":"e1adc2596d039da6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-097"},"match":"id","status":"reviewed","value":"'How, by what means': asks for the method (どうやって行きますか)."},{"id":"1913a979bbabcd87","role":"label","field":"family","source":{"source":"gokan","ref":"how"},"match":"id","status":"reviewed","value":"How (By What Means / How Do You Say It)","of":{"kind":"family","id":"how"}}]},"n5-097#187b27a17f83":{"renderings":[{"id":"221236a28ab31909","role":"translation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"How do you make sushi?"}]},"n5-097#66b4b2cfb337":{"renderings":[{"id":"e00fa39d482e9d6c","role":"translation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"How did you study Japanese?"}]},"n5-097#86cdea39dc2f":{"renderings":[{"id":"e6ce01127696f98b","role":"translation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"How do you solve this problem?"}]},"n5-097#e613118b5fc3":{"renderings":[{"id":"99f52e6c7fb687f6","role":"translation","source":{"source":"hanabira","ref":"n5-097"},"match":"id","status":"imported","value":"How do you go to the station?"}]}}}