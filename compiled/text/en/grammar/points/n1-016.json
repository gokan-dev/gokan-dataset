{"kind":"grammar","lang":"en","entities":{"n1-016":{"renderings":[{"id":"f8c1939047662aaa","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"Do one thing while also doing another; 'while', 'and at the same time'."},{"id":"16d8ef43b322d8a8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"「Noun かたがた」 is a somewhat formal expression for doing one thing while also doing another. The first action is often the main purpose, and the second is done simultaneously or incidentally."},{"id":"60670ddcc0a2e3f2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"Noun + かたがた"},{"id":"0ebf9a64da78293f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-016"},"match":"id","status":"reviewed","value":"Formal, literary \"while also doing/for the purpose of\" - similar function to がてら, more formal register."},{"id":"ad8e82d619954210","role":"label","field":"family","source":{"source":"gokan","ref":"occasion"},"match":"id","status":"reviewed","value":"Occasion (While Doing / On The Occasion Of)","of":{"kind":"family","id":"occasion"}}]},"n1-016#68b3a50dca50":{"renderings":[{"id":"b571b3172da04b8b","role":"translation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"While on a business trip to Tokyo, I also went to see a friend."}]},"n1-016#a45fef6db402":{"renderings":[{"id":"d28543a59a75195d","role":"translation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"While sightseeing, I bought some souvenirs."}]},"n1-016#44e2adf60853":{"renderings":[{"id":"a62f7b2f90fa0e5a","role":"translation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"While taking a walk, I also picked up trash."}]},"n1-016#80587837d0f2":{"renderings":[{"id":"3532add2f2de9c72","role":"translation","source":{"source":"hanabira","ref":"n1-016"},"match":"id","status":"imported","value":"While studying, I also listened to music."}]}}}