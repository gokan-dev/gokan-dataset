{"kind":"grammar","lang":"en","entities":{"n5-050":{"renderings":[{"id":"9d30bc1c7e6bb83b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-050"},"match":"id","status":"imported","value":"Used to make a polite request for someone not to do something; 'please don't'."},{"id":"ce4eade494dbf2e5","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-050"},"match":"id","status":"imported","value":"The grammar point Verb ないで ください is used to make a polite request for someone not to do a certain action. In English, it can be translated as 'please don't'. To form this expression, take the verb in its negative form (ない-form) and add で ください."},{"id":"0bce88e8597c5aee","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-050"},"match":"id","status":"imported","value":"Verb-ない-form + で ください"},{"id":"4fe34a97edf70e50","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-050"},"match":"id","status":"reviewed","value":"'Please don't': the negative request (見ないでください)."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n5-050#ae6ce86b487f":{"renderings":[{"id":"95cd131595ee1166","role":"translation","source":{"source":"hanabira","ref":"n5-050"},"match":"id","status":"imported","value":"Please don't smoke."}]},"n5-050#c24ac8f78997":{"renderings":[{"id":"c3d2c90e676a3c9e","role":"translation","source":{"source":"hanabira","ref":"n5-050"},"match":"id","status":"imported","value":"Please don't run here."}]},"n5-050#73bae2df4584":{"renderings":[{"id":"c40dd9d0dba36220","role":"translation","source":{"source":"hanabira","ref":"n5-050"},"match":"id","status":"imported","value":"Please don't speak loudly."}]},"n5-050#6f8b8da9494f":{"renderings":[{"id":"0dd7bd9bbb1cacc4","role":"translation","source":{"sou