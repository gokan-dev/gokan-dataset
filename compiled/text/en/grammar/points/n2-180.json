{"kind":"grammar","lang":"en","entities":{"n2-180":{"renderings":[{"id":"2f9abc32a4a63f4f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"To do something completely or thoroughly."},{"id":"ea10354617c27a22","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"The ～切る grammar point is added to the verb stem (masu-form) to express doing something completely or thoroughly, often implying a strong sense of finishing or using up everything."},{"id":"4c83a925642f8985","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"Verb-stem + 切る"},{"id":"968f1752171e7096","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-180"},"match":"id","status":"reviewed","value":"ます stem + 切る: do completely, all the way (使い切る)."},{"id":"346651d354f1ea02","role":"label","field":"family","source":{"source":"gokan","ref":"aspect-verbs"},"match":"id","status":"reviewed","value":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","of":{"kind":"family","id":"aspect-verbs"}}]},"n2-180#c92910508616":{"renderings":[{"id":"17b1c7f59004bf57","role":"translation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"He intends to give his absolute all to exam study."}]},"n2-180#292390070b6c":{"renderings":[{"id":"797a8a5bf392a7cc","role":"translation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"Please don't go home until you've completely finished this job."}]},"n2-180#4a43daac427e":{"renderings":[{"id":"e3ba7cee8bdf279c","role":"translation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"I argued with my friend and couldn't say everything I wanted to say."}]},"n2-180#c24c3930f382":{"renderings":[{"id":"6a7c9a18acd0daf4","role":"translation","source":{"source":"hanabira","ref":"n2-180"},"match":"id","status":"imported","value":"They were able to complete that game thoroughly."}]}}}