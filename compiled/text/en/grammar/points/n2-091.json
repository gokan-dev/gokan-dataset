{"kind":"grammar","lang":"en","entities":{"n2-091":{"renderings":[{"id":"dc0790000f760e4f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"Expressing a general rule or common sense."},{"id":"6e0f5f9344e286ba","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"The ～というものだ grammar point is used to emphasize a general rule, a piece of common sense, or an indisputable fact. It often appears in comments or observations about something commonly accepted as true."},{"id":"bc6af45d8cad8b3c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"Sentence + というものだ"},{"id":"f0f46b0e229328fa","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-091"},"match":"id","status":"reviewed","value":"というものだ: that is just what X is, a general truth."},{"id":"8930c0345232d655","role":"label","field":"family","source":{"source":"gokan","ref":"explanation"},"match":"id","status":"reviewed","value":"Explanation (The Reason Is)","of":{"kind":"family","id":"explanation"}}]},"n2-091#ecfb48c3239d":{"renderings":[{"id":"59f91cc9474c26d4","role":"translation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"The passion of young people is something that deserves respect."}]},"n2-091#a875c0f0aea7":{"renderings":[{"id":"87376d9ea5878a2e","role":"translation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"If you skip even a day of studying, you'll fall behind—that's just how it is."}]},"n2-091#469dbe8c9181":{"renderings":[{"id":"1ae47080e35c1c8c","role":"translation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"To succeed, one must face difficulties—that's just the way it is."}]},"n2-091#7edb4dfe1e63":{"renderings":[{"id":"6260aa78b4a61ccb","role":"translation","source":{"source":"hanabira","ref":"n2-091"},"match":"id","status":"imported","value":"It is said that friendship cannot be bought with money."}]}}}