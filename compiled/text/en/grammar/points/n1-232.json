{"kind":"grammar","lang":"en","entities":{"n1-232":{"renderings":[{"id":"3d652f72ba231042","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"Expresses the amount of time elapsed since doing something last."},{"id":"80aaf50c75a0b427","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"The ～ぶり grammar point is used to express that a certain amount of time has passed since you last did something. It often translates as 'for the first time in ~' or 'after (time period)'."},{"id":"e2dbcabe8b126840","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"Time expression + ぶり"}]},"n1-232#6537f4f030d5":{"renderings":[{"id":"638ae9f50546a2bf","role":"translation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"I met him for the first time in three years."}]},"n1-232#a97c8cf0fcdd":{"renderings":[{"id":"d1190e82700b82ed","role":"translation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"I went to the gym for the first time in a week."}]},"n1-232#548f6219f000":{"renderings":[{"id":"f8e7da8c3c8f5d5e","role":"translation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"I received a letter from him for the first time in a month."}]},"n1-232#95ed14bde005":{"renderings":[{"id":"caa528d6218b4aae","role":"translation","source":{"source":"hanabira","ref":"n1-232"},"match":"id","status":"imported","value":"It snowed for the first time in five years."}]}}}