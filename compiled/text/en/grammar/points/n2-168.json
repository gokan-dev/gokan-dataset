{"kind":"grammar","lang":"en","entities":{"n2-168":{"renderings":[{"id":"0e54d40bfbcfe8c1","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"Indicates that something is centered around or focused on a main topic or area."},{"id":"a93f88e0618be6e2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"「～を中心に」 is used with nouns to show that an action or situation is mainly or primarily about the specified noun. It can be translated as 'centered on', 'focusing on', or 'with ... as the main focus'."},{"id":"c9a8f28b94351098","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"Noun + を中心に"}]},"n2-168#d7f1fa68c4da":{"renderings":[{"id":"1402359ea6db5ed4","role":"translation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"This event is mainly enjoyed for its music."}]},"n2-168#d7f6047e7e39":{"renderings":[{"id":"c6985d917047b6f8","role":"translation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"His work is primarily conducted in and around Tokyo."}]},"n2-168#575d4828fb65":{"renderings":[{"id":"e018a120fbe2c7ea","role":"translation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"She’s writing a book focusing on health."}]},"n2-168#04d305aa245b":{"renderings":[{"id":"9df19c682bace9b6","role":"translation","source":{"source":"hanabira","ref":"n2-168"},"match":"id","status":"imported","value":"Recent research is being carried out with a primary focus on environmental protection."}]}}}