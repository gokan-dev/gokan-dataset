{"kind":"grammar","lang":"en","entities":{"n1-102":{"renderings":[{"id":"013c1cc3a1f628c0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"Assuming; presupposing; on the assumption of."},{"id":"9e41eafc4a70b717","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"The grammar point 'Noun を前提にして' is used to show that something is done assuming or presupposing the noun that comes before it. In English, it can be translated as 'on the assumption of', 'assuming', or 'presupposing'."},{"id":"743ccf80adf68cd7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"Noun + を前提にして"},{"id":"98bd7ed016216946","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-102"},"match":"id","status":"reviewed","value":"を前提にして: taking X as a given (結婚を前提に)."},{"id":"20db34780c641624","role":"label","field":"family","source":{"source":"gokan","ref":"based-on"},"match":"id","status":"reviewed","value":"Based On (In Accordance With)","of":{"kind":"family","id":"based-on"}}]},"n1-102#40e94e71e29c":{"renderings":[{"id":"851b9e365aa5914c","role":"translation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"We planned tomorrow's picnic assuming fine weather."}]},"n1-102#fb585b157ba1":{"renderings":[{"id":"ca75bd07b5f094fd","role":"translation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"We started preparing for the celebration party assuming she would pass the exam."}]},"n1-102#b3a77d7df77e":{"renderings":[{"id":"c81faee6773a8e82","role":"translation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"The budget was made on the assumption of economic growth."}]},"n1-102#6d3f45e26026":{"renderings":[{"id":"dccf0c623a3bcb25","role":"translation","source":{"source":"hanabira","ref":"n1-102"},"match":"id","status":"imported","value":"We decided the meeting schedule assuming his participation."}]}}}