{"kind":"grammar","lang":"en","entities":{"n3-040":{"renderings":[{"id":"c3a10535f01b56d8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"Express an unintentional action or a regretful action; 'ended up doing', 'did accidentally'."},{"id":"82adeb77ff9ef4f9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"The ～ちゃった grammar point is the informal, colloquial version of ～てしまった. It expresses unintentional or regretful actions and can be translated as 'ended up doing' or 'did accidentally'."},{"id":"7749ce85f24c780a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"Verb-て/で form -> ちゃった/じゃった (e.g. 食べてしまった -> 食べちゃった)"},{"id":"15fc8f06a056aabe","role":"label","field":"derives","source":{"source":"gokan","ref":"n3-040"},"match":"id","status":"reviewed","value":"ちゃった (て-form contraction)"}]},"n3-040#b4a06c0801f9":{"renderings":[{"id":"5cadef24bc812947","role":"translation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"I accidentally left something behind."}]},"n3-040#26c70f73858a":{"renderings":[{"id":"55f2e0c2e173a1fb","role":"translation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"I overslept and ended up being late."}]},"n3-040#9fa423ce8399":{"renderings":[{"id":"1c861bcf1aef08f7","role":"translation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"I ended up eating the whole cake."}]},"n3-040#de1a24584156":{"renderings":[{"id":"4d552a54aae3e575","role":"translation","source":{"source":"hanabira","ref":"n3-040"},"match":"id","status":"imported","value":"I wasn't planning to say it, but I ended up saying it."}]}}}