{"kind":"grammar","lang":"en","entities":{"n5-018":{"renderings":[{"id":"dad91e43323a987a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-018"},"match":"id","status":"imported","value":"Turn a な-adjective into an adverb by adding に."},{"id":"93f6b3bd6554542c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-018"},"match":"id","status":"imported","value":"To make a な-adjective modify a verb, remove the な and add に. This form describes how an action is performed. For instance, 静か（な） -> 静かに, 親切（な） -> 親切に."},{"id":"e3cad7871c01675a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-018"},"match":"id","status":"imported","value":"な-Adjective (remove な) + に + Verb"},{"id":"0e4ccddd3da66793","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-018"},"match":"id","status":"reviewed","value":"な-adjectives: add に (静かに話す). い-adjectives take く."},{"id":"2a0f219e7f8f01fe","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-018"},"match":"id","status":"reviewed","value":"na-adjective adverbial (に)"},{"id":"b16d8ba73398a4ab","role":"label","field":"family","source":{"source":"gokan","ref":"adverbial-form"},"match":"id","status":"reviewed","value":"Adjectives As Adverbs (Quickly / Quietly)","of":{"kind":"family","id":"adverbial-form"}}]},"n5-018#a052b6c15943":{"renderings":[{"id":"90819b37f4081813","role":"translation","source":{"source":"hanabira","ref":"n5-018"},"match":"id","status":"imported","value":"He speaks quietly."}]},"n5-018#a6aea52801c7":{"renderings":[{"id":"a9a2a3f74736ffc0","role":"translation","source":{"source":"hanabira","ref":"n5-018"},"match":"id","status":"imported","value":"I cleaned the room neatly."}]},"n5-018#20fa8fc2c6b7":{"renderings":[{"id":"388914993e9a2a1c","role":"translation","source":{"source":"hanabira","ref":"n5-018"},"match":"id","status":"imported","value":"She works energetically."}]},"n5-018#2b0ea1982a9d":{"rendering