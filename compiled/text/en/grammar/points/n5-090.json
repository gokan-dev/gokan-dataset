{"kind":"grammar","lang":"en","entities":{"n5-090":{"renderings":[{"id":"bf24f253267eb35d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"Asking 'who' in a sentence, used to inquire about someone's identity or to clarify who is being referred to."},{"id":"a025d08cbd3e420a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"The だれ〜 grammar point is used to ask about the identity of someone in a sentence. It can be translated as 'who' or 'whom' in English. It is often used with the particle が, は, or を, but can also be combined with other particles depending on the context."},{"id":"3244f68b1f9a9658","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"だれ + appropriate particle (が, は or を)"},{"id":"df93b8d95b3be2c1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-090"},"match":"id","status":"reviewed","value":"The everyday 'who', fine with friends and in most questions. Polite: どなた."},{"id":"51a79d989bbdb41e","role":"label","field":"family","source":{"source":"gokan","ref":"who"},"match":"id","status":"reviewed","value":"Who (Someone / Anyone / No One)","of":{"kind":"family","id":"who"}}]},"n5-090#7eb772493d1d":{"renderings":[{"id":"8382ec348c3dcc1a","role":"translation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"Who bought that book?"}]},"n5-090#0624cfbd23af":{"renderings":[{"id":"3e5fae32f7f43e4f","role":"translation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"Whom are you waiting for?"}]},"n5-090#c8253faccef6":{"renderings":[{"id":"48bbcc70b9a007fa","role":"translation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"Who ate that apple?"}]},"n5-090#0d959409e966":{"renderings":[{"id":"7d3931b560157b51","role":"translation","source":{"source":"hanabira","ref":"n5-090"},"match":"id","status":"imported","value":"Who has the key?"}]}}}