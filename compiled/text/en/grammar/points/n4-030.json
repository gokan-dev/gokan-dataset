{"kind":"grammar","lang":"en","entities":{"n4-030":{"renderings":[{"id":"00ad6c21c7e175dd","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"Expresses an action that continues on into the future or a change that progresses over time."},{"id":"1424bce3988a06be","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"The て いく grammar point is used to indicate that an action will continue or a change will progress into the future. It can be attached to the て-form of a verb and is often translated as 'to keep', 'to continue', or 'to go on' in English."},{"id":"623fe310a49da18b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"Verb in て-form + いく"},{"id":"90efe26b1e808a29","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-030"},"match":"id","status":"reviewed","value":"ていく: change continuing from now on, or moving away (増えていく)."},{"id":"28e0e6e1e644a507","role":"label","field":"family","source":{"source":"gokan","ref":"direction-of-change"},"match":"id","status":"reviewed","value":"Direction Of Change (From Now On / Up To Now)","of":{"kind":"family","id":"direction-of-change"}}]},"n4-030#35db2face069":{"renderings":[{"id":"24a8c20623bc2529","role":"translation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"If you keep practicing like this, you will improve."}]},"n4-030#58f11572eb88":{"renderings":[{"id":"ed3e4d2f7fe9d5c6","role":"translation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"As he grew up, his independence became stronger."}]},"n4-030#c6ea69d64596":{"renderings":[{"id":"6c6881a7650e0ee7","role":"translation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"This company will continue to innovate in technology in the future."}]},"n4-030#ac2b077b771a":{"renderings":[{"id":"2af4d3f2c7c71757","role":"translation","source":{"source":"hanabira","ref":"n4-030"},"match":"id","status":"imported","value":"Children will keep learning more and more."}]}}}