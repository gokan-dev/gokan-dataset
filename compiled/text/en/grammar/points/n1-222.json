{"kind":"grammar","lang":"en","entities":{"n1-222":{"renderings":[{"id":"bec3ad6f1149662b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"To endure or withstand something; 'endure', 'withstand', 'tolerate'."},{"id":"3e7ca3a083655e79","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"The ～に耐える grammar point is used to express the concept of enduring or withstanding something, often involving a degree of difficulty or hardship. It can be translated as 'endure', 'withstand', or 'tolerate' in English. Here we focus on usage with nouns (e.g., a force or a hardship to endure)."},{"id":"dd515d48266207f3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"Noun + に耐える"},{"id":"a45d15feed02b81b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-222"},"match":"id","status":"reviewed","value":"に耐える: withstand pressure or hardship (寒さに耐える). Different kanji from 堪える."},{"id":"2e4e09ff35069847","role":"label","field":"family","source":{"source":"gokan","ref":"worth"},"match":"id","status":"reviewed","value":"Worth (Worth Doing / In Vain / Bearable)","of":{"kind":"family","id":"worth"}}]},"n1-222#f02542543ca6":{"renderings":[{"id":"1f64f5795a3f4728","role":"translation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"He endured the harsh training."}]},"n1-222#88b8b38adb45":{"renderings":[{"id":"37abe484094237a2","role":"translation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"This bridge can withstand strong winds."}]},"n1-222#5c1851f34b2a":{"renderings":[{"id":"e81eec4c208e072e","role":"translation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"She endured the pain."}]},"n1-222#29557b50080b":{"renderings":[{"id":"4b9f6e138caac9b1","role":"translation","source":{"source":"hanabira","ref":"n1-222"},"match":"id","status":"imported","value":"This building can withstand an earthquake."}]}}}