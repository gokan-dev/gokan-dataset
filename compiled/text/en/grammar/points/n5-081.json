{"kind":"grammar","lang":"en","entities":{"n5-081":{"renderings":[{"id":"437e26ace781c4b0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"Immediately or right away; used to express promptness or quickness."},{"id":"f9ef07b8a8f18127","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"The すぐに～ grammar point is used to express an action happening immediately or right away. It often indicates promptness or quickness and can be used with both verbs and adjectives."},{"id":"107c526f20be28ef","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"すぐに + Verb/Adjective"},{"id":"5f9713c5ad6acf3c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-081"},"match":"id","status":"reviewed","value":"'Right away, immediately' (すぐに行きます)."},{"id":"99350681f510f5ba","role":"label","field":"family","source":{"source":"gokan","ref":"soon"},"match":"id","status":"reviewed","value":"Close In Time (Soon / Right Away / A Moment Ago)","of":{"kind":"family","id":"soon"}}]},"n5-081#35fadd0441e7":{"renderings":[{"id":"a27f9c0b8fd5abe6","role":"translation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"When my friend arrives, please call me right away."}]},"n5-081#74f2d7211b6b":{"renderings":[{"id":"93cc90fc18abb469","role":"translation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"Upon hearing that news, I went to the company immediately."}]},"n5-081#8f39d0581b86":{"renderings":[{"id":"45fd14ca98bc3cbc","role":"translation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"She started crying right away."}]},"n5-081#98398569fb24":{"renderings":[{"id":"fc14ec4addd3f10a","role":"translation","source":{"source":"hanabira","ref":"n5-081"},"match":"id","status":"imported","value":"As soon as I entered the classroom, the teacher started the lesson immediately."}]}}}