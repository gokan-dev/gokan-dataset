{"kind":"grammar","lang":"en","entities":{"n4-047":{"renderings":[{"id":"e647c1a26722a855","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"Express a desire to receive a favor or service from someone else."},{"id":"1e71d5fc05474bcd","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"The ～てもらいたい grammar point is used to express one's desire to receive a favor, service, or action from someone else. It is formed by attaching もらいたい to the て-form of verbs. This structure emphasizes the help or favor the speaker wants from someone else."},{"id":"3918b3260706fddb","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"Verb-て-form + もらいたい"},{"id":"cb6ab28e57603bbc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-047"},"match":"id","status":"reviewed","value":"Neutral \"I'd like you to...\" - less formal than ていただきたい."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-047#816d64929f8c":{"renderings":[{"id":"e7048a99f05d9f00","role":"translation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"I want you to carry this luggage for me."}]},"n4-047#825a0cc0a3ba":{"renderings":[{"id":"be209f02a5e522ce","role":"translation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"I want him to tell me the news."}]},"n4-047#11c3671c0acb":{"renderings":[{"id":"8d9786b2f26e155a","role":"translation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"I want my friend to teach me Japanese."}]},"n4-047#6366d86afc4d":{"renderings":[{"id":"e5177c76fa0a45dc","role":"translation","source":{"source":"hanabira","ref":"n4-047"},"match":"id","status":"imported","value":"I want the staff to explain the check-in process to me."}]}}}