{"kind":"grammar","lang":"en","entities":{"n4-107":{"renderings":[{"id":"60e57cb13b926cc0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"Expresses that something is not necessary to do; 'it's okay if not', 'don't have to'."},{"id":"dd2e57fc7a90151e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"The ～なくてもいい grammar point is used to express that an action or situation is not necessary or required, implying that it's okay if it does not occur. It can be translated as 'it's okay if not' or 'don't have to' in English. This grammar is used with verbs."},{"id":"3105341839c8a1c8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"Verb-ない-form + てもいい"},{"id":"9ef3f818479bd802","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-107"},"match":"id","status":"reviewed","value":"The everyday 'don't have to' (行かなくてもいい). Not permission: that is てもいい."},{"id":"620e2cd778f51c48","role":"label","field":"family","source":{"source":"gokan","ref":"no-need-to"},"match":"id","status":"reviewed","value":"No Need To","of":{"kind":"family","id":"no-need-to"}}]},"n4-107#ad63e51bbcfe":{"renderings":[{"id":"629103d6ca4118d6","role":"translation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"You don't have to drink the coffee."}]},"n4-107#fcbee846a443":{"renderings":[{"id":"47e870055ef6361a","role":"translation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"It's okay if you don't do your homework today."}]},"n4-107#7ce149dba26e":{"renderings":[{"id":"b81358faa79cb1d8","role":"translation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"You don't have to reply immediately."}]},"n4-107#76bf29a3af4c":{"renderings":[{"id":"6ae00eb1d5df4a31","role":"translation","source":{"source":"hanabira","ref":"n4-107"},"match":"id","status":"imported","value":"You don't have to eat everything, so please don't force yourself."}]}}}