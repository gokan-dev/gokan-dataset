{"kind":"grammar","lang":"en","entities":{"n4-084":{"renderings":[{"id":"9d2825b80de03865","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"Express the appearance, seeming, or feeling of something; 'looks like', 'seems', 'appears'."},{"id":"0adbb6c039bbe75e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"The ～そうだ grammar point is used to describe the appearance or feeling of something based on what is observed or inferred. It can be translated as 'looks like', 'seems', or 'appears' in English. The formation differs depending on whether it is used with a verb, い-adjective, or な-adjective."},{"id":"eb5ec41abe6f422c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"Verb-ますstem + そうだ, い-Adjective (without い) + そうだ, な-Adjective + そうだ"},{"id":"3b8e336c530f0f0d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-084"},"match":"id","status":"reviewed","value":"ます stem + そうだ: looks like, judged from what you see (おいしそう)."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n4-084#1087630ded43":{"renderings":[{"id":"1b55015afb2df97b","role":"translation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"That flower looks very beautiful."}]},"n4-084#df684f088e2b":{"renderings":[{"id":"6780266b1f56b2e4","role":"translation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"He looks tired."}]},"n4-084#170d3fcc84e2":{"renderings":[{"id":"2e7f17d6bec84906","role":"translation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"This book looks interesting."}]},"n4-084#84310f670ad0":{"renderings":[{"id":"4531887112a0b1fd","role":"translation","source":{"source":"hanabira","ref":"n4-084"},"match":"id","status":"imported","value":"It looks like it's going to rain."}]}}}