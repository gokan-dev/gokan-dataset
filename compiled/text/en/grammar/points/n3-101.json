{"kind":"grammar","lang":"en","entities":{"n3-101":{"renderings":[{"id":"ffa2fe4cbf183819","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"Used to express a strong resemblance or similarity; 'as if', 'just like', 'as though'."},{"id":"2540c0ba6ca9bbe1","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"The まるで～よう grammar point is used to emphasize a strong resemblance or similarity between two things or situations. It can be translated as 'as if', 'just like', or 'as though' in English. The formation is まるで + phrase/sentence + よう."},{"id":"f20dfdbe51b23b7c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"まるで + phrase/sentence + よう"},{"id":"2c4bbacc4977f4e6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-101"},"match":"id","status":"reviewed","value":"Emphatic \"just like/exactly as if\" - まるで adds emphasis to an already-strong resemblance."},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n3-101#a700f62e08ca":{"renderings":[{"id":"97e78a1dad5d397e","role":"translation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"She is as beautiful as an angel."}]},"n3-101#df50b15f3088":{"renderings":[{"id":"e2f364619c4a7efb","role":"translation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"He works as if he is a robot."}]},"n3-101#230df8aee0f4":{"renderings":[{"id":"93188496bb7aceda","role":"translation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"That house is just like a castle."}]},"n3-101#2cd4c221a4dd":{"renderings":[{"id":"e8485707f0973c8c","role":"translation","source":{"source":"hanabira","ref":"n3-101"},"match":"id","status":"imported","value":"This place is as though it's a paradise."}]}}}