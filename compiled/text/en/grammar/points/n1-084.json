{"kind":"grammar","lang":"en","entities":{"n1-084":{"renderings":[{"id":"09f13ade829033c6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"Used to express the extreme or utmost point of something."},{"id":"c68319f025b4b004","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"The の極み grammar point is used to express the highest level or the extreme of something. It often describes an extreme state or condition. The noun before の極み usually indicates some situation, state, or quality (e.g., 美の極み, 感動の極み)."},{"id":"64649612c75fb6ee","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"Noun + の極み"},{"id":"a2a357674387bcf0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-084"},"match":"id","status":"reviewed","value":"Noun の極み: the height of (贅沢の極み)."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n1-084#4b4f12799310":{"renderings":[{"id":"b35e40948c3b285a","role":"translation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"The pinnacle of his cooking is something nobody can imitate."}]},"n1-084#7b4e51e9b268":{"renderings":[{"id":"3cf71b030eca4f07","role":"translation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"The extreme of her effort has created this success."}]},"n1-084#91a83dae145d":{"renderings":[{"id":"6d13da6ff56b7438","role":"translation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"He continues to pursue the pinnacle of music."}]},"n1-084#4cdab6b07102":{"renderings":[{"id":"c63393b578807cd9","role":"translation","source":{"source":"hanabira","ref":"n1-084"},"match":"id","status":"imported","value":"This scenery is the epitome of beauty."}]}}}