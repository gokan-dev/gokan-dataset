{"kind":"grammar","lang":"en","entities":{"n5-903":{"renderings":[{"id":"a2612d3fd4339952","role":"label","field":"name","source":{"source":"gokan","ref":"n5-903"},"match":"id","status":"reviewed","value":"Polite negative"},{"id":"8c9cb7b365922407","role":"prose","field":"shortExplanation","source":{"source":"gokan","ref":"n5-903"},"match":"id","status":"reviewed","value":"The polite negative: 書きません, 食べません."},{"id":"5e59ab8f946a70d6","role":"prose","field":"longExplanation","source":{"source":"gokan","ref":"n5-903"},"match":"id","status":"reviewed","value":"ません negates ます on the same stem. It is the polite way to say an action does not or will not happen."},{"id":"8c30fa4e91596674","role":"prose","field":"formation","source":{"source":"gokan","ref":"n5-903"},"match":"id","status":"reviewed","value":"Verb (ます-stem) + ません."},{"id":"327a72c1bf217198","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-903"},"match":"id","status":"reviewed","value":"polite negative (ません)"}]}}}