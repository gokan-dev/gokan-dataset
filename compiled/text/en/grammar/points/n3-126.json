{"kind":"grammar","lang":"en","entities":{"n3-126":{"renderings":[{"id":"738dfd32502d2e52","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"Conveys information heard from someone else; 'I heard', 'They said'."},{"id":"538430056f6f071c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"The ～んだって grammar point is used to relay information the speaker has heard from someone else. It's a casual way of quoting what was said, effectively combining explanatory のだ (んだ) with the informal quoting particle って. It can be translated as 'I heard...' or 'They said...'."},{"id":"e37eb8cfd6ac2a86","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"Verb-casual + んだって, い-Adjective + んだって, な-Adjective + なんだって, Noun + なんだって"},{"id":"8ee1367cce8eb655","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-126"},"match":"id","status":"reviewed","value":"Casual, spoken hearsay - \"I heard (that)...\", conversational tone."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n3-126#ba7229f97403":{"renderings":[{"id":"7590527f47c0f15e","role":"translation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"I heard he's going to Tokyo."}]},"n3-126#2bf88227841a":{"renderings":[{"id":"efb370350892855f","role":"translation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"They said this movie is interesting."}]},"n3-126#cf90614e4731":{"renderings":[{"id":"f553106b54b420d5","role":"translation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"I heard she's a famous singer."}]},"n3-126#23822ee8a871":{"renderings":[{"id":"1e48fce278e1a2d3","role":"translation","source":{"source":"hanabira","ref":"n3-126"},"match":"id","status":"imported","value":"They said the night view at that restaurant is beautiful."}]}}}