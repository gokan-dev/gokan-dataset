{"kind":"grammar","lang":"en","entities":{"n4-113":{"renderings":[{"id":"65c7cf5b16b4cea6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"Express a suggestion or advice; 'should', 'it would be good if'."},{"id":"91add72c5ff14e3d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"The ～ばいい grammar point is used to express a suggestion, recommendation or advice. It can be translated as 'should', or 'it would be good if' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"b09b17e7a33999fc","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"Verb-ば-form + いい, い-Adjective + ければいい, な-Adjective + であればいい, Noun + であればいい"},{"id":"524e8ec0afba7a10","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-113"},"match":"id","status":"reviewed","value":"Casual, softer suggestion - \"it'd be good if...\", near-identical register to たらいい."},{"id":"6b4d498c02a32dcd","role":"label","field":"family","source":{"source":"gokan","ref":"should"},"match":"id","status":"reviewed","value":"Should (Advice / Expectation)","of":{"kind":"family","id":"should"}}]},"n4-113#d553b3dbb53e":{"renderings":[{"id":"39706a0d63cd982c","role":"translation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"You should study more."}]},"n4-113#3d73a8528a9f":{"renderings":[{"id":"7b4feedbadf8dc4d","role":"translation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"If you're hungry, you should eat something."}]},"n4-113#a7d9f246158d":{"renderings":[{"id":"64bd4ae5f8828774","role":"translation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"You should run faster."}]},"n4-113#e8a9e452253a":{"renderings":[{"id":"af9dcce77e6dda4e","role":"translation","source":{"source":"hanabira","ref":"n4-113"},"match":"id","status":"imported","value":"If you don't understand, you should ask the teacher."}]}}}