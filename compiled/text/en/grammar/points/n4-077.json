{"kind":"grammar","lang":"en","entities":{"n4-077":{"renderings":[{"id":"72b702db3961c2e7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"Express uncertainty; 'maybe', 'might', 'possibly'."},{"id":"b902fd6076b92f40","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"The ～かもしれない grammar point is used to express uncertainty or the possibility of something occurring. It can be translated as 'maybe', 'might', or 'possibly' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun. In everyday speech, speakers often omit だ before かもしれない for nouns and な-adjectives."},{"id":"11fe1fffed3e3638","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"Verb-casual + かもしれない, い-Adjective + かもしれない, な-Adjective + だかもしれない, Noun + だかもしれない"},{"id":"1382c3f30a062b6c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-077"},"match":"id","status":"reviewed","value":"The everyday hedge for possibility - \"maybe/might\"."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n4-077#d91567656344":{"renderings":[{"id":"faca17c9f6847022","role":"translation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"It might rain tomorrow."}]},"n4-077#441b5c88faba":{"renderings":[{"id":"df5974a3c3499ea5","role":"translation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"This cake might be delicious."}]},"n4-077#8fa6a8c1da18":{"renderings":[{"id":"36475dcdb955a29d","role":"translation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"He might be sick."}]},"n4-077#eea204787676":{"renderings":[{"id":"1ab0cd460d57ccd8","role":"translation","source":{"source":"hanabira","ref":"n4-077"},"match":"id","status":"imported","value":"She might be a student."}]}}}