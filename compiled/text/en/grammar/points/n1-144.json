{"kind":"grammar","lang":"en","entities":{"n1-144":{"renderings":[{"id":"bb3e2a5458393280","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"Indicates there's no end once you start listing, doing, or saying something: 'If one starts to..., there will be no end.'"},{"id":"1af14c5b7dc5a11a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"The pattern ～ばきりがない is used when expressing that if you start an action - like listing examples or complaining - there is no end. It literally means 'if (you) do X, there's no limit/end.'"},{"id":"a2b25eee547c81f8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"Verb-conditional form (ば) + きりがない"},{"id":"1bfe57847d3cabf6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-144"},"match":"id","status":"reviewed","value":"ばきりがない: once you start, there is no end. Same as たら / と きりがない."},{"id":"35530e0c1b8521ee","role":"label","field":"family","source":{"source":"gokan","ref":"endless"},"match":"id","status":"reviewed","value":"Endless (There's No End To It)","of":{"kind":"family","id":"endless"}}]},"n1-144#c083975e13cd":{"renderings":[{"id":"dd2b58c4bb5671b7","role":"translation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"Once I start speaking ill of someone, there's no end."}]},"n1-144#b0f0d6035ce4":{"renderings":[{"id":"4ea7532ce75b3f40","role":"translation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"If I start counting his flaws, there will be no end."}]},"n1-144#82a5f142f7d1":{"renderings":[{"id":"0ab86d789097594f","role":"translation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"If I start listing this country's beautiful places, there's no end."}]},"n1-144#744e455cfb7f":{"renderings":[{"id":"073b94298a1bcadc","role":"translation","source":{"source":"hanabira","ref":"n1-144"},"match":"id","status":"imported","value":"If I start giving more examples, there will be no end."}]}}}