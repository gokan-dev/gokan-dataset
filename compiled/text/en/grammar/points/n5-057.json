{"kind":"grammar","lang":"en","entities":{"n5-057":{"renderings":[{"id":"cee7aba2a6bd1f31","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"Express an action or event as a noun; 'the act of', 'doing'."},{"id":"19ef51579d6a33b8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"The ること grammar point is used to nominalize or turn a verb into a noun, which represents the action or event itself as a concept. It can be translated as 'the act of' or simply 'doing' in English. This formation is used with verbs in the dictionary (ru-)form."},{"id":"ead7f349f87581c6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"Verb (dictionary form) + こと"}]},"n5-057#2eb585693cf8":{"renderings":[{"id":"b1e7ec31e42f78cb","role":"translation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"I love swimming."}]},"n5-057#9fcbc2a688bd":{"renderings":[{"id":"3930d51a1686278e","role":"translation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"Studying Japanese is fun."}]},"n5-057#fda95442f000":{"renderings":[{"id":"ec4c508816bfbacc","role":"translation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"Talking with friends reduces stress."}]},"n5-057#ff6a50dbeb25":{"renderings":[{"id":"eeb599233bf5aa57","role":"translation","source":{"source":"hanabira","ref":"n5-057"},"match":"id","status":"imported","value":"He is good at singing."}]}}}