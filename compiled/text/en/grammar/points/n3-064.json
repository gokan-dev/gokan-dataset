{"kind":"grammar","lang":"en","entities":{"n3-064":{"renderings":[{"id":"28dd5fc5fb19d97e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"Expresses a near miss or a situation that almost happened; 'was just about to', 'almost', 'nearly'."},{"id":"1cfbcbd9bb7ac90e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"The ～ところだった grammar point is used to express a situation that almost occurred or something that the speaker was just about to do. It can be translated as 'was just about to', 'almost', or 'nearly' in English. Typically, it is formed with the dictionary form or ている form of a verb + ところだった."},{"id":"380c2e7bca9b8d4e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"Verb (dictionary form or ている form) + ところだった"},{"id":"5c489efbf4fc0368","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-064"},"match":"id","status":"reviewed","value":"\"Was just about to (but didn't)\" - a near-miss, describes something that almost happened."},{"id":"040d13b68e1b57c5","role":"label","field":"family","source":{"source":"gokan","ref":"almost"},"match":"id","status":"reviewed","value":"Almost (Nearly)","of":{"kind":"family","id":"almost"}}]},"n3-064#d868eadcf4f0":{"renderings":[{"id":"98729245030dd27d","role":"translation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"I was just about to be late."}]},"n3-064#424cf330dbf7":{"renderings":[{"id":"362103ffb6ab210a","role":"translation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"He almost had an accident."}]},"n3-064#07c06a32b2bb":{"renderings":[{"id":"e796a4f45e87d317","role":"translation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"I was just about to get on the train, but the door closed."}]},"n3-064#26dffd548adf":{"renderings":[{"id":"6a71756dfa48ab5d","role":"translation","source":{"source":"hanabira","ref":"n3-064"},"match":"id","status":"imported","value":"I almost forgot my belongings."}]}}}