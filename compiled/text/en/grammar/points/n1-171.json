{"kind":"grammar","lang":"en","entities":{"n1-171":{"renderings":[{"id":"1942f920bda9ab1d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"Means 'it's impossible to...' or 'there's no way to...'."},{"id":"12c212569e820fef","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"This grammar point is used when you want to express that something is impossible or there is no way to do something. The verb before 'べくもない' should be in its dictionary form."},{"id":"c8ff27f14e1305d8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"Verb-dictionary form + べくもない"},{"id":"2c49bf7c810ca09f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-171"},"match":"id","status":"reviewed","value":"べくもない: there is no way to (知るべくもない)."},{"id":"6a9ffa925908f457","role":"label","field":"family","source":{"source":"gokan","ref":"unlikely-impossible"},"match":"id","status":"reviewed","value":"Unlikely / Impossible","of":{"kind":"family","id":"unlikely-impossible"}}]},"n1-171#c1312fd785a9":{"renderings":[{"id":"38e06400534fe8c4","role":"translation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"That problem is so difficult that it's impossible to solve."}]},"n1-171#3a7cf0dc63d5":{"renderings":[{"id":"7542b634af10028f","role":"translation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"She runs so fast that there's no way to catch up."}]},"n1-171#0e7eddb47fcf":{"renderings":[{"id":"949b63d9545b6eb9","role":"translation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"I forgot my writing utensils for the test. It's impossible to write."}]},"n1-171#fc4d49999730":{"renderings":[{"id":"a9f13c85e4f99fe8","role":"translation","source":{"source":"hanabira","ref":"n1-171"},"match":"id","status":"imported","value":"He jumps so high that there's no way to surpass him."}]}}}