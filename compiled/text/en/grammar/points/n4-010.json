{"kind":"grammar","lang":"en","entities":{"n4-010":{"renderings":[{"id":"531f3250ff2adad9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"Used to express purpose or reason; 'for', 'for the sake of', 'in order to'."},{"id":"0fffc3bd2d45d64d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"The のために grammar point is used to express the purpose or reason for doing something, or for the benefit of someone or something. It can be translated as 'for', 'for the sake of', or 'in order to' in English. The formation is straightforward, simply place のために after a noun."},{"id":"73892b48bc99fb77","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"Noun + のために"},{"id":"3a2033852ae1da44","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-010"},"match":"id","status":"reviewed","value":"Neutral, common purpose marker - \"for the sake of/in order to\"; safe in most contexts."},{"id":"45dc062868902f1c","role":"label","field":"family","source":{"source":"gokan","ref":"purpose"},"match":"id","status":"reviewed","value":"Purpose (In Order To / So That)","of":{"kind":"family","id":"purpose"}}]},"n4-010#82e931d3ed09":{"renderings":[{"id":"13b006591e5a548b","role":"translation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"In order to study, I am looking for a quiet place in the library."}]},"n4-010#5949fe7273fe":{"renderings":[{"id":"1682be2e3c98039c","role":"translation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"He works hard for the sake of his family."}]},"n4-010#998b1cf082f4":{"renderings":[{"id":"e3cf8894415ce3d5","role":"translation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"I exercise every day for the sake of my health."}]},"n4-010#26087fa3491a":{"renderings":[{"id":"2e0da4438985f734","role":"translation","source":{"source":"hanabira","ref":"n4-010"},"match":"id","status":"imported","value":"Let's all cooperate for the sake of world peace."}]}}}