{"kind":"grammar","lang":"en","entities":{"n1-061":{"renderings":[{"id":"a61a434f105544de","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"This expresses the idea of 'not only...but also', 'not stopping at...'."},{"id":"c2e6bf508513db20","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"This grammar point is used to express that something is not limited to just one thing (the thing before にとどまらず), but also includes other things (the thing after も). It can be translated as 'not only... but also...' or 'not stopping at...'."},{"id":"523d2a1fed9a50d1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"Noun + にとどまらず + Noun + も"},{"id":"8eb51a854630a0e4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-061"},"match":"id","status":"reviewed","value":"Formal, literary \"not stopping at X, also Y\"."},{"id":"6bbaf03992aa7e5f","role":"label","field":"family","source":{"source":"gokan","ref":"not-only-but-also"},"match":"id","status":"reviewed","value":"Not Only But Also (Emphatic Addition)","of":{"kind":"family","id":"not-only-but-also"}}]},"n1-061#7c4756c0e886":{"renderings":[{"id":"a96583a79916e100","role":"translation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"This app not only supports Japanese, but also other languages."}]},"n1-061#e387fec97d54":{"renderings":[{"id":"6fd7a80ef68b1133","role":"translation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"He is not only interested in music, but also in filmmaking."}]},"n1-061#7953df0ddfcf":{"renderings":[{"id":"4b95f9a3fde4c491","role":"translation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"His influence extends not only to his family but also to the entire region."}]},"n1-061#5ad19b89fec0":{"renderings":[{"id":"5886b20f3eb077a2","role":"translation","source":{"source":"hanabira","ref":"n1-061"},"match":"id","status":"imported","value":"Her talent extends not only to painting, but also to literature."}]}}}