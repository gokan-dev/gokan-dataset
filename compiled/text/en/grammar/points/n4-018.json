{"kind":"grammar","lang":"en","entities":{"n4-018":{"renderings":[{"id":"39dae56313b2b0e3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"To receive or get something from someone; 'to receive', 'to get'."},{"id":"80589fbbc1dde101","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"The もらう (morau) grammar point is used to express the action of receiving or getting something from someone. It usually emphasizes that the action was done for you or you were the beneficiary of the action. The formation requires a noun followed by the particle を (wo) before 'もらう'."},{"id":"bf5ffe8d38a8412b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"Noun + を + もらう"},{"id":"8599003044b394b2","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-018"},"match":"id","status":"reviewed","value":"Neutral, plain-form counterpart of もらいます - the everyday \"receive/get\"."},{"id":"ac234185b47edc8a","role":"label","field":"family","source":{"source":"gokan","ref":"receiving"},"match":"id","status":"reviewed","value":"Receiving (Benefactive Register)","of":{"kind":"family","id":"receiving"}}]},"n4-018#b72945c7383d":{"renderings":[{"id":"ba7eabd746b9860e","role":"translation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"I received a gift from my friend."}]},"n4-018#3c374f0df1a7":{"renderings":[{"id":"29ac44d507c8dea6","role":"translation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"I got advice from my teacher."}]},"n4-018#c5c69e61d22b":{"renderings":[{"id":"4e6abb2751d59415","role":"translation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"To receive an allowance from one's father."}]},"n4-018#75f2fde7226c":{"renderings":[{"id":"cc0928322bfeef2e","role":"translation","source":{"source":"hanabira","ref":"n4-018"},"match":"id","status":"imported","value":"I got a letter from her."}]}}}