{"kind":"grammar","lang":"en","entities":{"n3-071":{"renderings":[{"id":"b434da903500f0e0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"Express a condition; 'if... not', 'unless', 'must'."},{"id":"4f1dd9e00d35bd35","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"The ～ないと grammar point is used to express a condition, focusing on the negative consequences if the action is not performed. It can be translated as 'if... not', 'unless', or 'must' in English. The formation is simply attaching ないと to the negative form of a verb."},{"id":"e3e76123aa51f157","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"Verb-negative form + ないと"},{"id":"2dd2a6a9201f9817","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-071"},"match":"id","status":"reviewed","value":"Casual 'I have to', the rest (いけない) left off (もう行かないと)."},{"id":"9a9ffc62f2cd4f3f","role":"label","field":"family","source":{"source":"gokan","ref":"obligation"},"match":"id","status":"reviewed","value":"Obligation (Must / Have to)","of":{"kind":"family","id":"obligation"}}]},"n3-071#22ca1c7f22c5":{"renderings":[{"id":"37f4b8778ddb89c9","role":"translation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"If I don't eat breakfast, I will be hungry."}]},"n3-071#ed27821dd59c":{"renderings":[{"id":"24107acd739f369d","role":"translation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"If I don't do my homework, the teacher will be angry."}]},"n3-071#2a725c65cdee":{"renderings":[{"id":"8f6e9dce4398e404","role":"translation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"If I don't charge it, I won't be able to use the phone."}]},"n3-071#7ce27179f325":{"renderings":[{"id":"eddcc93c3744e77f","role":"translation","source":{"source":"hanabira","ref":"n3-071"},"match":"id","status":"imported","value":"If I don't report this accident, the problem will become bigger."}]}}}