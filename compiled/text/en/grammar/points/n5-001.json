{"kind":"grammar","lang":"en","entities":{"n5-001":{"renderings":[{"id":"e651c2fb76cedbc1","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"Express the superlative degree; 'the most', 'the best', 'the least'."},{"id":"ba032d6047955d4a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"The A が いちばん～ grammar point is used to express a superlative degree or the highest rank. It can be translated as 'the most', 'the best', or 'the least' in English. The formation is used with various adjectives and verbs, and can also be used in comparison with other items or people."},{"id":"fbc42381d6d5aeaa","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"Noun + が + いちばん + Adjective/Verb"},{"id":"5cab4eccc8382fbb","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-001"},"match":"id","status":"reviewed","value":"'The most': among three or more, often after の中で or では (Aがいちばん好きです)."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n5-001#f5f2c8d0e880":{"renderings":[{"id":"42fc23c50948fed1","role":"translation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"Of all these, I like sushi the most."}]},"n5-001#6284ef8feb49":{"renderings":[{"id":"5d57dc7059a82d57","role":"translation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"She can swim the fastest in the class."}]},"n5-001#f33e5bf4b3d5":{"renderings":[{"id":"0b06573bef14fca4","role":"translation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"In this town, this park is the most beautiful."}]},"n5-001#91847a6db4d3":{"renderings":[{"id":"77258a876c9fc194","role":"translation","source":{"source":"hanabira","ref":"n5-001"},"match":"id","status":"imported","value":"Among all drinks, I like tea the most."}]}}}