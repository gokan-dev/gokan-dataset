{"kind":"grammar","lang":"en","entities":{"n1-188":{"renderings":[{"id":"d1757e425b1f16ad","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"Expresses the speaker's intention or plan; 'with the intention of', 'planning to'."},{"id":"e6bebec19d32ec0e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"The ～つもりで grammar point is used to express the speaker's intention or mindset when doing something. It can often be translated as 'with the intention of' or 'with the mindset that.'"},{"id":"8e6eb7cfafeab73a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"Verb-dictionary form + つもりで"},{"id":"db315c14d10909d7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-188"},"match":"id","status":"reviewed","value":"The standard \"intend to/plan to\", used adverbially before another clause."},{"id":"1f8c8930edf8789a","role":"label","field":"family","source":{"source":"gokan","ref":"intention"},"match":"id","status":"reviewed","value":"Intention (Plan To)","of":{"kind":"family","id":"intention"}}]},"n1-188#445036b1ecb4":{"renderings":[{"id":"79afe51a9a4f01e2","role":"translation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"I am studying Japanese with the intention of living in Japan."}]},"n1-188#cfe33e690fb3":{"renderings":[{"id":"8072db2e037daf1a","role":"translation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"He gambled with the intention of risking everything."}]},"n1-188#b268fdb720db":{"renderings":[{"id":"6375f6da56fa0061","role":"translation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"I will study hard with the intention of passing tomorrow’s test."}]},"n1-188#bad4d70a6eae":{"renderings":[{"id":"82e3c36f66db1b75","role":"translation","source":{"source":"hanabira","ref":"n1-188"},"match":"id","status":"imported","value":"He went to bed early with the intention of waking up early."}]}}}