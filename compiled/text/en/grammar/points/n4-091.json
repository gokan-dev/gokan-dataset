{"kind":"grammar","lang":"en","entities":{"n4-091":{"renderings":[{"id":"95b8dcb41caf20be","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"Express probability, likelihood or certainty; 'probably', 'maybe', 'I think'."},{"id":"6634893e9aef1416","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"The ～だろう grammar point is used to express probability, likelihood, or certainty about a situation or event. It can be translated as 'probably', 'maybe', or 'I think' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"11ee3a3110cae9ca","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"Verb-casual + だろう, い-Adjective (drop い) + だろう, な-Adjective + だろう, Noun + だろう"},{"id":"e2730c243cb9d056","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-091"},"match":"id","status":"reviewed","value":"Casual conjecture - \"probably\", the plain-form counterpart of でしょう."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n4-091#243ba5aa55cc":{"renderings":[{"id":"e17383d53c78dac2","role":"translation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"It will probably be sunny tomorrow."}]},"n4-091#2eceaa67043f":{"renderings":[{"id":"5edc78c5a7436e5f","role":"translation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"He is probably busy."}]},"n4-091#aa7eb596d3a1":{"renderings":[{"id":"5038bd2d034c55fe","role":"translation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"This book is probably interesting."}]},"n4-091#1aa73a815b1b":{"renderings":[{"id":"fdb2440f4889a757","role":"translation","source":{"source":"hanabira","ref":"n4-091"},"match":"id","status":"imported","value":"She is probably a teacher."}]}}}