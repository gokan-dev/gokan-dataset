{"kind":"grammar","lang":"en","entities":{"n5-128":{"renderings":[{"id":"dfff5be2efd7e5bc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"Expresses something as 'so-so', 'not bad', or 'average'."},{"id":"9038e05378367400","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"The expression まあまあ is used to describe something that is neither particularly good nor bad, but rather average or 'so-so'. It is a neutral term and can be used in various contexts when discussing quality, feelings, or situations."},{"id":"2a1347317e71f23a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"まあまあ (used as an adverb or short expression - not a strict grammatical construction)"}]},"n5-128#dd6f31766c53":{"renderings":[{"id":"ef3848c2551d6617","role":"translation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"His cooking skills are so-so."}]},"n5-128#c3d322437f8e":{"renderings":[{"id":"ec40672b94f0e29a","role":"translation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"The weather today is not bad, huh?"}]},"n5-128#1fce4a12ea7b":{"renderings":[{"id":"50b5770b76568d75","role":"translation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"That movie was somewhat interesting."}]},"n5-128#b21d1abe7c01":{"renderings":[{"id":"73117c880d01f860","role":"translation","source":{"source":"hanabira","ref":"n5-128"},"match":"id","status":"imported","value":"I think her singing is not bad."}]}}}