{"kind":"grammar","lang":"en","entities":{"n5-077":{"renderings":[{"id":"af44631bccd1d4cf","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"Used to connect two clauses; 'but', 'however', 'although'"},{"id":"c766867b6102d6c2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"The ～けど grammar point is used to connect two clauses, often to show a contrast or to introduce a different point of view. It can be translated as 'but', 'however', or 'although' in English. It's more casual than けれど or が."},{"id":"18dfeae89b00fa2e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"Verb-casual + けど / い-adjective + けど / な-adjective + だけど / Noun + だけど"},{"id":"7c2a9eb04daeb5e5","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-077"},"match":"id","status":"reviewed","value":"Casual, mid-sentence; the everyday spoken default among the \"but\" family."},{"id":"a13bf53f446f3f0d","role":"label","field":"family","source":{"source":"gokan","ref":"contradiction"},"match":"id","status":"reviewed","value":"Contradiction (But / However)","of":{"kind":"family","id":"contradiction"}}]},"n5-077#2c19781da3f1":{"renderings":[{"id":"72838a50575d8ed3","role":"translation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"I attended the class, but I still have to do my homework."}]},"n5-077#2827c8e131dd":{"renderings":[{"id":"80ee563c5dbede7f","role":"translation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"Yesterday was cold, but today is warm."}]},"n5-077#369113c8296b":{"renderings":[{"id":"20ea6674c7dc126f","role":"translation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"He is kind, but a little scary."}]},"n5-077#599900c75c2a":{"renderings":[{"id":"0b0da9ea58eae12c","role":"translation","source":{"source":"hanabira","ref":"n5-077"},"match":"id","status":"imported","value":"This looks delicious, but it is too expensive."}]}}}