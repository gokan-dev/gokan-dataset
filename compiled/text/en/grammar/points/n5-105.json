{"kind":"grammar","lang":"en","entities":{"n5-105":{"renderings":[{"id":"85e00ec4149ad1e7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"Express 'not anywhere' or 'nowhere' with a negative verb."},{"id":"f11eb2882c2d4091","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"The どこにも～ません grammar point is used to express that something doesn't exist, appear, or happen anywhere. It means 'not anywhere' or 'nowhere' when used with a negative verb. The formation is quite simple as you just need to add どこにも before the negative verb."},{"id":"00df0ed4517c79d7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"どこにも + Verb-negative"},{"id":"b10d7bd3945a90b8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-105"},"match":"id","status":"reviewed","value":"'Nowhere': どこにも + a negative verb (どこにも行きません). With an affirmative, どこでも."},{"id":"7fa850bc8a152d1f","role":"label","field":"family","source":{"source":"gokan","ref":"nowhere"},"match":"id","status":"reviewed","value":"Where (Somewhere / Anywhere / Nowhere)","of":{"kind":"family","id":"nowhere"}}]},"n5-105#83d7dc66e7ff":{"renderings":[{"id":"5b2808d0ef6cfa41","role":"translation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"The cat is not anywhere."}]},"n5-105#61cd1557c536":{"renderings":[{"id":"d869f321db1ac863","role":"translation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"I didn't put the money anywhere."}]},"n5-105#3d783471168c":{"renderings":[{"id":"7ee98ce7730bde2c","role":"translation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"There are no delicious ramen shops anywhere in this town."}]},"n5-105#cbaeadfab37b":{"renderings":[{"id":"a7f58553fe1392df","role":"translation","source":{"source":"hanabira","ref":"n5-105"},"match":"id","status":"imported","value":"Her name is not written anywhere."}]}}}