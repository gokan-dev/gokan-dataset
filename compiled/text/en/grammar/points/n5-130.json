{"kind":"grammar","lang":"en","entities":{"n5-130":{"renderings":[{"id":"e9240541417e695b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"Expresses that something has not happened or been done yet."},{"id":"c04cae51cbbcadf1","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"The まだ〜ないです grammar point is used to indicate that a certain action or event has not yet happened or been completed. It is used with the negative form of a verb (casual negative + です) and can be translated as 'not yet', 'still', or 'haven't' in English."},{"id":"6618dfe59eb4e865","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"まだ + Verb-negative + です"}]},"n5-130#ac3c96466a4d":{"renderings":[{"id":"4cd5b69c74d9dfed","role":"translation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"I haven't done my homework yet."}]},"n5-130#00ff35de608b":{"renderings":[{"id":"d680ac93172a29b1","role":"translation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"He hasn't come yet."}]},"n5-130#a0c1b9b009e3":{"renderings":[{"id":"35701c0f80e826e7","role":"translation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"The movie hasn't started yet."}]},"n5-130#04523ee4fcb4":{"renderings":[{"id":"699c9828a13a776e","role":"translation","source":{"source":"hanabira","ref":"n5-130"},"match":"id","status":"imported","value":"We haven't eaten dinner yet."}]}}}