{"kind":"grammar","lang":"en","entities":{"n2-001":{"renderings":[{"id":"11ce3294295f5cb3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"Indicates alternatives; 'A or B', 'either A or B'."},{"id":"f81064e01e8e9776","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"The あるいは grammar point is used to show alternatives or options, similar to 'A or B' or 'either A or B' in English. It highlights the possibility of more than one option in a situation. It can be used with verbs, adjectives, and nouns."},{"id":"ff39d1e67d8eec0a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"Phrase A + あるいは + Phrase B"},{"id":"d8781ba7b3ab09fa","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-001"},"match":"id","status":"reviewed","value":"Neutral, plain \"or\" - the everyday conjunction, not the literary A-とも-B-とも pattern."},{"id":"c0501e0b255eb50d","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-a-or-b"},"match":"id","status":"reviewed","value":"Regardless (Whether A Or B)","of":{"kind":"family","id":"regardless-a-or-b"}}]},"n2-001#da686b853839":{"renderings":[{"id":"d6fd50d8530e439b","role":"translation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"Today, I plan to either watch a movie or go shopping."}]},"n2-001#340a667e162d":{"renderings":[{"id":"f211276071d207ad","role":"translation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"She can speak either English or German."}]},"n2-001#3d91aa53c95b":{"renderings":[{"id":"fa20093cdf64d423","role":"translation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"We like to drink either coffee or tea."}]},"n2-001#b5cf1c32e10f":{"renderings":[{"id":"4e1fe0d415f7a1f8","role":"translation","source":{"source":"hanabira","ref":"n2-001"},"match":"id","status":"imported","value":"You can work as either a full-time employee or a contract employee in this job."}]}}}