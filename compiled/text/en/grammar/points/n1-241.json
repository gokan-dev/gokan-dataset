{"kind":"grammar","lang":"en","entities":{"n1-241":{"renderings":[{"id":"293bd373226ccd8a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"Expresses an extreme state, often negative; 'utterly', 'extremely', 'boundlessly'."},{"id":"89905f5ffd1750b3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"The ～極まりない grammar point indicates an extreme or utmost degree, most commonly with a negative nuance (e.g., 失礼極まりない, 危険極まりない). It can sometimes be used for positive contexts, but that usage is less common."},{"id":"d9f79c2f37d2a5ce","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"な-Adjective（語幹）+ 極まりない, い-Adjective（連用形）+ こと + 極まりない, Noun + の極まりない"},{"id":"8ec14934925b28bf","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-241"},"match":"id","status":"reviewed","value":"Formal, literary \"utterly/extremely\" - often for a negative extreme state."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n1-241#dad975bc2ff9":{"renderings":[{"id":"6ffbef2b62c5d0c9","role":"translation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"His rude attitude is utterly beyond words."}]},"n1-241#10fa3d3e996b":{"renderings":[{"id":"7d56b7337c129fd4","role":"translation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"That driving is extremely dangerous."}]},"n1-241#ee22977d7458":{"renderings":[{"id":"d48b45c4ebb889bf","role":"translation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"Her selfishness is utterly irrational."}]},"n1-241#044c51247891":{"renderings":[{"id":"332a773bca764de0","role":"translation","source":{"source":"hanabira","ref":"n1-241"},"match":"id","status":"imported","value":"The filthiness of this room is extremely unsanitary."}]}}}