{"kind":"grammar","lang":"en","entities":{"n4-095":{"renderings":[{"id":"1c8b44ab66ca9545","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"Expresses prohibition; 'must not', 'cannot'."},{"id":"8e4ae427442c7593","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"The ～てはいけない grammar point is used to express strict prohibition or something that must not be done. It can be translated as 'must not', 'cannot', or 'should not' in English. It is formed by adding て-form of a verb followed by はいけない."},{"id":"b234b785782259fa","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"Verb-て-form + はいけない"},{"id":"7ccf8fa7df78731f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-095"},"match":"id","status":"reviewed","value":"Everyday prohibition; common in daily instructions and rules (including for children) - less stiff than てはならない."},{"id":"52331782dd11468f","role":"label","field":"family","source":{"source":"gokan","ref":"prohibition"},"match":"id","status":"reviewed","value":"Permission And Prohibition (May / Must Not)","of":{"kind":"family","id":"prohibition"}}]},"n4-095#fe867729e371":{"renderings":[{"id":"00da2f451e1bd8bb","role":"translation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"You must not smoke in the park."}]},"n4-095#9b4ab69241bc":{"renderings":[{"id":"c39240087624040b","role":"translation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"You cannot take pictures here."}]},"n4-095#01a765bca3b3":{"renderings":[{"id":"40060705f2616540","role":"translation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"You must not speak loudly in the library."}]},"n4-095#4f7a564742a0":{"renderings":[{"id":"2981621aab1ed4e2","role":"translation","source":{"source":"hanabira","ref":"n4-095"},"match":"id","status":"imported","value":"You should not give up your seat to someone standing on the bus. (Note: Odd in actual social context, but valid grammar.)"}]}}}