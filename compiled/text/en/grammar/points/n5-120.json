{"kind":"grammar","lang":"en","entities":{"n5-120":{"renderings":[{"id":"3927f261d1ffef2e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"Asking the reason or cause; 'why', 'how come'."},{"id":"ae73f50eb900f528","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"The なんで grammar point is used to ask the reason or cause behind something. It can be translated as 'why' or 'how come' in English. It is a casual way of asking for an explanation, and it can be used with verbs, い-adjectives, な-adjectives, and nouns."},{"id":"7ce8ba7cf69007aa","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"なんで + [phrase or sentence]"},{"id":"835faaff06d7eeec","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-120"},"match":"id","status":"reviewed","value":"Casual 'why' (なんで遅れたの？). Same sound as なに + で, 'by what means', so context decides."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-120#7bcefe94b9aa":{"renderings":[{"id":"18ec388bf6936518","role":"translation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"Why were you late?"}]},"n5-120#71dea4643220":{"renderings":[{"id":"df4069139e21853e","role":"translation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"Why is this room so dirty?"}]},"n5-120#089c4bf1d5fa":{"renderings":[{"id":"764dab80d7574d61","role":"translation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"Why is she angry?"}]},"n5-120#ed17c0197678":{"renderings":[{"id":"b6e9cf61b7db894f","role":"translation","source":{"source":"hanabira","ref":"n5-120"},"match":"id","status":"imported","value":"Why is today a holiday?"}]}}}