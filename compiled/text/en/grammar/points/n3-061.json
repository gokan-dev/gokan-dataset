{"kind":"grammar","lang":"en","entities":{"n3-061":{"renderings":[{"id":"a9a23b1cc1b6a4f5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-061"},"match":"id","status":"imported","value":"Expresses that something is done 'as is', 'as stated', or 'as instructed'."},{"id":"c112178084c80199","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-061"},"match":"id","status":"imported","value":"The ～とおり grammar point is used to express that something is done exactly as stated, instructed, or shown. It is commonly used with verbs and nouns, and can be translated as 'just like', 'as per', or 'according to'."},{"id":"742ab57040058ca0","role":"prose","field":"formation","source":{"source":"gokan","ref":"n3-061"},"match":"id","status":"reviewed","value":"Verb-casual + とおり, Noun + のとおり"},{"id":"07d206d74b39f23c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-061"},"match":"id","status":"reviewed","value":"とおり(に): exactly as said or shown (言ったとおりにする)."},{"id":"3ce38c8d2bd06579","role":"label","field":"family","source":{"source":"gokan","ref":"according-to"},"match":"id","status":"reviewed","value":"According To (As Instructed)","of":{"kind":"family","id":"according-to"}}]},"n3-061#402a1d63963f":{"renderings":[{"id":"32ae961db2a4e2c4","role":"translation","source":{"source":"hanabira","ref":"n3-061"},"match":"id","status":"imported","value":"I did my homework exactly as the teacher said."}]},"n3-061#d87378d8c899":{"renderings":[{"id":"b9cf817544aabd42","role":"translation","source":{"source":"hanabira","ref":"n3-061"},"match":"id","status":"imported","value":"If you follow what's written on the map, you'll arrive at the station."}]},"n3-061#9710b7b23218":{"renderings":[{"id":"872c7c1003d1f5b2","role":"translation","source":{"source":"hanabira","ref":"n3-061"},"match":"id","status":"imported","value":"I baked the cake according to the recipe."}]},"n3-061#ad197ef2f780":{"renderings":[{"id":"cb982fe2d667ce37","role":"translation","source":{"source":"hanabira","ref":"n3-061"},"match":"id","status":"imported","value":"She arrived on time, just as she promised."}]}}}