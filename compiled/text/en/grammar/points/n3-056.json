{"kind":"grammar","lang":"en","entities":{"n3-056":{"renderings":[{"id":"d63cfd11656f3805","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"Used to provide an example or characteristic related to the topic; 'when it comes to', 'speaking of'."},{"id":"f85e224d56b39b75","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"The ～というと grammar point is used to indicate an example, characteristic, or association related to the topic being discussed. It can be translated as 'when it comes to', 'speaking of', or 'in terms of' in English."},{"id":"55fbea67a368508e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"Noun + というと"},{"id":"290626eb7529abe8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-056"},"match":"id","status":"reviewed","value":"\"Speaking of/when it comes to\" - introduces a related example or characteristic."},{"id":"ca66816e0e22c5d0","role":"label","field":"family","source":{"source":"gokan","ref":"speaking-of"},"match":"id","status":"reviewed","value":"Speaking Of (When It Comes To)","of":{"kind":"family","id":"speaking-of"}}]},"n3-056#69bf52034dc6":{"renderings":[{"id":"49cb5e20ec930a80","role":"translation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"When it comes to Japanese cuisine, sushi comes to mind."}]},"n3-056#aaed1a595535":{"renderings":[{"id":"ea268e6a6d80eb1e","role":"translation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"Speaking of Paris, I recall the Eiffel Tower."}]},"n3-056#8bc87420c39a":{"renderings":[{"id":"f178c5b9c6b9d725","role":"translation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"When it comes to summer vacation, I look forward to going to the beach."}]},"n3-056#c9ede2c697e9":{"renderings":[{"id":"efe15abad8b9ad1a","role":"translation","source":{"source":"hanabira","ref":"n3-056"},"match":"id","status":"imported","value":"Speaking of him, I think he's always energetic."}]}}}