{"kind":"grammar","lang":"en","entities":{"n1-075":{"renderings":[{"id":"af778d42a97676eb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-075"},"match":"id","status":"imported","value":"Depends on; up to"},{"id":"6be12424022a6b0c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-075"},"match":"id","status":"imported","value":"The のいかんだ(Noun no ikan da) grammar point is used to express that something depends on a particular situation or fact. It can be translated as 'Depends on' or 'up to' in English. The construction no ikan is usually used with nouns and naru verbs."},{"id":"6f16fc39f1316b02","role":"prose","field":"formation","source":{"source":"gokan","ref":"n1-075"},"match":"id","status":"reviewed","value":"Noun + のいかんだ, Noun + のいかんでは, Noun + のいかんで"},{"id":"4b01ee9d0f38edf9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-075"},"match":"id","status":"reviewed","value":"Noun のいかんだ: depends entirely on (結果のいかんだ)."},{"id":"9c243c5bc319e188","role":"label","field":"family","source":{"source":"gokan","ref":"depending-on"},"match":"id","status":"reviewed","value":"Depending On (Varies With)","of":{"kind":"family","id":"depending-on"}}]},"n1-075#6dcdacf08419":{"renderings":[{"id":"fd23e5190295f529","role":"translation","source":{"source":"hanabira","ref":"n1-075"},"match":"id","status":"imported","value":"Whether you repeat a year or not depends on the test results."}]},"n1-075#ceb893091fc6":{"renderings":[{"id":"0ea02b96d76455c5","role":"translation","source":{"source":"hanabira","ref":"n1-075"},"match":"id","status":"imported","value":"I'll cancel the picnic depending on the weather."}]},"n1-075#31d1a22d7c42":{"renderings":[{"id":"4a7c57c593bd4549","role":"translation","source":{"source":"hanabira","ref":"n1-075"},"match":"id","status":"imported","value":"Our next action depends on his response."}]}}}