{"kind":"grammar","lang":"en","entities":{"n1-237":{"renderings":[{"id":"b4d77db9487073e6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-237"},"match":"id","status":"imported","value":"Emphasizes the reason or purpose for an action; 'in order to', 'for the sake of'."},{"id":"ded698cf91c006ec","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-237"},"match":"id","status":"imported","value":"The ～んがために form is a formal/literary expression meaning 'in order to' or 'for the purpose of.' It attaches to the negative stem (ない-form minus ない) of the verb: e.g., する -> せん, 行く -> いかん, 保つ -> たもたん, etc."},{"id":"9812f9ada5de38e0","role":"prose","field":"formation","source":{"source":"gokan","ref":"n1-237"},"match":"id","status":"reviewed","value":"Verb-negative stem + んがために, Verb-negative stem + んがため"},{"id":"a6dc013871090b7d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-237"},"match":"id","status":"reviewed","value":"Very formal, emphatic literary \"for the sake of/in order to\"; found in formal writing, rare in speech."},{"id":"45dc062868902f1c","role":"label","field":"family","source":{"source":"gokan","ref":"purpose"},"match":"id","status":"reviewed","value":"Purpose (In Order To / So That)","of":{"kind":"family","id":"purpose"}}]},"n1-237#949dcac1a232":{"renderings":[{"id":"adc3053dfe9ab904","role":"translation","source":{"source":"hanabira","ref":"n1-237"},"match":"id","status":"imported","value":"I exercise daily in order to maintain my health."}]},"n1-237#80966074a23d":{"renderings":[{"id":"f9ba779078fa593d","role":"translation","source":{"source":"hanabira","ref":"n1-237"},"match":"id","status":"imported","value":"I study hard in order to pass."}]},"n1-237#1b48410fbb28":{"renderings":[{"id":"234f172a6fb1af39","role":"translation","source":{"source":"hanabira","ref":"n1-237"},"match":"id","status":"imported","value":"I plan to go to bed early so I can prepare for tomorrow’s exam."}]},"n1-237#51531ee01008":{"renderings":[{"id":"d12d8ae8d86bf599","role":"translation","source":{"source":"hanabira","ref":"n1-237"},"match":"id","status":"imported","value":"I go to see her every day in order to see her smile."}]}}}