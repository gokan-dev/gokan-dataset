{"kind":"grammar","lang":"en","entities":{"n5-055":{"renderings":[{"id":"ea787a0b4cd44568","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"Used to make a polite suggestion or offer help; 'shall we', 'should we', 'do you want me to'."},{"id":"d7e5b9d3b78220b7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"The ましょうか grammar point is used to make a polite suggestion, propose an action, or offer help. It can be translated as 'shall we', 'should we', or 'do you want me to' in English. This formation is used with verbs in their ます-form, replacing ます with ましょう and adding か."},{"id":"0d56838f0dff977d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"Verb (ます-stem) + ましょうか"},{"id":"d8ceb951e5feb75e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-055"},"match":"id","status":"reviewed","value":"Neutral \"shall we.../shall I...\" - offers to do something together or for someone."},{"id":"9f9ca2025be456fc","role":"label","field":"family","source":{"source":"gokan","ref":"invitation"},"match":"id","status":"reviewed","value":"Invitation (Let's / Shall We)","of":{"kind":"family","id":"invitation"}}]},"n5-055#ec887bde8312":{"renderings":[{"id":"f1930b8b3e9cc708","role":"translation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"Shall we go see a movie together?"}]},"n5-055#1a6b8c601941":{"renderings":[{"id":"80a184d8698dfd80","role":"translation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"Should we have another cup of coffee?"}]},"n5-055#72006093a202":{"renderings":[{"id":"863789d835b343ce","role":"translation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"Do you want me to carry your luggage?"}]},"n5-055#aa13bd851eb8":{"renderings":[{"id":"7b0664e36224750e","role":"translation","source":{"source":"hanabira","ref":"n5-055"},"match":"id","status":"imported","value":"Shall I open the window?"}]}}}