{"kind":"grammar","lang":"en","entities":{"n2-052":{"renderings":[{"id":"399d05aa1019be45","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"Expresses that something is exceptional, unusual, or negative based on a particular aspect or point."},{"id":"00e93c05468cefe7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"The 〜からして grammar point is used when you want to make a conclusion or emphasize that something is exceptional (often negative or surprising) from a certain aspect or starting point. The part before からして serves as the base or clue for the judgment."},{"id":"7f9ea4c04b0d803a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"Noun + からして"},{"id":"db485b7d6f8c58f6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-052"},"match":"id","status":"reviewed","value":"からして: judging from even X alone (名前からして怪しい)."},{"id":"7a65fa95bf79f08b","role":"label","field":"family","source":{"source":"gokan","ref":"considering"},"match":"id","status":"reviewed","value":"Considering (Judging From)","of":{"kind":"family","id":"considering"}}]},"n2-052#960c9effa473":{"renderings":[{"id":"8adcb72ba8f0bf18","role":"translation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"From his facial expression, something bad must have happened."}]},"n2-052#748ac516b600":{"renderings":[{"id":"3db6387ce928f713","role":"translation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"Judging from the appearance of this dish, it doesn't look delicious."}]},"n2-052#c11ac96037c2":{"renderings":[{"id":"84800a240c40f5a8","role":"translation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"Considering her test scores, it will be difficult for her to pass."}]},"n2-052#cdcdbc1222df":{"renderings":[{"id":"631d474ec9646331","role":"translation","source":{"source":"hanabira","ref":"n2-052"},"match":"id","status":"imported","value":"Judging from the title of the movie, I think it's not interesting."}]}}}