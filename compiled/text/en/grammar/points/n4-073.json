{"kind":"grammar","lang":"en","entities":{"n4-073":{"renderings":[{"id":"e6c5e802f582726a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-073"},"match":"id","status":"imported","value":"To continue doing or to keep doing an action."},{"id":"44312a574eae662b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-073"},"match":"id","status":"imported","value":"The grammar point 続ける (tsuzukeru) is attached to the masu-stem form of verbs, and it indicates the ongoing continuity of an action. It can be translated as 'to continue doing' or 'to keep doing' in English."},{"id":"bd56451ae8c189b5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-073"},"match":"id","status":"imported","value":"Verb-masu-stem + 続ける"},{"id":"c0d06707c2d7056a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-073"},"match":"id","status":"reviewed","value":"ます stem + 続ける: keep doing (歩き続ける)."},{"id":"346651d354f1ea02","role":"label","field":"family","source":{"source":"gokan","ref":"aspect-verbs"},"match":"id","status":"reviewed","value":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","of":{"kind":"family","id":"aspect-verbs"}}]},"n4-073#462082216e5f":{"renderings":[{"id":"8939b2339ec1ce60","role":"translation","source":{"source":"gokan","ref":"n4-073"},"match":"id","status":"reviewed","value":"He kept running for two hours."}]},"n4-073#0687c605a8d0":{"renderings":[{"id":"6662b1248106b493","role":"translation","source":{"source":"gokan","ref":"n4-073"},"match":"id","status":"reviewed","value":"It has kept raining all day."}]},"n4-073#ccdbccf22046":{"renderings":[{"id":"be707f0b87347bab","role":"translation","source":{"source":"gokan","ref":"n4-073"},"match":"id","status":"reviewed","value":"I want to keep studying Japanese."}]},"n4-073#281141a1f4fe":{"renderings":[{"id":"ea270c67870a0c72","role":"translation","source":{"source":"gokan","ref":"n4-073"},"match":"id","status":"reviewed","value":"The baby kept crying until morning."}]}}}