{"kind":"grammar","lang":"en","entities":{"n5-107":{"renderings":[{"id":"77e72f013bd1a9d3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"Nowhere; Not to any place"},{"id":"ddf4c72079c71808","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"The grammar point どこへも is used to express the idea of 'nowhere' or 'not to any place'. It is combined with the negative form of a verb to indicate that the action does not happen to any place or destination."},{"id":"2d6f61e70c6711d8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"どこへも + Verb-negative"},{"id":"9fd965fe0cb81ca4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-107"},"match":"id","status":"reviewed","value":"Standard polite negative - \"not anywhere\". (どこへも variant, ません form.)"}]},"n5-107#83567d76fe62":{"renderings":[{"id":"f8590d5cb111d54b","role":"translation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"I won't go anywhere today."}]},"n5-107#8c0ab4b96880":{"renderings":[{"id":"e0b79d5c7b88c8f8","role":"translation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"He didn't run anywhere."}]},"n5-107#90710959030c":{"renderings":[{"id":"a8fec136ef90849f","role":"translation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"I didn't go shopping anywhere."}]},"n5-107#caf47f128d2e":{"renderings":[{"id":"128ed10778d69bce","role":"translation","source":{"source":"hanabira","ref":"n5-107"},"match":"id","status":"imported","value":"She won't take me anywhere."}]}}}