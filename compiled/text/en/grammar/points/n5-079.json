{"kind":"grammar","lang":"en","entities":{"n5-079":{"renderings":[{"id":"542257841204d95a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"Refers to a person, place or thing; 'this', 'this one', 'this way', 'here'."},{"id":"28a30328d568992d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"The こちら grammar point is used to refer to a person, place, or thing that is closer to the speaker, or to show politeness when referring to someone. It can mean 'this', 'this one', 'this way', or 'here'."},{"id":"b03ca812b775a73d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"こちら / こちら + の + Person/Thing"}]},"n5-079#e059706cee3d":{"renderings":[{"id":"da1251bfef56c09e","role":"translation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"This is Mr./Ms. Tanaka."}]},"n5-079#b15aec33464a":{"renderings":[{"id":"0692c85483283483","role":"translation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"This restaurant is delicious."}]},"n5-079#282fd7e89cc4":{"renderings":[{"id":"678b81e331d6fcce","role":"translation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"Please come this way."}]},"n5-079#09b64c0b50bc":{"renderings":[{"id":"1a949a17d2c0570d","role":"translation","source":{"source":"hanabira","ref":"n5-079"},"match":"id","status":"imported","value":"Is this one better, or is that one better?"}]}}}