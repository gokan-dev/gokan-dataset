{"kind":"grammar","lang":"en","entities":{"n2-048":{"renderings":[{"id":"2564f9cb765e40f2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"Express inability or impossibility of doing an action (often as a polite refusal)."},{"id":"097e360ceb0d4d89","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"The ～かねる grammar point is used to express that someone cannot do an action or that something is impossible to do. It typically has a nuance of reluctance or polite refusal and is formed by adding かねる to the ます-stem of the verb."},{"id":"f637cfc345aff1e9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"Verb-ます stem + かねる"},{"id":"76d69fc46002d219","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-048"},"match":"id","status":"reviewed","value":"ます stem + かねる: politely, 'I can't' (お答えしかねます)."},{"id":"6a9ffa925908f457","role":"label","field":"family","source":{"source":"gokan","ref":"unlikely-impossible"},"match":"id","status":"reviewed","value":"Unlikely / Impossible","of":{"kind":"family","id":"unlikely-impossible"}}]},"n2-048#883ac9cede31":{"renderings":[{"id":"c9606455b4f27508","role":"translation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"Since that problem is difficult, I cannot solve it."}]},"n2-048#3500f82a0620":{"renderings":[{"id":"9de603b20c56b7ef","role":"translation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"I cannot judge whether what he is saying is true or not."}]},"n2-048#1ccb056e2206":{"renderings":[{"id":"f23d0ad0e8471e11","role":"translation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"I cannot immediately know whether she will come or not."}]},"n2-048#7a7333f278de":{"renderings":[{"id":"c063200dce46eaac","role":"translation","source":{"source":"hanabira","ref":"n2-048"},"match":"id","status":"imported","value":"I cannot explain the details."}]}}}