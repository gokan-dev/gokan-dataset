{"kind":"grammar","lang":"en","entities":{"n5-028":{"renderings":[{"id":"0f908289e30500c8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"Expresses 'around' or 'about' a certain time or age."},{"id":"6941c484f4cef0be","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"The ごろ grammar point is used to indicate 'around' or 'about' a certain time or age. It is commonly used with time-related expressions and age-related expressions to give an approximate time or age."},{"id":"81c1cff67fff88aa","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"Noun + ごろ"},{"id":"1d90c918019cdf21","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-028"},"match":"id","status":"reviewed","value":"Same idea as くらい/ぐらい but specifically for a POINT IN TIME (\"around 3 o'clock\"), not a quantity - doesn't substitute for くらい/ぐらい on quantities."},{"id":"cfc4dfbd28a9df99","role":"label","field":"family","source":{"source":"gokan","ref":"approximation"},"match":"id","status":"reviewed","value":"Approximation (About / Approximately)","of":{"kind":"family","id":"approximation"}}]},"n5-028#945ac5ca62d6":{"renderings":[{"id":"4d2fbfa8b0022ca6","role":"translation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"Please call me around noon."}]},"n5-028#a879772c5788":{"renderings":[{"id":"628bfe9e9d857b56","role":"translation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"He came to Japan around the age of 10."}]},"n5-028#4a3b8f86389a":{"renderings":[{"id":"3931f48e71166f5b","role":"translation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"Let's meet around 3 PM."}]},"n5-028#80cbf9caf9d2":{"renderings":[{"id":"b25334c8c55c6945","role":"translation","source":{"source":"hanabira","ref":"n5-028"},"match":"id","status":"imported","value":"I returned home last night around 8 o'clock."}]}}}