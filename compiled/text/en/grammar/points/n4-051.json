{"kind":"grammar","lang":"en","entities":{"n4-051":{"renderings":[{"id":"0ff6096cf3c34578","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"To decide not to do something."},{"id":"96869da32eeb012f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"The grammar point Verb ない + ことにする is used to express the decision not to do something. This structure shows that the speaker has made a conscious choice to not take the action expressed in the verb."},{"id":"7d72e9881274efbe","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"Verb-ない form + ことにする"},{"id":"f101d36bcca90d6a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-051"},"match":"id","status":"reviewed","value":"'Decide not to' (食べないことにした): your own decision."},{"id":"bd97fcb92a4cb49c","role":"label","field":"family","source":{"source":"gokan","ref":"decisions"},"match":"id","status":"reviewed","value":"Decisions (Decide To / It Was Decided)","of":{"kind":"family","id":"decisions"}}]},"n4-051#4acdda16ecb5":{"renderings":[{"id":"bc72d1907cbcb9ac","role":"translation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"I've decided not to go to tomorrow's party."}]},"n4-051#b3de226c4b57":{"renderings":[{"id":"d64bbdbc4a3edfa5","role":"translation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"I've decided not to eat that cake."}]},"n4-051#7c8c538e2ada":{"renderings":[{"id":"8de9536c0b1bfd69","role":"translation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"I've decided not to go jogging today."}]},"n4-051#b1ccee306f5f":{"renderings":[{"id":"e7e1d4753f77f2c5","role":"translation","source":{"source":"hanabira","ref":"n4-051"},"match":"id","status":"imported","value":"I've decided not to meet him."}]}}}