{"kind":"grammar","lang":"en","entities":{"n4-054":{"renderings":[{"id":"8b2b1946a80b4839","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-054"},"match":"id","status":"imported","value":"Expresses 'while' or 'as' in the sense of doing two things simultaneously."},{"id":"23f39fa226297b33","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-054"},"match":"id","status":"imported","value":"The ～ながら grammar point is used to indicate that two actions are happening simultaneously or that one action is happening while another is taking place. This can be translated to 'while' or 'as' in English. It is primarily used with verbs."},{"id":"ed9dae5fbeca8300","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-054"},"match":"id","status":"imported","value":"Verb-masu stem + ながら"},{"id":"f966137d316d642e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-054"},"match":"id","status":"reviewed","value":"The everyday \"while doing X\" for two simultaneous actions."},{"id":"3731dbbca209525b","role":"label","field":"family","source":{"source":"gokan","ref":"simultaneous"},"match":"id","status":"reviewed","value":"Simultaneous (While Doing)","of":{"kind":"family","id":"simultaneous"}}]},"n4-054#59d6448ee480":{"renderings":[{"id":"a56855ffcb09b4f7","role":"translation","source":{"source":"hanabira","ref":"n4-054"},"match":"id","status":"imported","value":"I did my homework while watching television."}]},"n4-054#1404525ad930":{"renderings":[{"id":"cab30497a1a96729","role":"translation","source":{"source":"hanabira","ref":"n4-054"},"match":"id","status":"imported","value":"I cooked while listening to music."}]},"n4-054#553105cc6e05":{"renderings":[{"id":"4c6ac008ff219db1","role":"translation","source":{"source":"hanabira","ref":"n4-054"},"match":"id","status":"imported","value":"Looking at your smartphone while walking is dangerous."}]},"n4-054#6a55918203bd":{"renderings":[{"id":"e1