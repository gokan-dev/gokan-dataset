{"kind":"grammar","lang":"en","entities":{"n2-137":{"renderings":[{"id":"3045bb79fe10c07d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-137"},"match":"id","status":"imported","value":"Expresses 'not only... but also'; emphasizing the extent of something."},{"id":"f41a16ba5f8a22b6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-137"},"match":"id","status":"imported","value":"The ～ばかりか〜も grammar point is used to express the idea of 'not only... but also' in a sentence. It emphasizes the extent to which something applies, showing a certain component or factor is not the only relevant one."},{"id":"88bceff713f80334","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-137"},"match":"id","status":"imported","value":"Noun/Verb/Adjective + ばかりか + Noun/Verb/Adjective + も"},{"id":"cb69c9ab60842644","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-137"},"match":"id","status":"reviewed","value":"\"Not only... but even\" - emphasizes the second, often surprising, fact."},{"id":"6bbaf03992aa7e5f","role":"label","field":"family","source":{"source":"gokan","ref":"not-only-but-also"},"match":"id","status":"reviewed","value":"Not Only But Also (Emphatic Addition)","of":{"kind":"family","id":"not-only-but-also"}}]},"n2-137#45fc07ad92cc":{"renderings":[{"id":"8d7d5cc297e5084d","role":"translation","source":{"source":"hanabira","ref":"n2-137"},"match":"id","status":"imported","value":"He is not only cute but also smart."}]},"n2-137#516964ccbbd9":{"renderings":[{"id":"d8d2af593f30e79d","role":"translation","source":{"source":"hanabira","ref":"n2-137"},"match":"id","status":"imported","value":"This restaurant not only has great taste but also wonderful service."}]},"n2-137#349267c68653":{"renderings":[{"id":"3aee4c5ba49fbbb4","role":"translation","source":{"source":"hanabira","ref":"n2-137"},"match":"id","status":"imported","value":"He is not only good at singing but also dancing."}]}}}