{"kind":"grammar","lang":"en","entities":{"n2-141":{"renderings":[{"id":"fdc7e9d304cfbf54","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"Used to compare or contrast two elements; 'as for...'."},{"id":"47ce8d6522fbfe8b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"The grammar point ～はともかく～は is used to compare or contrast two elements in a sentence. It implies that the first element can be set aside or is less important compared to the second element. It often translates to 'putting A aside, B...'."},{"id":"af54a7fdf251ed3c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"Noun1 はともかく Noun2 は"},{"id":"fcd22c31d5a64c00","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-141"},"match":"id","status":"reviewed","value":"はともかく: X aside, Y is what matters (見た目はともかく)."},{"id":"276bd004f9ddd9b1","role":"label","field":"family","source":{"source":"gokan","ref":"one-thing-but-another"},"match":"id","status":"reviewed","value":"Setting Aside (X Aside / X Is One Thing, But)","of":{"kind":"family","id":"one-thing-but-another"}}]},"n2-141#469a1d663351":{"renderings":[{"id":"d1fdbfdc6a7c80f3","role":"translation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"As for design, the functionality of this phone is the best."}]},"n2-141#48458a79b34a":{"renderings":[{"id":"e34840f8382bc554","role":"translation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"Putting aside his looks, his personality is wonderful."}]},"n2-141#f860c8a58884":{"renderings":[{"id":"9ca7461c244f168c","role":"translation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"Putting aside the taste of the food, the presentation is beautiful."}]},"n2-141#bbb9fae5976e":{"renderings":[{"id":"87b24bff95970d2e","role":"translation","source":{"source":"hanabira","ref":"n2-141"},"match":"id","status":"imported","value":"Ignoring the price, this bag’s quality is good."}]}}}