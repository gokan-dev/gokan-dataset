{"kind":"grammar","lang":"en","entities":{"n5-058":{"renderings":[{"id":"6d62d3c199bb46e3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"Express the potential form, or the ability to do something."},{"id":"9d27a1a444707267","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"The 〜ることができます grammar point is used to express that someone is capable of doing something or that something is possible. It is essentially the potential form of the verb. The formation is made by changing the verb to a noun phrase with こと and then adding ができます."},{"id":"641094312a257849","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"Verb (dictionary form) + ことができます"}]},"n5-058#ff4cc01a1ffe":{"renderings":[{"id":"a83d4eff2fcb8620","role":"translation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"I can solve this problem."}]},"n5-058#2071848f0632":{"renderings":[{"id":"019f54666803ee1e","role":"translation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"He can speak English."}]},"n5-058#0deb2463209d":{"renderings":[{"id":"8cbafed471ea5e85","role":"translation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"I can't climb to high places."}]},"n5-058#4a6faf65c9c2":{"renderings":[{"id":"c3dd716544fe5882","role":"translation","source":{"source":"hanabira","ref":"n5-058"},"match":"id","status":"imported","value":"She can play the piano."}]}}}