{"kind":"grammar","lang":"en","entities":{"n3-068":{"renderings":[{"id":"5c51363a0e5451bd","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"Expresses the extent of something or emphasizes the degree of a condition or situation."},{"id":"905c55a8dc89fd89","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"The ～どんなに～ことか grammar point is used to emphasize the extent of a condition or circumstance, and to express how much or to what degree something is happening. It is often translated as 'how much', 'how greatly', or 'to what extent' in English. This pattern is usually used with an adjective or verb in a sentence."},{"id":"e90834356b89084b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"どんなに + Adjective + ことか, どんなに + Verb + ことか"},{"id":"3f999fa52d2d5e74","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-068"},"match":"id","status":"reviewed","value":"どんなに～ことか: how very (どんなに嬉しかったことか)."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n3-068#ce1464d861b2":{"renderings":[{"id":"3e0cfa3b2e2eae86","role":"translation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"I can't put into words how tired I am."}]},"n3-068#5560b8c958af":{"renderings":[{"id":"c664f677aa947a94","role":"translation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"How hard it must be, she works hard every day."}]},"n3-068#57b421c89bdc":{"renderings":[{"id":"0f3961996b8e831c","role":"translation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"How happy his success must be."}]},"n3-068#1e6f0d2a4a17":{"renderings":[{"id":"961bdc9e09a951b1","role":"translation","source":{"source":"hanabira","ref":"n3-068"},"match":"id","status":"imported","value":"How fun it is to go on a trip with everyone."}]}}}