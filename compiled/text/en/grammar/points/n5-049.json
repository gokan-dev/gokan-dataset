{"kind":"grammar","lang":"en","entities":{"n5-049":{"renderings":[{"id":"1f8e45d17a2ca595","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"A request or command; 'please do'."},{"id":"372c6a162f119ac9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"The て ください grammar point is used to make a request or command someone to do something politely. The verb is conjugated into its て-form and followed by ください, which means 'please'. This structure is used when asking someone to do something with a polite and respectful tone."},{"id":"4d44de582a298183","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"Verb-て form + ください"},{"id":"7da26002f5f996da","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-049"},"match":"id","status":"reviewed","value":"The standard 'please do' (見てください). Softer: てくださいませんか. Who acts is the difference: Verb-て + ください asks someone else to act (帰ってください, 'please go home'), Verb-causative + て + ください asks permission to act yourself (帰らせてください, 'please let me go home')."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n5-049#68840df2a1bc":{"renderings":[{"id":"9082abc2a381bb21","role":"translation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"Please open the door."}]},"n5-049#051f0cf96c34":{"renderings":[{"id":"6141280d2ce72684","role":"translation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"Please tell me your phone number."}]},"n5-049#d4c1530a0a9f":{"renderings":[{"id":"578b52542d81c2c3","role":"translation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"Please speak slowly."}]},"n5-049#b51d968964e6":{"renderings":[{"id":"3c461187ae2782d6","role":"translation","source":{"source":"hanabira","ref":"n5-049"},"match":"id","status":"imported","value":"Please bring me a coffee."}]},"n5-049#7cce18002412":{"renderings":[{"id":"c2029ae665498a19","role":"translation","source":{"source":"hanabira","ref":"n3-027"},"match":"id","status":"imported","value":"Please let me explain it once more."}]},"n5-049#19b4d01723e1":{"renderings":[{"id":"20109a159214904d","role":"translation","source":{"source":"hanabira","ref":"n3-027"},"match":"id","status":"imported","value":"Please let me go home."}]},"n5-049#c7d96eb820d0":{"renderings":[{"id":"c11f580971489527","role":"translation","source":{"source":"hanabira","ref":"n3-027"},"match":"id","status":"imported","value":"Please let me see that book."}]},"n5-049#3003ece14b92":{"renderings":[{"id":"cc3c0841b0b9f713","role":"translation","source":{"source":"hanabira","ref":"n3-027"},"match":"id","status":"imported","value":"Please let me wait here."}]}}}