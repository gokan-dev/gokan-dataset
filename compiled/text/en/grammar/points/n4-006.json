{"kind":"grammar","lang":"en","entities":{"n4-006":{"renderings":[{"id":"4e07b6dfdbc3e7fd","role":"label","field":"title","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"な-adjective に する/なる"},{"id":"a77a92a92ccc18ce","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"Used to indicate change or decision; 'to become' or 'to make' with na-adjectives."},{"id":"5eb0f0571a0c70fe","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"The な-adjective に する/なる grammar point is used to express a change or a decision related to a na-adjective. The なる (naru) form indicates a change that occurs by itself, while the する (suru) form indicates a conscious decision made by someone."},{"id":"6538ff9a777f2503","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"な-Adjective + に + する/なる"},{"id":"14890f0f3c195854","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-006"},"match":"id","status":"reviewed","value":"する: you make it so (きれいにする). なる: it became so (元気になる)."},{"id":"f48a13546b42cc1e","role":"label","field":"family","source":{"source":"gokan","ref":"change-of-state"},"match":"id","status":"reviewed","value":"Change (Become / Make / Decide On)","of":{"kind":"family","id":"change-of-state"}}]},"n4-006#36cecf4eba3a":{"renderings":[{"id":"8b4d92d112731ecc","role":"translation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"To make the room clean."}]},"n4-006#224a9af7a128":{"renderings":[{"id":"0298c296c2964477","role":"translation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"He became energetic."}]},"n4-006#4a6c12372814":{"renderings":[{"id":"8a4793d227911efd","role":"translation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"It is important to make it quiet every day."}]},"n4-006#9bbd8a2526a3":{"renderings":[{"id":"c923dc036cf26fdb","role":"translation","source":{"source":"hanabira","ref":"n4-006"},"match":"id","status":"imported","value":"I will try to make studying Japanese become enjoyable."}]}}}