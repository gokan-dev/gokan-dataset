{"kind":"grammar","lang":"en","entities":{"n1-067":{"renderings":[{"id":"21599e06673b7f45","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"The grammar point Noun に即して Verb is used to mean 'to act in accordance with', 'in line with' or 'based on'."},{"id":"ae993659227221c6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"The formation Noun に即して Verb is used when someone is doing something based on or in accordance with some norms, rules, decisions or principles. This structure is often used in business or official contexts."},{"id":"2ffbc0b2ab6fa337","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"Noun + に即して + Verb"},{"id":"4bea1986e2331a60","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-067"},"match":"id","status":"reviewed","value":"Formal, literary \"in accordance with/based on\". (Verb-attached form of n1-066's に即した.)"},{"id":"20db34780c641624","role":"label","field":"family","source":{"source":"gokan","ref":"based-on"},"match":"id","status":"reviewed","value":"Based On (In Accordance With)","of":{"kind":"family","id":"based-on"}}]},"n1-067#b7b9bda53787":{"renderings":[{"id":"7997fce640114858","role":"translation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"Let's act in accordance with the company's policy."}]},"n1-067#cbf8b0312c38":{"renderings":[{"id":"181c72e56739e356","role":"translation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"It's important to make judgments in accordance with the law."}]},"n1-067#812403d04924":{"renderings":[{"id":"04f25510036bb21f","role":"translation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"Based on his opinion, we changed the plan."}]},"n1-067#27c854a7fa6b":{"renderings":[{"id":"7a88939a248f2699","role":"translation","source":{"source":"hanabira","ref":"n1-067"},"match":"id","status":"imported","value":"If we act in accordance with the rules, there will be no problem."}]}}}