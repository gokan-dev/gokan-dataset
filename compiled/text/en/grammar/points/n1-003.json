{"kind":"grammar","lang":"en","entities":{"n1-003":{"renderings":[{"id":"cd5a9ca3c8500c37","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"Expresses 'while also', 'at the same time as'."},{"id":"75cc1be64294f433","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"The ～かたわら grammar point is used when someone is doing B while also doing A. It often implies that both tasks require considerable commitment or skill. It can be translated as 'while also' or 'at the same time as'."},{"id":"f3f491c85ac13c2d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"Verb-dictionary form + かたわら, Noun + のかたわら"},{"id":"7544e4af5d7c1339","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-003"},"match":"id","status":"reviewed","value":"かたわら: alongside a main occupation, also doing (仕事のかたわら)."},{"id":"3731dbbca209525b","role":"label","field":"family","source":{"source":"gokan","ref":"simultaneous"},"match":"id","status":"reviewed","value":"Simultaneous (While Doing)","of":{"kind":"family","id":"simultaneous"}}]},"n1-003#26e2e51b2238":{"renderings":[{"id":"5b804c2a3ec33f6a","role":"translation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"While working, he also attends university."}]},"n1-003#07ed78fa7240":{"renderings":[{"id":"552e99d00239a2da","role":"translation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"While being a student, I work part-time at a restaurant."}]},"n1-003#6953f5644217":{"renderings":[{"id":"d68fc6fab209472d","role":"translation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"While being a doctor, she paints as a hobby."}]},"n1-003#774124e25f6d":{"renderings":[{"id":"86cc829085e5c721","role":"translation","source":{"source":"hanabira","ref":"n1-003"},"match":"id","status":"imported","value":"While doing his job, he also actively participates in volunteer work."}]}}}