{"kind":"grammar","lang":"en","entities":{"n5-133":{"renderings":[{"id":"9896be615dcfd961","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"Express an action or event happening soon: 'soon', 'in a short while', 'almost'."},{"id":"9219407aa5c79f91","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"The もうすぐ grammar point is used to express that an action or event is going to happen soon or is almost happening. It can be translated as 'soon', 'in a short while', or 'almost' in English. もうすぐ is usually followed by a verb or a noun indicating an event."},{"id":"f054a503bc721cb2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"もうすぐ + Verb (~ます form or 〜る form)"},{"id":"377111869ea7d5b0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-133"},"match":"id","status":"reviewed","value":"'Soon': an event is coming up (もうすぐ夏休み)."},{"id":"99350681f510f5ba","role":"label","field":"family","source":{"source":"gokan","ref":"soon"},"match":"id","status":"reviewed","value":"Close In Time (Soon / Right Away / A Moment Ago)","of":{"kind":"family","id":"soon"}}]},"n5-133#5127313b44b8":{"renderings":[{"id":"7f5ff777a8ae42d9","role":"translation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"Spring is coming soon."}]},"n5-133#f7cff91d26ac":{"renderings":[{"id":"cd4920d7859849aa","role":"translation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"Her birthday is coming up soon."}]},"n5-133#ec2871105872":{"renderings":[{"id":"4c1815bd89e241d0","role":"translation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"The exam will be over soon."}]},"n5-133#352f90ef1b2b":{"renderings":[{"id":"ff13a20f9ab23eea","role":"translation","source":{"source":"hanabira","ref":"n5-133"},"match":"id","status":"imported","value":"The rain will likely stop soon."}]}}}