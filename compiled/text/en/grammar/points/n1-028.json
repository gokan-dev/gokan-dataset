{"kind":"grammar","lang":"en","entities":{"n1-028":{"renderings":[{"id":"8d3844670172c2da","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"Denotes 'entirely' or 'nothing but' the preceding noun."},{"id":"10f38b37abf50096","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"「Noun + ずくめ」expresses that something consists entirely of that noun or is 'nothing but' that noun. It describes a situation with a predominance of one thing."},{"id":"0eb2f6626f4f0836","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"Noun + ずくめ"},{"id":"a0f8ae8627ac4087","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-028"},"match":"id","status":"reviewed","value":"Formal, literary \"entirely covered in/nothing but X\" - describes a state entirely characterized by one quality (e.g. dressed all in black)."},{"id":"d4a432b40b291048","role":"label","field":"family","source":{"source":"gokan","ref":"totality"},"match":"id","status":"reviewed","value":"Totality (Entirely / Full Of / Covered In)","of":{"kind":"family","id":"totality"}}]},"n1-028#7786865a59d4":{"renderings":[{"id":"2a635cbe5062a68e","role":"translation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"He has had nothing but failures recently."}]},"n1-028#4aabb54054ed":{"renderings":[{"id":"e7464555c396982c","role":"translation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"This winter has been nothing but snow, which is tough."}]},"n1-028#3bbc25651d4a":{"renderings":[{"id":"424b6e4fb6e7ba5d","role":"translation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"His story was full of nothing but lies."}]},"n1-028#1058a865f788":{"renderings":[{"id":"20ecb88fc762c0db","role":"translation","source":{"source":"hanabira","ref":"n1-028"},"match":"id","status":"imported","value":"Today's work was nothing but constant busyness."}]}}}