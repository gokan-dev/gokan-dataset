{"kind":"grammar","lang":"en","entities":{"n1-085":{"renderings":[{"id":"244e30010284419b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-085"},"match":"id","status":"imported","value":"Expresses 'the height of', 'the extreme of' something."},{"id":"3340811099dc655e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-085"},"match":"id","status":"imported","value":"The 'Nounの至り' grammar point is used to emphasize an extreme or the highest level of something, often an emotional state or an honor. Common nouns include 光栄, 若気, 感激, 恥, etc."},{"id":"b5211dab4f0dc0e3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-085"},"match":"id","status":"imported","value":"Noun + の至り"},{"id":"a418c8dc3882adf4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-085"},"match":"id","status":"reviewed","value":"Noun の至り: the utmost, in set phrases (光栄の至り)."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n1-085#103334ed0fe8":{"renderings":[{"id":"b7a21ab974d7e53d","role":"translation","source":{"source":"hanabira","ref":"n1-085"},"match":"id","status":"imported","value":"His jokes are the height of surprise."}]},"n1-085#b4cf2207a2e2":{"renderings":[{"id":"74b015d391d55778","role":"translation","source":{"source":"hanabira","ref":"n1-085"},"match":"id","status":"imported","value":"It is the height of honor that my father became the project leader."}]},"n1-085#a2271280783e":{"renderings":[{"id":"a6652af1899f5f1d","role":"translation","source":{"source":"hanabira","ref":"n1-085"},"match":"id","status":"imported","value":"Her wonderful performance was the height of emotion."}]},"n1-085#4080f88f38ca":{"renderings":[{"id":"f5ffd1753bc37b97","role":"translation","source":{"source":"hanabira","ref":"n1-085"},"mat