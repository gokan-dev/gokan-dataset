{"kind":"grammar","lang":"en","entities":{"n4-014":{"renderings":[{"id":"0c5d7ec7504c2937","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"To receive or accept something politely; 'to receive', 'to get', 'to accept'."},{"id":"34228757e5131ead","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"The Nounをいただく grammar point is used to express the action of receiving or accepting something in a polite or humble manner. The verb 'いただく' is a more respectful version of the verb 'もらう' (to receive), so using 'いただく' shows humility and respect towards the person who is giving you something."},{"id":"c241869bcaa2ef3f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"Noun + を + いただく"},{"id":"fa09e68dd2f24937","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-014"},"match":"id","status":"reviewed","value":"Humble/polite - lowers the speaker relative to the giver; used with someone of higher status."},{"id":"ac234185b47edc8a","role":"label","field":"family","source":{"source":"gokan","ref":"receiving"},"match":"id","status":"reviewed","value":"Receiving (Benefactive Register)","of":{"kind":"family","id":"receiving"}}]},"n4-014#80c0fe3a7c59":{"renderings":[{"id":"3184a865b5056d48","role":"translation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"Thank you for the gift that I received."}]},"n4-014#5b3afb8b5ec4":{"renderings":[{"id":"92d6899e57b76b9e","role":"translation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"I received advice from my teacher."}]},"n4-014#f859b4a5f7d9":{"renderings":[{"id":"973c253969eb3b2a","role":"translation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"May I have this coffee?"}]},"n4-014#7af1f9d8aed5":{"renderings":[{"id":"60c647592066b70c","role":"translation","source":{"source":"hanabira","ref":"n4-014"},"match":"id","status":"imported","value":"I received a promotion notification from my boss at the company."}]}}}