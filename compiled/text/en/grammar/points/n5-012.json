{"kind":"grammar","lang":"en","entities":{"n5-012":{"renderings":[{"id":"202bee6a9cd604b9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-012"},"match":"id","status":"imported","value":"Express a comparison between A and B; 'A is more/less than B'."},{"id":"351f6e247a31da7b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-012"},"match":"id","status":"imported","value":"The A は B より grammar point is used to express a comparison between two items or subjects (A and B). It can be translated as 'A is more/less than B' in English. This structure is followed by an adjective that describes the comparison."},{"id":"347136009aee7e30","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-012"},"match":"id","status":"imported","value":"A は B より + Adjective"},{"id":"3f8af77d6100fbb8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-012"},"match":"id","status":"reviewed","value":"'A is more ~ than B': より marks the thing A is measured against."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n5-012#37ea68b48940":{"renderings":[{"id":"2ab22450e4af031d","role":"translation","source":{"source":"hanabira","ref":"n5-012"},"match":"id","status":"imported","value":"This juice is sweeter than that juice."}]},"n5-012#333acc4f2adb":{"renderings":[{"id":"fa82cad227e52948","role":"translation","source":{"source":"hanabira","ref":"n5-012"},"match":"id","status":"imported","value":"Summer is hotter than winter."}]},"n5-012#889188194552":{"renderings":[{"id":"478f1683ec52d729","role":"translation","source":{"source":"hanabira","ref":"n5-012"},"match":"id","status":"imported","value":"She runs faster than me."}]},"n5-012#4b01749cf4cc":{"renderings":[{"id":"ad59419483f2e11f","role":"translation","source