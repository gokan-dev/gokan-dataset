{"kind":"grammar","lang":"en","entities":{"n5-109":{"renderings":[{"id":"22f41276fe8ef08b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"Express that 'nowhere' meets the verb action; 'nowhere does/can'."},{"id":"e980bc4c40f70100","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"The どこも + Verb ません grammar point is used to express that nowhere does or can fulfill the verb action. It is a negative statement and can be translated as 'nowhere (+ verb)' in English. Note that the first example below uses an adjective rather than a verb, which still conveys 'nowhere is ...'."},{"id":"d2735750707b57a9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"どこも + Verb-ます form + ません"},{"id":"b99689028fae0314","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-109"},"match":"id","status":"reviewed","value":"Standard polite negative - \"not anywhere\". (どこも variant of n5-105's どこにも - functionally identical.)"}]},"n5-109#555f45552f35":{"renderings":[{"id":"c1c056ee126199c8","role":"translation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"Nowhere is quiet."}]},"n5-109#07623acfaaeb":{"renderings":[{"id":"ca5519a546b167c9","role":"translation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"Nowhere sells that book."}]},"n5-109#de0e32c16ac0":{"renderings":[{"id":"c24795cc1c825f81","role":"translation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"In this area, nowhere can connect to the internet."}]},"n5-109#429f3db5b7f4":{"renderings":[{"id":"b803bc7976a7f0ac","role":"translation","source":{"source":"hanabira","ref":"n5-109"},"match":"id","status":"imported","value":"No place knows him."}]}}}