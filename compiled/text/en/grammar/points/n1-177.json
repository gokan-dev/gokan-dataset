{"kind":"grammar","lang":"en","entities":{"n1-177":{"renderings":[{"id":"497a510c76f48f01","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-177"},"match":"id","status":"imported","value":"Expresses uncertainty regarding duration; 'don't know when... will end'."},{"id":"87bf037c1c241440","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-177"},"match":"id","status":"imported","value":"The いつまで～のやら grammar point is used to express uncertainty about when something will end or finish. It is often used in situations where the speaker is unsure about when a particular state of affairs or event will conclude."},{"id":"af16825b52d4a592","role":"prose","field":"formation","source":{"source":"gokan","ref":"n1-177"},"match":"id","status":"reviewed","value":"いつまで + Verb (dictionary form) + のやら, いつ + Verb (dictionary form) + のやら"},{"id":"165a21a3fe9beff9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-177"},"match":"id","status":"reviewed","value":"いつまで～のやら: who knows how long it will go on."},{"id":"2876ead5ce935ea6","role":"label","field":"family","source":{"source":"gokan","ref":"i-wonder"},"match":"id","status":"reviewed","value":"I Wonder (Musing Uncertainty)","of":{"kind":"family","id":"i-wonder"}}]},"n1-177#53e070461cd5":{"renderings":[{"id":"c17cd527dc2da96b","role":"translation","source":{"source":"hanabira","ref":"n1-177"},"match":"id","status":"imported","value":"I don't know when this exam study will end."}]},"n1-177#56c3cd5094fd":{"renderings":[{"id":"74f121e26a847e87","role":"translation","source":{"source":"hanabira","ref":"n1-177"},"match":"id","status":"imported","value":"I don't know when his talk will finish."}]},"n1-177#9d948e945951":{"renderings":[{"id":"d49d6a8f2a6e2cea","role":"translation","source":{"source":"hanabira","ref":"n1-177"},"match":"id","status":"imported","value":"I don't know when this rain will stop."}]},"n1-177#93582cbc2e79":{"renderings":[{"id":"ba0365c0576fc531","role":"translation","source":{"source":"hanabira","ref":"n1-177"},"match":"id","status":"imported","value":"I don't know when this coronavirus pandemic will end."}]}}}