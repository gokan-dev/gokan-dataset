{"kind":"grammar","lang":"en","entities":{"n5-009":{"renderings":[{"id":"3113c51b4f742765","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-009"},"match":"id","status":"imported","value":"Used to ask which of two alternatives is preferred or to compare two things"},{"id":"f930894ca44b9cbc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-009"},"match":"id","status":"imported","value":"The grammar pattern Aと Bと どちら～ is used to compare two alternatives A and B, and ask which one is preferred, better, or more suitable. It can be used with verbs, adjectives, or nouns."},{"id":"b5fefae5282cec27","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-009"},"match":"id","status":"imported","value":"Aと Bと どちら + Verb/Adjective/Noun"},{"id":"54bb1da4393a7db2","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-009"},"match":"id","status":"reviewed","value":"Asks which of two (AとBとどちらが～ですか). Casual: どっち."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n5-009#8ad2ade0d3bb":{"renderings":[{"id":"561e1020ef28d389","role":"translation","source":{"source":"hanabira","ref":"n5-009"},"match":"id","status":"imported","value":"Which do you like, apples or oranges?"}]},"n5-009#4b0d8ef001a0":{"renderings":[{"id":"2999c2779b694210","role":"translation","source":{"source":"hanabira","ref":"n5-009"},"match":"id","status":"imported","value":"Should I go by train or bus?"}]},"n5-009#c3c47872edca":{"renderings":[{"id":"89d24c9e92bfe524","role":"translation","source":{"source":"hanabira","ref":"n5-009"},"match":"id","status":"imported","value":"Which do you think suits me better, the red dress or the blue dress?"}]},"n5-009#05496271c4ca":{"renderings":[{"id":"3977217ac00f406d","role":"translation","source":