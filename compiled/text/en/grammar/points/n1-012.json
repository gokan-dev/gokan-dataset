{"kind":"grammar","lang":"en","entities":{"n1-012":{"renderings":[{"id":"91f8ecda85ca5f06","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"Used when the speaker is unsure or confused between multiple possibilities."},{"id":"a5177a0470176535","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"The A のやら B のやら grammar expresses the speaker's confusion or inability to decide between possibility A and B. It can be translated roughly as 'whether it's A or B (I don't know).'"},{"id":"acd9f67f57e7c02b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"Noun1 + のやら + Noun2 + のやら (also works with adjectives and verbs + のやら)"},{"id":"827e931ed49e9245","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-012"},"match":"id","status":"reviewed","value":"A のやら B のやら: can't tell whether A or B (嬉しいのやら悲しいのやら)."},{"id":"2876ead5ce935ea6","role":"label","field":"family","source":{"source":"gokan","ref":"i-wonder"},"match":"id","status":"reviewed","value":"I Wonder (Musing Uncertainty)","of":{"kind":"family","id":"i-wonder"}}]},"n1-012#2e7a49f2268d":{"renderings":[{"id":"ac51a384e28d952d","role":"translation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"I don't know whether he's angry or sad."}]},"n1-012#8d3a6f2c3a22":{"renderings":[{"id":"8823938abefcbd07","role":"translation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"I can’t help worrying whether my exam results are good or bad."}]},"n1-012#5ac19c2d12f5":{"renderings":[{"id":"b882be1d5f136d9e","role":"translation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"I don’t know whether she likes me or hates me."}]},"n1-012#ea9bea6b337b":{"renderings":[{"id":"004dfad75c106519","role":"translation","source":{"source":"hanabira","ref":"n1-012"},"match":"id","status":"imported","value":"It’s unclear whether he will really go or not."}]}}}