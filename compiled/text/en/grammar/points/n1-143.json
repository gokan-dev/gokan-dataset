{"kind":"grammar","lang":"en","entities":{"n1-143":{"renderings":[{"id":"ccfa35f6ba280080","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"Used to modify a noun with a negative verb form; 'a Noun without (Verb)'."},{"id":"4aaa48cdd11b3555","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"VerbのないNoun modifies a noun by describing the absence of the verb's action. It indicates 'a Noun where the action does not happen' or 'a Noun without that action.'"},{"id":"015b939aed58b0f6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"Verb in negative form + の + Noun"}]},"n1-143#8061b4b20805":{"renderings":[{"id":"7670870fb8e910aa","role":"translation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"A life without laughter is boring."}]},"n1-143#f53f085fafab":{"renderings":[{"id":"994d32dfce4af6b4","role":"translation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"People cannot live in a place without water."}]},"n1-143#1c8dd74e6295":{"renderings":[{"id":"40d6d0b92b110db7","role":"translation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"It's hard to imagine a world without words."}]},"n1-143#75a0d88ba097":{"renderings":[{"id":"2fb04692d4376748","role":"translation","source":{"source":"hanabira","ref":"n1-143"},"match":"id","status":"imported","value":"A marriage without love will not last."}]}}}