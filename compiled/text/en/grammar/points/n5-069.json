{"kind":"grammar","lang":"en","entities":{"n5-069":{"renderings":[{"id":"e8dce051e616dd29","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-069"},"match":"id","status":"imported","value":"Expressing 'always' or 'usually' in a sentence."},{"id":"0ee46db87c44d354","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-069"},"match":"id","status":"imported","value":"The grammar point いつも (itsumo) is used to express the meaning of 'always' or 'usually' when describing a habitual action or situation. It is often used with the present tense or past tense to show that something is done on a regular basis or has been happening consistently."},{"id":"6b9c01e5e7992847","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-069"},"match":"id","status":"imported","value":"いつも + Verb / Adjective / Noun"},{"id":"e3d9903995d844af","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-069"},"match":"id","status":"reviewed","value":"\"Always/usually\" - describes a habitual state or repeated occurrence."},{"id":"4ead59a8748796c7","role":"label","field":"family","source":{"source":"gokan","ref":"always"},"match":"id","status":"reviewed","value":"When (Always / Anytime / Someday)","of":{"kind":"family","id":"always"}}]},"n5-069#789177a6a68c":{"renderings":[{"id":"26aeb5f3b1c19ea4","role":"translation","source":{"source":"hanabira","ref":"n5-069"},"match":"id","status":"imported","value":"He is always late."}]},"n5-069#593d20430ef0":{"renderings":[{"id":"94f02f5aeb3cb9cd","role":"translation","source":{"source":"hanabira","ref":"n5-069"},"match":"id","status":"imported","value":"I always like gentle dogs."}]},"n5-069#fd753d5683fe":{"renderings":[{"id":"fabfb5b21614da87","role":"translation","source":{"source":"hanabira","ref":"n5-069"},"match":"id","status":"imported","value":"She always studies in a quiet place."}]},"n5-069#ac5ebf390746":{"renderings":[{"id":"598e6f720c9ebf87","role":"tran