{"kind":"grammar","lang":"en","entities":{"n2-087":{"renderings":[{"id":"b29b182d631e463a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"Used to show a strong assertion or emphasis on one’s opinion; 'isn't it?', 'aren't you?', 'right?'."},{"id":"8752d56b03f39929","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"The ～ではないか grammar point is used at the end of a sentence to make a rhetorical question or a strong, emphatic statement. It often translates as 'isn't it…?' 'aren't you…?' or 'wouldn’t you say…?'."},{"id":"89ad94e849d21e83","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"Noun + ではないか / い-Adjective + ではないか / な-Adjective + ではないか / Verb-casual + ではないか"},{"id":"5addf71dd5e7d45b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-087"},"match":"id","status":"reviewed","value":"ではないか: isn't it (obviously)?, asserting an opinion."},{"id":"4e531465b57070e7","role":"label","field":"family","source":{"source":"gokan","ref":"rhetorical"},"match":"id","status":"reviewed","value":"Rhetorical Assertion (Isn't It / What Else)","of":{"kind":"family","id":"rhetorical"}}]},"n2-087#7671e5a2cf5d":{"renderings":[{"id":"cb590dbd90003ff3","role":"translation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"Isn’t he an excellent student?"}]},"n2-087#012e4789db53":{"renderings":[{"id":"12a590903fd9ab86","role":"translation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"Isn’t this dish delicious?"}]},"n2-087#01ba2fecc701":{"renderings":[{"id":"5b7743e1981c8874","role":"translation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"Aren’t you her friend?"}]},"n2-087#1a665d75e432":{"renderings":[{"id":"8b3b5c6de474c112","role":"translation","source":{"source":"hanabira","ref":"n2-087"},"match":"id","status":"imported","value":"Tomorrow’s a day off, right?"}]}}}