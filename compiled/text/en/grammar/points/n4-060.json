{"kind":"grammar","lang":"en","entities":{"n4-060":{"renderings":[{"id":"6c65d672cfe968a7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"Make an effort to; try to; see to it that; ensure that."},{"id":"484ab7dee94cc6a0","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"The ようにする grammar point is used to express that someone is making an effort, trying, or seeing to it that something happens. It can be translated as 'make sure to', 'try to', or 'ensure that' in English. The formation is simple, involving a verb in the dictionary form followed by ようにする."},{"id":"be42d78cde8aef77","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"Verb-dictionary form + ようにする"},{"id":"4b153294aceadf15","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-060"},"match":"id","status":"reviewed","value":"ようにする: make an effort, see to it (毎日運動するようにする). Deliberate."},{"id":"7bb6071bba353496","role":"label","field":"family","source":{"source":"gokan","ref":"effort-change"},"match":"id","status":"reviewed","value":"Effort And Change (Try To / Come To)","of":{"kind":"family","id":"effort-change"}}]},"n4-060#b8154f532997":{"renderings":[{"id":"69170fe1771cee2f","role":"translation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"I try to exercise every day."}]},"n4-060#8a3da6a3cdbe":{"renderings":[{"id":"49e8c6b6487ade3f","role":"translation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"Please try to go to bed early."}]},"n4-060#e784bedc9583":{"renderings":[{"id":"15f6bb2e5bf2e0a9","role":"translation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"I will make sure to keep my promise."}]},"n4-060#825cd1120f77":{"renderings":[{"id":"e9b795db3971a17f","role":"translation","source":{"source":"hanabira","ref":"n4-060"},"match":"id","status":"imported","value":"I will try not to see him."}]}}}