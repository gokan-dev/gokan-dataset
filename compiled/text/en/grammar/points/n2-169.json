{"kind":"grammar","lang":"en","entities":{"n2-169":{"renderings":[{"id":"5df8cb28af9be806","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-169"},"match":"id","status":"imported","value":"Means 'regardless of' or 'irrespective of'."},{"id":"e8ce740f4fa741af","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-169"},"match":"id","status":"imported","value":"「～を問わず」 is used to express that something applies or is available without any distinction regarding the stated nouns/conditions. It means 'regardless of...' or 'irrespective of...'."},{"id":"912cc1bf42ff531f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-169"},"match":"id","status":"imported","value":"Noun + を問わず"},{"id":"731bea72b6426443","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-169"},"match":"id","status":"reviewed","value":"Formal \"regardless of/irrespective of\" - common in official contexts (e.g. job postings: \"regardless of experience\")."},{"id":"a50efe0caa0d07a3","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-of"},"match":"id","status":"reviewed","value":"Regardless Of (No Matter)","of":{"kind":"family","id":"regardless-of"}}]},"n2-169#6da7e3ada15e":{"renderings":[{"id":"a8a503575df79ed6","role":"translation","source":{"source":"hanabira","ref":"n2-169"},"match":"id","status":"imported","value":"This event is open to everyone, regardless of age."}]},"n2-169#a9fd151005dd":{"renderings":[{"id":"648aa8786fc5c377","role":"translation","source":{"source":"hanabira","ref":"n2-169"},"match":"id","status":"imported","value":"This supermarket is open every day, regardless of Sunday."}]},"n2-169#3d2756763d49":{"renderings":[{"id":"83f1d4c20e5f8ab2","role":"translation","source":{"source":"hanabira","ref":"n2-169"},"match":"id","status":"imported","value":"She takes a walk every morning, no matter the heat or cold."}]},"n2-169#eefc2de89d89":{"renderings":[{"id":"b80