{"kind":"grammar","lang":"en","entities":{"n5-059":{"renderings":[{"id":"d61cca7632506d21","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"Expresses the potential form; 'can', 'be able to', 'is possible'."},{"id":"ec5886162ff0fbd1","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"The る こと ができる grammar point is used to express the potential form of a verb, meaning the ability or possibility to do something. It can be translated as 'can', 'be able to', or 'is possible' in English. This grammar is often used with verbs ending in る, but can also apply to other verbs once they are in the dictionary form."},{"id":"5828158297f7944a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"Verb (dictionary form) + ことができる"},{"id":"4dc4dca00a97d4ce","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-059"},"match":"id","status":"reviewed","value":"The standard \"can/be able to\" construction."},{"id":"8f10599b8cd5e8b5","role":"label","field":"family","source":{"source":"gokan","ref":"ability"},"match":"id","status":"reviewed","value":"Ability (Can / Able To)","of":{"kind":"family","id":"ability"}}]},"n5-059#dfba78f74f4d":{"renderings":[{"id":"7b0f066e5b32c502","role":"translation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"Can you solve this problem?"}]},"n5-059#4b0c8af51dd3":{"renderings":[{"id":"30b50064f8686094","role":"translation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"He can swim."}]},"n5-059#515c7ca0c098":{"renderings":[{"id":"0353945cddd10928","role":"translation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"I'm very happy that I can go to Japan."}]},"n5-059#4a6faf65c9c2":{"renderings":[{"id":"4662b9baad666201","role":"translation","source":{"source":"hanabira","ref":"n5-059"},"match":"id","status":"imported","value":"She can play the piano."}]}}}