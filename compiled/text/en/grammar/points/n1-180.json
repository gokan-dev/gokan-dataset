{"kind":"grammar","lang":"en","entities":{"n1-180":{"renderings":[{"id":"118180cb8de6d201","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"Expresses the reason or cause; 'because', 'due to', 'as a result of'."},{"id":"f6a4d34dd966acbc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"The ～がゆえに grammar point is used to express a reason or cause, often in more formal writing or speech. It roughly corresponds to 'because (of)', 'due to', or 'as a result of' in English."},{"id":"6f3edccb6d930b60","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"Noun / Verb / Adjective + がゆえに"},{"id":"366e0eb7da052f59","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-180"},"match":"id","status":"reviewed","value":"Formal, literary/academic; emphasizes logical cause-and-effect. Rare in speech."},{"id":"d295acbaf3aeb59b","role":"label","field":"family","source":{"source":"gokan","ref":"causality"},"match":"id","status":"reviewed","value":"Causality (Because / Since / Due to)","of":{"kind":"family","id":"causality"}}]},"n1-180#3f565fba0ddc":{"renderings":[{"id":"26c2e6fcea7a662c","role":"translation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"Because of love, he forgave her."}]},"n1-180#edc8e681553e":{"renderings":[{"id":"60548a23506d5712","role":"translation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"Due to the sudden rain, the match was postponed."}]},"n1-180#bd2fc80b1648":{"renderings":[{"id":"8301b5f9f34c3ff1","role":"translation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"Because of his efforts, he achieved success."}]},"n1-180#7514bb6514e6":{"renderings":[{"id":"4df0be480ebfc1af","role":"translation","source":{"source":"hanabira","ref":"n1-180"},"match":"id","status":"imported","value":"Due to his death, his family was enveloped in deep sorrow."}]}}}