{"kind":"grammar","lang":"en","entities":{"n1-107":{"renderings":[{"id":"4923057e46bc1832","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"'Cannot help but do', or 'inevitable'"},{"id":"2432c190ecd461b8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"The 〜を禁じ得ない (wo kinjienai) grammar point is used to express a situation or emotion that is so strong it can't be helped or is inevitable. It is used with nouns to express an uncontrollable feeling or action."},{"id":"c7cbe7163adab4c9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"Noun + を禁じ得ない"},{"id":"2501727035f483a4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-107"},"match":"id","status":"reviewed","value":"Formal, literary \"cannot help feeling...\" - specifically for an emotional reaction one cannot suppress."},{"id":"dbed7af32644c939","role":"label","field":"family","source":{"source":"gokan","ref":"inevitable"},"match":"id","status":"reviewed","value":"Inevitable (Cannot Help But)","of":{"kind":"family","id":"inevitable"}}]},"n1-107#98a2b58998d4":{"renderings":[{"id":"afc6e94a1e97dfe2","role":"translation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"I can't help but be surprised at this result."}]},"n1-107#5495104b7d13":{"renderings":[{"id":"3132649f7be406c9","role":"translation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"Hearing that news, I can't help but feel the urge to celebrate his success."}]},"n1-107#a5d34d51c0bb":{"renderings":[{"id":"c62b9a36878a95ce","role":"translation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"I can't help but be moved by her beauty."}]},"n1-107#8372275d8492":{"renderings":[{"id":"6deaf4963648af3c","role":"translation","source":{"source":"hanabira","ref":"n1-107"},"match":"id","status":"imported","value":"Hearing his story, I can't help but laugh."}]}}}