{"kind":"grammar","lang":"en","entities":{"n5-104":{"renderings":[{"id":"f2db2e47f499d009","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"Express that an action cannot be performed anywhere or something cannot be found anywhere."},{"id":"3f5e87e76d85816b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"The grammar point どこにも + Verb + ないです is used to express that an action cannot be performed anywhere or something cannot be found anywhere. It is used with a negative verb conjugation (ない-form) and highlights the unavailability or impossibility of finding or doing something in any location."},{"id":"701f890bc05a92e3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"どこにも + Verb in ない-form + です"},{"id":"07bc72168430d5a7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-104"},"match":"id","status":"reviewed","value":"Standard polite negative - \"not anywhere\". (どこへも variant of n5-105's どこにも.)"}]},"n5-104#14ee489d4b10":{"renderings":[{"id":"80a14063b2662bde","role":"translation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"Umbrellas are not sold anywhere."}]},"n5-104#ac5b364d9443":{"renderings":[{"id":"c44472714f52408e","role":"translation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"He cannot be found anywhere."}]},"n5-104#b8db0bb1ecde":{"renderings":[{"id":"0f58a71e3082043f","role":"translation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"There is no place to study anywhere."}]},"n5-104#a6d1b9c29669":{"renderings":[{"id":"30549208e7661183","role":"translation","source":{"source":"hanabira","ref":"n5-104"},"match":"id","status":"imported","value":"There are no delicious vegan dishes anywhere."}]}}}