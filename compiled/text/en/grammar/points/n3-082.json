{"kind":"grammar","lang":"en","entities":{"n3-082":{"renderings":[{"id":"38f449b0a627f6e9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"Means 'according to', 'based on' or 'by'."},{"id":"9a94c29bfcd7e889","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"The ～によれば grammar point is used to express information, opinions or a judgement made based on a certain source. It can be translated as 'according to', 'based on', or 'by' in English. This grammar point is typically used with a noun that represents the source of information."},{"id":"e96c183b4c0df809","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"Noun + によれば"},{"id":"2a6a78702a43b5d3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-082"},"match":"id","status":"reviewed","value":"The everyday way to cite a source - \"according to...\"."},{"id":"20db34780c641624","role":"label","field":"family","source":{"source":"gokan","ref":"based-on"},"match":"id","status":"reviewed","value":"Based On (In Accordance With)","of":{"kind":"family","id":"based-on"}}]},"n3-082#8a602d2afbea":{"renderings":[{"id":"04f5512425b3c0c9","role":"translation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"According to the weather forecast, it will be sunny tomorrow."}]},"n3-082#b39a7cb26bfc":{"renderings":[{"id":"f8d3a8a0c7f5f693","role":"translation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"According to the teacher, this problem seems to be easy."}]},"n3-082#e98138dcfa3f":{"renderings":[{"id":"9cc6d5d46ceb29da","role":"translation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"According to the survey, the smoking rate among young people is decreasing."}]},"n3-082#20004c4aa746":{"renderings":[{"id":"2c8d4dc5f3a16b15","role":"translation","source":{"source":"hanabira","ref":"n3-082"},"match":"id","status":"imported","value":"According to the newspaper article, the company appears to be on the verge of bankruptcy."}]}}}