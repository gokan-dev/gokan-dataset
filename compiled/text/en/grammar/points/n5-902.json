{"kind":"grammar","lang":"en","entities":{"n5-902":{"renderings":[{"id":"b6ac1090020822c9","role":"label","field":"name","source":{"source":"gokan","ref":"n5-902"},"match":"id","status":"reviewed","value":"Polite past"},{"id":"212efad741133bdb","role":"prose","field":"shortExplanation","source":{"source":"gokan","ref":"n5-902"},"match":"id","status":"reviewed","value":"The polite past tense: 書きました, 食べました."},{"id":"79101ac99cefad63","role":"prose","field":"longExplanation","source":{"source":"gokan","ref":"n5-902"},"match":"id","status":"reviewed","value":"ました is the past of ます, formed on the same ます-stem. It states that a polite, completed action happened."},{"id":"eb5093cc469a876e","role":"prose","field":"formation","source":{"source":"gokan","ref":"n5-902"},"match":"id","status":"reviewed","value":"Verb (ます-stem) + ました."},{"id":"18ae48409ec13bae","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-902"},"match":"id","status":"reviewed","value":"polite past (ました)"}]}}}