{"kind":"grammar","lang":"en","entities":{"n3-035":{"renderings":[{"id":"4b450c23a5337b37","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-035"},"match":"id","status":"imported","value":"Express a condition with 'even if'; 'no matter how'."},{"id":"f9cc2013c7ca773f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-035"},"match":"id","status":"imported","value":"The ～たとえ～ても grammar point is used to express a hypothetical or conditional situation where the outcome remains the same even if the condition is met. It can be translated as 'even if' or 'no matter how' in English."},{"id":"0240613c8d060b28","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-035"},"match":"id","status":"imported","value":"たとえ + Verb-casual + ても, たとえ + い-Adjective + くても, たとえ + な-Adjective + であっても, たとえ + Noun + であっても"},{"id":"57847b41a8b59d57","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-035"},"match":"id","status":"reviewed","value":"The standard \"even if\" - pairs たとえ with ても for emphasis."},{"id":"a3d1d81bf546c33e","role":"label","field":"family","source":{"source":"gokan","ref":"even-if"},"match":"id","status":"reviewed","value":"Even If (Hypothetical Concession)","of":{"kind":"family","id":"even-if"}}]},"n3-035#d8905d0556f7":{"renderings":[{"id":"49dc8d4b35998e9b","role":"translation","source":{"source":"hanabira","ref":"n3-035"},"match":"id","status":"imported","value":"Even if it rains, let's go out."}]},"n3-035#c98214cf958b":{"renderings":[{"id":"6dcbc36b25007ece","role":"translation","source":{"source":"hanabira","ref":"n3-035"},"match":"id","status":"imported","value":"Even if he gets angry, let's tell the truth."}]},"n3-035#26cb2b9dedc9":{"renderings":[{"id":"e414fadd27fed939","role":"translation","source":{"source":"hanabira","ref":"n3-035"},"match":"id","status":"imported","value":"Even if it's cold, I want to go for a walk."}]},"n3-035#838338520da9":{"renderings":[