{"kind":"grammar","lang":"en","entities":{"n1-090":{"renderings":[{"id":"430be3c7580a5e9b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"Means 'putting aside', 'aside from', 'notwithstanding'."},{"id":"23a0d12108dcdf73","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"The grammar point 'Noun はさておき' is used when highlighting something as an exception from an overall generalization, or when putting aside a particular matter before progressing to another point of discussion. The literal translation would be 'putting Noun aside', 'aside from Noun' or 'notwithstanding Noun.'"},{"id":"06a1ab2f844e4010","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"Noun + はさておき"},{"id":"0cd62462c3fb717a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-090"},"match":"id","status":"reviewed","value":"はさておき: setting X aside for now (それはさておき)."},{"id":"276bd004f9ddd9b1","role":"label","field":"family","source":{"source":"gokan","ref":"one-thing-but-another"},"match":"id","status":"reviewed","value":"Setting Aside (X Aside / X Is One Thing, But)","of":{"kind":"family","id":"one-thing-but-another"}}]},"n1-090#3b835054ee3e":{"renderings":[{"id":"2260d05b2d499be9","role":"translation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"Aside from the exam results, I learned a lot this semester."}]},"n1-090#87d33f1b46ca":{"renderings":[{"id":"073d7da1733ed432","role":"translation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"Putting aside the weather, I am looking forward to tomorrow's picnic."}]},"n1-090#607f7539e884":{"renderings":[{"id":"ea67f5f7a3c83ed4","role":"translation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"Notwithstanding his personality, his skills are undeniable."}]},"n1-090#1bbeb2e6d674":{"renderings":[{"id":"1b0862100c65d7e7","role":"translation","source":{"source":"hanabira","ref":"n1-090"},"match":"id","status":"imported","value":"Aside from him being late, the issue is that he is expected to come at all."}]}}}