{"kind":"grammar","lang":"en","entities":{"n5-066":{"renderings":[{"id":"907d3115af0e1734","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"Used to express 'how many' or ask for the number of something."},{"id":"6e6ac8d7a6d37273","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"The grammar point いくつ is used when asking or expressing 'how many' of something there are, or to indicate an unspecified number. In English, it can be translated as 'how many' or 'several'."},{"id":"be3aa70cfa0b55ea","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"いくつ + Noun (optional)"},{"id":"deb3b379820f2f58","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-066"},"match":"id","status":"reviewed","value":"'How many' for things counted without a special counter, and 'how old'. With a counter, なん + counter."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-066#71d539aa4729":{"renderings":[{"id":"5acc6974d637e91a","role":"translation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"How many apples are there?"}]},"n5-066#f0749bed8e21":{"renderings":[{"id":"b4e9bf0fb17cbeff","role":"translation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"I have to solve several problems."}]},"n5-066#d7ce39b1c793":{"renderings":[{"id":"72dc660f600c353f","role":"translation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"How many languages can you speak?"}]},"n5-066#d55884e3fec6":{"renderings":[{"id":"ad7c86930a782a77","role":"translation","source":{"source":"hanabira","ref":"n5-066"},"match":"id","status":"imported","value":"There are several drinks at the party."}]}}}