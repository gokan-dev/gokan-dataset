{"kind":"grammar","lang":"en","entities":{"n1-062":{"renderings":[{"id":"976a41069c67f6fb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"Represents 'in contrast to', 'as opposed to'."},{"id":"a05a6daf376c6eb8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"The grammar point Noun にひきかえ Noun は is used in Japanese to express contrast or opposition between two nouns. It translates to 'as opposed to' or 'in contrast to' in English. The first noun represents what is being contrasted against and the second noun represents the main subject."},{"id":"8e64481be274d8e8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"Noun 1 + にひきかえ + Noun 2 + は"},{"id":"87ed6cd49fad9940","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-062"},"match":"id","status":"reviewed","value":"Formal, literary \"in contrast to\" - a deliberate, pointed contrast; written register."},{"id":"3966c116fd1cdc05","role":"label","field":"family","source":{"source":"gokan","ref":"contrast-toward"},"match":"id","status":"reviewed","value":"Contrast (Toward / In Contrast To)","of":{"kind":"family","id":"contrast-toward"}}]},"n1-062#3fd0d789ed9a":{"renderings":[{"id":"5995307878b66941","role":"translation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"In contrast to his kindness, she is emotionless."}]},"n1-062#f288fe7f1f93":{"renderings":[{"id":"942b5a72fe933880","role":"translation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"As opposed to summer, winter is cold with snow."}]},"n1-062#43109062ec53":{"renderings":[{"id":"aef003d5bd5b5a81","role":"translation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"As opposed to Japanese stations, American stations are wide."}]},"n1-062#82a1f1913382":{"renderings":[{"id":"18a70a41ce2888da","role":"translation","source":{"source":"hanabira","ref":"n1-062"},"match":"id","status":"imported","value":"As opposed to the old days, modern times have advanced technology."}]}}}