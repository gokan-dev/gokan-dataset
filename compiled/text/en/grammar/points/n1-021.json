{"kind":"grammar","lang":"en","entities":{"n1-021":{"renderings":[{"id":"aa4d7954a5c646be","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"Express the perspective of the noun; 'from ~'s point of view.'"},{"id":"092b89506a94826b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"「Noun + から言わせれば」is used to express an opinion or perspective from that noun's point of view. It can translate as 'from ~'s perspective' or 'if ~ had a say...'."},{"id":"fe08262f42d6bf38","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"Noun + から言わせれば"},{"id":"c899aa6dfefbdcef","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-021"},"match":"id","status":"reviewed","value":"から言わせれば: if you ask X, in X's view. Same as に言わせれば."},{"id":"3ce38c8d2bd06579","role":"label","field":"family","source":{"source":"gokan","ref":"according-to"},"match":"id","status":"reviewed","value":"According To (As Instructed)","of":{"kind":"family","id":"according-to"}}]},"n1-021#7d650a0d746d":{"renderings":[{"id":"61aefdee290d4b7e","role":"translation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"From the teacher's point of view, you should study every day."}]},"n1-021#1400faa5072c":{"renderings":[{"id":"6ab3f20e04239d60","role":"translation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"From the children's perspective, they want more time to play."}]},"n1-021#ae69edb6117d":{"renderings":[{"id":"20da73d1d672a55b","role":"translation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"From my point of view, that plan is feasible."}]},"n1-021#a85b4dc94435":{"renderings":[{"id":"562029e23f8c7c44","role":"translation","source":{"source":"hanabira","ref":"n1-021"},"match":"id","status":"imported","value":"If the dog could talk, it would probably want more walks."}]}}}