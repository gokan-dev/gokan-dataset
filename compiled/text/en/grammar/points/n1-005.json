{"kind":"grammar","lang":"en","entities":{"n1-005":{"renderings":[{"id":"4202f6b1dafcc016","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"Used to list examples (often with a critical or complaining tone); 'things like A, B, etc.'."},{"id":"c3d84c14054fbf0d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"The ～だの～だの grammar point is used to list examples, typically in a casual or complaining tone. It can be translated as 'things like... and so on'."},{"id":"51a94f975676c4c1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"Noun/Verb casual + だの + Noun/Verb casual + だの"},{"id":"2cf2367e40908475","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-005"},"match":"id","status":"reviewed","value":"だの～だの: complaining list of examples (高いだの遠いだの)."},{"id":"af190fe17e925fca","role":"label","field":"family","source":{"source":"gokan","ref":"listing"},"match":"id","status":"reviewed","value":"Listing (Such As / Etc.)","of":{"kind":"family","id":"listing"}}]},"n1-005#eb9b2b1bd1ff":{"renderings":[{"id":"b4a24f56b5105300","role":"translation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"I'm troubled because he's always late, forgets work, and so on."}]},"n1-005#c23fab3b091a":{"renderings":[{"id":"5de3e3c3d6b46883","role":"translation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"She often spends money on new clothes, cosmetics, and so on."}]},"n1-005#8f2c43c1f555":{"renderings":[{"id":"acdcf570d4e5aa70","role":"translation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"He says he likes music, movies, books, and so on."}]},"n1-005#926f1a01a412":{"renderings":[{"id":"db3a828a1be5793d","role":"translation","source":{"source":"hanabira","ref":"n1-005"},"match":"id","status":"imported","value":"I want to give children all the things they like, such as sweets and toys, without limit."}]}}}