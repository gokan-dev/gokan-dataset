{"kind":"grammar","lang":"en","entities":{"n1-045":{"renderings":[{"id":"8cec1081b1d77935","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"'When it comes to...', emphasizes a change of situation or status."},{"id":"6688eed46bd01cd2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"Noun + ともなると indicates a change of state or circumstances once that noun becomes relevant or once one attains that position. It conveys that 'once it’s X, things change' or 'when it comes to X...'."},{"id":"b1d5ece6785c0e85","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"Noun + ともなると"},{"id":"ea610d953340e248","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-045"},"match":"id","status":"reviewed","value":"ともなると: once X reaches that level (大学生ともなると)."},{"id":"fa19f1c414ee3570","role":"label","field":"family","source":{"source":"gokan","ref":"conditional"},"match":"id","status":"reviewed","value":"Conditional (If / Assuming That)","of":{"kind":"family","id":"conditional"}}]},"n1-045#9e500dd3d32c":{"renderings":[{"id":"21f4e62fd7fb726c","role":"translation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"When it comes to Christmas time, the whole city sparkles."}]},"n1-045#a715c69786d1":{"renderings":[{"id":"37372d979e5e956e","role":"translation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"When a child admits their mistake, that’s a different story."}]},"n1-045#b52b00ff53c3":{"renderings":[{"id":"09414a2fa65f65f5","role":"translation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"When summer vacation comes, the seaside is filled with tourists."}]},"n1-045#243c5cb73772":{"renderings":[{"id":"295be543a7a53ac3","role":"translation","source":{"source":"hanabira","ref":"n1-045"},"match":"id","status":"imported","value":"When exam week arrives, the library gets more crowded than usual."}]}}}