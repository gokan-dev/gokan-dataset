{"kind":"grammar","lang":"en","entities":{"n1-149":{"renderings":[{"id":"c245082f4062922b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-149"},"match":"id","status":"imported","value":"Expresses 'whether or not', 'no matter if something happens or not'."},{"id":"32d20f06b15d0745","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-149"},"match":"id","status":"imported","value":"Verbようが Verbるまいが indicates that whatever happens - whether the action is done or not - the outcome remains unchanged or the speaker's stance remains the same."},{"id":"025bb7eefce8fa5f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-149"},"match":"id","status":"imported","value":"Verb-volitional form + が + Verb-negative volitional form + が"},{"id":"f16db5b3db18ceb6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-149"},"match":"id","status":"reviewed","value":"Formal, literary \"whether one does X or not, (the outcome is unchanged)\" - stronger, more declarative than ようか～まいか."},{"id":"30f05beb6988b79b","role":"label","field":"family","source":{"source":"gokan","ref":"whether-or-not"},"match":"id","status":"reviewed","value":"Whether Or Not (To Do X)","of":{"kind":"family","id":"whether-or-not"}}]},"n1-149#c29ba405c596":{"renderings":[{"id":"6467b1a4ce07216b","role":"translation","source":{"source":"hanabira","ref":"n1-149"},"match":"id","status":"imported","value":"Whether he comes or not, the party will start."}]},"n1-149#394850104feb":{"renderings":[{"id":"b8ecf8c64babcf5d","role":"translation","source":{"source":"hanabira","ref":"n1-149"},"match":"id","status":"imported","value":"Whether you study or not, the test results won't change."}]},"n1-149#8aba9820213e":{"renderings":[{"id":"369078b1522fb09c","role":"translation","source":{"source":"hanabira","ref":"n1-149"},"match":"id","status":"imported","value":"Whether it rains or not, we're going on a picnic."}]},"n1-149#2ad6d6