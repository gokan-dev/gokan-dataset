{"kind":"grammar","lang":"en","entities":{"n3-030":{"renderings":[{"id":"0619890530b45afb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"Used to link two or more items; 'and', 'also'."},{"id":"605ef54e061b322c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"The ～それと～ grammar point is used to connect two or more items or actions, similar to how 'and' or 'also' is used in English. The expression それと can appear at the start of a new sentence or between items in a list to add another point."},{"id":"1c3d274507b3055c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"Item1 + それと + Item2"},{"id":"5acfa55f38214bb4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-030"},"match":"id","status":"reviewed","value":"Casual \"and also\" - a conversational way to add an afterthought."},{"id":"e65e0d1190f99736","role":"label","field":"family","source":{"source":"gokan","ref":"also"},"match":"id","status":"reviewed","value":"Also (In Addition, Too)","of":{"kind":"family","id":"also"}}]},"n3-030#1fa5b52fb42d":{"renderings":[{"id":"2726bcb296da371a","role":"translation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"I plan to go shopping, and I also have to go to the post office."}]},"n3-030#549058bd87d0":{"renderings":[{"id":"6726441561c0546f","role":"translation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"Today, I made tacos, and I also made a salad."}]},"n3-030#ce46ca2318a1":{"renderings":[{"id":"f1bc81fe9e765f03","role":"translation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"Please clean the room before you go out, and also throw away the trash."}]},"n3-030#5b8a0d764226":{"renderings":[{"id":"231d63b87cbbf596","role":"translation","source":{"source":"hanabira","ref":"n3-030"},"match":"id","status":"imported","value":"He can speak French, and he can also speak Spanish."}]}}}