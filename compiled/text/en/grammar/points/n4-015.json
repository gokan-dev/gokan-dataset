{"kind":"grammar","lang":"en","entities":{"n4-015":{"renderings":[{"id":"0dda075138458991","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"Used to express someone doing something as a favor or for the benefit of the speaker."},{"id":"5c7e2037f5608ad2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"The grammar point 'Nounをくださる' is a polite expression used to say that someone is giving or doing something for the benefit of the speaker. It is often used when referring to people who have a higher social status or when expressing gratitude for their actions."},{"id":"b1b49705b15c6690","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"Noun + を + くださる"},{"id":"a9360f330d4b4bcb","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-015"},"match":"id","status":"reviewed","value":"Honorific - someone of higher status giving to the speaker, as a favor."},{"id":"aabe59494c91ee24","role":"label","field":"family","source":{"source":"gokan","ref":"giving"},"match":"id","status":"reviewed","value":"Giving (Benefactive Register)","of":{"kind":"family","id":"giving"}}]},"n4-015#a1197902d818":{"renderings":[{"id":"644d8e54a1e9e613","role":"translation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"The teacher gave me the materials."}]},"n4-015#c6b3f43f0565":{"renderings":[{"id":"75ec5f6dd9492328","role":"translation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"My mother gives me snacks."}]},"n4-015#97794934f65a":{"renderings":[{"id":"9bd41d57041097db","role":"translation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"My boss gave me advice."}]},"n4-015#4a33969c8ce8":{"renderings":[{"id":"c5e5a9c79f32b52a","role":"translation","source":{"source":"hanabira","ref":"n4-015"},"match":"id","status":"imported","value":"My friend gave me a present."}]}}}