{"kind":"grammar","lang":"en","entities":{"n1-169":{"renderings":[{"id":"868dd63256cb65e5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"Expresses the idea of 'must not do' or 'should not do'."},{"id":"b25069128bf1efae","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"The ～るべからず grammar point is used to express a strong prohibition or firmly established rule. It can be translated as 'must not do' or 'should not do'. It is common in formal or instructive settings (e.g., signs, notices). The formation is straightforward with verbs in dictionary form followed by べからず."},{"id":"a14f32345a344005","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"Verb-ru + べからず"},{"id":"812fe53129b475dc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-169"},"match":"id","status":"reviewed","value":"べからず: must not, on signs and rules (入るべからず)."},{"id":"52331782dd11468f","role":"label","field":"family","source":{"source":"gokan","ref":"prohibition"},"match":"id","status":"reviewed","value":"Permission And Prohibition (May / Must Not)","of":{"kind":"family","id":"prohibition"}}]},"n1-169#9b6aba5205eb":{"renderings":[{"id":"7fa6c075cfc47b71","role":"translation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"One must not tell lies."}]},"n1-169#6f97516ac485":{"renderings":[{"id":"88aad5d45481543e","role":"translation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"You must not leak their secrets."}]},"n1-169#0ae32e00b792":{"renderings":[{"id":"9889c48adf9ee5c0","role":"translation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"You must not break the rules."}]},"n1-169#4e9b8163b150":{"renderings":[{"id":"769fd0fbf8d36e02","role":"translation","source":{"source":"hanabira","ref":"n1-169"},"match":"id","status":"imported","value":"One must not neglect their studies."}]}}}