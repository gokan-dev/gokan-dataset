{"kind":"grammar","lang":"en","entities":{"n4-114":{"renderings":[{"id":"9e8fbac116d7c9cd","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"Indicates extent, 'until', 'up to', 'as far as', 'even'."},{"id":"c40bdffab4931988","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"The ～まで grammar point is used to express extent or range in terms of time, distance, or degree. It can be translated as 'until', 'up to', 'as far as', or 'even' in English. It is used with verbs, い-adjectives, な-adjectives, or nouns."},{"id":"f6db0dd2a977f312","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"Verb + まで, い-Adjective + まで, な-Adjective + まで, Noun + まで"},{"id":"9aa81e4c79a377a1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-114"},"match":"id","status":"reviewed","value":"Casual-to-neutral \"even/to the point of\" - overlaps with さえ in everyday speech."},{"id":"f576172f87098943","role":"label","field":"family","source":{"source":"gokan","ref":"emphasis-even"},"match":"id","status":"reviewed","value":"Emphasis (Even)","of":{"kind":"family","id":"emphasis-even"}}]},"n4-114#dca2124f310b":{"renderings":[{"id":"1ce93b9ba670f963","role":"translation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"I will wait until work is finished."}]},"n4-114#c958be62d3b0":{"renderings":[{"id":"50697daaaa1320df","role":"translation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"It takes 10 minutes to walk from here to the station."}]},"n4-114#3ab590726c9a":{"renderings":[{"id":"153d4871e102c905","role":"translation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"I will support him until he succeeds."}]},"n4-114#ba2009f68d66":{"renderings":[{"id":"2639db4fc607f99f","role":"translation","source":{"source":"hanabira","ref":"n4-114"},"match":"id","status":"imported","value":"She likes even cats."}]}}}