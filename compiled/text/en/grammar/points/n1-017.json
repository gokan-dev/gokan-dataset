{"kind":"grammar","lang":"en","entities":{"n1-017":{"renderings":[{"id":"ede01d12a8a3f445","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"Means 'while...at the same time', 'on the occasion of', or 'along with'."},{"id":"76fe5663f5e458c2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"The suffix ～がてら is used to show doing one activity alongside another, taking advantage of the opportunity. It can often be translated as 'while', 'at the same time', 'along with', or 'on the occasion of'."},{"id":"d49ddfa900aeb34b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"Noun + がてら"},{"id":"7cee3f85065c0a24","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-017"},"match":"id","status":"reviewed","value":"Formal, literary \"while...at the same time\" - doing a second thing incidentally during the first."},{"id":"ad8e82d619954210","role":"label","field":"family","source":{"source":"gokan","ref":"occasion"},"match":"id","status":"reviewed","value":"Occasion (While Doing / On The Occasion Of)","of":{"kind":"family","id":"occasion"}}]},"n1-017#537cd1dae4f1":{"renderings":[{"id":"7ced8ecd5293425f","role":"translation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"While taking a walk, I picked some flowers in the nearby park."}]},"n1-017#30a4c2e7b2a0":{"renderings":[{"id":"d87a473c2e3aaf37","role":"translation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"While I was out shopping, I went to see a friend."}]},"n1-017#d4a6db59a95a":{"renderings":[{"id":"31ec8447e756b841","role":"translation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"She studied a new language while traveling."}]},"n1-017#aaf2ff8e5b9f":{"renderings":[{"id":"f119147d77352e90","role":"translation","source":{"source":"hanabira","ref":"n1-017"},"match":"id","status":"imported","value":"I listened to a new album while going for a drive."}]}}}