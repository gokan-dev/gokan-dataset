{"kind":"grammar","lang":"en","entities":{"n1-074":{"renderings":[{"id":"9fdad3bf50450a72","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"Expresses the concept of doing something completely or thoroughly."},{"id":"b2a83b1dbf41a7e5","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"'Noun ぬく' is a phrase that conveys the idea of doing an action thoroughly or completely. It demonstrates a determination to carry out a task until the end. While the formation commonly uses verbs, it does convey a meaning similar to the English phrase 'to do completely'."},{"id":"e513564b2cc478bc","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"Verb-stem + ぬく"},{"id":"3440bc8b2d74d160","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-074"},"match":"id","status":"reviewed","value":"ます stem + ぬく: see it through to the end despite difficulty (走りぬく)."},{"id":"346651d354f1ea02","role":"label","field":"family","source":{"source":"gokan","ref":"aspect-verbs"},"match":"id","status":"reviewed","value":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","of":{"kind":"family","id":"aspect-verbs"}}]},"n1-074#a9de96c748a8":{"renderings":[{"id":"35cfe7d55681f2a1","role":"translation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"He will read the book all day long."}]},"n1-074#62aa444dd6a7":{"renderings":[{"id":"89748760bc873f49","role":"translation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"I will finish this project completely."}]},"n1-074#56f3482923d6":{"renderings":[{"id":"547cadb3b7f84812","role":"translation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"She goes to the gym every day and finishes her exercise completely."}]},"n1-074#fc151077e90c":{"renderings":[{"id":"5cb8ce984cbed370","role":"translation","source":{"source":"hanabira","ref":"n1-074"},"match":"id","status":"imported","value":"We will solve this game completely."}]}}}