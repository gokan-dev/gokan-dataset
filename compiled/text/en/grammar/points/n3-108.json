{"kind":"grammar","lang":"en","entities":{"n3-108":{"renderings":[{"id":"a299c25e6253ba79","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"Express a hypothetical situation or assumption with the nuance of 'even if'."},{"id":"e232282790f15e05","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"The もし～ても grammar point is used to describe a situation in which even if the stated condition is true, the result or decision does not change. It can be translated as 'even if', 'no matter if', or 'suppose ~'."},{"id":"5d46fcb7cb037bcc","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"もし + Verb-て form + も / もし + い-Adjective(く) + ても / もし + な-Adjective/Noun + でも"},{"id":"b1482f11bb6bac05","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-108"},"match":"id","status":"reviewed","value":"Pairs もし with ても - a plain hypothetical \"even if\"."},{"id":"a3d1d81bf546c33e","role":"label","field":"family","source":{"source":"gokan","ref":"even-if"},"match":"id","status":"reviewed","value":"Even If (Hypothetical Concession)","of":{"kind":"family","id":"even-if"}}]},"n3-108#18827908f774":{"renderings":[{"id":"357e5280646c4272","role":"translation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"Even if it rains, we will go on a picnic."}]},"n3-108#d29ab73559de":{"renderings":[{"id":"5c09c65c3b4b4cfc","role":"translation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"Even if he apologizes, I will still be angry."}]},"n3-108#2bdced1c8dc8":{"renderings":[{"id":"6e8beaaa3587c2cd","role":"translation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"Even if I pass the exam, I will still continue studying."}]},"n3-108#fcbf6532eb07":{"renderings":[{"id":"b71949b9e6d1943f","role":"translation","source":{"source":"hanabira","ref":"n3-108"},"match":"id","status":"imported","value":"Even if she comes late, I will wait."}]}}}