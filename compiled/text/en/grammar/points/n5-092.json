{"kind":"grammar","lang":"en","entities":{"n5-092":{"renderings":[{"id":"99df0f858d5d1be1","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"Used to express 'anyone' or 'everyone'; 'no matter who'."},{"id":"f7ddbe006f12db8f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"The grammar point だれでも is used to emphasize that something applies to everyone or anyone, regardless of who they are. It can be translated as 'anyone', 'everyone', or 'no matter who' in English. It is used in sentences to show that a certain situation, characteristic, or condition applies to all people."},{"id":"4ae149e0e26667f7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"だれでも + Verb/Adjective/Noun"},{"id":"70d2f8f123ffc791","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-092"},"match":"id","status":"reviewed","value":"'Anyone at all', whoever it is, with an affirmative verb (だれでもできます)."},{"id":"51a79d989bbdb41e","role":"label","field":"family","source":{"source":"gokan","ref":"who"},"match":"id","status":"reviewed","value":"Who (Someone / Anyone / No One)","of":{"kind":"family","id":"who"}}]},"n5-092#694ebede38d3":{"renderings":[{"id":"3b00daa1a6adfb72","role":"translation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"Anyone can play this game."}]},"n5-092#9d4bd2dccf3d":{"renderings":[{"id":"06ec7800201f8e00","role":"translation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"Everyone gets tired sometimes."}]},"n5-092#959a22085995":{"renderings":[{"id":"9c21a7e1180e4704","role":"translation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"Anyone can participate in this event for free."}]},"n5-092#0afab3d7673b":{"renderings":[{"id":"a88ce335fb25529c","role":"translation","source":{"source":"hanabira","ref":"n5-092"},"match":"id","status":"imported","value":"No matter who you are, you can enjoy the sightseeing spots in this town."}]}}}