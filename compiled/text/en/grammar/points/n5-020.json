{"kind":"grammar","lang":"en","entities":{"n5-020":{"renderings":[{"id":"ba2580222aa01699","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"Expressing a decision or preference with a な-adjective."},{"id":"fb2d55c403568db8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"The な-adjective に します pattern is used to express a decision or choice based on a な-adjective. It often translates as 'I’ll make it ...,' 'I will choose ...,' or 'I’ve decided on ...'."},{"id":"5fed5e15dc9cef88","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"な-Adjective + に + します"},{"id":"e53876f2820b7a20","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-020"},"match":"id","status":"reviewed","value":"にする: you make it so (静かにする). になる: it becomes so."},{"id":"f48a13546b42cc1e","role":"label","field":"family","source":{"source":"gokan","ref":"change-of-state"},"match":"id","status":"reviewed","value":"Change (Become / Make / Decide On)","of":{"kind":"family","id":"change-of-state"}}]},"n5-020#4ff73178ac3c":{"renderings":[{"id":"aef29388518413fa","role":"translation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"I will be quiet."}]},"n5-020#6f7743def632":{"renderings":[{"id":"ef80f4757f4437ed","role":"translation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"I will make the room clean."}]},"n5-020#228d183f258a":{"renderings":[{"id":"c1f4f416bacd447f","role":"translation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"I will make tomorrow’s meeting simple."}]},"n5-020#29e63b16a897":{"renderings":[{"id":"20d0118e8a6c1ea0","role":"translation","source":{"source":"hanabira","ref":"n5-020"},"match":"id","status":"imported","value":"I will choose a healthy meal."}]}}}