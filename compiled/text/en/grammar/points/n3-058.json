{"kind":"grammar","lang":"en","entities":{"n3-058":{"renderings":[{"id":"bad53fc6ce2183d9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-058"},"match":"id","status":"imported","value":"Used to provide an explanation or definition; 'that is to say...', 'by that, I mean...'."},{"id":"bba1af05ccc73bd8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-058"},"match":"id","status":"imported","value":"The ～というのは grammar point is used to provide an explanation or definition of the preceding statement or word. It can be translated as 'that is to say...', 'by that, I mean...', or 'what I mean by...'."},{"id":"9ebdf842e91833b1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-058"},"match":"id","status":"imported","value":"Phrase/sentence + というのは + explanation/definition"},{"id":"6c90ec54672674e8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-058"},"match":"id","status":"reviewed","value":"というのは: 'what X means is', a definition or explanation."},{"id":"71737f2ed7047fb3","role":"label","field":"family","source":{"source":"gokan","ref":"quoting"},"match":"id","status":"reviewed","value":"Called / Quoting (Named / They Say)","of":{"kind":"family","id":"quoting"}}]},"n3-058#5ce1fcce30f4":{"renderings":[{"id":"96b717a77deea6d8","role":"translation","source":{"source":"hanabira","ref":"n3-058"},"match":"id","status":"imported","value":"Going to Japan, that is to say, traveling to Japan."}]},"n3-058#f38fed45f1f7":{"renderings":[{"id":"d119d547bb020580","role":"translation","source":{"source":"hanabira","ref":"n3-058"},"match":"id","status":"imported","value":"When I say this problem is difficult, I mean it takes time to solve."}]},"n3-058#fc3ad9f8ccc3":{"renderings":[{"id":"607015bf3773b26f","role":"translation","source":{"source":"hanabira","ref":"n3-058"},"match":"id","status":"imported","value":"By saying that he's angry, I mean he's feeling dissatisfied."}]},"n3