{"kind":"grammar","lang":"en","entities":{"n3-046":{"renderings":[{"id":"e37fffe518b3f475","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"Expressing a past intention or plan; 'was planning to', 'meant to'."},{"id":"5cb550fb3d6c8f90","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"The ～つもりでした grammar point is used to express a past intention or plan that did not happen, or a past belief that turned out incorrect. It can be translated as 'was planning to', 'intended to', or 'meant to'."},{"id":"b5a77392761b9c51","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"Verb-casual (dictionary form) + つもりでした"},{"id":"11a3a999994176e8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-046"},"match":"id","status":"reviewed","value":"Past-tense \"was planning to/meant to (but didn't necessarily follow through)\"."},{"id":"1f8c8930edf8789a","role":"label","field":"family","source":{"source":"gokan","ref":"intention"},"match":"id","status":"reviewed","value":"Intention (Plan To)","of":{"kind":"family","id":"intention"}}]},"n3-046#112b51e3471a":{"renderings":[{"id":"2b50dd28f8ed0f5a","role":"translation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"I was planning to meet my friend yesterday, but I caught a cold."}]},"n3-046#7c22b0a2d526":{"renderings":[{"id":"058a645aca9a9292","role":"translation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"I intended to watch a movie, but I ran out of time."}]},"n3-046#84b55541c0c4":{"renderings":[{"id":"5bcc9313ef08bf77","role":"translation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"They were supposed to come, but they canceled by phone."}]},"n3-046#f6f330aaf421":{"renderings":[{"id":"53df8ae05ac741d7","role":"translation","source":{"source":"hanabira","ref":"n3-046"},"match":"id","status":"imported","value":"I meant to read this book, but I realized I'd already finished it."}]}}}