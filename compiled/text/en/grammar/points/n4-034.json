{"kind":"grammar","lang":"en","entities":{"n4-034":{"renderings":[{"id":"0c09a6cf83c57ab6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"Expresses an ongoing action or a state resulting from a past action."},{"id":"399d0fd9b3aebc82","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"The ている form is used to express either an ongoing action or a state resulting from a past action. It is formed by conjugating the verb into its て-form and then adding いる. In English, this can be translated as verb-ing or 'have verb-ed'. Its usage depends on the type of verb: action verbs or state verbs."},{"id":"cfe943521a7e3165","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"Verb (て-form) + いる"}]},"n4-034#b9d255b919ac":{"renderings":[{"id":"0dffe69c184133ed","role":"translation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"I am reading a book now."}]},"n4-034#69df500e69c1":{"renderings":[{"id":"7407e941b4a5f02a","role":"translation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"He is studying English."}]},"n4-034#7179bef506f7":{"renderings":[{"id":"fdc784bf111dd1f5","role":"translation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"The cake is in the refrigerator."}]},"n4-034#a57e7c99b052":{"renderings":[{"id":"4c7fc86acbd22556","role":"translation","source":{"source":"hanabira","ref":"n4-034"},"match":"id","status":"imported","value":"The room has become clean."}]}}}