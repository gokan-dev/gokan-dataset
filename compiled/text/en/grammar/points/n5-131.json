{"kind":"grammar","lang":"en","entities":{"n5-131":{"renderings":[{"id":"edc5fd6b4858eb2c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"Expresses that something has not happened or been done yet (polite form)."},{"id":"c60cd372d00209ce","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"The まだ～ません grammar point is used to express that something has not happened or been done yet in a polite register. It is used with the negative ます-form of a verb (～ません). まだ is placed before the verb phrase."},{"id":"c1b0790dc4ee566e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"まだ + Verb-ます form (negative)"},{"id":"d589fee0e81dc4bd","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-131"},"match":"id","status":"reviewed","value":"'Not yet' (まだ食べていません): the answer to もう～ましたか."},{"id":"d2065b19e1abd29f","role":"label","field":"family","source":{"source":"gokan","ref":"already-still"},"match":"id","status":"reviewed","value":"Already / Still / Not Yet","of":{"kind":"family","id":"already-still"}}]},"n5-131#3313ab1e6cfb":{"renderings":[{"id":"3990f9d488c5abe2","role":"translation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"I have not eaten lunch yet."}]},"n5-131#83ccd68b9842":{"renderings":[{"id":"7b4d954d0ee58a98","role":"translation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"I have not finished my homework yet."}]},"n5-131#a43de5f1e1ce":{"renderings":[{"id":"afed1caf5bf47045","role":"translation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"I have not been to Tokyo yet."}]},"n5-131#176c715678ed":{"renderings":[{"id":"627e882aad7affe4","role":"translation","source":{"source":"hanabira","ref":"n5-131"},"match":"id","status":"imported","value":"He hasn't come yet."}]}}}