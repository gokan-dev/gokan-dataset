{"kind":"grammar","lang":"en","entities":{"n1-131":{"renderings":[{"id":"4769b88e83acb077","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"Expresses that ever since a certain event happened, a condition has continued until now."},{"id":"4aedd5c5d9ae4ebf","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"The てからというもの grammar point indicates that from the time a certain action happened, a significant change or condition has persisted continuously. It emphasizes that the new situation contrasts with what came before."},{"id":"810089a18e296672","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"Verb-て form + からというもの"},{"id":"69444763cc563155","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-131"},"match":"id","status":"reviewed","value":"てからというもの: ever since X, things have been different."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n1-131#36fc38869eda":{"renderings":[{"id":"9e5a765839fcf031","role":"translation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"Ever since I broke up with her, I've spent more time alone."}]},"n1-131#6cfe6662a1f5":{"renderings":[{"id":"afd6d655b08f4d40","role":"translation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"Since the baby was born, I have had no free time."}]},"n1-131#47b17f7eb28a":{"renderings":[{"id":"3854631d3e0c167b","role":"translation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"Ever since I started my new job, I've been busy every day."}]},"n1-131#3b3d6c1cd1df":{"renderings":[{"id":"3daa674dec203b9e","role":"translation","source":{"source":"hanabira","ref":"n1-131"},"match":"id","status":"imported","value":"I haven’t had time to play sports since I entered university."}]}}}