{"kind":"grammar","lang":"en","entities":{"n5-024":{"renderings":[{"id":"b9a7d6bcefa90b6a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"Express a desire or wanting something; 'I want', 'I would like'."},{"id":"197724dd78d28c17","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"The がほしいです grammar point is used to express a desire or the act of wanting something in polite form. It can be translated as 'I want' or 'I would like' in English. It is used with a noun and the particle が."},{"id":"cd672056f216c935","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"Noun + が + ほしいです"},{"id":"8b22de25caaeac43","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-024"},"match":"id","status":"reviewed","value":"ほしい: want a THING (車がほしい). Wanting to DO something is たい."},{"id":"9587285840ba1a2d","role":"label","field":"family","source":{"source":"gokan","ref":"wanting"},"match":"id","status":"reviewed","value":"Wanting (Want / Want To / Want Someone To)","of":{"kind":"family","id":"wanting"}}]},"n5-024#c50769e6ed2d":{"renderings":[{"id":"c108d2e2b5001464","role":"translation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"I want a new car."}]},"n5-024#0e6ab6a192f2":{"renderings":[{"id":"909222e6e7da7777","role":"translation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"I would like some coffee."}]},"n5-024#8b467a065753":{"renderings":[{"id":"43e089750e2b67c3","role":"translation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"She wants flowers."}]},"n5-024#ef7b6227db07":{"renderings":[{"id":"2fe20a8e8a544f3d","role":"translation","source":{"source":"hanabira","ref":"n5-024"},"match":"id","status":"imported","value":"I want a friend."}]}}}