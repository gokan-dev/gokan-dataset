{"kind":"grammar","lang":"en","entities":{"n2-036":{"renderings":[{"id":"c2de0c8554db1fd6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"Means 'without doing', 'not doing', or 'without happening'."},{"id":"9a35a8381679ecc3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"The grammar point ことなく is added to the stem of a verb to express that something doesn't happen or isn't done. It can be translated as 'without doing', 'not doing', or 'without happening'. The formation depends on whether it is used with a verb."},{"id":"798cb916505286ad","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"Verb-stem + ことなく"},{"id":"3e61aa696e2f8b4c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-036"},"match":"id","status":"reviewed","value":"ことなく: without ever doing; written register (休むことなく働いた)."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n2-036#1902dc155a9b":{"renderings":[{"id":"117b3ba0c0fad676","role":"translation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"She went home without crying."}]},"n2-036#72586a61fad9":{"renderings":[{"id":"900c614eb018eb13","role":"translation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"He suddenly left without giving any warning."}]},"n2-036#a7ebf5833675":{"renderings":[{"id":"47bbe00635e93114","role":"translation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"Mr. Yamada quit the company without talking to anyone."}]},"n2-036#5054054e77f8":{"renderings":[{"id":"7ad5fc823d88b8cc","role":"translation","source":{"source":"hanabira","ref":"n2-036"},"match":"id","status":"imported","value":"I have been working for 20 years without getting sick."}]}}}