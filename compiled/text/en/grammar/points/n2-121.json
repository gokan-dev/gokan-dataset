{"kind":"grammar","lang":"en","entities":{"n2-121":{"renderings":[{"id":"b637e054225d5a15","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"Contrary to, against, in spite of"},{"id":"421ffee000f300dc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"The ～に反して grammar point is used to express that something is contrary to or against an expectation or belief. It can be translated as 'contrary to', 'against', or 'in spite of' in English. It is generally used with nouns."},{"id":"94c64216d9292ce2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"Noun + に反して"},{"id":"1735a591493e01a2","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-121"},"match":"id","status":"reviewed","value":"Formal \"contrary to (what was expected)\" - the outcome defies the setup."},{"id":"e7484b401cb1f08c","role":"label","field":"family","source":{"source":"gokan","ref":"concession"},"match":"id","status":"reviewed","value":"Concession (Even Though / Although / Despite)","of":{"kind":"family","id":"concession"}}]},"n2-121#470a8c683efe":{"renderings":[{"id":"3210d28cff706b86","role":"translation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"Contrary to the weather forecast, it is raining today."}]},"n2-121#4dd06e02df9c":{"renderings":[{"id":"2ae5fa86b7085f0a","role":"translation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"We won the match against his prediction."}]},"n2-121#721487614ef7":{"renderings":[{"id":"0e6a7fdff577606c","role":"translation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"I married him against my parents' opinion."}]},"n2-121#eaffbba0963a":{"renderings":[{"id":"d9a308ad3a8e3e1a","role":"translation","source":{"source":"hanabira","ref":"n2-121"},"match":"id","status":"imported","value":"This movie became a big hit contrary to the critics' ratings."}]}}}