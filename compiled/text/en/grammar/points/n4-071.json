{"kind":"grammar","lang":"en","entities":{"n4-071":{"renderings":[{"id":"a2280ce51fca7765","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"Indicates the way or method of doing something; often read as '～かた' ('how to', 'the way of')."},{"id":"e4039dc916c27dca","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"The ～方 grammar point is used to express the way or method of doing something, similar to 'how to' or 'the way of' in English. It can be attached to the stem of a verb to form a noun that indicates the method of doing the action. In practice, ～方 is usually read as '～かた' (e.g., 作り方＝つくりかた)."},{"id":"b250a256dae7cfc1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"Verb-stem + 方 (read as かた)"},{"id":"921ed752d7dfcdab","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-071"},"match":"id","status":"reviewed","value":"ます stem + 方: how to, the way of (読み方, 作り方)."},{"id":"f154a4c08defae72","role":"label","field":"family","source":{"source":"gokan","ref":"manner"},"match":"id","status":"reviewed","value":"Manner (Way Of Doing)","of":{"kind":"family","id":"manner"}}]},"n4-071#680f03ae40b9":{"renderings":[{"id":"b108a94aacc2ee98","role":"translation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"Does anyone know how to make a cake?"}]},"n4-071#345c2186a80c":{"renderings":[{"id":"683d39f6f9f84d72","role":"translation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"She is learning how to speak English."}]},"n4-071#ddf2d57f6364":{"renderings":[{"id":"51d3e349a645cdca","role":"translation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"Please teach me how to use this computer."}]},"n4-071#111b9559dba8":{"renderings":[{"id":"62fbaa8c5bca919b","role":"translation","source":{"source":"hanabira","ref":"n4-071"},"match":"id","status":"imported","value":"It is difficult to remember the way to solve math problems."}]}}}