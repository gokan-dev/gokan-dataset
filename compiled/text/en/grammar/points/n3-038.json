{"kind":"grammar","lang":"en","entities":{"n3-038":{"renderings":[{"id":"6b40801bcd9312af","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-038"},"match":"id","status":"imported","value":"Express 'every time' or 'whenever'."},{"id":"f3fcbe4cef7fa3fc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-038"},"match":"id","status":"imported","value":"The ～たびに grammar point is used to express that an action or event occurs every time or whenever something else happens. It can be translated as 'every time', 'whenever', or 'each time' in English. Typically, you attach たびに to a verb in its dictionary form, or to a noun plus の."},{"id":"1dc12511fcad72d0","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-038"},"match":"id","status":"imported","value":"Verb-dictionary form + たびに, Noun + のたびに"},{"id":"2094f2fde44308dc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-038"},"match":"id","status":"reviewed","value":"The everyday \"every time/whenever\"."},{"id":"6b62e9f8e3b329be","role":"label","field":"family","source":{"source":"gokan","ref":"whenever"},"match":"id","status":"reviewed","value":"Whenever (Every Time)","of":{"kind":"family","id":"whenever"}}]},"n3-038#800616b7cd77":{"renderings":[{"id":"063545dc9c6008ef","role":"translation","source":{"source":"hanabira","ref":"n3-038"},"match":"id","status":"imported","value":"Every time I meet her, my heart leaps."}]},"n3-038#f63eb01db2ce":{"renderings":[{"id":"7f776130e5b6e961","role":"translation","source":{"source":"hanabira","ref":"n3-038"},"match":"id","status":"imported","value":"Whenever it rains, nostalgic memories come back."}]},"n3-038#99a728ef4b47":{"renderings":[{"id":"4e65cd26fb4e4944","role":"translation","source":{"source":"hanabira","ref":"n3-038"},"match":"id","status":"imported","value":"Every time I listen to this song, I feel happy."}]},"n3-038#afc1c58d346b":{"renderings":[{"id":"892650221291e602",