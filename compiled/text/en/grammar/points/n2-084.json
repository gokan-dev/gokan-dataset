{"kind":"grammar","lang":"en","entities":{"n2-084":{"renderings":[{"id":"cfefa6656f6b284a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"Express extremely strong feelings or sensations; 'can't stand', 'unbearably'."},{"id":"1473ec4427c12e6a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"The ～でたまらない grammar point is used to convey very strong emotion or sensation - so strong it’s almost unbearable. It’s common with expressions like 暑くてたまらない, うれしくてたまらない, etc."},{"id":"bbe8e207c02583ba","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"い-Adjective (く) + てたまらない / な-Adjective + でたまらない / Verb-て form + たまらない"},{"id":"d5f926ef86ae6c4a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-084"},"match":"id","status":"reviewed","value":"\"Unbearably.../can't stand it\" - an intense physical or emotional sensation."},{"id":"140b3ceb8a829c1f","role":"label","field":"family","source":{"source":"gokan","ref":"cant-help-but"},"match":"id","status":"reviewed","value":"Can't Help But (Overwhelming Feeling)","of":{"kind":"family","id":"cant-help-but"}}]},"n2-084#181662bcb4d8":{"renderings":[{"id":"6df4ca35bb459684","role":"translation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"This heat is absolutely unbearable."}]},"n2-084#c5730fc34663":{"renderings":[{"id":"7d39664e1d30ad20","role":"translation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"I like her so much I can hardly stand it."}]},"n2-084#e8a832c221af":{"renderings":[{"id":"255f85713e56222a","role":"translation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"This room is unbearably cold."}]},"n2-084#3948c94bdae0":{"renderings":[{"id":"df40eb4b860ee785","role":"translation","source":{"source":"hanabira","ref":"n2-084"},"match":"id","status":"imported","value":"Seeing his attitude makes me extremely angry."}]}}}