{"kind":"grammar","lang":"en","entities":{"n3-025":{"renderings":[{"id":"2cc4588f6b0c4dab","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"Express 'without doing' something or 'not doing' something."},{"id":"81dc93d587e301c9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"The ～ずに grammar point is used to express the meaning of not doing something or doing an action without doing another action first. It is similar to the negative ないで form (～ないで) but ～ずに is considered slightly more formal."},{"id":"f03470548817be28","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"Verb-ない form (Remove ない) + ずに"},{"id":"5a0b2baf1919b2ea","role":"label","field":"derives","source":{"source":"gokan","ref":"n3-025"},"match":"id","status":"reviewed","value":"ず (negative adverbial)"}]},"n3-025#1effc7497314":{"renderings":[{"id":"e96a628cb5150119","role":"translation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"He was listening to the story without laughing."}]},"n3-025#2e2e53d49020":{"renderings":[{"id":"cd2cc2f4953bc321","role":"translation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"It's not good to go to bed without eating."}]},"n3-025#74cda15ca546":{"renderings":[{"id":"725c6db46b3a0951","role":"translation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"I started working without drinking coffee."}]},"n3-025#24b8451a846a":{"renderings":[{"id":"7b7a086d9fe92fb8","role":"translation","source":{"source":"hanabira","ref":"n3-025"},"match":"id","status":"imported","value":"I went out without telling anyone."}]}}}