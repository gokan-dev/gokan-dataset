{"kind":"grammar","lang":"en","entities":{"n1-091":{"renderings":[{"id":"3c0680344f1e5ca7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"This phrase means 'regardless of' or 'no matter how…'."},{"id":"0de8ede5bcc32a21","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"It is used to convey indifference about the state or condition of a certain thing or matter. You can think of it as 'no matter what' or 'regardless of' in English. The phrase shows the speaker’s strong intention to do something or an assertion that doesn’t change regardless of the noun’s state or condition."},{"id":"4e9deed12d616912","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"Noun + はどうであれ"},{"id":"a40139aa88644e1d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-091"},"match":"id","status":"reviewed","value":"Formal, literary \"regardless of/no matter how\"."},{"id":"a50efe0caa0d07a3","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-of"},"match":"id","status":"reviewed","value":"Regardless Of (No Matter)","of":{"kind":"family","id":"regardless-of"}}]},"n1-091#edf0c0676317":{"renderings":[{"id":"9f157d62504eafdf","role":"translation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"No matter what the weather is, the match will be held."}]},"n1-091#af2c70a4f01d":{"renderings":[{"id":"1b312c9fe74df340","role":"translation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"No matter what the result is, all we can do is try our best."}]},"n1-091#83684dc05f82":{"renderings":[{"id":"93c9a8633b003222","role":"translation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"No matter what your opinion is, I believe him."}]},"n1-091#f9518539d457":{"renderings":[{"id":"47f7fe11875b3d5a","role":"translation","source":{"source":"hanabira","ref":"n1-091"},"match":"id","status":"imported","value":"No matter what the result of the test is, nothing will change for you."}]}}}