{"kind":"grammar","lang":"en","entities":{"n2-130":{"renderings":[{"id":"a63dd378b57d50d3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"Expresses limitation; 'only', 'limited to', 'exclusive to'."},{"id":"d400f87b4cf7427a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"The ～に限り grammar point is used to indicate that something is limited or exclusive to a certain condition or situation. It can be translated as 'only', 'limited to', or 'exclusive to' in English. The formation is simple and can be used with nouns."},{"id":"ae342ebae78cdc27","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"Noun + に限り"},{"id":"283e0e382415d4c1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-130"},"match":"id","status":"reviewed","value":"Administrative \"limited to\" - common in official rules, offers, terms."},{"id":"0a7eb6991316e0ea","role":"label","field":"family","source":{"source":"gokan","ref":"exclusivity"},"match":"id","status":"reviewed","value":"Exclusivity (Only / Nothing But)","of":{"kind":"family","id":"exclusivity"}}]},"n2-130#2a5bdbe0efc5":{"renderings":[{"id":"ae344ab240b556d5","role":"translation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"Today only, this product is half price."}]},"n2-130#b414c6d4711c":{"renderings":[{"id":"00c1a1b91b8066dd","role":"translation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"This coupon is valid only at this store."}]},"n2-130#5c3cc7790f98":{"renderings":[{"id":"a61aebd76cbe35b3","role":"translation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"Only members can use this service for free."}]},"n2-130#0c07ccfb61bf":{"renderings":[{"id":"428ead3db2310bc9","role":"translation","source":{"source":"hanabira","ref":"n2-130"},"match":"id","status":"imported","value":"This benefit is limited to the first 10 people."}]}}}