{"kind":"grammar","lang":"en","entities":{"n1-035":{"renderings":[{"id":"752a3bd709d8f6fc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"Used to indicate doing two things at once or fulfilling two roles/purposes."},{"id":"71ea9d89d5b4fc47","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"「Noun と Noun を兼ねて」means that one action or thing serves the purpose of both nouns. It can be translated as 'serving as both… and…', or 'for both… and…'."},{"id":"875bac007fb68547","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"Noun + と + Noun + を兼ねて"},{"id":"a5def08599fe891e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-035"},"match":"id","status":"reviewed","value":"と～を兼ねて: doing two things at once (観光と仕事を兼ねて)."},{"id":"e65e0d1190f99736","role":"label","field":"family","source":{"source":"gokan","ref":"also"},"match":"id","status":"reviewed","value":"Also (In Addition, Too)","of":{"kind":"family","id":"also"}}]},"n1-035#8c1f11e879d3":{"renderings":[{"id":"2642bb0af100d351","role":"translation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"My father serves as both the company president and the head of accounting."}]},"n1-035#e180687e9495":{"renderings":[{"id":"ccc21ab455d6f7df","role":"translation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"She works as both a music teacher and a pianist."}]},"n1-035#6d652e2d3055":{"renderings":[{"id":"6852f00976ac0a9b","role":"translation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"This room serves as both a bedroom and a study."}]},"n1-035#43a9a3fd7231":{"renderings":[{"id":"d03306d1f1cad622","role":"translation","source":{"source":"hanabira","ref":"n1-035"},"match":"id","status":"imported","value":"He looks after his child, taking on both mother and father roles."}]}}}