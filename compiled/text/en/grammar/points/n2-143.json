{"kind":"grammar","lang":"en","entities":{"n2-143":{"renderings":[{"id":"a3ce7edc8bb14a33","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"Expressing that something is obvious, and there is also something else."},{"id":"f27e7613c790ad06","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"The ～はもとより grammar point is used to emphasize that something is obvious or a given, and on top of that, there’s another aspect to consider. It translates to 'not only…but also…' or 'of course…and also…'."},{"id":"96a396dae003fe30","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"Noun1 + はもとより, Noun2 + も"},{"id":"e0bd3d140aa9e4b7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-143"},"match":"id","status":"reviewed","value":"はもとより: X goes without saying, and Y too (英語はもとより)."},{"id":"6bbaf03992aa7e5f","role":"label","field":"family","source":{"source":"gokan","ref":"not-only-but-also"},"match":"id","status":"reviewed","value":"Not Only But Also (Emphatic Addition)","of":{"kind":"family","id":"not-only-but-also"}}]},"n2-143#478aa8094d39":{"renderings":[{"id":"bb4c6371114fde0a","role":"translation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"I'm studying not only English, but also Spanish."}]},"n2-143#7ad8e8a60844":{"renderings":[{"id":"50eec685937c2288","role":"translation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"She’s not only good at cooking, but also at making sweets."}]},"n2-143#be2c684f5e69":{"renderings":[{"id":"2564023bfa14d719","role":"translation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"This hotel not only has clean rooms but also great service."}]},"n2-143#8c95dd29106c":{"renderings":[{"id":"b73c67da0a897ad1","role":"translation","source":{"source":"hanabira","ref":"n2-143"},"match":"id","status":"imported","value":"He’s not only good at music, but also skilled at drawing."}]}}}