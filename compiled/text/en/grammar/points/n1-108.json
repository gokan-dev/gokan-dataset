{"kind":"grammar","lang":"en","entities":{"n1-108":{"renderings":[{"id":"c9963546d5ed8cfe","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"Expresses the idea of 'through' or 'via'; going through some process or phase."},{"id":"0ce143f6d0baf507","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"The を経て grammar point is used to express the concept of going through some process, phase, place, or period of time as a means of achieving something or reaching some end point. It can be literally translated as 'through' or 'via' in English, and can be used both literally and metaphorically."},{"id":"5e51e1b75982c67d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"Noun + を経て"},{"id":"8a99c53a881c786c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-108"},"match":"id","status":"reviewed","value":"Formal, literary \"via/through (a process or stage)\" - describes a path or progression."},{"id":"847d6f1b7ffb4bde","role":"label","field":"family","source":{"source":"gokan","ref":"through"},"match":"id","status":"reviewed","value":"Through (Via / Over A Range)","of":{"kind":"family","id":"through"}}]},"n1-108#45d7769b866b":{"renderings":[{"id":"19d43a3a366f9bda","role":"translation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"He achieved success through hardships."}]},"n1-108#b36a3e4af476":{"renderings":[{"id":"dab0fe808a471f2c","role":"translation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"She returned to Japan via New York."}]},"n1-108#4a727db6295f":{"renderings":[{"id":"0b92c432bdf2af3b","role":"translation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"We made a decision through a long discussion."}]},"n1-108#e9a77d5b67d7":{"renderings":[{"id":"9510f39ee2e4b2a6","role":"translation","source":{"source":"hanabira","ref":"n1-108"},"match":"id","status":"imported","value":"Through a lot of training, he reached a master's level."}]}}}