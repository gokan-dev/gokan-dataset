{"kind":"grammar","lang":"en","entities":{"n3-129":{"renderings":[{"id":"e4c97e14425b3095","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"Expresses inability to completely finish or do something."},{"id":"b1708baa26baaea8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"The ～切れない grammar point is used to express the inability to fully complete, finish, or do something. It is formed by attaching 切れない to the stem of a verb. It often implies that some portion of the action is done, but finishing it entirely is not possible for some reason."},{"id":"fd709d1004f02be5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"Verb-stem + 切れない"},{"id":"f24c6f1bd655b3cc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-129"},"match":"id","status":"reviewed","value":"ます stem + 切れない: can't do it all (食べ切れない)."},{"id":"346651d354f1ea02","role":"label","field":"family","source":{"source":"gokan","ref":"aspect-verbs"},"match":"id","status":"reviewed","value":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","of":{"kind":"family","id":"aspect-verbs"}}]},"n3-129#7041bd7024b9":{"renderings":[{"id":"71a320ac6e153f6b","role":"translation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"I cannot finish reading this book in one night."}]},"n3-129#43c27497a250":{"renderings":[{"id":"9d67718f1ff2149a","role":"translation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"He was so happy that he couldn't stop crying."}]},"n3-129#36e63d7ae044":{"renderings":[{"id":"7481baca4327c97b","role":"translation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"I cannot finish cleaning this room in one day."}]},"n3-129#820724bc9d79":{"renderings":[{"id":"0455e30de2e98c58","role":"translation","source":{"source":"hanabira","ref":"n3-129"},"match":"id","status":"imported","value":"She has so many worries that she can't finish talking about them."}]}}}