{"kind":"grammar","lang":"en","entities":{"n4-083":{"renderings":[{"id":"d7d213bfcaaec9d6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"Indicates equal distribution; 'each', 'per', 'apiece'."},{"id":"2601e1f5e986c4fd","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"The ～ずつ grammar point is used to express an equal distribution of something, whether it is an action, an amount, or an item. It is translated as 'each', 'per', or 'apiece' in English."},{"id":"a17c38bb010fbaa9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"Noun + ずつ"}]},"n4-083#784bcb08ff1f":{"renderings":[{"id":"4e0c721c84737fdf","role":"translation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"I will distribute 2 apples each."}]},"n4-083#2ca93d12b02a":{"renderings":[{"id":"c8d914da0f0d5752","role":"translation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"We each clean once per week."}]},"n4-083#49c4a77c53cb":{"renderings":[{"id":"41d99876230bac23","role":"translation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"Everyone walked the same distance, one step at a time."}]},"n4-083#0c44df3d5586":{"renderings":[{"id":"0a5485b032bdf972","role":"translation","source":{"source":"hanabira","ref":"n4-083"},"match":"id","status":"imported","value":"She gave one present to each child."}]}}}