{"kind":"grammar","lang":"en","entities":{"n2-090":{"renderings":[{"id":"26fdede9a883bbbe","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"Expresses that something is natural or expected."},{"id":"25a082df27455504","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"The ～て当然だ grammar point is used to express that something is natural, obvious, or expected under the circumstances. It can be translated as 'it's natural that', 'as expected', or 'no wonder' in English."},{"id":"3ea05f7d612e09d0","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"Verb-て form + 当然だ"},{"id":"e7f26b9726c9a19f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-090"},"match":"id","status":"reviewed","value":"て当然だ: it is only natural that (怒って当然だ)."},{"id":"5c23c7b563fc5ee4","role":"label","field":"family","source":{"source":"gokan","ref":"natural"},"match":"id","status":"reviewed","value":"Naturally (Of Course / Understandably)","of":{"kind":"family","id":"natural"}}]},"n2-090#64b6d15ece12":{"renderings":[{"id":"a542edd0ae4d5ccd","role":"translation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"Since he studies every day, it's only natural that he passes the exam."}]},"n2-090#01954cbb1646":{"renderings":[{"id":"9fa5cabed2df5f26","role":"translation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"Because that restaurant’s food is delicious, no wonder its reservations are always full."}]},"n2-090#824d467174c6":{"renderings":[{"id":"03520f9a432b18ae","role":"translation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"She practices every night, so it's natural that she becomes skilled."}]},"n2-090#5a4580ef3752":{"renderings":[{"id":"ae28f068d10eb0a0","role":"translation","source":{"source":"hanabira","ref":"n2-090"},"match":"id","status":"imported","value":"He has succeeded at his job, so it's only natural that he's become wealthy."}]}}}