{"kind":"grammar","lang":"en","entities":{"n2-110":{"renderings":[{"id":"fdaf4d07dce7d13b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"Expresses a natural consequence or a change that occurs according to something else; 'as', 'with', 'in accordance with'."},{"id":"c531154b468c7019","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"The ～にしたがって grammar point is used to express a natural consequence or a change that occurs according to something else. It can be translated as 'as', 'with', or 'in accordance with' in English. This grammar point is used with nouns and can be used to show a change in proportion or in accordance with a rule or principle."},{"id":"f3bb5c4f2c8ae27e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"Noun + にしたがって"},{"id":"26476b4b162d697a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-110"},"match":"id","status":"reviewed","value":"\"As/with/in accordance with (a rule or guideline)\"."},{"id":"3ce38c8d2bd06579","role":"label","field":"family","source":{"source":"gokan","ref":"according-to"},"match":"id","status":"reviewed","value":"According To (As Instructed)","of":{"kind":"family","id":"according-to"}}]},"n2-110#518f2f1cf7fc":{"renderings":[{"id":"136b7b83e467a9f6","role":"translation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"As it grows, the leaves of this plant become larger."}]},"n2-110#a13f240fba91":{"renderings":[{"id":"611db1f7509bb6c8","role":"translation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"Please assemble the furniture according to the instructions."}]},"n2-110#65ebcd66eedf":{"renderings":[{"id":"ff4a0fd607370956","role":"translation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"As people age, their physical strength declines."}]},"n2-110#98f47bff4eae":{"renderings":[{"id":"749ce22c86873b62","role":"translation","source":{"source":"hanabira","ref":"n2-110"},"match":"id","status":"imported","value":"It is common for the heart rate to increase with exercise."}]}}}