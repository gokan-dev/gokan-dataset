{"kind":"grammar","lang":"en","entities":{"n5-135":{"renderings":[{"id":"6f20bf9f6019708d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported","value":"Often used to express 'doing something well' or 'often'."},{"id":"0e3763a40be3d235","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported","value":"The よく～ grammar point is used to express that someone does something well, frequently, or often. It is often placed before the verb and can also mean 'well done' or 'good job' when praising someone's action."},{"id":"9145a28a7cff29a8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported","value":"よく + Verb-casual"},{"id":"4f7ef756324c2595","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-135"},"match":"id","status":"reviewed","value":"'Often' with a verb (よく行く); also 'well' (よく分かる)."},{"id":"d78d4d222abb81b2","role":"label","field":"family","source":{"source":"gokan","ref":"frequency"},"match":"id","status":"reviewed","value":"Frequency (Usually / Often / Sometimes)","of":{"kind":"family","id":"frequency"}}]},"n5-135#fcc577ff8dc4":{"renderings":[{"id":"697bab6f51cac710","role":"translation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported","value":"He studies often."}]},"n5-135#5ea0e4769132":{"renderings":[{"id":"88095576219fe89d","role":"translation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported","value":"She often cooks."}]},"n5-135#e9bf9e2450b2":{"renderings":[{"id":"e7485ca1ffc2ceee","role":"translation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported","value":"I used to play a lot with my old friends."}]},"n5-135#15ee85b2d097":{"renderings":[{"id":"c317753ad5c46ca2","role":"translation","source":{"source":"hanabira","ref":"n5-135"},"match":"id","status":"imported",