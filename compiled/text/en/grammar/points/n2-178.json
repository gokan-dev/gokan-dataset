{"kind":"grammar","lang":"en","entities":{"n2-178":{"renderings":[{"id":"a5f87009ea9117e0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"Expresses 'since' or 'as long as' in a conditional context."},{"id":"6ecfe5aa88621979","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"The ～以上 grammar point is used to express a condition or requirement, and it can be translated as 'since', 'as long as', or 'if'. It often emphasizes that if a certain condition is met, a certain action or consequence will follow."},{"id":"02b650ff1a988c82","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"Verb-casual + 以上, い-Adjective + 以上, な-Adjective + な以上, Noun + の以上"},{"id":"35f8272e2e986c1c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-178"},"match":"id","status":"reviewed","value":"\"Given that/since (this is the case), as long as it stands\"."},{"id":"8eb0b4b0b42b219f","role":"label","field":"family","source":{"source":"gokan","ref":"as-long-as"},"match":"id","status":"reviewed","value":"As Long As (To That Extent)","of":{"kind":"family","id":"as-long-as"}}]},"n2-178#ef2c0bb059f0":{"renderings":[{"id":"a390678b474c994b","role":"translation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"Since he's busy, it would be pointless to try helping him."}]},"n2-178#8cfdb2988b43":{"renderings":[{"id":"5030a0e024b51f72","role":"translation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"Since I made a promise, I should keep it."}]},"n2-178#a6fc46832994":{"renderings":[{"id":"64361c0c9ee97488","role":"translation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"As long as the deadline is near, I have to work with all my might."}]},"n2-178#1015b4e2a267":{"renderings":[{"id":"635883a8be7d84b0","role":"translation","source":{"source":"hanabira","ref":"n2-178"},"match":"id","status":"imported","value":"Since she's a college student, studying should be her priority."}]}}}