{"kind":"grammar","lang":"en","entities":{"n4-064":{"renderings":[{"id":"e557bc12b5013bbb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"Used to express that something happens sometimes or has happened before."},{"id":"e2ccafcc14ee8d61","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"The grammar point る ことがある is used to express that something occurs sometimes or has occurred in the past. It indicates that the action is not a regular or constant event, but rather something that takes place occasionally or has happened at least once."},{"id":"9c01205da586ca45","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"Verb-dictionary form + ことがある"},{"id":"32307ed0fb7a766b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-064"},"match":"id","status":"reviewed","value":"Dictionary form + ことがある: 'sometimes does' (遅れることがある). Polarity is the only difference: Verb-dictionary + ことがある is 'there are times when I do', Verb-ない + ことがある is 'there are times when I don't'."},{"id":"8c9f3aa97389b285","role":"label","field":"family","source":{"source":"gokan","ref":"experience"},"match":"id","status":"reviewed","value":"Experience And Occasion (Have Done / Sometimes Do)","of":{"kind":"family","id":"experience"}}]},"n4-064#2a09a552ab9f":{"renderings":[{"id":"ce631c81d3be3bf9","role":"translation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"He is sometimes late."}]},"n4-064#c7fec6dbce98":{"renderings":[{"id":"7dded826a2770642","role":"translation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"I sometimes oversleep."}]},"n4-064#0f297386a3d2":{"renderings":[{"id":"1a721b46dccb4e70","role":"translation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"She sometimes sings songs."}]},"n4-064#e91e271c01b4":{"renderings":[{"id":"9977f6cd453c981c","role":"translation","source":{"source":"hanabira","ref":"n4-064"},"match":"id","status":"imported","value":"When I was a child, I sometimes climbed mountains."}]},"n4-064#44a81b0bbe03":{"renderings":[{"id":"e1bee43af93f7537","role":"translation","source":{"source":"hanabira","ref":"n4-050"},"match":"id","status":"imported","value":"There are times when he doesn't attend meetings."}]},"n4-064#b394c7cb77ab":{"renderings":[{"id":"304265e83db14cfe","role":"translation","source":{"source":"hanabira","ref":"n4-050"},"match":"id","status":"imported","value":"There are occasions when this train doesn't come on time."}]},"n4-064#7cf5359713da":{"renderings":[{"id":"90777ffcc5122bf8","role":"translation","source":{"source":"hanabira","ref":"n4-050"},"match":"id","status":"imported","value":"There are times when I don't eat breakfast."}]},"n4-064#31e97edd522d":{"renderings":[{"id":"12f3425f22e41509","role":"translation","source":{"source":"hanabira","ref":"n4-050"},"match":"id","status":"imported","value":"There are occasions when she doesn't answer the phone."}]}}}