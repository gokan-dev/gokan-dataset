{"kind":"grammar","lang":"en","entities":{"n2-111":{"renderings":[{"id":"34c78e1a06389e98","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"Express a point of view; 'from the perspective of', 'if I were'."},{"id":"0482534171d76085","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"The ～にしたら grammar point is used to express a point of view or opinion from someone else's perspective. It can be translated as 'from the perspective of' or 'if I were' in English. The formation differs depending on whether it is used with a noun or a pronoun."},{"id":"b563bfe22ebb6b59","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"Noun + にしたら, Pronoun + にしたら"},{"id":"e67f8df4416be311","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-111"},"match":"id","status":"reviewed","value":"Neutral \"if you ask.../from (someone)'s perspective\" - often used for a third party's viewpoint."},{"id":"251569c15f31ac19","role":"label","field":"family","source":{"source":"gokan","ref":"perspective"},"match":"id","status":"reviewed","value":"Perspective (From The Standpoint Of)","of":{"kind":"family","id":"perspective"}}]},"n2-111#579eae0cbb28":{"renderings":[{"id":"a7868bc55a2060cf","role":"translation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"From his perspective, he probably wants to go home early."}]},"n2-111#71b9f19fc77d":{"renderings":[{"id":"8eef9b5090b331d8","role":"translation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"If I were the children, this story might be boring."}]},"n2-111#cb631f07cb96":{"renderings":[{"id":"76f0b668aff6131e","role":"translation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"From my perspective, I think that present is wonderful."}]},"n2-111#456f0390af7b":{"renderings":[{"id":"9e2081c7f466f5b8","role":"translation","source":{"source":"hanabira","ref":"n2-111"},"match":"id","status":"imported","value":"If I were her, I would not like this movie."}]}}}