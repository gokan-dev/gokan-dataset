{"kind":"grammar","lang":"en","entities":{"n2-028":{"renderings":[{"id":"badeb4bbcb6a945f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"Used to provide a reason or explanation based on one's knowledge about the noun; 'since', 'because', 'knowing'."},{"id":"ffc1acc5ee094e11","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"The の ことだから (no koto dakara) grammar point is used when giving a reason or explanation based on one’s knowledge or understanding of a particular person or thing. It often implies 'given that this is the kind of person/thing it is'."},{"id":"3cc18c1f3d27bc43","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"Noun + のことだから"},{"id":"a6fe8bc446b56be9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-028"},"match":"id","status":"reviewed","value":"Noun のことだから: knowing what X is like, I expect (彼のことだから)."},{"id":"98641544bada2a98","role":"label","field":"family","source":{"source":"gokan","ref":"befitting"},"match":"id","status":"reviewed","value":"Befitting (As Expected Of / Unbecoming Of)","of":{"kind":"family","id":"befitting"}}]},"n2-028#5daba72efdb2":{"renderings":[{"id":"47f9dc07ea6d92fe","role":"translation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"Since he’s good at cooking, he’ll probably make delicious food."}]},"n2-028#356799b22de8":{"renderings":[{"id":"b8ff4ef4211bb7e1","role":"translation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"Because she’s always late, she might be late again today."}]},"n2-028#a7daff5ab421":{"renderings":[{"id":"2535ddd25bee7fba","role":"translation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"Since it’s a cheap store, it should sell a lot."}]},"n2-028#6ce1b12c2489":{"renderings":[{"id":"d6d701b98f9d92d7","role":"translation","source":{"source":"hanabira","ref":"n2-028"},"match":"id","status":"imported","value":"Knowing he likes dramas, it’d be good to talk about the latest shows."}]}}}