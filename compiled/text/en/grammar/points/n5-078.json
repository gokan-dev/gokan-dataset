{"kind":"grammar","lang":"en","entities":{"n5-078":{"renderings":[{"id":"86c1930331634b12","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"Expresses a contrast or contradiction; 'but', 'however', 'even though'."},{"id":"792c8b4a891fcadb","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"The ～けれど grammar point is used to express a contrast or contradiction between two statements. It can be translated as 'but', 'however', or 'even though' in English. This grammar point is slightly more formal than けど."},{"id":"a8cda066c218acdf","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"Verb-casual + けれど / い-Adjective + けれど / な-Adjective + だけれど / Noun + だけれど"},{"id":"dbbbd9367f846295","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-078"},"match":"id","status":"reviewed","value":"Slightly more formal than けど but still conversational; safe in most spoken contexts."},{"id":"a13bf53f446f3f0d","role":"label","field":"family","source":{"source":"gokan","ref":"contradiction"},"match":"id","status":"reviewed","value":"Contradiction (But / However)","of":{"kind":"family","id":"contradiction"}}]},"n5-078#81769bbdf189":{"renderings":[{"id":"7e28c150fb9b7492","role":"translation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"Even though it's cold today, I'll go for a walk."}]},"n5-078#3fae9a21003d":{"renderings":[{"id":"7e298b7a6e8e75ff","role":"translation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"He is kind, but a little scary."}]},"n5-078#09400915475c":{"renderings":[{"id":"9dd0c654462acd76","role":"translation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"This room is small, but it's bright."}]},"n5-078#bcf58cd12153":{"renderings":[{"id":"57546660a37120bf","role":"translation","source":{"source":"hanabira","ref":"n5-078"},"match":"id","status":"imported","value":"She is sick, but she works every day."}]}}}