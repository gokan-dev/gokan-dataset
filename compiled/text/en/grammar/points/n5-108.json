{"kind":"grammar","lang":"en","entities":{"n5-108":{"renderings":[{"id":"8bf3db91d95c0fed","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"Express that something cannot be found anywhere or in any place; 'nowhere', 'in no place'."},{"id":"a23711246bf7f3d8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"The どこも～ないです grammar point is used to express that something cannot be found anywhere or in any place. It can be translated as 'nowhere' or 'in no place' in English. It is used in combination with a negative verb (ないです) to indicate the absence of something."},{"id":"b17348790898dc81","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"どこも + Verb-negative"},{"id":"c2df1e6b0c39a32d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-108"},"match":"id","status":"reviewed","value":"Slightly more conversational variant, ないです instead of ません."}]},"n5-108#20c6499f9892":{"renderings":[{"id":"ef144b3f0a0a2d62","role":"translation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"I can't find fans anywhere."}]},"n5-108#be659022c997":{"renderings":[{"id":"3390979855415383","role":"translation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"There are no delicious ramen shops anywhere in this town."}]},"n5-108#688f025b9bed":{"renderings":[{"id":"b2f830586431e961","role":"translation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"There is no parking anywhere."}]},"n5-108#27eb46e62606":{"renderings":[{"id":"e70afe1595141d2b","role":"translation","source":{"source":"hanabira","ref":"n5-108"},"match":"id","status":"imported","value":"There are no seats available anywhere."}]}}}