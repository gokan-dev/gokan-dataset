{"kind":"grammar","lang":"en","entities":{"n3-097":{"renderings":[{"id":"a2ef52cbaccddf2b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"Used to express a wish or hope for oneself or someone else."},{"id":"a801acc48df76d58","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"The ～ますように grammar point is used to express a wish or hope. It is often used as a closing phrase in letters or messages, and can be applied to both oneself and others. The phrase is typically used with the ます form of the verb, with the final る replaced by ように."},{"id":"de95503823f3e967","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"Verb-ます form, remove final る + ように"},{"id":"a6318834ac0fa30f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-097"},"match":"id","status":"reviewed","value":"ますように: a prayer or wish (合格しますように)."},{"id":"d6e1d43571c480f1","role":"label","field":"family","source":{"source":"gokan","ref":"wish"},"match":"id","status":"reviewed","value":"Wish And Hope (I Hope / If Only)","of":{"kind":"family","id":"wish"}}]},"n3-097#f39d23657a98":{"renderings":[{"id":"08c79f4c816ee4a3","role":"translation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"I hope I get good grades on tomorrow's test."}]},"n3-097#8ea3e0a9451d":{"renderings":[{"id":"aa0381cf1f26a7ea","role":"translation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"I hope he comes back safely."}]},"n3-097#0208fcf4d7cb":{"renderings":[{"id":"f3c48f9462537a1e","role":"translation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"I hope everyone stays healthy."}]},"n3-097#441b1077e605":{"renderings":[{"id":"d2544ad7d80554f7","role":"translation","source":{"source":"hanabira","ref":"n3-097"},"match":"id","status":"imported","value":"I hope she becomes happy."}]}}}