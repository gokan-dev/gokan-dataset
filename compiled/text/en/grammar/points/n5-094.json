{"kind":"grammar","lang":"en","entities":{"n5-094":{"renderings":[{"id":"95bdd3e42440f7a7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"Express 'nobody' or 'no one' in negative sentences."},{"id":"49156433a8e19ccb","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"The grammar point だれも is used in combination with a negative form of the verb, usually ません, to express the idea of 'nobody' or 'no one' doing something. It is used with questions or statements and can be translated as 'nobody' or 'no one' in English."},{"id":"85c9e0180cda1901","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"だれも + Verb-negative (ません)"},{"id":"fe98c39850193ba1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-094"},"match":"id","status":"reviewed","value":"'No one': だれも needs a negative verb (だれも来ませんでした). With an affirmative, だれでも."},{"id":"51a79d989bbdb41e","role":"label","field":"family","source":{"source":"gokan","ref":"who"},"match":"id","status":"reviewed","value":"Who (Someone / Anyone / No One)","of":{"kind":"family","id":"who"}}]},"n5-094#bd88e282572c":{"renderings":[{"id":"273a17c381621a57","role":"translation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"No one knows the secret."}]},"n5-094#8356ddd91540":{"renderings":[{"id":"35a23be20b57c38e","role":"translation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"Nobody answered that question."}]},"n5-094#b610ea57b90c":{"renderings":[{"id":"948440d6eefe49eb","role":"translation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"Nobody will help him."}]},"n5-094#5b58cca708cd":{"renderings":[{"id":"56c16bf7acc2d430","role":"translation","source":{"source":"hanabira","ref":"n5-094"},"match":"id","status":"imported","value":"No one wants to watch that movie."}]}}}