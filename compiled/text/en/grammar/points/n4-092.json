{"kind":"grammar","lang":"en","entities":{"n4-092":{"renderings":[{"id":"76e72bfee260fd8d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"Used to quote, define, or specify a noun."},{"id":"5f99f83c84b5d557","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"The ～っていう grammar point is used for quoting, defining, or specifying a noun. It can be translated as 'called', 'that is to say', or 'I mean' in English. This expression is similar to ～という, but it is more casual and commonly used in spoken conversations."},{"id":"431e92359d00999c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"Noun/Adjective/Verb + っていう + Noun"},{"id":"21f117832f3e6b3f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-092"},"match":"id","status":"reviewed","value":"Casual という: 'called' or 'that says', in conversation (田中っていう人)."},{"id":"71737f2ed7047fb3","role":"label","field":"family","source":{"source":"gokan","ref":"quoting"},"match":"id","status":"reviewed","value":"Called / Quoting (Named / They Say)","of":{"kind":"family","id":"quoting"}}]},"n4-092#af388ff299c8":{"renderings":[{"id":"cbbe5324b926e344","role":"translation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"I love the dish called pizza."}]},"n4-092#278d0fee4b59":{"renderings":[{"id":"791c3289316f021d","role":"translation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"That man (called ‘kare’) is really interesting."}]},"n4-092#ae32ec74ef56":{"renderings":[{"id":"bcbd205b0250a521","role":"translation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"This movie, I mean, is really touching."}]},"n4-092#31748791ff86":{"renderings":[{"id":"f5147409cf0ac6b0","role":"translation","source":{"source":"hanabira","ref":"n4-092"},"match":"id","status":"imported","value":"The store she's talking about, I mean, is not here."}]}}}