{"kind":"grammar","lang":"en","entities":{"n3-029":{"renderings":[{"id":"0b843a48ffa952d7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"Shows the result or consequence of a previous action or situation; 'as a result', 'in consequence'."},{"id":"397fa71627fa0720","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"The ～その結果 grammar point is used to show the result, outcome, or consequence of a previous action or situation. It can be translated as 'as a result', 'in consequence', or 'therefore' in English. It is typically placed between two statements to link cause and effect."},{"id":"10f89f421b83bdc8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"Situation/ACTION 1 + その結果 + RESULT"},{"id":"15069ddb89dbc1fb","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-029"},"match":"id","status":"reviewed","value":"その結果: as a result of that (sentence-initial)."},{"id":"a369fa147f888d6d","role":"label","field":"family","source":{"source":"gokan","ref":"therefore"},"match":"id","status":"reviewed","value":"Therefore (Formal Cause-Result)","of":{"kind":"family","id":"therefore"}}]},"n3-029#d647524d89ba":{"renderings":[{"id":"438e79c11e32aa5b","role":"translation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"She practiced every day. As a result, she won the match."}]},"n3-029#05733d6939dd":{"renderings":[{"id":"e7f143fc009810dc","role":"translation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"The company went bankrupt. As a result, he lost his job."}]},"n3-029#d15336f5bbd9":{"renderings":[{"id":"4c2e4d11bedff4ea","role":"translation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"We were late. As a result, we couldn't catch the train."}]},"n3-029#5f9fafb2f8f8":{"renderings":[{"id":"82bab762f3faaf68","role":"translation","source":{"source":"hanabira","ref":"n3-029"},"match":"id","status":"imported","value":"He neglected his studies. As a result, he failed the exam."}]}}}