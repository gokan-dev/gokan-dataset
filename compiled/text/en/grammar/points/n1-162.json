{"kind":"grammar","lang":"en","entities":{"n1-162":{"renderings":[{"id":"3ed56f8d91808dac","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"Expresses doing something unintentionally or without conscious thought."},{"id":"e7d29f831d70c7e3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"VerbるともなしにVerb is used to show that you do some action without particularly intending to. Often you ‘end up doing’ something by habit or casually."},{"id":"fc13e4a971fe2553","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"Verb-dictionary form + ともなしに + Verb"},{"id":"19db20cd9c5c7037","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-162"},"match":"id","status":"reviewed","value":"ともなしに: without really meaning to. Same as ともなく."},{"id":"02607eba4a2d65cf","role":"label","field":"family","source":{"source":"gokan","ref":"without-meaning-to"},"match":"id","status":"reviewed","value":"Without Meaning To","of":{"kind":"family","id":"without-meaning-to"}}]},"n1-162#cfe95f0ebcac":{"renderings":[{"id":"33ae77d00bfde66a","role":"translation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"I ended up falling asleep while reading the book without really meaning to."}]},"n1-162#68a52a5ff21d":{"renderings":[{"id":"7b7d107eff893759","role":"translation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"While writing a letter casually, I ended up confessing my true feelings to him."}]},"n1-162#f28f07909050":{"renderings":[{"id":"7ae8b2b3ff834231","role":"translation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"While I was walking with no particular destination, I found a new cafe."}]},"n1-162#40a7cc642daa":{"renderings":[{"id":"dc355a06565a53c7","role":"translation","source":{"source":"hanabira","ref":"n1-162"},"match":"id","status":"imported","value":"As I was absentmindedly organizing clothes, I came across some old photos."}]}}}