{"kind":"grammar","lang":"en","entities":{"n1-239":{"renderings":[{"id":"9ec548635a730c24","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"Indicates no problem or obstacle; 'it’s fine if...', 'there’s no issue'."},{"id":"8758293c4da0b685","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"The ～差し支えない grammar point expresses that doing something (or something occurring) is not a problem and causes no inconvenience. It’s often used in polite or formal situations."},{"id":"dbee74c3b701ff2a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"Verb-て form + も差し支えない, Noun + が差し支えない"},{"id":"b6e4d2e848a3add9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-239"},"match":"id","status":"reviewed","value":"て(も)差し支えない: formal 'it is fine to', permission."},{"id":"52331782dd11468f","role":"label","field":"family","source":{"source":"gokan","ref":"prohibition"},"match":"id","status":"reviewed","value":"Permission And Prohibition (May / Must Not)","of":{"kind":"family","id":"prohibition"}}]},"n1-239#784a599f3dba":{"renderings":[{"id":"52d5477fb6a4fb7c","role":"translation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"It’s no problem if you’re a bit late."}]},"n1-239#ec9a6b9291de":{"renderings":[{"id":"a3910fcc7d8d14fd","role":"translation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"It doesn’t matter if the room is slightly messy."}]},"n1-239#cd7f8f2184fa":{"renderings":[{"id":"89c5f0d68b83c747","role":"translation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"It’s not an issue even if it rains."}]},"n1-239#a4565b997291":{"renderings":[{"id":"7ecfeee817fe18da","role":"translation","source":{"source":"hanabira","ref":"n1-239"},"match":"id","status":"imported","value":"Is it okay (no problem) for him to be here?"}]}}}