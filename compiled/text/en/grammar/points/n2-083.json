{"kind":"grammar","lang":"en","entities":{"n2-083":{"renderings":[{"id":"c0a7d67ff80bb598","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"Expresses an intense emotional or physical state; 'extremely', 'can’t help but'."},{"id":"a0832ccbbbd63c7a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"The pattern ～(て)しょうがない (or 〜でしょうがない) indicates a condition or feeling so intense that one is almost 'overcome' by it. It’s often used with emotions (e.g. 退屈で(しょうがない), 嬉しくてしょうがない, 寒くてしょうがない)."},{"id":"4841a0156e9f9525","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"い-Adjective(く) + てしょうがない / な-Adjective + で(は)しょうがない / Verb-て form + しょうがない"},{"id":"6d08bab91d7842d4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-083"},"match":"id","status":"reviewed","value":"Casual, spoken \"unbearably/can't help but\" - the everyday way to express an intense feeling."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n2-083#3d91c97e4bcf":{"renderings":[{"id":"721dbec0a6ec0723","role":"translation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"I’m extremely bored today."}]},"n2-083#19ad7040b673":{"renderings":[{"id":"41c0cb0f71685edb","role":"translation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"I’m so anxious because the exam is coming up."}]},"n2-083#31b6e77646f5":{"renderings":[{"id":"43352babae79d08d","role":"translation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"My head hurts so much I can’t stand it—I want to leave early."}]},"n2-083#6f576e178342":{"renderings":[{"id":"60336f69a21f4e6e","role":"translation","source":{"source":"hanabira","ref":"n2-083"},"match":"id","status":"imported","value":"I can’t help but keep thinking about the new game."}]}}}