{"kind":"grammar","lang":"en","entities":{"n2-116":{"renderings":[{"id":"24fcd73a95b53784","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-116"},"match":"id","status":"imported","value":"Express that something is 'nothing but' or 'none other than'."},{"id":"6f5a990ec1ec017d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-116"},"match":"id","status":"imported","value":"The ～にほかならない grammar point is used to emphasize that something is no more or no less than what is specified. It can be seen as a strong way to say that something is 'nothing but' or 'none other than'."},{"id":"a4d0f31256c057ea","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-116"},"match":"id","status":"imported","value":"Verb-plain + にほかならない, い-Adjective + にほかならない, な-Adjective + にほかならない, Noun + にほかならない"},{"id":"98a15113ac76be6d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-116"},"match":"id","status":"reviewed","value":"Emphatic literary \"nothing other than\" - asserts something is exactly and only this."},{"id":"0a7eb6991316e0ea","role":"label","field":"family","source":{"source":"gokan","ref":"exclusivity"},"match":"id","status":"reviewed","value":"Exclusivity (Only / Nothing But)","of":{"kind":"family","id":"exclusivity"}}]},"n2-116#fa8f72de69ed":{"renderings":[{"id":"0b49487735d4e902","role":"translation","source":{"source":"hanabira","ref":"n2-116"},"match":"id","status":"imported","value":"His success is nothing but hard work."}]},"n2-116#4b25f4e4d5b2":{"renderings":[{"id":"2c1c069b9011e30b","role":"translation","source":{"source":"hanabira","ref":"n2-116"},"match":"id","status":"imported","value":"This pain is nothing but the cold."}]},"n2-116#e09c4e4fbfd8":{"renderings":[{"id":"e2321ab645ec7611","role":"translation","source":{"source":"hanabira","ref":"n2-116"},"match":"id","status":"imported","value":"The cause of his failure is nothing but overconfidence."}]},"n2-116#2af