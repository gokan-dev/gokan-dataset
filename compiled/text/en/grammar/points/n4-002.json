{"kind":"grammar","lang":"en","entities":{"n4-002":{"renderings":[{"id":"50b2d193cb488b01","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"Express that A is not as much as B; 'not as... as', 'not... to the extent of'."},{"id":"305625758cff4329","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"The は B ほど～ありません grammar point is used to express that A is not as much as B or not to the same extent as B, emphasizing the difference. It can be translated as 'not as... as' or 'not... to the extent of' in English."},{"id":"7a3eceddacaaa077","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"A は B ほど Verb/adjective ありません"},{"id":"30a388e4426724a8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-002"},"match":"id","status":"reviewed","value":"'A is not as ~ as B': ほど always takes a negative predicate."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n4-002#3010ac497b91":{"renderings":[{"id":"08e223853d57b6e9","role":"translation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"Today is not as cold as yesterday."}]},"n4-002#258ea4e42355":{"renderings":[{"id":"0519d4134db13538","role":"translation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"He cannot speak English as well as I can."}]},"n4-002#9746dc3836e4":{"renderings":[{"id":"30e3eab3a828f641","role":"translation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"This restaurant is not as expensive as that restaurant."}]},"n4-002#4e46dbaa248a":{"renderings":[{"id":"375cd240ba1853af","role":"translation","source":{"source":"hanabira","ref":"n4-002"},"match":"id","status":"imported","value":"She is not as busy as him."}]}}}