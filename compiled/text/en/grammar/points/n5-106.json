{"kind":"grammar","lang":"en","entities":{"n5-106":{"renderings":[{"id":"593e2a66ea47df23","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"Express that an action doesn't take place anywhere; 'nowhere', 'not anywhere'."},{"id":"7393ec8cc56d8e5f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"The どこへも + Verb ないです grammar point is used to express a situation where an action doesn't occur or isn't applicable anywhere. It emphasizes a strong sense of not performing the action anywhere. Keep in mind that only negative verbs can follow 'どこへも' in this construction."},{"id":"1a4bbf78b8084fdb","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"どこへも + Verb in negative form (ないです)"},{"id":"617ce0ac8e325f5a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-106"},"match":"id","status":"reviewed","value":"Slightly more conversational variant, ないです instead of ません. (どこへも variant.)"}]},"n5-106#1a41845f5842":{"renderings":[{"id":"cc8003df921f7c61","role":"translation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"I'm not going anywhere this weekend."}]},"n5-106#07ec89d6a270":{"renderings":[{"id":"5ba23e6f3dcc2b31","role":"translation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"She didn't go shopping anywhere."}]},"n5-106#267d0644bc72":{"renderings":[{"id":"12299dd60b75c2f6","role":"translation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"It's not sold at any supermarket."}]},"n5-106#1e7c0018dd10":{"renderings":[{"id":"cf48d03b6e91c851","role":"translation","source":{"source":"hanabira","ref":"n5-106"},"match":"id","status":"imported","value":"I have no plans to go anywhere."}]}}}