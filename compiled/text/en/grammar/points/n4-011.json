{"kind":"grammar","lang":"en","entities":{"n4-011":{"renderings":[{"id":"f5b08378c87832cb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-011"},"match":"id","status":"imported","value":"Expresses 'while' or 'during' a specific period or time."},{"id":"d6e8092998b3f7db","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-011"},"match":"id","status":"imported","value":"The Noun の 間に grammar point is used to indicate a specific period or time during which an action takes place. It is often translated as 'while' or 'during' in English. This grammar point requires a noun to represent the time or period."},{"id":"019b4dbab54f4c9d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-011"},"match":"id","status":"imported","value":"Noun + の間に"},{"id":"b420f8357b0a595a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-011"},"match":"id","status":"reviewed","value":"Simple time-window marker - \"during (a period)\"."},{"id":"752b6fa31dd22e50","role":"label","field":"family","source":{"source":"gokan","ref":"time-window"},"match":"id","status":"reviewed","value":"Time Window (During / While It Lasts)","of":{"kind":"family","id":"time-window"}}]},"n4-011#eae3328b4f93":{"renderings":[{"id":"e146bb63a10a59df","role":"translation","source":{"source":"hanabira","ref":"n4-011"},"match":"id","status":"imported","value":"I will go to the bank during lunch break."}]},"n4-011#256f95b6e454":{"renderings":[{"id":"134d7a6c2025c46b","role":"translation","source":{"source":"hanabira","ref":"n4-011"},"match":"id","status":"imported","value":"I plan to go on an overseas trip during the summer vacation."}]},"n4-011#f15e4faafc53":{"renderings":[{"id":"563e00859adfd85a","role":"translation","source":{"source":"hanabira","ref":"n4-011"},"match":"id","status":"imported","value":"I went shopping while the kids were at school."}]}}}