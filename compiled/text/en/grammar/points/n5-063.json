{"kind":"grammar","lang":"en","entities":{"n5-063":{"renderings":[{"id":"9f1e98c1a3b43ac3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"Express 'not really' or 'not very'; used to soften a negative statement."},{"id":"cafb872d1e02e741","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"The あまり～ないです grammar point is used to express that something is 'not really' or 'not very' to a certain extent. It is often used to soften a negative statement. It can be used with verbs, い-adjectives, and な-adjectives in their negative forms."},{"id":"e6f4be19ba81dc0c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"あまり + Verb-ないform + です / あまり + い-Adjective-くない + です / あまり + な-Adjective-じゃない + です"}]},"n5-063#98f9eefc78c2":{"renderings":[{"id":"bce02e9bca801ac7","role":"translation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"I don't really eat much."}]},"n5-063#07124dcb8f90":{"renderings":[{"id":"f26c58ac9fd71b2b","role":"translation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"This movie is not really interesting."}]},"n5-063#2acbd66b54be":{"renderings":[{"id":"cc2bfc25927ce2aa","role":"translation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"He is not very kind."}]},"n5-063#45ded8cd97bd":{"renderings":[{"id":"2cad3e333a85bcb8","role":"translation","source":{"source":"hanabira","ref":"n5-063"},"match":"id","status":"imported","value":"I am not very good at Japanese."}]}}}