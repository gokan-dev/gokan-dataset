{"kind":"grammar","lang":"en","entities":{"n1-015":{"renderings":[{"id":"c7e3d1ecd007cb4e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"Expresses 'B cannot exist without A'; 'B only exists because of A'."},{"id":"3539614c5daf1b6b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"The 'Noun + あっての + Noun' pattern emphasizes that the second noun (B) exists only thanks to, or on the foundation of, the first noun (A). It's often translated as 'B is nothing without A' or 'B exists only because of A'."},{"id":"cecadde8c67db4d8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"Noun1 + あっての + Noun2"},{"id":"fbba4933a1f86735","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-015"},"match":"id","status":"reviewed","value":"Noun あっての Noun: B only exists thanks to A (お客様あっての店)."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n1-015#eea6a2c80a9a":{"renderings":[{"id":"4352770898a96cec","role":"translation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"I am who I am thanks to my family."}]},"n1-015#1db1637297c1":{"renderings":[{"id":"94e3a71d4171b5d2","role":"translation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"A business is nothing without its customers."}]},"n1-015#0f02884ee073":{"renderings":[{"id":"2648dd95d2f010da","role":"translation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"Success is nothing without practice."}]},"n1-015#424cb4521532":{"renderings":[{"id":"e7a780ae029f5256","role":"translation","source":{"source":"hanabira","ref":"n1-015"},"match":"id","status":"imported","value":"Work is nothing without your health."}]}}}