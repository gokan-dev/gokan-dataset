{"kind":"grammar","lang":"en","entities":{"n2-081":{"renderings":[{"id":"d1c579b0c3fe158c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"Indicates that something cannot be done before a certain action is completed; 'not until', 'only after'."},{"id":"64d15d7ac5c7c144","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"The ～てからでないと grammar point is used to express that an action cannot be done before another action has been completed. It can be translated as 'not until' or 'only after' in English. It attaches to a verb in the て-form, plus からでないと."},{"id":"e88b6128bc146a2a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"Verb-て + からでないと"},{"id":"fbabf20bd0ed7b34","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-081"},"match":"id","status":"reviewed","value":"てからでないと: not until you have first done X (宿題をしてからでないと)."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n2-081#3daecf3b0871":{"renderings":[{"id":"70752b6a0d38fedf","role":"translation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"You cannot go play until you’ve finished your homework."}]},"n2-081#0e5abdd854d8":{"renderings":[{"id":"fd7c12f3f2b16edc","role":"translation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"You cannot eat dessert until after having a meal."}]},"n2-081#1df13f39e058":{"renderings":[{"id":"b1cb7c6438904a3a","role":"translation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"You can’t watch the movie until after you buy a ticket."}]},"n2-081#5032d64547f5":{"renderings":[{"id":"bacbf8a78a9a5ffa","role":"translation","source":{"source":"hanabira","ref":"n2-081"},"match":"id","status":"imported","value":"You can’t take time off until the exam is over."}]}}}