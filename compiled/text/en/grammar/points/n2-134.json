{"kind":"grammar","lang":"en","entities":{"n2-134":{"renderings":[{"id":"0531595188d33c49","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"Express that something is understandable or reasonable."},{"id":"78679de22ef39ea7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"The ～のももっともだ grammar point is used to express that a situation, action, or feeling is understandable or reasonable, considering the circumstances. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"7310d5139108d3b8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"Verb-casual + のももっともだ, い-Adjective + のももっともだ, な-Adjective + なのももっともだ, Noun + なのももっともだ"},{"id":"9afe16fb9353e4cc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-134"},"match":"id","status":"reviewed","value":"のももっともだ: it's understandable that (怒るのももっともだ)."},{"id":"5c23c7b563fc5ee4","role":"label","field":"family","source":{"source":"gokan","ref":"natural"},"match":"id","status":"reviewed","value":"Naturally (Of Course / Understandably)","of":{"kind":"family","id":"natural"}}]},"n2-134#6ac6201ae04c":{"renderings":[{"id":"33d44e0cb5e9eaf6","role":"translation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"It's understandable that he is nervous."}]},"n2-134#7dedbb4cc3ea":{"renderings":[{"id":"122ea9be859778a5","role":"translation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"It's reasonable that this problem is difficult."}]},"n2-134#25ae6955a389":{"renderings":[{"id":"a7c0ea25a1a0f16e","role":"translation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"It's understandable that she is happy."}]},"n2-134#a10198d55c4b":{"renderings":[{"id":"7794d4ea2439cef3","role":"translation","source":{"source":"hanabira","ref":"n2-134"},"match":"id","status":"imported","value":"It's reasonable that he is the leader."}]}}}