{"kind":"grammar","lang":"en","entities":{"n1-244":{"renderings":[{"id":"bd3ff2555e827d3a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"Indicates that something is worthy or sufficient to be called/used as ~; 'worthy of', 'enough to ~'."},{"id":"cd2d605974474330","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"The classical pattern 'Noun + に足る + Noun' or 'Verb + に足る + Noun' means 'something is worthy of or sufficient for ~.' For instance, '信頼に足る人物' means 'a person worthy of trust.' It’s different from the everyday verb 足りる ('to be enough')."},{"id":"d5f84c983d0d133d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"Noun/Verb-dictionary form + に足る + Noun"},{"id":"03d00b96af19e067","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-244"},"match":"id","status":"reviewed","value":"に足る: worthy of (信頼に足る)."},{"id":"2e4e09ff35069847","role":"label","field":"family","source":{"source":"gokan","ref":"worth"},"match":"id","status":"reviewed","value":"Worth (Worth Doing / In Vain / Bearable)","of":{"kind":"family","id":"worth"}}]},"n1-244#937608400529":{"renderings":[{"id":"5959e4f1d9e0f48b","role":"translation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"He is a person worthy of trust."}]},"n1-244#5d1bc78174a0":{"renderings":[{"id":"f6a5893d0e729d81","role":"translation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"This novel is well worth reading."}]},"n1-244#1c87f588b3d1":{"renderings":[{"id":"88618356558696b0","role":"translation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"We've gathered enough data to be worth examining."}]},"n1-244#c085de6f0bf8":{"renderings":[{"id":"1b4686ff08b84d91","role":"translation","source":{"source":"hanabira","ref":"n1-244"},"match":"id","status":"imported","value":"I think his explanation is worthy of trust."}]}}}