{"kind":"grammar","lang":"en","entities":{"n1-145":{"renderings":[{"id":"1b8b7e88333d012c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-145"},"match":"id","status":"imported","value":"Means 'without even doing'."},{"id":"f1127bbe77ca5925","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-145"},"match":"id","status":"imported","value":"This pattern is used to express that one has not done (or not even tried to do) some action before proceeding to do something else. It emphasizes doing something 'without even' doing the prior action."},{"id":"c85e7b3adb6198f3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-145"},"match":"id","status":"imported","value":"Verb (masu stem) + もしないで"},{"id":"3296af52e82397ce","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-145"},"match":"id","status":"reviewed","value":"もしないで: without even doing, often a complaint (調べもしないで)."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n1-145#41809b384eae":{"renderings":[{"id":"0f8b75e321ce5247","role":"translation","source":{"source":"hanabira","ref":"n1-145"},"match":"id","status":"imported","value":"I wrote the answer without even investigating."}]},"n1-145#a1ac50ef9e24":{"renderings":[{"id":"3fd6fa7d0089933f","role":"translation","source":{"source":"hanabira","ref":"n1-145"},"match":"id","status":"imported","value":"He passed the test without even studying."}]},"n1-145#e89b2c7e36d6":{"renderings":[{"id":"fecbe80e83d94025","role":"translation","source":{"source":"hanabira","ref":"n1-145"},"match":"id","status":"imported","value":"She wrote her report without even reading the book."}]},"n1-145#8d72b3539791":{"renderings":[{"id":"a53cb49152367b89","role":"translation","source":{"source":"hanabira","ref":"n1-145"},