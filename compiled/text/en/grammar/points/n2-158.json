{"kind":"grammar","lang":"en","entities":{"n2-158":{"renderings":[{"id":"4ac6ea984f51557a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"Indicates 'as good as', 'virtually', or 'practically' the same as something."},{"id":"6f5c550d8223f16b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"「～も同然だ」 means something is practically the same as (X). It emphasizes that although it may not be literally identical, there is hardly any difference in reality."},{"id":"75ce85c9468727a5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"Noun + (も)同然だ, Verb-casual + (も)同然だ, etc."},{"id":"fdfd228c329c2bda","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-158"},"match":"id","status":"reviewed","value":"も同然だ: as good as, practically (家族も同然だ)."},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n2-158#d2bf477f34db":{"renderings":[{"id":"f038390fc4bdbb49","role":"translation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"I've known him for so long that he's practically family."}]},"n2-158#2a6531887dfd":{"renderings":[{"id":"3fdddc63f9920cdd","role":"translation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"Being late every single day is as good as not coming at all."}]},"n2-158#d3f40410078c":{"renderings":[{"id":"f0b2030a61e9819c","role":"translation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"She and I are childhood friends, practically like sisters."}]},"n2-158#2c8ae61bc5a3":{"renderings":[{"id":"33862dc19eb2178b","role":"translation","source":{"source":"hanabira","ref":"n2-158"},"match":"id","status":"imported","value":"With such a small salary, it's practically like working for free."}]}}}