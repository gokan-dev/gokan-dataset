{"kind":"grammar","lang":"en","entities":{"n5-014":{"renderings":[{"id":"dfa37556b90107b8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"Used to connect an い-adjective to a verb, modifying the verb (adverbial usage)."},{"id":"91e913e26429f5d6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"The い-Adjective + く + Verb grammar point transforms an い-adjective into its adverbial form, describing how the verb is performed. In English, this often corresponds to '-ly' adverbs (e.g., 'quickly', 'slowly')."},{"id":"c3923d2dcb9c07a2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"い-Adjective (remove い) + く + Verb"},{"id":"110993337f5b3b83","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-014"},"match":"id","status":"reviewed","value":"い-adjectives: drop い, add く (早く起きる). な-adjectives take に."},{"id":"bf3e0a24fdc411d3","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-014"},"match":"id","status":"reviewed","value":"i-adjective adverbial (く)"},{"id":"b16d8ba73398a4ab","role":"label","field":"family","source":{"source":"gokan","ref":"adverbial-form"},"match":"id","status":"reviewed","value":"Adjectives As Adverbs (Quickly / Quietly)","of":{"kind":"family","id":"adverbial-form"}}]},"n5-014#3ad4894f930f":{"renderings":[{"id":"2e56949f325707bc","role":"translation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"He ran quickly."}]},"n5-014#b777fb34fbb0":{"renderings":[{"id":"4e8802bd175d9a43","role":"translation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"I enjoyed eating this dish."}]},"n5-014#1c7c238ee208":{"renderings":[{"id":"343f8a87a11a083e","role":"translation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"She speaks kindly."}]},"n5-014#2fef6a31ca8b":{"renderings":[{"id":"b880d29049bb4742","role":"translation","source":{"source":"hanabira","ref":"n5-014"},"match":"id","status":"imported","value":"My mother is working busily."}]}}}