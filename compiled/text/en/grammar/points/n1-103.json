{"kind":"grammar","lang":"en","entities":{"n1-103":{"renderings":[{"id":"4f6b9c4771b00b7e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"Means 'as a turning point', 'since (time)', or 'from (time) on'."},{"id":"359382c08e7e364f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"The grammar point 'Noun を境にして' is used to indicate a significant change or turning point marked by a specific event or time. It means that after this boundary, some situation changes or a new state begins."},{"id":"2da8a6030393c8e1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"Noun + を境に(して)"},{"id":"2a19567911aa4ddf","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-103"},"match":"id","status":"reviewed","value":"を境に(して): with X as the dividing line (その日を境に)."},{"id":"df1f12cd56dbd438","role":"label","field":"family","source":{"source":"gokan","ref":"turning-point"},"match":"id","status":"reviewed","value":"Turning Point (Triggered By / From Then On)","of":{"kind":"family","id":"turning-point"}}]},"n1-103#3b7fe7731427":{"renderings":[{"id":"06194fff7c5bf419","role":"translation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"His personality changed completely since his father's death."}]},"n1-103#65d33d26cff0":{"renderings":[{"id":"0759133899a92e77","role":"translation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"I plan to take a vacation after the exam."}]},"n1-103#31291995857e":{"renderings":[{"id":"d864c1707c202254","role":"translation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"I intend to start a new life from spring onwards."}]},"n1-103#37cee0446a64":{"renderings":[{"id":"9de14198d79cd40b","role":"translation","source":{"source":"hanabira","ref":"n1-103"},"match":"id","status":"imported","value":"She began to take an interest in fashion from the time she entered school."}]}}}