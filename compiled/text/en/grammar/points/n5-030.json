{"kind":"grammar","lang":"en","entities":{"n5-030":{"renderings":[{"id":"7ca87238b8bcefed","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"Indicate a place or means for an action or situation; 'at, in, on', 'using', or 'by means of'."},{"id":"b108afe78e28430f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"The で grammar point is used to indicate a location, method, or tool for doing an action or for being in a situation. It can be translated as 'at, in, on', 'using', or 'by means of' in English. Nounで is formed by adding で after a noun."},{"id":"f3dd8e62f3fb5949","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"Noun + で"},{"id":"521b22518355b4c8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-030"},"match":"id","status":"reviewed","value":"で: where an action happens (図書館で勉強する), or the means (バスで)."},{"id":"50cc4031e27cad12","role":"label","field":"family","source":{"source":"gokan","ref":"place-particles"},"match":"id","status":"reviewed","value":"Place Particles (At / In / To)","of":{"kind":"family","id":"place-particles"}}]},"n5-030#e19f16c3aab3":{"renderings":[{"id":"2b3e8ca8784d2b4d","role":"translation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"I study at the library."}]},"n5-030#c9bca8e4c03c":{"renderings":[{"id":"d63c3e042ca19d20","role":"translation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"I go to school by bus."}]},"n5-030#00acc8029ca6":{"renderings":[{"id":"ae888ca91977e765","role":"translation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"I wrote it using a pencil."}]},"n5-030#1e9783cb0135":{"renderings":[{"id":"f3b2bc25c5a49548","role":"translation","source":{"source":"hanabira","ref":"n5-030"},"match":"id","status":"imported","value":"Let's talk in English."}]}}}