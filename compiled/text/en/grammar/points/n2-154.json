{"kind":"grammar","lang":"en","entities":{"n2-154":{"renderings":[{"id":"25e44fc1bc4f58ca","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"Expresses a strong negative suggestion or prohibition: 'should not', 'must not'."},{"id":"30976315944dae1a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"「～ものではない」 is used to indicate that something should not or must not be done. It often appears in written or formal contexts, meaning 'it is not proper to...' or 'you shouldn’t...'."},{"id":"e45a1b565da29207","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"Verb-dictionary form + ものではない"},{"id":"f94f442eae31d122","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-154"},"match":"id","status":"reviewed","value":"A social/moral prohibition - \"that's not the sort of thing one does\" - rather than a hard rule."},{"id":"52331782dd11468f","role":"label","field":"family","source":{"source":"gokan","ref":"prohibition"},"match":"id","status":"reviewed","value":"Permission And Prohibition (May / Must Not)","of":{"kind":"family","id":"prohibition"}}]},"n2-154#b8ba0ed85be5":{"renderings":[{"id":"ffb506ceb94f5707","role":"translation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"You should not say such a thing."}]},"n2-154#ac5a7450bb38":{"renderings":[{"id":"c2b16af16b317fe3","role":"translation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"You should not raise your voice in public places."}]},"n2-154#1b5627745a53":{"renderings":[{"id":"b67168b199168552","role":"translation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"You must not tell his secret to other people."}]},"n2-154#e585474edecb":{"renderings":[{"id":"b0501a698ce1b55e","role":"translation","source":{"source":"hanabira","ref":"n2-154"},"match":"id","status":"imported","value":"It's okay to play in safe places, but you should not play somewhere dangerous."}]}}}