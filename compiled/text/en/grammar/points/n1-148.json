{"kind":"grammar","lang":"en","entities":{"n1-148":{"renderings":[{"id":"4c0b796bc29bc0a8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"Expresses indecision: 'Should I do it or not?'."},{"id":"0c2eb4bcea07fead","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"This grammar shows hesitation about whether to do something or not. The volitional form plus まい (negative volitional) suggests an internal debate about two opposite choices of the *same* verb."},{"id":"1e02eaca8533df80","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"Verb-volitional form + か + Verb-volitional negative form (まい) + か"},{"id":"172cf9f98641698d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-148"},"match":"id","status":"reviewed","value":"\"Should I do X or not\" - expresses indecision about a single action."},{"id":"30f05beb6988b79b","role":"label","field":"family","source":{"source":"gokan","ref":"whether-or-not"},"match":"id","status":"reviewed","value":"Whether Or Not (To Do X)","of":{"kind":"family","id":"whether-or-not"}}]},"n1-148#d646b9e5acf8":{"renderings":[{"id":"516760442656c6b0","role":"translation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"I'm really unsure whether to talk to him or not."}]},"n1-148#f08ec013f137":{"renderings":[{"id":"9b1c154808f78882","role":"translation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"I'm wondering whether to take the exam or not."}]},"n1-148#5911c15c32df":{"renderings":[{"id":"cf1f2e9619fc51d7","role":"translation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"I'm considering whether to apologize to that person or not."}]},"n1-148#6a81f5edaf7d":{"renderings":[{"id":"d76e51bca8639792","role":"translation","source":{"source":"hanabira","ref":"n1-148"},"match":"id","status":"imported","value":"I'm worried about whether to continue my studies or not."}]}}}