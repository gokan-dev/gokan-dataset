{"kind":"grammar","lang":"en","entities":{"n3-121":{"renderings":[{"id":"41ad3cddf04c6153","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"Expresses that something is impossible or unreasonable; 'there's no way', 'can't be'."},{"id":"bce3f220bfe78de8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"The ～わけがない grammar point is used to show that something is impossible, non-existent, or unreasonable based on logic or context. It is often translated as 'there's no way' or 'it's impossible'."},{"id":"b46ec1db81791eee","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"Verb-casual + わけがない, い-Adjective + わけがない, な-Adjective + なわけがない, Noun + のわけがない"},{"id":"e06c848777078acd","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-121"},"match":"id","status":"reviewed","value":"\"There's no way/it's impossible\". (Near-duplicate of n2-162 - same construction, taught at both N2 and N3.)"},{"id":"6a9ffa925908f457","role":"label","field":"family","source":{"source":"gokan","ref":"unlikely-impossible"},"match":"id","status":"reviewed","value":"Unlikely / Impossible","of":{"kind":"family","id":"unlikely-impossible"}}]},"n3-121#da4d309cf043":{"renderings":[{"id":"0a509712029099ac","role":"translation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"There's no way he would say something like that."}]},"n3-121#a742fd85ad7f":{"renderings":[{"id":"5279ec295a5e3baf","role":"translation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"There's no way that restaurant tastes bad."}]},"n3-121#53b3ecf1ffcf":{"renderings":[{"id":"9a212c29066def71","role":"translation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"There's no way she's not kind."}]},"n3-121#8644bf1f3634":{"renderings":[{"id":"b7a38a812cfb819c","role":"translation","source":{"source":"hanabira","ref":"n3-121"},"match":"id","status":"imported","value":"There's no way he won't pass the exam."}]}}}