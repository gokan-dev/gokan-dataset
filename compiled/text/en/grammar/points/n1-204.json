{"kind":"grammar","lang":"en","entities":{"n1-204":{"renderings":[{"id":"4a3e0380d4bef9b9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"Expresses the idea of 'if it comes to...; when we talk about...; in the case of...'."},{"id":"9f5f6fea8f72e3b9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"The ～となれば grammar point is used to express a situation where a particular case or condition brings about a certain result or consequence. It translates as 'if it comes to...; when we talk about...; in the case of...' in English."},{"id":"f5d70bd3a0a8792c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"Verb-casual + となれば, い-Adjective + となれば, な-Adjective + だとなれば, Noun + だとなれば"},{"id":"26982aec120d05c3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-204"},"match":"id","status":"reviewed","value":"となれば: once it is the case that (そうとなれば)."},{"id":"fa19f1c414ee3570","role":"label","field":"family","source":{"source":"gokan","ref":"conditional"},"match":"id","status":"reviewed","value":"Conditional (If / Assuming That)","of":{"kind":"family","id":"conditional"}}]},"n1-204#76d6b6b55f22":{"renderings":[{"id":"dce4a0dfc821e503","role":"translation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"If he becomes the leader, the project will probably succeed."}]},"n1-204#f60f3a1a0241":{"renderings":[{"id":"2e1c2543178e94e3","role":"translation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"If it turns out to be raining tomorrow, let's cancel the picnic."}]},"n1-204#d6278d130ce8":{"renderings":[{"id":"c96639fcb3f5d000","role":"translation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"If this job is over, you can take a vacation."}]},"n1-204#e654c055cc93":{"renderings":[{"id":"110b44629c6c482f","role":"translation","source":{"source":"hanabira","ref":"n1-204"},"match":"id","status":"imported","value":"If that test is difficult, we must study all the more."}]}}}