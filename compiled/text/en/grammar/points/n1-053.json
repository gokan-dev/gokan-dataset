{"kind":"grammar","lang":"en","entities":{"n1-053":{"renderings":[{"id":"82eb0e498c8d0d4b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-053"},"match":"id","status":"imported","value":"Lists alternatives of the same kind; 'either A or B', 'A or B, for example'."},{"id":"b010732428a7758f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-053"},"match":"id","status":"imported","value":"The pattern AなりBなり is used to suggest alternatives or options, usually of the same category. It can be translated as 'whether A or B' or 'A or B, for example'."},{"id":"3c00eb52e58f357e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-053"},"match":"id","status":"imported","value":"Noun + なり + Noun + なり"},{"id":"53945b7fa6ab9afd","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-053"},"match":"id","status":"reviewed","value":"Formal, literary \"either A or B, for example\" - lists representative alternatives of the same kind."},{"id":"c0501e0b255eb50d","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-a-or-b"},"match":"id","status":"reviewed","value":"Regardless (Whether A Or B)","of":{"kind":"family","id":"regardless-a-or-b"}}]},"n1-053#98d01a120030":{"renderings":[{"id":"1d60dbf1165c7764","role":"translation","source":{"source":"hanabira","ref":"n1-053"},"match":"id","status":"imported","value":"Do you have any hobbies, such as movies or music?"}]},"n1-053#355a9782ffd1":{"renderings":[{"id":"217de72e9d92dd13","role":"translation","source":{"source":"hanabira","ref":"n1-053"},"match":"id","status":"imported","value":"Please give me something to drink, like tea or coffee."}]},"n1-053#1691041a2d43":{"renderings":[{"id":"efd8a256b25232c7","role":"translation","source":{"source":"hanabira","ref":"n1-053"},"match":"id","status":"imported","value":"Please eat something—bread, onigiri, or whatever you’d like."}]},"n1-053#1e5c71b424bf":{"renderings":[{"