{"kind":"grammar","lang":"en","entities":{"n2-166":{"renderings":[{"id":"9b144882aff0a0d8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-166"},"match":"id","status":"imported","value":"Indicates that something serves as a trigger or starting point for another action/event."},{"id":"04382c7c5fdf42b9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-166"},"match":"id","status":"imported","value":"「～をきっかけに」 is used with a noun to show that an event, thing, or situation became a trigger or motive that led to a new development or action. It translates as 'taking ... as an opportunity,' 'due to ...,' or 'inspired by ...'."},{"id":"42e33d4f145c9a1a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-166"},"match":"id","status":"imported","value":"Noun + をきっかけに"},{"id":"72da059aee392dcc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-166"},"match":"id","status":"reviewed","value":"をきっかけに: triggered by X, something started (結婚をきっかけに)."},{"id":"df1f12cd56dbd438","role":"label","field":"family","source":{"source":"gokan","ref":"turning-point"},"match":"id","status":"reviewed","value":"Turning Point (Triggered By / From Then On)","of":{"kind":"family","id":"turning-point"}}]},"n2-166#ea3487328948":{"renderings":[{"id":"e41577ff88c21dd0","role":"translation","source":{"source":"hanabira","ref":"n2-166"},"match":"id","status":"imported","value":"Getting married was the catalyst for him to start working seriously."}]},"n2-166#0466b3626536":{"renderings":[{"id":"94d2b9f79555870e","role":"translation","source":{"source":"hanabira","ref":"n2-166"},"match":"id","status":"imported","value":"That encounter led us to become friends."}]},"n2-166#f52ea1a77e73":{"renderings":[{"id":"489a81283fd0862a","role":"translation","source":{"source":"hanabira","ref":"n2-166"},"match":"id","status":"imported","value":"Inspired by the concert, she decided to pursue music."}]},"n2-166#7a2