{"kind":"grammar","lang":"en","entities":{"n1-099":{"renderings":[{"id":"f82f720eeb409eb9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"Despite; Notwithstanding; Regardless of"},{"id":"55776de1d32148b8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"The Japanese phrase 'Nounをよそに' is used to express a situation where, despite some circumstance (represented by the noun), a certain action takes place. It can convey a feeling of disregard or nonchalance. In English, it can be translated as 'despite', 'notwithstanding', or 'regardless of'."},{"id":"8661e153b80c4133","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"Noun + をよそに"},{"id":"26b733f6c9e9ff1f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-099"},"match":"id","status":"reviewed","value":"をよそに: ignoring others' worry or concern about X."},{"id":"a50efe0caa0d07a3","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-of"},"match":"id","status":"reviewed","value":"Regardless Of (No Matter)","of":{"kind":"family","id":"regardless-of"}}]},"n1-099#d4759decd01f":{"renderings":[{"id":"49df725b65f7183d","role":"translation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"Despite the economic crisis, he bought a luxury car."}]},"n1-099#8c3885b03c91":{"renderings":[{"id":"860c8a4b236f385b","role":"translation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"Despite the approaching test, he keeps on playing."}]},"n1-099#570aecbad9a1":{"renderings":[{"id":"29e6abd57f4b0157","role":"translation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"Despite her parents' opposition, she married him."}]},"n1-099#e7abc9461ccf":{"renderings":[{"id":"352f1d237c85887e","role":"translation","source":{"source":"hanabira","ref":"n1-099"},"match":"id","status":"imported","value":"Despite the country's economic situation, many companies continue to expand."}]}}}