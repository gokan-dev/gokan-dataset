{"kind":"grammar","lang":"en","entities":{"n4-096":{"renderings":[{"id":"8717660677fcb2bc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"To give or ask permission; 'it's okay to', 'may', 'can'."},{"id":"5695187d550977ef","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"The ～てもいい grammar point is used to give or ask for permission to do something. It can be translated as 'it's okay to', 'may', or 'can' in English. The formation is derived by adding てもいい after the て-form of a verb."},{"id":"de9c2b83c7e97d08","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"Verb-て form + もいい"},{"id":"ff309b425d41a3e7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-096"},"match":"id","status":"reviewed","value":"'May, it's OK to': permission (入ってもいい). Refusing it: てはいけない."},{"id":"52331782dd11468f","role":"label","field":"family","source":{"source":"gokan","ref":"prohibition"},"match":"id","status":"reviewed","value":"Permission And Prohibition (May / Must Not)","of":{"kind":"family","id":"prohibition"}}]},"n4-096#feac2f539d57":{"renderings":[{"id":"37c40533f81ac24f","role":"translation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"Is it okay to take a photo here?"}]},"n4-096#4d93981300d9":{"renderings":[{"id":"3a73add58b508a09","role":"translation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"May I eat this apple?"}]},"n4-096#5a183435c49b":{"renderings":[{"id":"ecef45955fce9196","role":"translation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"You can go home after the exam is over."}]},"n4-096#c3996c9398ac":{"renderings":[{"id":"f29bba62aad8f90c","role":"translation","source":{"source":"hanabira","ref":"n4-096"},"match":"id","status":"imported","value":"It's okay to play with friends tonight."}]}}}