{"kind":"grammar","lang":"en","entities":{"n1-069":{"renderings":[{"id":"eee95b4d7ad9f3d5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"Indicates that something is not only limited to; 'not only', 'not just'."},{"id":"368b6c24271feac6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"This grammar point is used to express that the statement is not only limited to the noun mentioned before it. In English, it can be translated as 'not only', 'not just', or sometimes 'not necessarily'. It underscores that what is being said is also true for other things or situations, not just for the specific noun stated."},{"id":"c6882ce9de455037","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"Noun + に限ったことではない"},{"id":"2fbd30ee88823b0d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-069"},"match":"id","status":"reviewed","value":"Formal, literary \"not only limited to...\"."},{"id":"38b1bffd12f4b052","role":"label","field":"family","source":{"source":"gokan","ref":"not-only-limited"},"match":"id","status":"reviewed","value":"Not Only Limited To (Far From)","of":{"kind":"family","id":"not-only-limited"}}]},"n1-069#6a8bfe8f49c8":{"renderings":[{"id":"776991fe39fb9555","role":"translation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"This issue is not only limited to Japan."}]},"n1-069#c8f0bb4210d7":{"renderings":[{"id":"2512fdc22a47bf36","role":"translation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"English is not just limited to America."}]},"n1-069#2309c5c15cb8":{"renderings":[{"id":"86f7dc85e4f7ffe4","role":"translation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"Smartphone addiction is not only limited to young people."}]},"n1-069#2d62ed35cefa":{"renderings":[{"id":"d1c4bfdd3167bfb8","role":"translation","source":{"source":"hanabira","ref":"n1-069"},"match":"id","status":"imported","value":"Global warming is not just limited to us humans."}]}}}