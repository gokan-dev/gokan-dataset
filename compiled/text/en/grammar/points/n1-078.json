{"kind":"grammar","lang":"en","entities":{"n1-078":{"renderings":[{"id":"0e8c940987b2febc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"Depending on the matter; depending on noun"},{"id":"4599627ff7dfeaf8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"The phrase のいかんによっては (no ikan ni yotte wa) is used to express the concept of 'depending on the matter or situation'. It is used to indicate that the outcome may change based on the condition or quality of the noun (matter) in question."},{"id":"f8f8bec95da85bb8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"Noun + のいかんによっては"},{"id":"d84f0d56ed302b56","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-078"},"match":"id","status":"reviewed","value":"Noun のいかんによっては: depending on X, possibly."},{"id":"9c243c5bc319e188","role":"label","field":"family","source":{"source":"gokan","ref":"depending-on"},"match":"id","status":"reviewed","value":"Depending On (Varies With)","of":{"kind":"family","id":"depending-on"}}]},"n1-078#181f45758e3f":{"renderings":[{"id":"49ddbb99a8007cc6","role":"translation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"Depending on the weather, we should postpone the picnic."}]},"n1-078#a4c66066632c":{"renderings":[{"id":"51ad5f484cb78bae","role":"translation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"You can go on to further education, depending on the result of the exam."}]},"n1-078#d95df7d228e0":{"renderings":[{"id":"a12ed9f23b607c35","role":"translation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"Depending on the situation, I will consider early retirement."}]},"n1-078#e4c7e6f57c7e":{"renderings":[{"id":"bcbf3b0c3e49d1e7","role":"translation","source":{"source":"hanabira","ref":"n1-078"},"match":"id","status":"imported","value":"Depending on his reaction, we will decide our next move."}]}}}