{"kind":"grammar","lang":"en","entities":{"n5-117":{"renderings":[{"id":"8e41d942e081d371","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"Used to express 'not any' or 'nothing' in a negative sentence."},{"id":"41be57197e9ae294","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"The なにも～ないです grammar point is used in negative sentences to express the idea of 'not any', 'not at all', 'nothing', or 'none'. It is commonly used with verbs in the negative form."},{"id":"b8e808bc61572614","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"なにも + Verb-negative"}]},"n5-117#08baae8c3aba":{"renderings":[{"id":"e4c7ba696dda5b9d","role":"translation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"He didn't say anything."}]},"n5-117#08ee04c5b96e":{"renderings":[{"id":"6e8bb942d5bfe12e","role":"translation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"I don't eat anything."}]},"n5-117#36c2cf4b518a":{"renderings":[{"id":"a396ecbc563a6f62","role":"translation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"She doesn't have anything."}]},"n5-117#b1c318cdde08":{"renderings":[{"id":"11903266634a0196","role":"translation","source":{"source":"hanabira","ref":"n5-117"},"match":"id","status":"imported","value":"There is nothing in this box."}]}}}