{"kind":"grammar","lang":"en","entities":{"n5-113":{"renderings":[{"id":"e98a00482923b7e7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"Indicates 'any' or 'whichever' when referring to multiple items."},{"id":"de32c3c7863225c2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"The どれでも grammar point is used to express that any option or element among multiple choices is acceptable. It can be translated as 'any' or 'whichever' in English. It is often used in questions or suggestions and is commonly seen with でも, but it can also be used with だれでも, いつでも, どこでも, etc."},{"id":"7da59c819529681e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"どれ + でも"},{"id":"b7871167d96a1b40","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-113"},"match":"id","status":"reviewed","value":"'Any of them, whichever' with an affirmative verb (どれでもいいです)."}]},"n5-113#17e121334112":{"renderings":[{"id":"7460bdeea4bc4862","role":"translation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"Is any choice okay?"}]},"n5-113#55af688e4fa5":{"renderings":[{"id":"597ea83e553efa50","role":"translation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"Please choose whichever you like."}]},"n5-113#8294eb77a7f9":{"renderings":[{"id":"9d19cb4e4a49030c","role":"translation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"All of them are delicious."}]},"n5-113#29ea243aa4ce":{"renderings":[{"id":"ab817c063e690840","role":"translation","source":{"source":"hanabira","ref":"n5-113"},"match":"id","status":"imported","value":"Please take whichever you like from these."}]}}}