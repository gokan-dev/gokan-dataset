{"kind":"grammar","lang":"en","entities":{"n5-134":{"renderings":[{"id":"06568e9be292ebbd","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"Expresses 'more' or 'even more' when describing a quantity, frequency, or degree."},{"id":"0a123a116d737b5c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"The もっと〜 grammar point is used to emphasize the desire or need for something to be 'more' or 'even more' in terms of quantity, frequency, or degree. It is often translated as 'more' or 'even more' in English. もっと can be used with verbs, い-adjectives, or な-adjectives."},{"id":"596285178fe2717f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"もっと + Verb / い-Adjective / な-Adjective"},{"id":"cfc67b5854295f51","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-134"},"match":"id","status":"reviewed","value":"'More' of a quality or amount (もっと大きい). Comparing two named things uses より."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n5-134#7c3e6bd19a03":{"renderings":[{"id":"5e0a92f1c8d15841","role":"translation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"I have to study more."}]},"n5-134#e2ac0e0c6ba5":{"renderings":[{"id":"b838e789c6327de8","role":"translation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"I want to change this bag to a larger size."}]},"n5-134#006943f89c34":{"renderings":[{"id":"7c3ff044253f40ef","role":"translation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"I want to work in a quieter place."}]},"n5-134#10fafac3d691":{"renderings":[{"id":"7b13ad9ec88d3f7b","role":"translation","source":{"source":"hanabira","ref":"n5-134"},"match":"id","status":"imported","value":"She wants to become even better."}]}}}