{"kind":"grammar","lang":"en","entities":{"n3-001":{"renderings":[{"id":"96345bb39099c4e2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"Used to express 'in addition to', 'besides', or 'furthermore' when adding information or making a suggestion."},{"id":"dbe233e864b1807b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"The grammar point A その上 B is used to connect two statements, where B is an additional piece of information, a suggestion or reason that is related to statement A. The expression can be translated as 'in addition to', 'besides', or 'furthermore'."},{"id":"1ef7d819ec2e7091","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"A [sentence/clause] + その上 + B [sentence/clause]"},{"id":"2e4cb17e5e103268","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-001"},"match":"id","status":"reviewed","value":"Neutral \"on top of that\" - conversational-to-written."},{"id":"0387b814f24604ce","role":"label","field":"family","source":{"source":"gokan","ref":"addition"},"match":"id","status":"reviewed","value":"Addition (Besides / Moreover)","of":{"kind":"family","id":"addition"}}]},"n3-001#078a2edb4932":{"renderings":[{"id":"ba5436a9345fee2f","role":"translation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"He is smart. In addition, he is also good at sports."}]},"n3-001#dc57ee2da4b5":{"renderings":[{"id":"77532e24fb418005","role":"translation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"This cafe has a nice atmosphere. Besides, the food is delicious."}]},"n3-001#8faaa791fd24":{"renderings":[{"id":"8c344b078846e6b2","role":"translation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"This apartment is close to the station. Furthermore, the rent is also cheap."}]},"n3-001#1a1de1102707":{"renderings":[{"id":"52ae2415636abe17","role":"translation","source":{"source":"hanabira","ref":"n3-001"},"match":"id","status":"imported","value":"She is competent at work. In addition, she can get along with anyone."}]}}}