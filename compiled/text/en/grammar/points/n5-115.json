{"kind":"grammar","lang":"en","entities":{"n5-115":{"renderings":[{"id":"fac65f8d9dad7cb0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-115"},"match":"id","status":"imported","value":"Asking about 'what' or 'which' in Japanese"},{"id":"eb8cd6f43a81e4fa","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-115"},"match":"id","status":"imported","value":"The なに～ grammar point is used to ask questions about 'what' or 'which' in Japanese. It can be combined with various parts of speech to create different questions. The formation differs depending on whether it's used with a verb, い-adjective, な-adjective, or noun."},{"id":"87c4f237be89a279","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-115"},"match":"id","status":"imported","value":"Verb + なに, い-Adjective + なに, な-Adjective + なに, Noun + なに"},{"id":"bdf4abae56d3df30","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-115"},"match":"id","status":"reviewed","value":"なに before を, が, も and most particles (なにを食べますか). Before です, a counter, or で/の, use なん."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-115#281b41e509d7":{"renderings":[{"id":"019b2637f67a66cc","role":"translation","source":{"source":"hanabira","ref":"n5-115"},"match":"id","status":"imported","value":"What is that person doing?"}]},"n5-115#29c706a340b5":{"renderings":[{"id":"a029c4f6ee9d9ddf","role":"translation","source":{"source":"hanabira","ref":"n5-115"},"match":"id","status":"imported","value":"What do you like?"}]}}}