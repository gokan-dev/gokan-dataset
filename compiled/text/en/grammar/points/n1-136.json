{"kind":"grammar","lang":"en","entities":{"n1-136":{"renderings":[{"id":"46fd48af73619bb9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"'Show by doing', 'demonstrate', 'prove by action'."},{"id":"d37f37f6919c9117","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"The ～てみせる grammar point is used to express the action of demonstrating or proving something by actually doing it. It can be translated as 'show by doing', 'demonstrate', or 'prove by action' in English."},{"id":"218a483c164d7c23","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"Verb-て form + みせる"}]},"n1-136#6ef986a39049":{"renderings":[{"id":"2983d6e36fef48d2","role":"translation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"He solved the puzzle to show me."}]},"n1-136#e4be373bf8ba":{"renderings":[{"id":"86e6d1bfaf58df9b","role":"translation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"I will do this job to prove that I can."}]},"n1-136#94dadd9ad39a":{"renderings":[{"id":"da0b4595eda39e15","role":"translation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"She studied hard to prove she could pass the exam."}]},"n1-136#32241a81e072":{"renderings":[{"id":"5f9f366f132986b2","role":"translation","source":{"source":"hanabira","ref":"n1-136"},"match":"id","status":"imported","value":"He jumped to show he wasn’t afraid of anything."}]}}}