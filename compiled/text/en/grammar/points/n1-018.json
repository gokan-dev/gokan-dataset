{"kind":"grammar","lang":"en","entities":{"n1-018":{"renderings":[{"id":"d6e7f0b0e52e2121","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"Used with large numbers or measurements to emphasize 'at least that many' or 'no less than.'"},{"id":"28c3b2f3f011a234","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"「Noun + Counter + からある」indicates a large or minimum number, emphasizing that the quantity is at least that high (often more). It conveys the idea that the figure is notably large or impressive."},{"id":"af62e534b280ef69","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"Number + Counter + からある"},{"id":"65268664de70027e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-018"},"match":"id","status":"reviewed","value":"からある: as much as, no less than, with a large amount (10キロからある)."},{"id":"cfc4dfbd28a9df99","role":"label","field":"family","source":{"source":"gokan","ref":"approximation"},"match":"id","status":"reviewed","value":"Approximation (About / Approximately)","of":{"kind":"family","id":"approximation"}}]},"n1-018#b204e1ed16cf":{"renderings":[{"id":"69d3e58475aed506","role":"translation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"He has at least 500 items in his collection."}]},"n1-018#d9b59e6df754":{"renderings":[{"id":"e64bd1adcb937214","role":"translation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"This building has at least 40 floors."}]},"n1-018#5a6011f415d2":{"renderings":[{"id":"8dcae2791468842f","role":"translation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"He has assets worth at least one billion yen."}]},"n1-018#56e67200cf45":{"renderings":[{"id":"6ff3cc67f6ea897a","role":"translation","source":{"source":"hanabira","ref":"n1-018"},"match":"id","status":"imported","value":"This marathon is at least 10 kilometers long."}]}}}