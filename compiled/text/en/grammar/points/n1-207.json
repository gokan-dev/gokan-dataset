{"kind":"grammar","lang":"en","entities":{"n1-207":{"renderings":[{"id":"dc83ede97d56fd51","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"It seems that; apparently"},{"id":"f9a1a2cda7aa59ca","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"The ～とみえて grammar point is used to express the speaker's judgment about a situation based on visible or known information. It is often translated as 'apparently' or 'it seems that' in English."},{"id":"992b97fb079aa310","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"Verb-casual + とみえて, い-Adjective + とみえて, な-Adjective + だとみえて, Noun + だとみえて"},{"id":"829ba80bee0c85e5","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-207"},"match":"id","status":"reviewed","value":"Formal, literary observational inference - \"it appears that (judging from what I see)\"."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n1-207#f0e6f9581cca":{"renderings":[{"id":"80405c9bb628b58d","role":"translation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"He seems to be good at exercise, as he goes to the gym every day."}]},"n1-207#b45abbd1c521":{"renderings":[{"id":"9ed07fbfed2a0986","role":"translation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"She seems to be busy, as it's hard to meet her."}]},"n1-207#6b6330e5c767":{"renderings":[{"id":"6cd3d5a0d4b520b1","role":"translation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"It seems that Tanaka-san was tired, as he went home early."}]},"n1-207#2fbccbc2af27":{"renderings":[{"id":"3368f07efffe8858","role":"translation","source":{"source":"hanabira","ref":"n1-207"},"match":"id","status":"imported","value":"That shop seems to be popular, as there is always a line."}]}}}