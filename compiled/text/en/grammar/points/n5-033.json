{"kind":"grammar","lang":"en","entities":{"n5-033":{"renderings":[{"id":"40a8f6a5233244df","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"Express going back or returning to a place: 'to return to', 'to go back to'."},{"id":"83bda4dc537af1c7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"The grammar point 'Noun に 帰ります' is used to express physically going back or returning to a specific place. It can be translated as 'to go back to' or 'to return to' in English. The particle に indicates the destination of the return."},{"id":"8f6aa2e9b9a1b44b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"Noun + に + 帰ります"},{"id":"74b9673485a52364","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-033"},"match":"id","status":"reviewed","value":"Returning to a place you belong: home, your hometown, your country."},{"id":"9952d59dae38a7d4","role":"label","field":"family","source":{"source":"gokan","ref":"returning"},"match":"id","status":"reviewed","value":"Going And Coming (Go / Come / Go Back)","of":{"kind":"family","id":"returning"}}]},"n5-033#d188ea3949ac":{"renderings":[{"id":"f8da192ebaa51315","role":"translation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"When summer vacation ends, I'll go back to school."}]},"n5-033#a576d508e332":{"renderings":[{"id":"81712a2544633363","role":"translation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"After finishing shopping, I will go back home."}]},"n5-033#b91bd08b5de5":{"renderings":[{"id":"27bd3c771fa88409","role":"translation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"I'm going back to my parents' home this weekend."}]},"n5-033#fa42b5d816b7":{"renderings":[{"id":"b2e212014c8e5b47","role":"translation","source":{"source":"hanabira","ref":"n5-033"},"match":"id","status":"imported","value":"After traveling with my friend, I'll return to Tokyo."}]}}}