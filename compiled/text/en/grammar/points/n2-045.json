{"kind":"grammar","lang":"en","entities":{"n2-045":{"renderings":[{"id":"22954a788e8a4134","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"Expresses that something tends to occur frequently or habitually."},{"id":"87b07bc7215d5f85","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"The ～がち grammar point is used to express that something has a tendency to occur frequently or habitually. It can be attached to verbs and adjectives to indicate that the action or state tends to occur often."},{"id":"5378489e0d090cc8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"Verb-ます stem + がち / い-Adjective stem + がち / な-Adjective stem + がち"},{"id":"7f6271b969717744","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-045"},"match":"id","status":"reviewed","value":"ます stem / Noun + がち: tends to, usually something bad (忘れがち)."},{"id":"327bbb1b37deacf0","role":"label","field":"family","source":{"source":"gokan","ref":"tendency"},"match":"id","status":"reviewed","value":"Tendency (Tend To / -ish / A Touch Of)","of":{"kind":"family","id":"tendency"}}]},"n2-045#cb2963b4cb74":{"renderings":[{"id":"cfdf8a97ff2da3b6","role":"translation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"He tends to catch colds easily."}]},"n2-045#d840073bc054":{"renderings":[{"id":"02e924b5ba53c2c2","role":"translation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"This area tends to get a lot of rain."}]},"n2-045#57133988e2dc":{"renderings":[{"id":"e5f0348bfa6baaa0","role":"translation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"She tends to forget things."}]},"n2-045#83444b922957":{"renderings":[{"id":"ada3db548ae07390","role":"translation","source":{"source":"hanabira","ref":"n2-045"},"match":"id","status":"imported","value":"I tend to be late, so I need to wake up earlier."}]}}}