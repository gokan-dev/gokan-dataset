{"kind":"grammar","lang":"en","entities":{"n2-074":{"renderings":[{"id":"d62984a808260dfc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"Expresses the impossibility or very low probability of something happening; 'no way', 'impossible'."},{"id":"18c3eb3a3a77f6f7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"The ～っこない grammar point is used to express that something is impossible or extremely unlikely. It’s formed by attaching ～っこない to the negative stem of a verb. It can be translated as 'no way', 'no chance', or 'impossible.'"},{"id":"847f032c2e9df3a6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"Verb-negative stem + っこない"},{"id":"24c8c565d2a491f7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-074"},"match":"id","status":"reviewed","value":"Casual, spoken \"no way/impossible\" - blunt, conversational."},{"id":"6a9ffa925908f457","role":"label","field":"family","source":{"source":"gokan","ref":"unlikely-impossible"},"match":"id","status":"reviewed","value":"Unlikely / Impossible","of":{"kind":"family","id":"unlikely-impossible"}}]},"n2-074#400fcfbf3684":{"renderings":[{"id":"0ec96114eaa47798","role":"translation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"With snow falling this heavily, there's no way we'll make it to school on time."}]},"n2-074#14ee29fe35a9":{"renderings":[{"id":"3a0ead918cbf7cdf","role":"translation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"Since he can’t swim, there’s no way he’ll make it to the other side of the pool."}]},"n2-074#f54f54022683":{"renderings":[{"id":"e410a680567419c1","role":"translation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"She’s so timid, there’s no chance she’d go to the park alone at night."}]},"n2-074#93a5a95fd70f":{"renderings":[{"id":"756501cb108124fd","role":"translation","source":{"source":"hanabira","ref":"n2-074"},"match":"id","status":"imported","value":"It's impossible to read the entire book in such a short time."}]}}}