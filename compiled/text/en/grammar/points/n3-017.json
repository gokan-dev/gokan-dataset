{"kind":"grammar","lang":"en","entities":{"n3-017":{"renderings":[{"id":"f8fff6cc8a937269","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"Express a personal rule or habit; 'I make it a rule to', 'I always make sure to'."},{"id":"589b86e50887f8fb","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"The ～ことにしている grammar point is used to express a personal rule, habit, or decision that the speaker has made for themselves. It can be translated as 'I make it a rule to' or 'I always make sure to' in English. This grammar point is formed by attaching ことにしている to the casual form of a verb."},{"id":"8e6fb59e5fcb7790","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"Verb-casual + ことにしている"},{"id":"02c6c093db4ff05d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-017"},"match":"id","status":"reviewed","value":"ことにしている: a rule you set yourself and keep (毎朝走ることにしている)."},{"id":"bd97fcb92a4cb49c","role":"label","field":"family","source":{"source":"gokan","ref":"decisions"},"match":"id","status":"reviewed","value":"Decisions (Decide To / It Was Decided)","of":{"kind":"family","id":"decisions"}}]},"n3-017#94ce0f938c1d":{"renderings":[{"id":"b524ba39b7107b1b","role":"translation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"I make it a rule to exercise every day."}]},"n3-017#da3fe9c073de":{"renderings":[{"id":"010377e973e80055","role":"translation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"I make it a rule not to work late into the night."}]},"n3-017#46d38dffd70b":{"renderings":[{"id":"4708b37ce122b115","role":"translation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"I always make sure to brush my teeth after meals."}]},"n3-017#a28eb639c257":{"renderings":[{"id":"9f05d972a0ff3caf","role":"translation","source":{"source":"hanabira","ref":"n3-017"},"match":"id","status":"imported","value":"I always make sure to arrive 10 minutes early for meetings."}]}}}