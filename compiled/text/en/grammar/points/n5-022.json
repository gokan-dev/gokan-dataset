{"kind":"grammar","lang":"en","entities":{"n5-022":{"renderings":[{"id":"eb84744a9ba6d7a0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"Expresses choice or alternatives; 'either', 'or'."},{"id":"0da64445d5d90d69","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"The Noun か Noun か～ grammar point is used to present two or more alternatives for a choice. It can be translated to 'either', 'or' in English. It is formed by placing the particle か in between two nouns or noun phrases."},{"id":"94f08699dd9ad066","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"Noun1 + か + Noun2 + か～"},{"id":"391d7f8dd38c7be9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-022"},"match":"id","status":"reviewed","value":"Neutral, everyday \"A or B\" for simple choices."},{"id":"bef7a3b562a0b387","role":"label","field":"family","source":{"source":"gokan","ref":"or-choice"},"match":"id","status":"reviewed","value":"Or (Alternatively)","of":{"kind":"family","id":"or-choice"}}]},"n5-022#74586a39568f":{"renderings":[{"id":"6856790b07e9a67c","role":"translation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"Will we watch a movie or go for a walk today?"}]},"n5-022#13682bd33db7":{"renderings":[{"id":"85af533382349a71","role":"translation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"Please choose only one, either coffee or tea."}]},"n5-022#a8c863358436":{"renderings":[{"id":"9990a14e788bdf2f","role":"translation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"I plan to go to school using either the train or the bus."}]},"n5-022#0cb3bd903891":{"renderings":[{"id":"1b050955d873132f","role":"translation","source":{"source":"hanabira","ref":"n5-022"},"match":"id","status":"imported","value":"I haven't decided whether to climb the mountain or go to the beach this weekend."}]}}}