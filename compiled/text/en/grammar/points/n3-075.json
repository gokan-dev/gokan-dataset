{"kind":"grammar","lang":"en","entities":{"n3-075":{"renderings":[{"id":"038e9864c521fdcf","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-075"},"match":"id","status":"imported","value":"Indicates the place, time, or context where an action or situation takes place."},{"id":"b5c4034ebafd00d2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-075"},"match":"id","status":"imported","value":"The ～において grammar point is used to indicate where an action or situation occurs. It can often be translated as 'in', 'at', or 'on' in English. In some cases, it can also express a specific context or aspect. This grammar point can be used with verbs, adjectives, and nouns."},{"id":"0f6ac06a77530a36","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-075"},"match":"id","status":"imported","value":"Noun (Place/Time/Context) + において"},{"id":"74f55cb41aa11ca2","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-075"},"match":"id","status":"reviewed","value":"において: in, at (a place, time or field), in formal writing. Everyday: で."},{"id":"6afb424e456d931a","role":"label","field":"family","source":{"source":"gokan","ref":"formal-location"},"match":"id","status":"reviewed","value":"Formal Location (At / In, Official Register)","of":{"kind":"family","id":"formal-location"}}]},"n3-075#80e28b81867c":{"renderings":[{"id":"78dcb3f9321317ff","role":"translation","source":{"source":"hanabira","ref":"n3-075"},"match":"id","status":"imported","value":"In Japan, Obon is an important event where families gather."}]},"n3-075#3109eadc636f":{"renderings":[{"id":"8bf9ca1c0b488dd2","role":"translation","source":{"source":"hanabira","ref":"n3-075"},"match":"id","status":"imported","value":"In the meeting, his opinion was the most persuasive."}]},"n3-075#cfba73f70792":{"renderings":[{"id":"0dcca7aa92ae385a","role":"translation","source":{"source":"hanabira","ref":"n3-075"},"match":"id","status":"impor