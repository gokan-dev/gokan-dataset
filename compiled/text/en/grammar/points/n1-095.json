{"kind":"grammar","lang":"en","entities":{"n1-095":{"renderings":[{"id":"180f31015139fe62","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"Used to express that combined with something else, it caused a certain outcome."},{"id":"4b5f5ff766d4c780","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"The grammar point Noun も相まって is used to express the meaning that, combined with something else, it caused a certain result. Literally, it translates to 'also contributes to'. It is generally used with nouns and points out that there are multiple contributing factors."},{"id":"fa6390fe7b3ee2ba","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"Noun + も相まって"},{"id":"2a6062a619e4e036","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-095"},"match":"id","status":"reviewed","value":"も相まって: combined with X, producing a stronger effect."},{"id":"21471b3825094354","role":"label","field":"family","source":{"source":"gokan","ref":"proportional-change"},"match":"id","status":"reviewed","value":"Proportional Change (As X, So Y)","of":{"kind":"family","id":"proportional-change"}}]},"n1-095#3944744a0b8e":{"renderings":[{"id":"5ce311f65d197897","role":"translation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"Combined with the climate, this area is suitable for agriculture."}]},"n1-095#cdfef07cfe93":{"renderings":[{"id":"79473455b65f72ed","role":"translation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"Combined with his talent, he was rapidly promoted."}]},"n1-095#78c07eae2860":{"renderings":[{"id":"cefc7d03d8daa208","role":"translation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"Combined with technological progress, we have become able to handle our work more efficiently."}]},"n1-095#613e9af2d294":{"renderings":[{"id":"e0bc2582f65a788a","role":"translation","source":{"source":"hanabira","ref":"n1-095"},"match":"id","status":"imported","value":"Combined with his efforts, the project was successful."}]}}}