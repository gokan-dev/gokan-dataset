{"kind":"grammar","lang":"en","entities":{"n1-113":{"renderings":[{"id":"f550440b896c0f18","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"Expresses 'as long as', 'while this condition is true'."},{"id":"266225575558d740","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"This grammar is used to express that something holds true as long as a particular condition remains in effect. When using a noun, it can appear as Noun(である) + 限り(は). With a verb, use the dictionary form + 限り(は)."},{"id":"0f62b584d58135e2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"Verb-dictionary form + 限り(は)\nNoun(である) + 限り(は)"},{"id":"5104097d60c131e8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-113"},"match":"id","status":"reviewed","value":"Formal, literary \"as long as (this condition holds)\"."},{"id":"8eb0b4b0b42b219f","role":"label","field":"family","source":{"source":"gokan","ref":"as-long-as"},"match":"id","status":"reviewed","value":"As Long As (To That Extent)","of":{"kind":"family","id":"as-long-as"}}]},"n1-113#b4390fbfbcdf":{"renderings":[{"id":"5653799ab9e7c7c9","role":"translation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"As long as I'm alive, I will support you."}]},"n1-113#a2b2cd4e3358":{"renderings":[{"id":"014fb94fb91e60cd","role":"translation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"As long as the kids are going to school, we will protect them."}]},"n1-113#d0b3d8ad1c71":{"renderings":[{"id":"72dbfd83c8d97105","role":"translation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"I will do my best as long as I have the ability."}]},"n1-113#07e794d903df":{"renderings":[{"id":"27fa33e3f1365d17","role":"translation","source":{"source":"hanabira","ref":"n1-113"},"match":"id","status":"imported","value":"As long as you're here, I feel safe."}]}}}