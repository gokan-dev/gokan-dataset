{"kind":"grammar","lang":"en","entities":{"n5-041":{"renderings":[{"id":"b3a8fe15a70d9d30","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"Indicates that the action or state is the same for multiple items or people; 'also', 'as well'."},{"id":"de1f05c1ac706499","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"The も grammar point is used after a noun to indicate that the action or state is the same for multiple items or people. It means 'also', 'as well', or 'too' in English. も often replaces は or が in the sentence to show that the same statement applies to this additional noun."},{"id":"0a62d07e71eece74","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"Noun + も"},{"id":"9531e1e6ff4865dc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-041"},"match":"id","status":"reviewed","value":"The plain particle \"also/too\". (Near-duplicate of n4-118 - same particle, taught at both N4 and N5.)"},{"id":"e65e0d1190f99736","role":"label","field":"family","source":{"source":"gokan","ref":"also"},"match":"id","status":"reviewed","value":"Also (In Addition, Too)","of":{"kind":"family","id":"also"}}]},"n5-041#c6822f2ea5ef":{"renderings":[{"id":"8b2fe5bf2dd000e4","role":"translation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"I am also studying Japanese."}]},"n5-041#cafef2a75a80":{"renderings":[{"id":"f22058bd8eb57e47","role":"translation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"He also likes cake."}]},"n5-041#27b4101d0697":{"renderings":[{"id":"56eb8a73e763f913","role":"translation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"There are many tourist spots in both Tokyo and Osaka."}]},"n5-041#9fa91bd392e1":{"renderings":[{"id":"f7199bc91b2f198d","role":"translation","source":{"source":"hanabira","ref":"n5-041"},"match":"id","status":"imported","value":"Both this movie and that movie were interesting."}]}}}