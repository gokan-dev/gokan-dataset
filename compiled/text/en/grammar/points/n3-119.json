{"kind":"grammar","lang":"en","entities":{"n3-119":{"renderings":[{"id":"47aa925607d35eec","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-119"},"match":"id","status":"imported","value":"Express a passive action, 'was/were', 'has/have been'."},{"id":"7389287e642c864a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-119"},"match":"id","status":"imported","value":"The ～られた grammar point is used to express a passive action or situation. It is formed by conjugating the verb into its passive form in the past tense, which can be translated into English as 'was/were' or 'has/have been'. This grammar is used in situations where the subject is affected by an action rather than performing the action itself."},{"id":"bda6e63482b6f056","role":"prose","field":"formation","source":{"source":"gokan","ref":"n3-119"},"match":"id","status":"reviewed","value":"Verb (passive) + られた, Verb (passive) + れた, Verb (passive) + られました, Verb (passive) + れました"},{"id":"d06f10dc923558c1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-119"},"match":"id","status":"reviewed","value":"られた: passive past, 'was done' (騙された)."},{"id":"f1ea7cb8d22b48c3","role":"label","field":"family","source":{"source":"gokan","ref":"voice"},"match":"id","status":"reviewed","value":"Causative And Passive (Make / Be Done To / Be Made To)","of":{"kind":"family","id":"voice"}}]},"n3-119#ac801bf8a013":{"renderings":[{"id":"c26c7ddc05c14b0a","role":"translation","source":{"source":"hanabira","ref":"n3-119"},"match":"id","status":"imported","value":"This book was read by many people."}]},"n3-119#af433cee6b72":{"renderings":[{"id":"b77aedf2ca13cb32","role":"translation","source":{"source":"hanabira","ref":"n3-119"},"match":"id","status":"imported","value":"He was deceived by his friend."}]},"n3-119#809565dd4fdd":{"renderings":[{"id":"6d58b0767928b314","role":"translation","source":{"source":"hanabira","ref":"n3-119"},"match":"id","status":"imported","value":"Yesterday, my wallet was stolen."}]},"n3-119#de3f36bfda29":{"renderings":[{"id":"d8e824636275f582","role":"translation","source":{"source":"hanabira","ref":"n3-119"},"match":"id","status":"imported","value":"She was deeply moved by the movie."}]}}}