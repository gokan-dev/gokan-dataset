{"kind":"grammar","lang":"en","entities":{"n4-045":{"renderings":[{"id":"4ab7016f1f15a3dd","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"Express a desire for someone else to do something; 'I want (someone) to'."},{"id":"b56d36e7d7b9242b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"The て ほしい grammar point is used to express the speaker's desire for someone else to do an action. It is formed by combining the て-form of a verb with ほしい. The subject is usually followed by the particle に, but it can be dropped in casual speech."},{"id":"28bc2520c407f641","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"Verb-て form + ほしい"},{"id":"90949cfcdfd9cd8f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-045"},"match":"id","status":"reviewed","value":"てほしい: want SOMEONE ELSE to do it (早く来てほしい)."},{"id":"9587285840ba1a2d","role":"label","field":"family","source":{"source":"gokan","ref":"wanting"},"match":"id","status":"reviewed","value":"Wanting (Want / Want To / Want Someone To)","of":{"kind":"family","id":"wanting"}}]},"n4-045#eee1c4e56931":{"renderings":[{"id":"81bd53c8e55b829e","role":"translation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"I want my child to study more."}]},"n4-045#e4c79ba776a7":{"renderings":[{"id":"905839cf875c71bc","role":"translation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"I want him to come earlier."}]},"n4-045#f344704c4ab9":{"renderings":[{"id":"9b28c2c114ee249b","role":"translation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"I want my friend to read that book."}]},"n4-045#c546e6ffeb1a":{"renderings":[{"id":"c5944f5a580b99bc","role":"translation","source":{"source":"hanabira","ref":"n4-045"},"match":"id","status":"imported","value":"I want the teacher to answer the question."}]}}}