{"kind":"grammar","lang":"en","entities":{"n5-080":{"renderings":[{"id":"412e6b45e78610a3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"Refers to a short time ago or just now."},{"id":"991e07ad3436aa8b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"The word さっき (sakki) is an adverb used to express that something happened or was done a short time ago or just now. It can be combined with verbs or other phrases to convey that meaning."},{"id":"f5442b45f39ca523","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"さっき + verb / さっき + phrase"},{"id":"187236ff5e683b51","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-080"},"match":"id","status":"reviewed","value":"'A moment ago, just now': the past (さっき食べた)."},{"id":"99350681f510f5ba","role":"label","field":"family","source":{"source":"gokan","ref":"soon"},"match":"id","status":"reviewed","value":"Close In Time (Soon / Right Away / A Moment Ago)","of":{"kind":"family","id":"soon"}}]},"n5-080#c23206796f86":{"renderings":[{"id":"3292315b04e7901f","role":"translation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"There was a phone call just now."}]},"n5-080#38e09d95e881":{"renderings":[{"id":"71c2790e78e47eed","role":"translation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"I cleaned the room a short while ago."}]},"n5-080#faa0e2f7d0b0":{"renderings":[{"id":"6b0ced18ba64d921","role":"translation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"I met him just now."}]},"n5-080#3cb1e8419ff8":{"renderings":[{"id":"4c0846165ce2cdde","role":"translation","source":{"source":"hanabira","ref":"n5-080"},"match":"id","status":"imported","value":"Did you watch the news a short time ago?"}]}}}