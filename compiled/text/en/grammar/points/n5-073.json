{"kind":"grammar","lang":"en","entities":{"n5-073":{"renderings":[{"id":"bba83dc0f64d91eb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"Expresses reason or cause; 'because', 'since', 'so'."},{"id":"789da656df1b174a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"The ～から grammar point is used to indicate the reason or cause for something. It can be translated as 'because', 'since', or 'so' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"3fb64280d95b49f8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"Verb-casual + から / い-Adjective + から / な-Adjective + だから / Noun + だから"},{"id":"9c30a5667e2ab839","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-073"},"match":"id","status":"reviewed","value":"Everyday spoken default for stating a reason; emphasizes the speaker's subjective reason."},{"id":"d295acbaf3aeb59b","role":"label","field":"family","source":{"source":"gokan","ref":"causality"},"match":"id","status":"reviewed","value":"Causality (Because / Since / Due to)","of":{"kind":"family","id":"causality"}}]},"n5-073#3022d17924e1":{"renderings":[{"id":"d8baed33a3af5b7e","role":"translation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"Because I have an exam tomorrow, I must study tonight."}]},"n5-073#e8283411087d":{"renderings":[{"id":"a3208179e08f2578","role":"translation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"Since this room is small, I am looking for a bigger one."}]},"n5-073#eab1be21185e":{"renderings":[{"id":"190c6b9092017251","role":"translation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"Since he is my friend, he will probably help me."}]},"n5-073#2aa5c6d7ae85":{"renderings":[{"id":"9ab2fe1c7f098084","role":"translation","source":{"source":"hanabira","ref":"n5-073"},"match":"id","status":"imported","value":"Because it rained, I can't go outside."}]}}}