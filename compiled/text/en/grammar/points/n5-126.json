{"kind":"grammar","lang":"en","entities":{"n5-126":{"renderings":[{"id":"1ca6e2b6387612ca","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"Express that something is difficult or tough."},{"id":"f1ae83081664a4b6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"The ～はたいへんです grammar point is used to express that something is difficult or tough to do, handle, or face. It can be translated as 'is difficult' or 'is tough' in English. The formation is used with a noun followed by はたいへんです."},{"id":"8949f11574d89b6e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"Noun + はたいへんです"}]},"n5-126#5e0f34811e37":{"renderings":[{"id":"fe65b22ae4abc3b1","role":"translation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"It is difficult to remember kanji."}]},"n5-126#a0f729160c7a":{"renderings":[{"id":"c68427f45720ff81","role":"translation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"This job is tough."}]},"n5-126#b73d08246553":{"renderings":[{"id":"e28a4c9c66e78b6a","role":"translation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"Understanding Japanese train stations is difficult."}]},"n5-126#62be0059238e":{"renderings":[{"id":"420623bec09a351e","role":"translation","source":{"source":"hanabira","ref":"n5-126"},"match":"id","status":"imported","value":"When she is sick, life is tough."}]}}}