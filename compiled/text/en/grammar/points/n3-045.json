{"kind":"grammar","lang":"en","entities":{"n3-045":{"renderings":[{"id":"02751419f53ee8a4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"Summarizing, restating, or clarifying a point: 'in other words', 'that is to say'."},{"id":"aee6fe838a115684","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"The ～つまり grammar point is used to restate or clarify in a concise way what has been said. It can be translated as 'in other words', 'that is to say', or 'in short'."},{"id":"84c88e41638f3231","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"Sentence A + つまり + Sentence B (rephrasing)"},{"id":"c625290535dacb77","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-045"},"match":"id","status":"reviewed","value":"The standard \"in other words\" - summarizes or restates a point."},{"id":"be1377e33ff4303d","role":"label","field":"family","source":{"source":"gokan","ref":"restatement"},"match":"id","status":"reviewed","value":"Restatement (That Is To Say)","of":{"kind":"family","id":"restatement"}}]},"n3-045#122b84054a26":{"renderings":[{"id":"5b3ad4ba2a12a3cc","role":"translation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"He is a university professor. In other words, he is an expert."}]},"n3-045#435adf88ef53":{"renderings":[{"id":"063eb353d798a9a2","role":"translation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"Today is Saturday. That is to say, tomorrow is Sunday."}]},"n3-045#b40527baed6c":{"renderings":[{"id":"5e347ceec1e36a62","role":"translation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"Ms. Yamada is my friend's older sister. In short, she's someone we know."}]},"n3-045#8c7c70e5482c":{"renderings":[{"id":"f82b97145819a1fb","role":"translation","source":{"source":"hanabira","ref":"n3-045"},"match":"id","status":"imported","value":"She is from France. In other words, she can speak French."}]}}}