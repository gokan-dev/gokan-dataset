{"kind":"grammar","lang":"en","entities":{"n1-142":{"renderings":[{"id":"801b161da9d023fa","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"Expresses the idea that it's not entirely impossible or non-existent: 'It's not that I don't...', 'It's not that there aren't...'"},{"id":"cdbe3d69230be3bb","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"The grammar point Verbないものでもない is used to express that a situation is not completely impossible or nonexistent. Literally, it can be translated as 'it's not that there aren't...' or 'it's not that I never...'. It implies that some possibility or partial truth exists."},{"id":"06e7a20d7c85e7ea","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"Verb-negative form (ない form) + ものでもない"},{"id":"9b26a4d393c086d0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-142"},"match":"id","status":"reviewed","value":"ないものでもない: it is not out of the question."},{"id":"20ad52b8dbd916f2","role":"label","field":"family","source":{"source":"gokan","ref":"not-impossible"},"match":"id","status":"reviewed","value":"Not Impossible (Double-Negative Hedge)","of":{"kind":"family","id":"not-impossible"}}]},"n1-142#35b3934d2a2e":{"renderings":[{"id":"6f10ffe376101c2a","role":"translation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"It's not that I never want to travel."}]},"n1-142#f683a2bd4b3f":{"renderings":[{"id":"4307b6d0640e0c1b","role":"translation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"It's not that everything he said is completely free from mistakes."}]},"n1-142#fafc9e738d3d":{"renderings":[{"id":"d4d4d612beaf1888","role":"translation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"It's not that the problem can't be solved."}]},"n1-142#7f8089013972":{"renderings":[{"id":"50784a8a94991b2e","role":"translation","source":{"source":"hanabira","ref":"n1-142"},"match":"id","status":"imported","value":"It's not that I don't want to see him."}]}}}