{"kind":"grammar","lang":"en","entities":{"n1-193":{"renderings":[{"id":"452f73d376789e90","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-193"},"match":"id","status":"imported","value":"Express extreme exclamation; 'extremely', 'unbelievable', 'unsurpassed'."},{"id":"e226462dfc336720","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-193"},"match":"id","status":"imported","value":"The ～といったらありはしない grammar point is used to express an extreme degree of something, often surprise or admiration. It can be loosely translated as 'unbelievably...' or 'incredibly...'."},{"id":"8abb5b67e0a51978","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-193"},"match":"id","status":"imported","value":"Noun + といったらありはしない / な-Adjective + といったらありはしない"},{"id":"a60c10f5dd9e53a7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-193"},"match":"id","status":"reviewed","value":"Very formal, literary exclamation - \"extremely, beyond words\"; dramatic, rare in casual speech."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n1-193#3c51df3ab256":{"renderings":[{"id":"5dcc065182218afd","role":"translation","source":{"source":"hanabira","ref":"n1-193"},"match":"id","status":"imported","value":"His English is unbelievably good."}]},"n1-193#5177dfd179cf":{"renderings":[{"id":"44cafc4a3162063b","role":"translation","source":{"source":"hanabira","ref":"n1-193"},"match":"id","status":"imported","value":"These sweets are unbelievably delicious."}]},"n1-193#cdca98bbb04f":{"renderings":[{"id":"0b3f54b4b836abe0","role":"translation","source":{"source":"hanabira","ref":"n1-193"},"match":"id","status":"imported","value":"That kid's intelligence is unsurpassed."}]},"n1-193#9e006466912e":{"renderings":[{"id":"c0c71f0623444d46","