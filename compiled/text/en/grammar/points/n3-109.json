{"kind":"grammar","lang":"en","entities":{"n3-109":{"renderings":[{"id":"a2aec15c1880df23","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"Express a hypothetical condition or situation; 'if', 'in case', 'suppose'."},{"id":"6e558f9c9cdfb2ae","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"The もしも～なら grammar point is used to express a hypothetical condition or situation, often with a sense of uncertainty. It can be translated as 'if', 'in case', or 'suppose'. The formation varies slightly based on whether it is used with a verb, an い-adjective, a な-adjective, or a noun."},{"id":"2d0b7445e9c10f31","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"Verb-casual + なら, い-Adjective + なら, な-Adjective + なら, Noun + なら"},{"id":"4a8c3abf42c2294e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-109"},"match":"id","status":"reviewed","value":"Slightly more emphatic version of もし～たなら."},{"id":"fa19f1c414ee3570","role":"label","field":"family","source":{"source":"gokan","ref":"conditional"},"match":"id","status":"reviewed","value":"Conditional (If / Assuming That)","of":{"kind":"family","id":"conditional"}}]},"n3-109#ad8adbfaef1e":{"renderings":[{"id":"73156d22dd69ca48","role":"translation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"If it rains tomorrow, I won't go out."}]},"n3-109#ed4cbbbbd1cb":{"renderings":[{"id":"31b25e359ee40d4c","role":"translation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"If he doesn't come, we'll have the party just by ourselves."}]},"n3-109#532bb312a549":{"renderings":[{"id":"10e338723ab55be4","role":"translation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"If she is tired, please let her rest."}]},"n3-109#4f3af937f45e":{"renderings":[{"id":"78c54d68799560db","role":"translation","source":{"source":"hanabira","ref":"n3-109"},"match":"id","status":"imported","value":"If that is true, we have to admit it."}]}}}