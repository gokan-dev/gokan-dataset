{"kind":"grammar","lang":"en","entities":{"n2-099":{"renderings":[{"id":"84e7d42247e248dd","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"Even if, despite, although"},{"id":"7d7d467d4d97bfa2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"The ～としても grammar point is used to say ‘even if...’ or ‘even assuming that...’, often followed by a conclusion or stance. It’s similar to ～ても, but puts more emphasis on the hypothetical assumption or viewpoint."},{"id":"99123d53f342c162","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"Verb-casual + としても, い-Adjective + としても, な-Adjective + だとしても, Noun + だとしても"},{"id":"f6f60c43142c98d4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-099"},"match":"id","status":"reviewed","value":"としても: even supposing it were so (雨が降るとしても行く)."},{"id":"a3d1d81bf546c33e","role":"label","field":"family","source":{"source":"gokan","ref":"even-if"},"match":"id","status":"reviewed","value":"Even If (Hypothetical Concession)","of":{"kind":"family","id":"even-if"}}]},"n2-099#644d41cd6298":{"renderings":[{"id":"fa0401313a530fef","role":"translation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"Even if it rains, we won't cancel the race."}]},"n2-099#23aaf3a4520d":{"renderings":[{"id":"102ce8d0b3b53d10","role":"translation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"Even if this cake isn't delicious, I plan on eating it."}]},"n2-099#65172d47b49b":{"renderings":[{"id":"ef3baded3edd67af","role":"translation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"Even if she is late, we will keep waiting."}]},"n2-099#a80b2c61dc18":{"renderings":[{"id":"d38526969c8851e5","role":"translation","source":{"source":"hanabira","ref":"n2-099"},"match":"id","status":"imported","value":"Even if I'm busy, I want to keep my promise to my friend."}]}}}