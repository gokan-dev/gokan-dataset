{"kind":"grammar","lang":"en","entities":{"n1-065":{"renderings":[{"id":"78c32729fbff7aab","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"Meaning 'ahead of', 'before', or 'preceding in time'."},{"id":"606422341a88560a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"The grammar point 〜に先駆けて indicates something happening ahead or before something else in terms of time. Typically used in written language or formal speech."},{"id":"fa4f1601d97d1ed0","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"Noun + に先駆けて"},{"id":"47ed6a7690c82542","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-065"},"match":"id","status":"reviewed","value":"Formal, literary \"ahead of/in advance of\" - announcements, official events."},{"id":"5890bdada9401857","role":"label","field":"family","source":{"source":"gokan","ref":"before"},"match":"id","status":"reviewed","value":"Before (Prior To)","of":{"kind":"family","id":"before"}}]},"n1-065#3d4aa0da0fe4":{"renderings":[{"id":"441ba6781900b129","role":"translation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"This film was released in America ahead of Japan."}]},"n1-065#9f7d6bb9fdc3":{"renderings":[{"id":"2446a754e2580f98","role":"translation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"He heard the announcement before the people around him."}]},"n1-065#ebf4e4aeac4c":{"renderings":[{"id":"7129547abd7e38fa","role":"translation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"Mr. Johnson arrived at the venue ahead of the other participants."}]},"n1-065#ca798ddba01a":{"renderings":[{"id":"e3693b8532b18061","role":"translation","source":{"source":"hanabira","ref":"n1-065"},"match":"id","status":"imported","value":"She was able to graduate before her classmates."}]}}}