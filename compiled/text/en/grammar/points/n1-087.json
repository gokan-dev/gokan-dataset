{"kind":"grammar","lang":"en","entities":{"n1-087":{"renderings":[{"id":"74fa79a4fd5a5e46","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"Expresses 'not to mention ~, even ~'."},{"id":"b05295f871447886","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"The grammar point Noun はおろか～すら is used to emphasize that a particular statement applies not only to the first noun mentioned, but even more so to what comes after すら or さえ. It can be translated as ‘let alone ~, even ~’."},{"id":"6b0217ad4b0b6392","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"Noun1 はおろか, Noun2 すら/さえ ～"},{"id":"b8b0f43b01b6b4d3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-087"},"match":"id","status":"reviewed","value":"Formal, literary \"not to mention X, even Y\" - emphasizes Y as more extreme than the already-notable X."},{"id":"ad5bcc6ae11cf6c0","role":"label","field":"family","source":{"source":"gokan","ref":"not-to-mention"},"match":"id","status":"reviewed","value":"Not To Mention (Let Alone)","of":{"kind":"family","id":"not-to-mention"}}]},"n1-087#292876b3c160":{"renderings":[{"id":"9a2f62ea46c8ac9e","role":"translation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"He can't even walk fast, let alone run."}]},"n1-087#fffb15b73170":{"renderings":[{"id":"c5209215adb97ff8","role":"translation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"He doesn't even speak English, let alone Japanese."}]},"n1-087#1ddd6a790af1":{"renderings":[{"id":"5791a41c0bdf553b","role":"translation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"He didn't even drink anything all day, let alone eat a meal."}]},"n1-087#74ed994a466c":{"renderings":[{"id":"3488bc4fc9b8a622","role":"translation","source":{"source":"hanabira","ref":"n1-087"},"match":"id","status":"imported","value":"Never mind the taste; even the service is bad."}]}}}