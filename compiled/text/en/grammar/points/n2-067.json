{"kind":"grammar","lang":"en","entities":{"n2-067":{"renderings":[{"id":"51a8e26d55e32e56","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"Express a sequence of events happening in quick succession; 'as soon as', 'no sooner than'."},{"id":"30c712342283bc37","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"The ～たかと思ったら grammar point indicates that one action occurs almost immediately after another, often conveying surprise at how quickly it happens. It is frequently translated as 'as soon as...' or 'no sooner than...'."},{"id":"3464a4b80ac57715","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"Verb-た form + かと思ったら"},{"id":"49c20ab1a4b7ccd5","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-067"},"match":"id","status":"reviewed","value":"Neutral, often carries surprise - \"just when I thought..., then...\"."},{"id":"f993e5eecc2b6f19","role":"label","field":"family","source":{"source":"gokan","ref":"as-soon-as"},"match":"id","status":"reviewed","value":"As Soon As (The Moment That)","of":{"kind":"family","id":"as-soon-as"}}]},"n2-067#9d0f1a915832":{"renderings":[{"id":"b6aba4881145cf12","role":"translation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"No sooner had I called than she picked up."}]},"n2-067#bebf59b1b075":{"renderings":[{"id":"7f3d2711fad607d9","role":"translation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"As soon as we took off, the plane started shaking."}]},"n2-067#93a8a319f44d":{"renderings":[{"id":"2be72f80219bea0c","role":"translation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"No sooner had I gone shopping than it began to rain."}]},"n2-067#951187606b3e":{"renderings":[{"id":"bdc8c4cb212857d8","role":"translation","source":{"source":"hanabira","ref":"n2-067"},"match":"id","status":"imported","value":"As soon as I finished work, my boss brought more tasks."}]}}}