{"kind":"grammar","lang":"en","entities":{"n4-062":{"renderings":[{"id":"119e4df43712f9c3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-062"},"match":"id","status":"imported","value":"Tell someone to do something; 'tell to do', 'instruct to do'."},{"id":"df5517f31e5909ab","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-062"},"match":"id","status":"imported","value":"The grammar point Verb ように言う is used when someone tells or instructs another person to do something. It can be translated as 'tell to do' or 'instruct to do' in English. The formation is created by adding ように言う to the casual form of a verb."},{"id":"dbd95147dc991bb0","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-062"},"match":"id","status":"imported","value":"Verb-casual + ように言う"},{"id":"8b1c99c66833ad21","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-062"},"match":"id","status":"reviewed","value":"ように言う: tell someone to do something (早く来るように言った)."},{"id":"b3e707337e2047da","role":"label","field":"family","source":{"source":"gokan","ref":"reported-request"},"match":"id","status":"reviewed","value":"Reported Requests (Told To Do)","of":{"kind":"family","id":"reported-request"}}]},"n4-062#fb1e2488b306":{"renderings":[{"id":"2552d439de737ba5","role":"translation","source":{"source":"hanabira","ref":"n4-062"},"match":"id","status":"imported","value":"The teacher told us to do our homework."}]},"n4-062#aae11cef9861":{"renderings":[{"id":"f90cd7d4f90e8468","role":"translation","source":{"source":"hanabira","ref":"n4-062"},"match":"id","status":"imported","value":"My mother told my younger brother to clean his room."}]},"n4-062#b94614028408":{"renderings":[{"id":"80bc76a97dc861b9","role":"translation","source":{"source":"hanabira","ref":"n4-062"},"match":"id","status":"imported","value":"My boss told me to submit the report."}]},"n4-062#4f6c71f41184":{"renderings":[{"id":"72ae9841489a0605"