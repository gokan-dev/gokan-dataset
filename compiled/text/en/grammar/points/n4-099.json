{"kind":"grammar","lang":"en","entities":{"n4-099":{"renderings":[{"id":"25367b7630ca1f9e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-099"},"match":"id","status":"imported","value":"Used to define or explain a noun more specifically."},{"id":"f5a8b9e64b09f967","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-099"},"match":"id","status":"imported","value":"The ～という grammar point is used to define or explain a noun more specifically. It is often translated as 'called', 'named', or 'that is to say' in English. It can be used with nouns, な-adjectives, and adjectival verbs."},{"id":"ad7bc93e9f619277","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-099"},"match":"id","status":"imported","value":"Noun + という + Noun, な-Adjective + という + Noun, Adjectival Verb + という + Noun"},{"id":"94d8ca368ed44e31","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-099"},"match":"id","status":"reviewed","value":"'A ~ called X' (田中という人). Casual speech: っていう."},{"id":"71737f2ed7047fb3","role":"label","field":"family","source":{"source":"gokan","ref":"quoting"},"match":"id","status":"reviewed","value":"Called / Quoting (Named / They Say)","of":{"kind":"family","id":"quoting"}}]},"n4-099#3a97fe043704":{"renderings":[{"id":"28786481098b85a4","role":"translation","source":{"source":"gokan","ref":"n4-099"},"match":"id","status":"reviewed","value":"The person called Hayao Miyazaki is a famous animation director."}]},"n4-099#91cf94d5a303":{"renderings":[{"id":"32d29ab397bf845d","role":"translation","source":{"source":"gokan","ref":"n4-099"},"match":"id","status":"reviewed","value":"The city called Tokyo is bustling even at night."}]},"n4-099#1797375b018b":{"renderings":[{"id":"2cc35570df4de8a6","role":"translation","source":{"source":"gokan","ref":"n4-099"},"match":"id","status":"reviewed","value":"I like the book called 'Harry Potter'."}]},"n4-099#ca032ec24540":{"renderings":[{"id":"b90389bbcb3e556a","role":"translation","source":{"source":"gokan","ref":"n4-099"},"match":"id","status":"reviewed","value":"I had lunch at a restaurant called 'Sakura'."}]}}}