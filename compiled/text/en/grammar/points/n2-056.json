{"kind":"grammar","lang":"en","entities":{"n2-056":{"renderings":[{"id":"5be923e1173f4145","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"Express a sense of responsibility or determination; 'since', 'now that', 'if'."},{"id":"f90db771f8555ef2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"The ～からには grammar point is used to show a sense of responsibility or strong resolve once a certain condition is met. It can be translated as 'since', 'now that', or 'if'."},{"id":"2861459ac8e90b89","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"Noun + だ + からには, な-Adjective + だ + からには, い-Adjective + からには, Verb-casual + からには"},{"id":"17b2e53ee5caf4b6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-056"},"match":"id","status":"reviewed","value":"\"Now that/since (you've committed to X)\" - implies a resulting obligation or determination."},{"id":"fa19f1c414ee3570","role":"label","field":"family","source":{"source":"gokan","ref":"conditional"},"match":"id","status":"reviewed","value":"Conditional (If / Assuming That)","of":{"kind":"family","id":"conditional"}}]},"n2-056#2e7bed62047f":{"renderings":[{"id":"0be41069cb5189f6","role":"translation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"Since I passed the exam, I have to work hard."}]},"n2-056#ca1c0adad387":{"renderings":[{"id":"772be22ef4977ab8","role":"translation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"Since I made a promise, I must keep it."}]},"n2-056#27054f85273e":{"renderings":[{"id":"ea78b99848df7826","role":"translation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"Since this movie is interesting, I want to show it to my friends too."}]},"n2-056#91cb7887bc1f":{"renderings":[{"id":"341c9448ff0788a4","role":"translation","source":{"source":"hanabira","ref":"n2-056"},"match":"id","status":"imported","value":"Since she asked for help, I must help her."}]}}}