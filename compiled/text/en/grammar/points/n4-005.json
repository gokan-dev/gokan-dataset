{"kind":"grammar","lang":"en","entities":{"n4-005":{"renderings":[{"id":"8e54efd27950d722","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"Express a change happening or making something change."},{"id":"390fb87b7c855198","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"The い-Adjective く する/なる grammar point is used to indicate a change happening (naru) or intentionally making something change (suru). When using this grammatical structure, the い-adjective is changed to its く form, and then is followed by either する (to make the change) or なる (the change happens)."},{"id":"d73a7994b35b9c7f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"い-Adjective (remove い) + く + する/なる"},{"id":"c3ea9b0ae6dd61d4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-005"},"match":"id","status":"reviewed","value":"する: you make it so (明るくする). なる: it became so (赤くなる)."},{"id":"8553d2d48522a250","role":"label","field":"derives","source":{"source":"gokan","ref":"n4-005"},"match":"id","status":"reviewed","value":"i-adjective adverbial (く) + する/なる"},{"id":"f48a13546b42cc1e","role":"label","field":"family","source":{"source":"gokan","ref":"change-of-state"},"match":"id","status":"reviewed","value":"Change (Become / Make / Decide On)","of":{"kind":"family","id":"change-of-state"}}]},"n4-005#5bb9d70c18b3":{"renderings":[{"id":"24a97865cfeffa7f","role":"translation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"I will make the room brighter."}]},"n4-005#dbc5afdf9550":{"renderings":[{"id":"d0c96f0b42fb9d14","role":"translation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"His face turned red."}]},"n4-005#89f3b5f59cee":{"renderings":[{"id":"c47907af74138e44","role":"translation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"Please make this dish spicy."}]},"n4-005#ea11e8b3881b":{"renderings":[{"id":"d2d5b88e2e885e6d","role":"translation","source":{"source":"hanabira","ref":"n4-005"},"match":"id","status":"imported","value":"When it rains, the road becomes slippery."}]}}}