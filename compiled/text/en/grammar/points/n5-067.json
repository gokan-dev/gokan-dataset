{"kind":"grammar","lang":"en","entities":{"n5-067":{"renderings":[{"id":"11d79b230afbb0a8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"Indicates an unspecified point in time; 'someday', 'one day', 'at some point'."},{"id":"e02aa452a9a896dc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"The grammar point いつか is used to indicate an unspecified point in time, meaning 'someday', 'one day', or 'at some point' in the future or the past. It can be used in sentences to express hopes, dreams, or possibilities."},{"id":"c3b4a093dfa4a77f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"いつか + sentence"},{"id":"779201f235633050","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-067"},"match":"id","status":"reviewed","value":"'Someday, at some point': a time you do not name (いつか日本に行きたい)."},{"id":"4ead59a8748796c7","role":"label","field":"family","source":{"source":"gokan","ref":"always"},"match":"id","status":"reviewed","value":"When (Always / Anytime / Someday)","of":{"kind":"family","id":"always"}}]},"n5-067#f9197618bf5b":{"renderings":[{"id":"bfd13e12ea027967","role":"translation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"I want to go to Japan someday."}]},"n5-067#7e1d93dfa96c":{"renderings":[{"id":"a4a9271b0ae95c6e","role":"translation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"He will become a famous writer someday."}]},"n5-067#0e518aa48710":{"renderings":[{"id":"58aa9c3c4ee785bc","role":"translation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"I think I want to climb that mountain someday."}]},"n5-067#13d84995888b":{"renderings":[{"id":"2707e910ae05c445","role":"translation","source":{"source":"hanabira","ref":"n5-067"},"match":"id","status":"imported","value":"I believe she can achieve her dream someday."}]}}}