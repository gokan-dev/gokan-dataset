{"kind":"grammar","lang":"en","entities":{"n5-127":{"renderings":[{"id":"497b5178ec47ff2d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"Used to express 'almost', 'nearly', or 'most'."},{"id":"9eab71d4bb2233b8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"The ほとんど〜 grammar point is used to express that something is 'almost', 'nearly', or 'most'. It can appear in both negative contexts (hardly/barely) or positive contexts (almost all). It is typically followed by a verb or used with a noun to describe the quantity or extent of something."},{"id":"e28e0bf5c3bfdebc","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"ほとんど + Verb / ほとんど + Noun"},{"id":"5728f6f4ca89f646","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-127"},"match":"id","status":"reviewed","value":"\"Almost/nearly all\" - the standard degree-based \"almost\"."},{"id":"040d13b68e1b57c5","role":"label","field":"family","source":{"source":"gokan","ref":"almost"},"match":"id","status":"reviewed","value":"Almost (Nearly)","of":{"kind":"family","id":"almost"}}]},"n5-127#740034b4ae41":{"renderings":[{"id":"2c58d171f8f810fc","role":"translation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"She can hardly speak English."}]},"n5-127#aa2d2297de98":{"renderings":[{"id":"63793be4d4d2d695","role":"translation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"Most people attended the party."}]},"n5-127#e80f8bf32860":{"renderings":[{"id":"cf598efa03d47d81","role":"translation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"We passed the test with hardly any studying."}]},"n5-127#c8ca48884172":{"renderings":[{"id":"50bbab87af7c9cb3","role":"translation","source":{"source":"hanabira","ref":"n5-127"},"match":"id","status":"imported","value":"I have almost finished reading this book."}]}}}