{"kind":"grammar","lang":"en","entities":{"n2-097":{"renderings":[{"id":"b2c9d5116623908a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"Not the time/place for; far from; can't possibly."},{"id":"1bfaa288961839d3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"The ～どころではない grammar point is used to express that circumstances make it impossible or inappropriate to do something - there’s a much bigger issue at hand. It can also mean ‘far from’ in a figurative sense."},{"id":"bb8c5969cdb647d4","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"Verb-casual + どころではない, い-Adjective + どころではない, な-Adjective + どころではない, Noun + どころではない"},{"id":"898492600543cb22","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-097"},"match":"id","status":"reviewed","value":"どころではない: no time or place for that (勉強どころではない)."},{"id":"38b1bffd12f4b052","role":"label","field":"family","source":{"source":"gokan","ref":"not-only-limited"},"match":"id","status":"reviewed","value":"Not Only Limited To (Far From)","of":{"kind":"family","id":"not-only-limited"}}]},"n2-097#16916a9347d7":{"renderings":[{"id":"baf1a8891a538a96","role":"translation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"This is not the time to laugh at his mistakes—we’re making the same ones."}]},"n2-097#be7116fdb87c":{"renderings":[{"id":"4372cf6b7fe1a673","role":"translation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"When you’re sick in bed, it's far from the time to play around."}]},"n2-097#4a3585fa8d0f":{"renderings":[{"id":"db4255e3ad95dd56","role":"translation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"Since the exam is coming up, I can’t possibly watch a movie."}]},"n2-097#00407813fff2":{"renderings":[{"id":"c588231f9dccc236","role":"translation","source":{"source":"hanabira","ref":"n2-097"},"match":"id","status":"imported","value":"I'm way too busy with work to even think about going on a trip."}]}}}