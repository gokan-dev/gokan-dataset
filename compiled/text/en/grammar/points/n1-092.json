{"kind":"grammar","lang":"en","entities":{"n1-092":{"renderings":[{"id":"3711c2d516c54d60","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"Expresses a state in which something is entirely covered or filled with something else."},{"id":"80e56511d9f179fc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"The まみれ grammar point is used to express a state where someone or something is completely covered, smeared, or filled with another thing. The noun before まみれ indicates what the person or thing is covered in. This grammar point often has a negative connotation."},{"id":"54522d10c2e9172e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"Noun + まみれ"},{"id":"d10924c7c87708fc","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-092"},"match":"id","status":"reviewed","value":"まみれ: smeared all over with (泥まみれ)."},{"id":"d4a432b40b291048","role":"label","field":"family","source":{"source":"gokan","ref":"totality"},"match":"id","status":"reviewed","value":"Totality (Entirely / Full Of / Covered In)","of":{"kind":"family","id":"totality"}}]},"n1-092#5c4ba7a6d853":{"renderings":[{"id":"c3999fe6a2742ace","role":"translation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"He returned home covered in mud."}]},"n1-092#fb7e6fa0ee11":{"renderings":[{"id":"6ab072784ff6102d","role":"translation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"She confessed while crying her eyes out."}]},"n1-092#f313e9accb27":{"renderings":[{"id":"ab365ef4d8fae7d2","role":"translation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"After that incident, he was completely embroiled in scandal."}]},"n1-092#1db6f9de067a":{"renderings":[{"id":"dab5ae498258102f","role":"translation","source":{"source":"hanabira","ref":"n1-092"},"match":"id","status":"imported","value":"This room is covered in dust."}]}}}