{"kind":"grammar","lang":"en","entities":{"n1-057":{"renderings":[{"id":"ef65575fc8808690","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"Expresses the idea of 'unfitting', 'unbecoming' or 'inappropriate'."},{"id":"5fdd27678da32a76","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"The grammar point Noun にあるまじき Noun is used to express that the noun doesn't fit or is inappropriate in some way for the other noun. It can translate loosely as 'unfitting for', 'unbecoming of' or 'something that must not be for a/ the noun'."},{"id":"89e76d1c2576dac2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"Noun1 にあるまじき Noun2"},{"id":"ffd030e60a2d8f6a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-057"},"match":"id","status":"reviewed","value":"にあるまじき: unbecoming of (教師にあるまじき行為)."},{"id":"98641544bada2a98","role":"label","field":"family","source":{"source":"gokan","ref":"befitting"},"match":"id","status":"reviewed","value":"Befitting (As Expected Of / Unbecoming Of)","of":{"kind":"family","id":"befitting"}}]},"n1-057#00652262f79d":{"renderings":[{"id":"f7ee8174c5ac5f56","role":"translation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"He took actions that are unbecoming of a teacher."}]},"n1-057#c838aa30f94c":{"renderings":[{"id":"29ed28c38276edd7","role":"translation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"This is an act that is unfitting for a human."}]},"n1-057#ee792e8cf710":{"renderings":[{"id":"f74710055e2a5dca","role":"translation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"She behaved in a way that is unbecoming of a president."}]},"n1-057#173a815760bd":{"renderings":[{"id":"21123bf017d57b49","role":"translation","source":{"source":"hanabira","ref":"n1-057"},"match":"id","status":"imported","value":"That is a behaviour that is not suitable for an adult."}]}}}