{"kind":"grammar","lang":"en","entities":{"n1-147":{"renderings":[{"id":"152a15b3ec6ebcb8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"Expresses 'the way/manner of doing something' or 'in order to / so that / try to'."},{"id":"c850401dcf03ab31","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"This usage of よう most commonly appears as 「Verb辞書形 + ように」. It can mean 'in order to do something', 'so that something happens', or 'in the way someone does something'. It is also used in expressions like ～ようにする (to make an effort to) or ～ように言う (to tell someone to do something)."},{"id":"193d017cc92ecfc2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"Verb (dictionary or negative form) + ように (する / etc.)"},{"id":"5e62067524b255be","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-147"},"match":"id","status":"reviewed","value":"ます stem + よう: the way of doing (話しよう)."},{"id":"f154a4c08defae72","role":"label","field":"family","source":{"source":"gokan","ref":"manner"},"match":"id","status":"reviewed","value":"Manner (Way Of Doing)","of":{"kind":"family","id":"manner"}}]},"n1-147#ac13b835c242":{"renderings":[{"id":"6925c1326fc58390","role":"translation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"I will try to solve this problem."}]},"n1-147#815b3ac6575d":{"renderings":[{"id":"0e40a708cf8794bd","role":"translation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"Let's do it the way he said."}]},"n1-147#72d30ba90ac5":{"renderings":[{"id":"1db06e194c1e56b5","role":"translation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"I make it a point to run every day."}]},"n1-147#a25e87aca2c4":{"renderings":[{"id":"f3b4ed232f210856","role":"translation","source":{"source":"hanabira","ref":"n1-147"},"match":"id","status":"imported","value":"Try to take care of your own heart."}]}}}