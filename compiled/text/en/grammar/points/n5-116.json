{"kind":"grammar","lang":"en","entities":{"n5-116":{"renderings":[{"id":"9c8a08600642de35","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"Indicates 'something' or 'some kind of'."},{"id":"30f93cc03c8707a7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"The なにか grammar point is used to express the idea of 'something' or 'some kind of' in Japanese. It is often used when the speaker is unsure or not specific about the details of the noun being referred to. なにか is used before the noun it modifies."},{"id":"c484abe111c13012","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"なにか + Noun"},{"id":"2dc2ad640aeb4dd0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-116"},"match":"id","status":"reviewed","value":"'Something': a thing you do not name (なにか食べたい). A statement, not a question."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-116#f01447255b59":{"renderings":[{"id":"9e9cd2c5bb5f6bfc","role":"translation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"Please bring some kind of drink."}]},"n5-116#4a0260d922fa":{"renderings":[{"id":"6a9b914715539e93","role":"translation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"If you have any questions, please feel free to ask."}]},"n5-116#6054df2d6d6e":{"renderings":[{"id":"c9d287d3f810e323","role":"translation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"She has some kind of present."}]},"n5-116#bb3d4f820641":{"renderings":[{"id":"888a13d2bbba240d","role":"translation","source":{"source":"hanabira","ref":"n5-116"},"match":"id","status":"imported","value":"If you need any help, please let me know."}]}}}