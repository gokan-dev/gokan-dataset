{"kind":"grammar","lang":"en","entities":{"n4-056":{"renderings":[{"id":"64a3f0f1d8531ab0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-056"},"match":"id","status":"imported","value":"Express difficulty or complexity; 'hard to', 'difficult to', 'not easily'."},{"id":"a6812f90c4415268","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-056"},"match":"id","status":"imported","value":"The ～にくい grammar point is used to express that an action is difficult or relatively hard to do. It is used by attaching にくい to the stem of a verb. It can be translated as 'hard to', 'difficult to', or 'not easily' in English."},{"id":"59d501b299d12f4e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-056"},"match":"id","status":"imported","value":"Verb-stem + にくい"},{"id":"b47983a151891310","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-056"},"match":"id","status":"reviewed","value":"ます stem + にくい: hard to do (読みにくい). Easy to do: やすい."},{"id":"6b1e4cc3700c0626","role":"label","field":"family","source":{"source":"gokan","ref":"ease"},"match":"id","status":"reviewed","value":"Ease (Easy To / Hard To)","of":{"kind":"family","id":"ease"}}]},"n4-056#e6247958d8bc":{"renderings":[{"id":"b8aa248b0610eacd","role":"translation","source":{"source":"hanabira","ref":"n4-056"},"match":"id","status":"imported","value":"This character is hard to read."}]},"n4-056#7e74602008d9":{"renderings":[{"id":"1e3628294171fc4a","role":"translation","source":{"source":"hanabira","ref":"n4-056"},"match":"id","status":"imported","value":"This door is difficult to open."}]},"n4-056#5c2910c77250":{"renderings":[{"id":"a3d96433fad0c420","role":"translation","source":{"source":"hanabira","ref":"n4-056"},"match":"id","status":"imported","value":"His handwriting is hard to read."}]},"n4-056#b3392f5744f6":{"renderings":[{"id":"8537d7c0afc30505","role":"translation","source":{"source":"hanabira","ref":"n4-056"},