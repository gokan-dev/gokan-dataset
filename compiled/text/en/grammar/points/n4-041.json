{"kind":"grammar","lang":"en","entities":{"n4-041":{"renderings":[{"id":"88f895ad343f3ac7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-041"},"match":"id","status":"imported","value":"A polite way to request someone to do something for you; 'Could you please', 'Would you please', 'Won't you'."},{"id":"927e3528e3a99660","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-041"},"match":"id","status":"imported","value":"The ～てくれませんか grammar point is used to ask someone politely to do something for you. It is formed by using the て-form of a verb followed by くれませんか. It translates to 'Could you please', 'Would you please', or 'Won't you' in English."},{"id":"557125b8b6eda054","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-041"},"match":"id","status":"imported","value":"Verb-て form + くれませんか"},{"id":"7495b6f2f827a7c6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-041"},"match":"id","status":"reviewed","value":"Neutral, everyday \"could you...\" - casual-to-neutral request."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-041#02e308565e91":{"renderings":[{"id":"4ee4699752b6b58c","role":"translation","source":{"source":"hanabira","ref":"n4-041"},"match":"id","status":"imported","value":"Could you please open the door?"}]},"n4-041#45939126fe2d":{"renderings":[{"id":"d88f4d1736d5dacc","role":"translation","source":{"source":"hanabira","ref":"n4-041"},"match":"id","status":"imported","value":"Would you please take a look at this?"}]},"n4-041#e8cfc3f69c92":{"renderings":[{"id":"4616684cb42e40e7","role":"translation","source":{"source":"hanabira","ref":"n4-041"},"match":"id","status":"imported","value":"Won't you help me?"}]},"n4-041#f5f69b17af21":{"renderings":[{"id":"2