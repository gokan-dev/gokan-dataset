{"kind":"grammar","lang":"en","entities":{"n4-070":{"renderings":[{"id":"9466bb42a598e36d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-070"},"match":"id","status":"imported","value":"Express the action of taking something out, starting an action, or emphasizing a verb."},{"id":"8a25ed3c6220b813","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-070"},"match":"id","status":"imported","value":"The verb 出す (~dasu) is used to express the action of taking something out, starting an action, or emphasizing the verb it is attached to. To form this grammar point, simply attach 出す (~dasu) to the stem of the verb."},{"id":"025f4e95d92521cd","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-070"},"match":"id","status":"imported","value":"Verb stem + 出す (~dasu)"},{"id":"29fbd55468649a69","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-070"},"match":"id","status":"reviewed","value":"ます stem + 出す: suddenly start (泣き出す)."},{"id":"346651d354f1ea02","role":"label","field":"family","source":{"source":"gokan","ref":"aspect-verbs"},"match":"id","status":"reviewed","value":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","of":{"kind":"family","id":"aspect-verbs"}}]},"n4-070#e3f66b4ad30e":{"renderings":[{"id":"433bb3277a7e5d17","role":"translation","source":{"source":"gokan","ref":"n4-070"},"match":"id","status":"reviewed","value":"It suddenly started to rain."}]},"n4-070#b3cb3e74f8e6":{"renderings":[{"id":"158ce7d5ccf5b334","role":"translation","source":{"source":"gokan","ref":"n4-070"},"match":"id","status":"reviewed","value":"The baby burst out crying."}]},"n4-070#e5b58174bb80":{"renderings":[{"id":"3f08cdc09af120fc","role":"translation","source":{"source":"gokan","ref":"n4-070"},"match":"id","status":"reviewed","value":"She started singing."}]},"n4-070#12624ebafd5f":{"renderings":[{"id":"4d5b653004ac2ac3","role":"translation","source":{"source":"gokan","ref":"n4-070"},"match":"id","status":"reviewed","value":"Hearing the story, everyone burst out laughing."}]}}}