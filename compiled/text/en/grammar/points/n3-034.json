{"kind":"grammar","lang":"en","entities":{"n3-034":{"renderings":[{"id":"30a3b0ad9a34ef6a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"Indicates an action that has just been completed; 'freshly', 'just'."},{"id":"cd18596b136efb80","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"The ～たて grammar point is used to express that an action has just been completed, and the result or condition is still fresh or new. This is often used with verbs like 焼く (bake), 作る (make), or 洗う (wash)."},{"id":"5ecbb5e1ed01536e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"Verb-stem + たて"},{"id":"dfac746066c0c344","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-034"},"match":"id","status":"reviewed","value":"ます stem + たて: freshly done, just made (焼きたてのパン)."},{"id":"f23b094c4a6b95fd","role":"label","field":"family","source":{"source":"gokan","ref":"in-progress"},"match":"id","status":"reviewed","value":"Stage Of An Action (About To / In The Middle Of / Just Did)","of":{"kind":"family","id":"in-progress"}}]},"n3-034#34f1b817c51f":{"renderings":[{"id":"865df796328cbe1b","role":"translation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"This bread is freshly baked and still warm."}]},"n3-034#7fcc1ca4d67d":{"renderings":[{"id":"d8ae1f5b777ce56d","role":"translation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"A freshly made bento is delicious."}]},"n3-034#f0ece253359a":{"renderings":[{"id":"826acef35b2025d9","role":"translation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"Freshly washed shirts smell nice."}]},"n3-034#68036f447755":{"renderings":[{"id":"56dd53400174f7c1","role":"translation","source":{"source":"hanabira","ref":"n3-034"},"match":"id","status":"imported","value":"She added freshly cut vegetables to the salad."}]}}}