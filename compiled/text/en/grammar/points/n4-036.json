{"kind":"grammar","lang":"en","entities":{"n4-036":{"renderings":[{"id":"79fce128d6958b74","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"Expresses 'while' or 'during the time' something is happening."},{"id":"65d14927e744a420","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"The ～ている間に grammar point is used to express that an action or event occurs during the time another action or event is happening. It is often translated to 'while' or 'during the time' in English. It is formed by combining the て-form of a verb with いる and adding 間に."},{"id":"acd3af3996c52f9d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"Verb-て form + いる + 間に"},{"id":"dd6e619300a7b2f3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-036"},"match":"id","status":"reviewed","value":"\"While (an ongoing action continues)\" - pairs with an ongoing verb."},{"id":"752b6fa31dd22e50","role":"label","field":"family","source":{"source":"gokan","ref":"time-window"},"match":"id","status":"reviewed","value":"Time Window (During / While It Lasts)","of":{"kind":"family","id":"time-window"}}]},"n4-036#2902326b966a":{"renderings":[{"id":"6759e480774f36f3","role":"translation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"While watching the movie, he fell asleep."}]},"n4-036#e8f73e0ace0a":{"renderings":[{"id":"ba51321cedef64de","role":"translation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"While the children are playing, I'll cook."}]},"n4-036#d87b6266e928":{"renderings":[{"id":"6c80a2b8df7a2acd","role":"translation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"While the meeting was being held, it started raining."}]},"n4-036#d600c858a157":{"renderings":[{"id":"49abbaff9ca227f8","role":"translation","source":{"source":"hanabira","ref":"n4-036"},"match":"id","status":"imported","value":"While he is working, we'll go shopping."}]}}}