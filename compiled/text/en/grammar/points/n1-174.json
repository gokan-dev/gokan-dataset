{"kind":"grammar","lang":"en","entities":{"n1-174":{"renderings":[{"id":"d06b77ca889f34f4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"Expresses the idea of 'as soon as', 'the moment...'."},{"id":"c06ce55fac5a5085","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"The grammar point Verbる や否や is used to express something happening immediately after another action or event. It can be translated as 'as soon as...' or 'the moment...'. The verb must be in dictionary form."},{"id":"66dbc8dcd674cf9f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"Verb-dictionary form + や否や"},{"id":"0df74345b52826c9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-174"},"match":"id","status":"reviewed","value":"Formal, literary \"no sooner than\" - written narrative style."},{"id":"f993e5eecc2b6f19","role":"label","field":"family","source":{"source":"gokan","ref":"as-soon-as"},"match":"id","status":"reviewed","value":"As Soon As (The Moment That)","of":{"kind":"family","id":"as-soon-as"}}]},"n1-174#ef518c14beae":{"renderings":[{"id":"5592ccfa72f2fe0e","role":"translation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"As soon as she returned home, she turned on the TV."}]},"n1-174#fe44cc31673e":{"renderings":[{"id":"fb2b13d591148785","role":"translation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"The moment I opened the mailbox, the letters fell out."}]},"n1-174#3ebca8cd5b2a":{"renderings":[{"id":"ab885246e00671b6","role":"translation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"As soon as school was over, the children ran to the park."}]},"n1-174#c220e8d9ec50":{"renderings":[{"id":"b4b0b919abc4ef51","role":"translation","source":{"source":"hanabira","ref":"n1-174"},"match":"id","status":"imported","value":"The moment my father read the newspaper, he started trembling about something."}]}}}