{"kind":"grammar","lang":"en","entities":{"n4-066":{"renderings":[{"id":"12f9da6656c6921c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"Decide to do something, make a decision."},{"id":"97a4fdf30d75a6d0","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"The ～ることにする grammar point is used to express that someone has made a decision to do something or has decided on a specific course of action. It is formed by attaching ことにする to the verb in its る form."},{"id":"22d3dcd47e1c4861","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"Verb-る + ことにする"},{"id":"5e08512b0480c3a4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-066"},"match":"id","status":"reviewed","value":"ことにする: YOU decide (行くことにした). Decided for you: ことになる."},{"id":"bd97fcb92a4cb49c","role":"label","field":"family","source":{"source":"gokan","ref":"decisions"},"match":"id","status":"reviewed","value":"Decisions (Decide To / It Was Decided)","of":{"kind":"family","id":"decisions"}}]},"n4-066#dd66e4d711d1":{"renderings":[{"id":"158d46fbcf7a6331","role":"translation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"I decided to go to the gym next week."}]},"n4-066#af8c87db2d73":{"renderings":[{"id":"32abd48e7b369cee","role":"translation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"I decided to buy these shoes."}]},"n4-066#cb9120502867":{"renderings":[{"id":"1abd83d202968ca8","role":"translation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"I decided to take a walk every day."}]},"n4-066#74fbaa8bcff5":{"renderings":[{"id":"9670847d6d233c94","role":"translation","source":{"source":"hanabira","ref":"n4-066"},"match":"id","status":"imported","value":"I’ve decided to call him."}]}}}