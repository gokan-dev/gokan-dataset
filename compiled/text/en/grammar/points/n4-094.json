{"kind":"grammar","lang":"en","entities":{"n4-094":{"renderings":[{"id":"772c2010146aac88","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"A conjecture or probability; 'probably', 'I think', 'it seems'."},{"id":"8aaf2cee199d2622","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"The ～でしょう grammar point is used to indicate a conjecture or probability. It can be translated as 'probably', 'I think', or 'it seems' in English. It can be used with verbs, い-adjectives, な-adjectives, and nouns."},{"id":"68d02353571166b7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"Verb-ますstem + でしょう, い-Adjective + でしょう, な-Adjective + でしょう, Noun + でしょう"},{"id":"b35359ec0761e766","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-094"},"match":"id","status":"reviewed","value":"Polite conjecture - \"probably/I think\", softer and more polite than だろう."}]},"n4-094#b75abe16d7c5":{"renderings":[{"id":"c161c4b2d9e80d41","role":"translation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"It will probably be sunny tomorrow."}]},"n4-094#02bdfe700485":{"renderings":[{"id":"000abffce5040ba2","role":"translation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"He is probably fine."}]},"n4-094#3550380b7a8b":{"renderings":[{"id":"9e6f9bce6273745d","role":"translation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"This book is probably interesting."}]},"n4-094#f88c510bf868":{"renderings":[{"id":"83b3133df230d9f0","role":"translation","source":{"source":"hanabira","ref":"n4-094"},"match":"id","status":"imported","value":"She is probably a doctor."}]}}}