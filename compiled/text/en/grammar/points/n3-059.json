{"kind":"grammar","lang":"en","entities":{"n3-059":{"renderings":[{"id":"ae6930a3e46f2599","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"Express a comparison with preference; 'rather than', 'more like', 'instead of'."},{"id":"099144625e205bf2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"The ～というより grammar point is used to express a comparison where one description is more accurate than another. Translated as 'rather than', 'more like', or 'instead of'."},{"id":"165eb7cf6168d2b3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"Verb-casual + というより, い-Adjective + というより, な-Adjective + だというより, Noun + だというより"},{"id":"0e5cf9ecfa85a1b7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-059"},"match":"id","status":"reviewed","value":"というより: rather than A, it is more B (寒いというより痛い)."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n3-059#e3195480f6fa":{"renderings":[{"id":"b724d0b123f6379d","role":"translation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"Rather than saying this room is small, it's more like it's cozy."}]},"n3-059#18c196ce1ab1":{"renderings":[{"id":"b56a16e63be049f8","role":"translation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"Instead of saying he's scary, he's more like a reliable person."}]},"n3-059#972a0e1b1150":{"renderings":[{"id":"cc8db2d176f7cb62","role":"translation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"Rather than calling the movie boring, I'd say it was a bit long."}]},"n3-059#45b6e0dcb6e4":{"renderings":[{"id":"bb6d53c4f7d3bbdc","role":"translation","source":{"source":"hanabira","ref":"n3-059"},"match":"id","status":"imported","value":"Rather than a friend, she's more like family."}]}}}