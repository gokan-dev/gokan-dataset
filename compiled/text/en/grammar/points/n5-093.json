{"kind":"grammar","lang":"en","entities":{"n5-093":{"renderings":[{"id":"d36e4ab3751fd76d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"Express 'nobody' or 'no one' in a negative sentence."},{"id":"9dbacb2a1b11161a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"The grammar point だれも～ないです is used to express the idea of 'nobody' or 'no one' in a negative sentence. だれも is followed by the negative form of a verb or adjective, often using the polite ないです form."},{"id":"ed98f089a371fddc","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"だれも + Verb-negative form (ないです), だれも + い-Adjective-negative form (ないです), だれも + な-Adjective-negative form (じゃないです)"}]},"n5-093#efb002112a92":{"renderings":[{"id":"67f08e6d8945203f","role":"translation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"Nobody knows."}]},"n5-093#4c5fa20e856f":{"renderings":[{"id":"2d6678c860550a41","role":"translation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"Nobody is coming."}]},"n5-093#5c68536cd1ad":{"renderings":[{"id":"e8aa54a93feb0fa7","role":"translation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"She doesn't like anyone."}]},"n5-093#7d4960356c59":{"renderings":[{"id":"c04c8cb99127f9c8","role":"translation","source":{"source":"hanabira","ref":"n5-093"},"match":"id","status":"imported","value":"There is nobody here."}]}}}