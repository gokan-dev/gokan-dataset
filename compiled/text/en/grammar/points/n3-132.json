{"kind":"grammar","lang":"en","entities":{"n3-132":{"renderings":[{"id":"b6ce04909395efe0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-132"},"match":"id","status":"imported","value":"Express 'never', 'by no means', or 'not at all' when negating a statement."},{"id":"33a8c9b609f1d43c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-132"},"match":"id","status":"imported","value":"The 決して～ない grammar point is used to emphasize a negative statement or action. It can be translated as 'never', 'by no means', or 'not at all'. This grammar point must be paired with a negative verb form to maintain its negative meaning."},{"id":"cbc014da3bdd2fa1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-132"},"match":"id","status":"imported","value":"決して + Verb (negative form)"},{"id":"f1eafd8e8c16cb19","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-132"},"match":"id","status":"reviewed","value":"Emphatic \"never/by no means\" - stronger and more deliberate than ぜんぜん; common in writing and serious statements."},{"id":"515717669db2afa2","role":"label","field":"family","source":{"source":"gokan","ref":"negation-intensity"},"match":"id","status":"reviewed","value":"Negation Intensity (Not Very / Not At All)","of":{"kind":"family","id":"negation-intensity"}}]},"n3-132#5bc4c25f7106":{"renderings":[{"id":"6486b25bbb4fd29f","role":"translation","source":{"source":"hanabira","ref":"n3-132"},"match":"id","status":"imported","value":"He never arrives late."}]},"n3-132#9ee611e71bd1":{"renderings":[{"id":"87c1333fd738f1f5","role":"translation","source":{"source":"hanabira","ref":"n3-132"},"match":"id","status":"imported","value":"Please never tell this secret to anyone."}]},"n3-132#e686c061d1f8":{"renderings":[{"id":"be36163cae41668f","role":"translation","source":{"source":"hanabira","ref":"n3-132"},"match":"id","status":"imported","value":"Never give up and keep trying until