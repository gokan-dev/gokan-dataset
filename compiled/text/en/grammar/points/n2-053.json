{"kind":"grammar","lang":"en","entities":{"n2-053":{"renderings":[{"id":"4fb1abe82fba4c0d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-053"},"match":"id","status":"imported","value":"Expresses a judgment or evaluation based on a certain standard; 'from this perspective', 'considering', 'judging from'."},{"id":"0932af1342c58884","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-053"},"match":"id","status":"imported","value":"The ～からすると grammar point is used to make a judgment or evaluation based on some criterion, perspective, or standard. It can be translated as 'from this perspective', 'considering', or 'judging from' in English."},{"id":"7035b6fcff4aef5d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-053"},"match":"id","status":"imported","value":"Noun + からすると"},{"id":"44e7990b69606316","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-053"},"match":"id","status":"reviewed","value":"\"From this perspective/judging from\"."},{"id":"7a65fa95bf79f08b","role":"label","field":"family","source":{"source":"gokan","ref":"considering"},"match":"id","status":"reviewed","value":"Considering (Judging From)","of":{"kind":"family","id":"considering"}}]},"n2-053#cefc9e6c4472":{"renderings":[{"id":"9e96174ce43c0ed0","role":"translation","source":{"source":"hanabira","ref":"n2-053"},"match":"id","status":"imported","value":"Considering their experience, this job might be difficult."}]},"n2-053#6c3bd89ad9fd":{"renderings":[{"id":"bfc57446b86dd918","role":"translation","source":{"source":"hanabira","ref":"n2-053"},"match":"id","status":"imported","value":"Judging from the reputation, that restaurant is very delicious."}]},"n2-053#8a1a96a2f045":{"renderings":[{"id":"f8401c016c95f507","role":"translation","source":{"source":"hanabira","ref":"n2-053"},"match":"id","status":"imported","value":"Considering the price, this product seems to be of high quality."}]},"n2-053