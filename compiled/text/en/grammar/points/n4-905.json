{"kind":"grammar","lang":"en","entities":{"n4-905":{"renderings":[{"id":"5439574a524c260b","role":"label","field":"name","source":{"source":"gokan","ref":"n4-905"},"match":"id","status":"reviewed","value":"Conditional"},{"id":"c9de45cd8bc28540","role":"prose","field":"shortExplanation","source":{"source":"gokan","ref":"n4-905"},"match":"id","status":"reviewed","value":"The conditional 'if it is (adjective)' form."},{"id":"1534dc88b1014f30","role":"prose","field":"longExplanation","source":{"source":"gokan","ref":"n4-905"},"match":"id","status":"reviewed","value":"い-adjectives take the same ば-conditional as verbs, replacing い with ければ (安ければ買う, 'if it's cheap, I'll buy it')."},{"id":"68f598b69b340891","role":"prose","field":"formation","source":{"source":"gokan","ref":"n4-905"},"match":"id","status":"reviewed","value":"Drop the final い and add ければ: 高い -> 高ければ. Irregular: いい -> よければ."},{"id":"7c34757f898c3706","role":"label","field":"derives","source":{"source":"gokan","ref":"n4-905"},"match":"id","status":"reviewed","value":"ば conditional (ければ)"}]}}}