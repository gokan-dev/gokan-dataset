{"kind":"grammar","lang":"en","entities":{"n2-082":{"renderings":[{"id":"2a5095d506034f16","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"Emphasizes the condition; 'only when', 'precisely because'."},{"id":"7e45e0110c420318","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"The ～てこそ grammar point is used to emphasize that 'only when' or 'precisely because' the stated condition is met, a certain result or meaning arises. For nouns and adjectives, similar forms appear (e.g., Noun + でこそ, い-Adjective くてこそ, な-Adjective でこそ)."},{"id":"2826b4e21f8ba70e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"Verb-て form + こそ / い-Adjective + くてこそ / な-Adjective + でこそ / Noun + でこそ"},{"id":"be3d255648877ef1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-082"},"match":"id","status":"reviewed","value":"てこそ: only by doing X (やってこそ分かる)."},{"id":"d9af84a42d98e34b","role":"label","field":"family","source":{"source":"gokan","ref":"koso"},"match":"id","status":"reviewed","value":"Emphasis With こそ (Precisely / Only By)","of":{"kind":"family","id":"koso"}}]},"n2-082#d8e5ff4115d5":{"renderings":[{"id":"876b098f517d3dc6","role":"translation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"Only when you study can you pass the test."}]},"n2-082#9699e212d36b":{"renderings":[{"id":"b5a04a52b263f0af","role":"translation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"Only when you’re honest can you understand the other person’s feelings."}]},"n2-082#b15716860070":{"renderings":[{"id":"9a05ccb8a1baca22","role":"translation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"Only in silence can one’s mind be at peace."}]},"n2-082#9816c3625327":{"renderings":[{"id":"a80afd6d0b1d0d8b","role":"translation","source":{"source":"hanabira","ref":"n2-082"},"match":"id","status":"imported","value":"Precisely because we’re friends, it’s natural to help each other."}]}}}