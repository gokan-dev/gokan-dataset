{"kind":"grammar","lang":"en","entities":{"n2-147":{"renderings":[{"id":"31fb618d183ad22f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"Express doing something until a certain time or condition; 'until', 'to'."},{"id":"cfdaaa80e9c153db","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"The ～まで～て grammar point is used to show that an action continues until a certain time or condition. In your examples, a time expression (such as 9時) is followed by まで, then the action in the て-form. It can be translated as 'until' or 'up to the point when/where'."},{"id":"e884e6e7da063501","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"Time/Noun + まで + Verb(て-form)"},{"id":"e994c893b7f8e1f4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-147"},"match":"id","status":"reviewed","value":"Verb-て + まで variant - \"(does something) until X happens\"."},{"id":"f576172f87098943","role":"label","field":"family","source":{"source":"gokan","ref":"emphasis-even"},"match":"id","status":"reviewed","value":"Emphasis (Even)","of":{"kind":"family","id":"emphasis-even"}}]},"n2-147#4d54e96e0c9f":{"renderings":[{"id":"d846b8f829cca8f6","role":"translation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"I worked until 9 o'clock, and then took a break."}]},"n2-147#efa7023af2d5":{"renderings":[{"id":"763d242da9107903","role":"translation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"I studied until night, and passed the exam."}]},"n2-147#4b87144b3b49":{"renderings":[{"id":"5946d723c4872b60","role":"translation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"I read until the last page, then closed the book."}]},"n2-147#598b1e6d510a":{"renderings":[{"id":"37970a30bf3141bc","role":"translation","source":{"source":"hanabira","ref":"n2-147"},"match":"id","status":"imported","value":"I waited until the train arrived, and then met my friend."}]}}}