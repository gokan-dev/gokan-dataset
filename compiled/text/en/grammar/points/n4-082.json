{"kind":"grammar","lang":"en","entities":{"n4-082":{"renderings":[{"id":"0ba31eb4755606c5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"Expresses that something is excessive or overdone; 'too much', 'too', 'over'."},{"id":"9133c7f2e0eb5e0a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"The ～すぎる grammar point is used to express that something is excessive or beyond a certain level. It can be translated as 'too much', 'too', or 'over' in English. The formation differs depending on whether it is used with a verb, い-adjective, or な-adjective."},{"id":"2bb870fbddbc66f1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"Verb-stem + すぎる, い-Adjective (remove い) + すぎる, な-Adjective + すぎる"}]},"n4-082#db267d67bafa":{"renderings":[{"id":"c34e57121b95098f","role":"translation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"This room is too hot."}]},"n4-082#35a3e76419be":{"renderings":[{"id":"67b0af4aab34ff40","role":"translation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"He came too early."}]},"n4-082#73d5b519b8b6":{"renderings":[{"id":"59f0a76d277c4e33","role":"translation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"This box is too heavy to lift."}]},"n4-082#892508530765":{"renderings":[{"id":"3df5b3b2dfc06cf5","role":"translation","source":{"source":"hanabira","ref":"n4-082"},"match":"id","status":"imported","value":"She's too busy to play too much."}]}}}