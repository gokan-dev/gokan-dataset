{"kind":"grammar","lang":"en","entities":{"n4-022":{"renderings":[{"id":"f3a3c04be007aec0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"Expresses the experience of having done something in the past."},{"id":"5cf7a56c41e8239a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"The ～たことがある grammar point is used to express the experience of having done an action in the past. It indicates that the speaker has had the experience of doing something at least once before. It is formed by adding ことがある to the た-form of the verb."},{"id":"48456c1095c9b23c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"Verb-た-form + ことがある"},{"id":"b63f8a4527f184b3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-022"},"match":"id","status":"reviewed","value":"た + ことがある: 'have done before', an experience (行ったことがある)."},{"id":"8c9f3aa97389b285","role":"label","field":"family","source":{"source":"gokan","ref":"experience"},"match":"id","status":"reviewed","value":"Experience And Occasion (Have Done / Sometimes Do)","of":{"kind":"family","id":"experience"}}]},"n4-022#8605f0a5485a":{"renderings":[{"id":"661b6911d93eb446","role":"translation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"I have been to Japan before."}]},"n4-022#cc8b6d3072c5":{"renderings":[{"id":"3c95a6f5acea39e6","role":"translation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"Have you ever eaten sushi before?"}]},"n4-022#2481de67e9c9":{"renderings":[{"id":"8dcd9662be364496","role":"translation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"He has experienced running a marathon."}]},"n4-022#ca25033d7d0b":{"renderings":[{"id":"2f56ab2bd579adac","role":"translation","source":{"source":"hanabira","ref":"n4-022"},"match":"id","status":"imported","value":"I have never experienced skydiving."}]}}}