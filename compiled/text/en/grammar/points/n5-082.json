{"kind":"grammar","lang":"en","entities":{"n5-082":{"renderings":[{"id":"2c1597de16e32733","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"Used to express 'not at all' or 'completely' in negative sentences."},{"id":"9e0cf3d5f7d30bb8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"The ぜんぜん grammar point is used to emphasize a negative statement and can be translated as 'not at all' or 'completely (in negative sense)'. It is commonly used with negative verbs or negative forms of adjectives, placed before the negative part."},{"id":"ff6c92392e80adb8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"ぜんぜん + [Negative verb/adjective]"},{"id":"2a1e36e65c9fdc83","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-082"},"match":"id","status":"reviewed","value":"The everyday, common \"not at all\" - very frequent in speech."},{"id":"515717669db2afa2","role":"label","field":"family","source":{"source":"gokan","ref":"negation-intensity"},"match":"id","status":"reviewed","value":"Negation Intensity (Not Very / Not At All)","of":{"kind":"family","id":"negation-intensity"}}]},"n5-082#7b6546b82e95":{"renderings":[{"id":"8afc34666c13b134","role":"translation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"He doesn't talk at all."}]},"n5-082#a318554c8da8":{"renderings":[{"id":"d006813c89cd50a9","role":"translation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"This room is not dark at all."}]},"n5-082#312400f6dfcc":{"renderings":[{"id":"7a6480683cdce2b7","role":"translation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"She is not tired at all."}]},"n5-082#387a937b4aa7":{"renderings":[{"id":"f85303769671f14d","role":"translation","source":{"source":"hanabira","ref":"n5-082"},"match":"id","status":"imported","value":"That movie was not interesting at all."}]}}}