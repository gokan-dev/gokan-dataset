{"kind":"grammar","lang":"en","entities":{"n1-008":{"renderings":[{"id":"fc733e1953b505d5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"Expresses two possibilities; 'either A or B', 'whether A or B'."},{"id":"1c6997509facdbbf","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"The 'A とも B とも' grammar pattern indicates two possible scenarios. It can be translated as 'whether A or B' or 'either A or B'."},{"id":"b5f6decfb921daa2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"Noun + とも + Noun + とも (or sometimes Verb forms for each A, B)"},{"id":"6cbefbfe329751c7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-008"},"match":"id","status":"reviewed","value":"Formal, literary - one of several near-interchangeable \"whether A or B\" constructions; stylistic choice more than a formality ladder."},{"id":"c0501e0b255eb50d","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-a-or-b"},"match":"id","status":"reviewed","value":"Regardless (Whether A Or B)","of":{"kind":"family","id":"regardless-a-or-b"}}]},"n1-008#7bf0278ce11c":{"renderings":[{"id":"c5e9a6098a8fa8ce","role":"translation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"Whether it's a wise decision or a mistake, time will show the result."}]},"n1-008#c741abbd0eca":{"renderings":[{"id":"cdaf75fa9a5122a0","role":"translation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"He hasn't spoken to either his father or his brother in years."}]},"n1-008#5868a6973310":{"renderings":[{"id":"47d854c8a51e9e42","role":"translation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"I plan to go watch a movie either with my girlfriend or a friend."}]},"n1-008#80d8ea3020b0":{"renderings":[{"id":"220a329605ab1be0","role":"translation","source":{"source":"hanabira","ref":"n1-008"},"match":"id","status":"imported","value":"This game requires a kind of persistence beyond just time or effort."}]}}}