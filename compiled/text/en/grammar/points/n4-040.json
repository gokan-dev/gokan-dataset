{"kind":"grammar","lang":"en","entities":{"n4-040":{"renderings":[{"id":"a5d32fde4e33f2bf","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"An action that starts in the past and continues to the present or future; 'come to', 'begin to', 'become'."},{"id":"2dd50b8a0207300c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"The て くる grammar point is used to express an action that starts in the past and continues to the present or future. It can also show a change in state or condition. The formation involves attaching the て-form of the verb followed by くる."},{"id":"3fbd0ecd9349f3a3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"Verb て-form + くる"},{"id":"e2631aaeb2df20c3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-040"},"match":"id","status":"reviewed","value":"てくる: change up to now, or moving toward the speaker (寒くなってきた)."},{"id":"28e0e6e1e644a507","role":"label","field":"family","source":{"source":"gokan","ref":"direction-of-change"},"match":"id","status":"reviewed","value":"Direction Of Change (From Now On / Up To Now)","of":{"kind":"family","id":"direction-of-change"}}]},"n4-040#df3ff20a1c99":{"renderings":[{"id":"9be67818292b2a6c","role":"translation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"Recently, I've come to understand Japanese."}]},"n4-040#0119607dde18":{"renderings":[{"id":"69171034de1d3a33","role":"translation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"Since it's gotten cold, let's put on a coat."}]},"n4-040#837bbcd4d982":{"renderings":[{"id":"d680f6530975da4f","role":"translation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"The rain has stopped (and it's cleared up)."}]},"n4-040#5e80b0df0ab7":{"renderings":[{"id":"5f2f59622e4fc15a","role":"translation","source":{"source":"hanabira","ref":"n4-040"},"match":"id","status":"imported","value":"He has become progressively scarier."}]}}}