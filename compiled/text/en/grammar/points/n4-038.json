{"kind":"grammar","lang":"en","entities":{"n4-038":{"renderings":[{"id":"a9cd4bed5e00f5fc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"Polite request for asking someone for a favor."},{"id":"7953e8bfe6042c45","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"The て くださいませんか grammar point is a polite way of asking someone for a favor or requesting them to do something. It is more formal than the simple て form followed by ください, and it is commonly used in more formal settings or when speaking to someone who is not close."},{"id":"fad20569c86c5680","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"Verb in て-form + くださいませんか"},{"id":"8daf9453938749a9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-038"},"match":"id","status":"reviewed","value":"Formal but common - \"would you please...\"."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-038#f7bed3146cc8":{"renderings":[{"id":"0c32461f19f1c7b0","role":"translation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"Would you please drink some coffee?"}]},"n4-038#7585b097f2d8":{"renderings":[{"id":"9742805f9b8c4690","role":"translation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"Would you please close the door?"}]},"n4-038#654079218f9f":{"renderings":[{"id":"a9851c433f487bc6","role":"translation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"Would you please meet me at lunch tomorrow?"}]},"n4-038#f368d3f1954a":{"renderings":[{"id":"a06da5f1c03bb441","role":"translation","source":{"source":"hanabira","ref":"n4-038"},"match":"id","status":"imported","value":"Would you please send me that document?"}]}}}