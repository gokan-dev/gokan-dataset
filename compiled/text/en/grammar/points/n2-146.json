{"kind":"grammar","lang":"en","entities":{"n2-146":{"renderings":[{"id":"21831982a0ecc2e1","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"Express a negative conjecture or determination; 'probably not' or 'I will not'."},{"id":"34674394212beaa4","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"The ～まい grammar point is used to express a negative conjecture or a strong determination not to do something. In modern usage, it is generally used with the dictionary form of verbs (来る -> 来るまい, する -> するまい, etc.). It can be translated as 'probably not' or 'I will not' in English."},{"id":"5373864a101619b9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"Verb-dictionary form + まい"},{"id":"cf8499a3b7060cc9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-146"},"match":"id","status":"reviewed","value":"Formal, literary negative conjecture - \"probably not/I won't\" - the negative counterpart to だろう."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n2-146#e94b3f7040a4":{"renderings":[{"id":"8714d93fca6a7f7d","role":"translation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"He probably won't come tonight."}]},"n2-146#903f017230d7":{"renderings":[{"id":"455fc0e879e3c2ed","role":"translation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"Being this late, I probably won't make it for the train."}]},"n2-146#ca028945af78":{"renderings":[{"id":"42d9b57adaaff3fe","role":"translation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"That person will definitely not forget."}]},"n2-146#92ce7d36aaa6":{"renderings":[{"id":"379c6b4f6bc19985","role":"translation","source":{"source":"hanabira","ref":"n2-146"},"match":"id","status":"imported","value":"I will not repeat that mistake again."}]}}}