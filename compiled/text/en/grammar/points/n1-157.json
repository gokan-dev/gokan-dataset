{"kind":"grammar","lang":"en","entities":{"n1-157":{"renderings":[{"id":"b0fb3aaff1339458","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"Expresses preference to avoid something: 'rather than...', 'if it comes to doing X, I'd rather...'."},{"id":"8cdb1657b5eb0e45","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"This grammar is used when the speaker would rather not do something or chooses another option rather than face the stated action. It’s often translated as 'rather than... I'd prefer...' or 'if it comes down to doing X, I'd rather...'."},{"id":"c72e1516556bfc91","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"Verb-dictionary form + くらいなら"},{"id":"d74e5f30fd3bb518","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-157"},"match":"id","status":"reviewed","value":"くらいなら: rather than do X, I'd sooner (謝るくらいなら死ぬ)."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n1-157#fdb4fe765a0e":{"renderings":[{"id":"b4d0d11ce1e2f9fd","role":"translation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"I'd rather stay at home than go alone."}]},"n1-157#64ab1399e7df":{"renderings":[{"id":"34ff6ef35478bdfa","role":"translation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"Rather than lose, it's better not to compete."}]},"n1-157#3af34418d59d":{"renderings":[{"id":"cf3f9b954a3387bd","role":"translation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"It's better to take a day off than to be late."}]},"n1-157#7df0794a9e24":{"renderings":[{"id":"f3a6741bf3a5615c","role":"translation","source":{"source":"hanabira","ref":"n1-157"},"match":"id","status":"imported","value":"I'd rather avoid that risk than suffer the consequences."}]}}}