{"kind":"grammar","lang":"en","entities":{"n1-175":{"renderings":[{"id":"125e527c4136b16a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"Indicates a (often unfortunate) result or conclusion of an action."},{"id":"78fcdf2bfd07d038","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"The ～る始末だ grammar point expresses the outcome or conclusion of an action, typically a negative or unfortunate result. It can be translated as 'end up...', 'the result is...', or 'the conclusion is...'."},{"id":"cfdc1fa608631dd7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"Verb-dictionary form + 始末だ"},{"id":"d187a68ed9f39eb3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-175"},"match":"id","status":"reviewed","value":"始末だ: ended up in this sorry state (最後には泣き出す始末だ)."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n1-175#d836144a3fb5":{"renderings":[{"id":"0f66a79b8d11b9c6","role":"translation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"I ended up leaving my passport at home because I forgot."}]},"n1-175#69dcfec8840b":{"renderings":[{"id":"c823d9a9c09a1805","role":"translation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"I work until late every night and end up collapsing."}]},"n1-175#fde287213413":{"renderings":[{"id":"e3991203d1c27ca6","role":"translation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"I didn't study, so I ended up failing the exam."}]},"n1-175#5c6170735240":{"renderings":[{"id":"47f7f8107ebae571","role":"translation","source":{"source":"hanabira","ref":"n1-175"},"match":"id","status":"imported","value":"Because the train was delayed, I ended up being late for the meeting."}]}}}