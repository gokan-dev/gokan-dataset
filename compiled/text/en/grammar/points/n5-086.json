{"kind":"grammar","lang":"en","entities":{"n5-086":{"renderings":[{"id":"7ffa0616be54bed1","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"Expresses 'roughly', 'approximately', or 'almost'."},{"id":"24ced6ff6955830c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"The だいたい〜 (daitai〜) grammar point is used to express a rough estimate or generalization, meaning 'roughly', 'approximately', or 'almost' in English. It can be used before numbers, amounts, or percentages to show that the value is not exact."},{"id":"7fc6741c475836c3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"だいたい + Number/Amount/Percentage"},{"id":"16d9d0c3d0422ef9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-086"},"match":"id","status":"reviewed","value":"A freestanding adverb (\"roughly, for the most part\"), not attached to a number like くらい/ぐらい - broader, less precise approximation."},{"id":"cfc4dfbd28a9df99","role":"label","field":"family","source":{"source":"gokan","ref":"approximation"},"match":"id","status":"reviewed","value":"Approximation (About / Approximately)","of":{"kind":"family","id":"approximation"}}]},"n5-086#3c9f733371f7":{"renderings":[{"id":"00614cd6f5565e5f","role":"translation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"Approximately 100 people attended the party."}]},"n5-086#818ce5cd01f5":{"renderings":[{"id":"e7531906358a8f8c","role":"translation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"She finishes that work in roughly two hours."}]},"n5-086#f52c75706fcd":{"renderings":[{"id":"b8c666290abf99fb","role":"translation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"About 80% of the students passed the exam."}]},"n5-086#7883d22ad0eb":{"renderings":[{"id":"1798b1e9f54dc368","role":"translation","source":{"source":"hanabira","ref":"n5-086"},"match":"id","status":"imported","value":"Today is almost 30 degrees hot."}]}}}