{"kind":"grammar","lang":"en","entities":{"n3-110":{"renderings":[{"id":"14f005e0115900da","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"Not showing any sign or intention to do something."},{"id":"4d4bb33789633daf","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"The ～ようとしない grammar point indicates that someone is not showing any sign or intention of doing an action. It is used to express a refusal or unwillingness to do something. It is formed by using the volitional form of a verb followed by としない."},{"id":"30810111186c590f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"Verb-volitional form + としない"},{"id":"4b2b0242f682accb","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-110"},"match":"id","status":"reviewed","value":"Volitional + としない: won't even try, refuses (謝ろうとしない)."},{"id":"c1d42b40faca8500","role":"label","field":"family","source":{"source":"gokan","ref":"trying"},"match":"id","status":"reviewed","value":"Trying (Try Doing / Try To / Refuse To)","of":{"kind":"family","id":"trying"}}]},"n3-110#f7582ffc6a84":{"renderings":[{"id":"f8079762ffbeec3a","role":"translation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"He doesn't show any sign of trying to study."}]},"n3-110#82638820d596":{"renderings":[{"id":"f09b53d7d59325c0","role":"translation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"She doesn't show any intention of apologizing."}]},"n3-110#54de2f6996fc":{"renderings":[{"id":"4c15a3529069f747","role":"translation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"My son doesn't show any intention of cleaning his room."}]},"n3-110#771a12b642e5":{"renderings":[{"id":"21bfe658a133fcb8","role":"translation","source":{"source":"hanabira","ref":"n3-110"},"match":"id","status":"imported","value":"The dog doesn't show any sign of wanting to go for a walk."}]}}}