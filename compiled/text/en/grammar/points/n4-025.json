take medicine when you're sick."}]},"n4-025#1300701a1b02":{"renderings":[{"id":"e1a09a122a4d3efa","role":"translation","source":{"source":"hanabira","ref":"n4-025"},"match":"id","status":"imported","value":"It's better if you don't drink coffee."}]},"n4-025#4abbda4599e7":{"renderings":[{"id":"a5cac584774a1213","role":"translation","source":{"source":"hanabira","ref":"n4-053"},"match":"id","status":"imported","value":"It's better not to take this medicine."}]},"n4-025#1b942998dbc9":{"renderings":[{"id":"6b9a0e5f409ec0ee","role":"translation","source":{"source":"hanabira","ref":"n4-053"},"match":"id","status":"imported","value":"When you're in a hurry, it's better not to run."}]},"n4-025#e3e84c714d25":{"renderings":[{"id":"cf2ff7e09cb1c190","role":"translation","source":{"source":"hanabira","ref":"n4-053"},"match":"id","status":"imported","value":"If you don't want him to know your secret, it's better not to tell him."}]},"n4-025#92240f08fb9f":{"renderings":[{"id":"354f5a6cdd83e418","role":"translation","source":{"source":"hanabira","ref":"n4-053"},"match":"id","status":"imported","value":"It's better not to go out on a rainy day."}]}}}