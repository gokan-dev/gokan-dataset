{"kind":"grammar","lang":"en","entities":{"n1-124":{"renderings":[{"id":"7005d38d6c18d91d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"Expresses that as soon as one action finishes, another begins immediately."},{"id":"c874e94fc0de9fa4","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"The 〜そばから grammar point is used to indicate that right after a certain action is completed, another action takes place - often suggesting a repetitive or frustrating cycle."},{"id":"b5bcd6d01ae4edbb","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"Verb-ますstem + そばから"},{"id":"2ed746e791638f5a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-124"},"match":"id","status":"reviewed","value":"そばから: no sooner done than undone, again and again (覚えるそばから忘れる)."},{"id":"f993e5eecc2b6f19","role":"label","field":"family","source":{"source":"gokan","ref":"as-soon-as"},"match":"id","status":"reviewed","value":"As Soon As (The Moment That)","of":{"kind":"family","id":"as-soon-as"}}]},"n1-124#e751aeb5dab1":{"renderings":[{"id":"7df7321d0642bb9a","role":"translation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"As soon as I clean, the kids mess it up."}]},"n1-124#90732445a200":{"renderings":[{"id":"be3160cd06bf650f","role":"translation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"As soon as I finished my work, a new task came in."}]},"n1-124#6df789fa7379":{"renderings":[{"id":"addf760f936cdbfb","role":"translation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"As soon as we solve that, another problem arises."}]},"n1-124#42f17adb6fa5":{"renderings":[{"id":"9462966278d3969d","role":"translation","source":{"source":"hanabira","ref":"n1-124"},"match":"id","status":"imported","value":"The phone rang as soon as I fell asleep."}]}}}