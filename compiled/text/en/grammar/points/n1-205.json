{"kind":"grammar","lang":"en","entities":{"n1-205":{"renderings":[{"id":"5d0da5e05b649c39","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"Expresses something that the speaker heard; 'I've heard that', 'I was told that'."},{"id":"c8dc1c0c8559fce3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"The ～とのことだ grammar point is used to express something that the speaker has heard from someone else. It can be roughly translated as 'I've heard that', 'I was told that' in English. It is a formal way to present hearsay or information the speaker did not directly witness but was informed about."},{"id":"7a143d9236ebc1f3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"Simplified phrase + とのことだ"},{"id":"2c825ecd20ed3df1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-205"},"match":"id","status":"reviewed","value":"Formal, literary hearsay - \"I was told that/it is said that\"."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n1-205#482c6bf5a383":{"renderings":[{"id":"6d40b34306f9e381","role":"translation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"I've heard that there is a party this weekend."}]},"n1-205#d732f0cdb4e9":{"renderings":[{"id":"c1b240c12b58a34b","role":"translation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"I was told that he is moving to London next year."}]},"n1-205#e90c70d0e4cb":{"renderings":[{"id":"96f77091727d8277","role":"translation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"I've heard that she has gotten a new job."}]},"n1-205#86171455e70c":{"renderings":[{"id":"2889d65f6f0e7a7d","role":"translation","source":{"source":"hanabira","ref":"n1-205"},"match":"id","status":"imported","value":"I was told that there is no exam tomorrow."}]}}}