{"kind":"grammar","lang":"en","entities":{"n5-054":{"renderings":[{"id":"12bb2c581a234818","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"Making a suggestion or invitation; 'let's' or 'shall we'."},{"id":"d6b169ad3278bac2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"The ましょう grammar point is used to suggest or invite someone to do something in a polite and friendly way. It can be translated as 'let's' or 'shall we' in English. This grammar point is formed by attaching ましょう to the stem of the verb (i.e. remove ます)."},{"id":"e526b9f5e998f16a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"Verb (ます-stem) + ましょう"},{"id":"fa962d22c28c0105","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-054"},"match":"id","status":"reviewed","value":"Neutral, direct \"let's...\" - a plain suggestion/invitation."},{"id":"9f9ca2025be456fc","role":"label","field":"family","source":{"source":"gokan","ref":"invitation"},"match":"id","status":"reviewed","value":"Invitation (Let's / Shall We)","of":{"kind":"family","id":"invitation"}}]},"n5-054#30b6079033fe":{"renderings":[{"id":"3c74d1e3fd3b696b","role":"translation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"Let's watch a movie together."}]},"n5-054#fefd3f1e172f":{"renderings":[{"id":"1c24753f84a49596","role":"translation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"Let's take a walk."}]},"n5-054#0cdb1f56575d":{"renderings":[{"id":"cbdf79263c2f54f4","role":"translation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"Let's go out for dinner tonight."}]},"n5-054#3688622adece":{"renderings":[{"id":"797a457d83dd8088","role":"translation","source":{"source":"hanabira","ref":"n5-054"},"match":"id","status":"imported","value":"Let's study tomorrow."}]}}}