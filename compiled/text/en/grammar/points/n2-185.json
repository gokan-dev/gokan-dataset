{"kind":"grammar","lang":"en","entities":{"n2-185":{"renderings":[{"id":"1ab2d373ab09c68b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"Express the outcome after a period of time or series of actions; 'after', 'as a result of'."},{"id":"823d6b73e2ab405c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"The ～末 grammar point is used to indicate an outcome or result after a period of time, effort, or a series of actions. It can be translated as 'after', 'as a result of', or 'following'. It is typically used with nouns (e.g., '相談の末', '努力の末')."},{"id":"34671e02ba8a57b8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"Noun + 末"},{"id":"8694384948531721","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-185"},"match":"id","status":"reviewed","value":"Formal, written \"after (a long process), finally\" - emphasizes the effort/duration before the outcome."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n2-185#5d8451cdbcf4":{"renderings":[{"id":"28f7f6b8d0a13c84","role":"translation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"After a long discussion, we finally reached a consensus."}]},"n2-185#0ea1c31243ca":{"renderings":[{"id":"b5999017d24ea651","role":"translation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"After a week of studying, I passed the exam."}]},"n2-185#ef91ec38d71b":{"renderings":[{"id":"323e5aa2572c2421","role":"translation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"After many failures, I finally achieved success."}]},"n2-185#61cd1741929c":{"renderings":[{"id":"2fa42bb235bbd256","role":"translation","source":{"source":"hanabira","ref":"n2-185"},"match":"id","status":"imported","value":"After breaking up with him, I started a new life."}]}}}