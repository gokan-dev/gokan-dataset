{"kind":"grammar","lang":"en","entities":{"n3-016":{"renderings":[{"id":"0fd98e2b30e2c9f2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"Expresses advice or recommendation; 'should', 'it is important', 'it is necessary'."},{"id":"410681809efe0636","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"The ～ことだ grammar point is used to express a piece of advice or recommendation to someone. It can be translated as 'should', 'it is important', or 'it is necessary' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"4f2a5ddc25c3b67c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"Verb-ますstem + ことだ, い-Adjective + ことだ, な-Adjective + なことだ, Noun + のことだ"},{"id":"68dde43d7682df82","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-016"},"match":"id","status":"reviewed","value":"Neutral, direct advice - \"you should.../it's important to...\"."},{"id":"6b4d498c02a32dcd","role":"label","field":"family","source":{"source":"gokan","ref":"should"},"match":"id","status":"reviewed","value":"Should (Advice / Expectation)","of":{"kind":"family","id":"should"}}]},"n3-016#df9436e6077c":{"renderings":[{"id":"3fa502a91d6e6089","role":"translation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"You should exercise every day."}]},"n3-016#a3b1cd6b2394":{"renderings":[{"id":"07daee778b0c3cca","role":"translation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"For your health, you should eat lots of vegetables."}]},"n3-016#2ed3fe4157d8":{"renderings":[{"id":"4c3a4999e8a3ab9c","role":"translation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"When studying, you should choose a quiet place."}]},"n3-016#f100bb225f0e":{"renderings":[{"id":"eb6a5b7c895b9249","role":"translation","source":{"source":"hanabira","ref":"n3-016"},"match":"id","status":"imported","value":"You should use a dictionary to learn new words."}]}}}