{"kind":"grammar","lang":"en","entities":{"n1-210":{"renderings":[{"id":"4e0e052371fc920f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"Expresses 'no matter how much...', 'even if...'."},{"id":"501cd9fc3c10061a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"The grammar point どんなに～うが is used to express a condition that is not affected by the degree of an action or state. It can be translated as 'no matter how much...' or 'even if...'. It is generally used with verbs, い-adjectives and な-adjectives in their volitional or かろう/だろう form."},{"id":"f806415f6fea8966","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"どんなに + Verb-volitional + うが, どんなに + い-Adjective(～かろう) + が, どんなに + な-Adjective + だろうが"},{"id":"73ae2cf57799e76a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-210"},"match":"id","status":"reviewed","value":"Formal, literary \"no matter how much...\" - emphasizes degree specifically."},{"id":"a50efe0caa0d07a3","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-of"},"match":"id","status":"reviewed","value":"Regardless Of (No Matter)","of":{"kind":"family","id":"regardless-of"}}]},"n1-210#6b19e2014794":{"renderings":[{"id":"01ff209e22660596","role":"translation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"No matter how hard I try, I can't catch up with his speed."}]},"n1-210#0c485ca64d1b":{"renderings":[{"id":"aaae3661225e0328","role":"translation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"No matter how much she eats, she doesn't gain weight."}]},"n1-210#30eba2126a6f":{"renderings":[{"id":"7018bf8baca319d8","role":"translation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"No matter how cold it is, he goes jogging every day."}]},"n1-210#79f4a4f4dda3":{"renderings":[{"id":"3b9767fa1f0d5d15","role":"translation","source":{"source":"hanabira","ref":"n1-210"},"match":"id","status":"imported","value":"No matter how hot it is, I don't use air conditioning."}]}}}