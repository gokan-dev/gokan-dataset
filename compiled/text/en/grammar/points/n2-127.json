{"kind":"grammar","lang":"en","entities":{"n2-127":{"renderings":[{"id":"fd6a6d9a0005e8b4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"Along with; in accordance with; following"},{"id":"b9cb417bb46c1832","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"The ～に沿って grammar point is used to express that something happens or is done along with, in accordance with, or following a particular line, path, or guideline. It is often used in instructions or explanations. The に沿って is attached to the noun representing the line, path or guideline."},{"id":"e9da576eb4e6ae78","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"Noun + に沿って"},{"id":"4f82e39dbf2713c4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-127"},"match":"id","status":"reviewed","value":"に沿って: along, or in line with (川に沿って, 方針に沿って)."},{"id":"3ce38c8d2bd06579","role":"label","field":"family","source":{"source":"gokan","ref":"according-to"},"match":"id","status":"reviewed","value":"According To (As Instructed)","of":{"kind":"family","id":"according-to"}}]},"n2-127#0b6f5966ee93":{"renderings":[{"id":"21b44a1d3527a267","role":"translation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"If you walk along the river, you will see a bridge."}]},"n2-127#0ca826235b58":{"renderings":[{"id":"051c05043a5aa7fc","role":"translation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"If you cook according to this recipe, there will be no mistakes."}]},"n2-127#e60482a840cc":{"renderings":[{"id":"cf27dc3b9d39ed53","role":"translation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"We must act in accordance with the rules."}]},"n2-127#b81aecda0e69":{"renderings":[{"id":"e599f9c1c02390dc","role":"translation","source":{"source":"hanabira","ref":"n2-127"},"match":"id","status":"imported","value":"If you follow the mountain path, there is a small shrine."}]}}}