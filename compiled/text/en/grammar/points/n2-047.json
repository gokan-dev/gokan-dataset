{"kind":"grammar","lang":"en","entities":{"n2-047":{"renderings":[{"id":"3d6bdaf5ebbaf731","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"Express the likelihood of a negative outcome or consequence."},{"id":"dd26c44b2c872de9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"The ～かねない grammar point is used to express the possibility or likelihood of a negative outcome or consequence, often used when there is concern about the result. It is typically used with verbs in their stem form and can be understood as 'might (have a bad result)'."},{"id":"4c400ce86b355b69","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"Verb-stem + かねない"},{"id":"536ebc9411ffbe19","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-047"},"match":"id","status":"reviewed","value":"\"Might result in (a negative outcome)\" - a warning about a possible bad consequence."},{"id":"a89936e04d45fb8c","role":"label","field":"family","source":{"source":"gokan","ref":"risk-of"},"match":"id","status":"reviewed","value":"Risk Of (Might Lead To)","of":{"kind":"family","id":"risk-of"}}]},"n2-047#6e859fe050c2":{"renderings":[{"id":"2ccd272b09d9355b","role":"translation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"He is so irresponsible that he might break his promise."}]},"n2-047#e41b987dfb3d":{"renderings":[{"id":"cdc29de921165893","role":"translation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"If you don't pay attention, you might cause an accident."}]},"n2-047#13cef8d54c47":{"renderings":[{"id":"aed6116eeb435b18","role":"translation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"Since this app has many bugs, it might crash."}]},"n2-047#ec45aaa336a4":{"renderings":[{"id":"9ca1746c4424209f","role":"translation","source":{"source":"hanabira","ref":"n2-047"},"match":"id","status":"imported","value":"She's so nervous that she might fail."}]}}}