{"kind":"grammar","lang":"en","entities":{"n1-117":{"renderings":[{"id":"9b877a082313facb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"'Cannot but', 'have no choice but to', 'forced to'"},{"id":"f6d05f8880527f54","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"The Verb ざるを得ない construction is used when the subject is compelled or forced to do something out of necessity, leaving no other choice. It conveys the idea of 'cannot but...' or 'have no choice but...' in English."},{"id":"295e52aeffd208b6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"Verb-dictionary form + ざるを得ない (する -> せざるを得ない)"},{"id":"125e994a79c2af77","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-117"},"match":"id","status":"reviewed","value":"Formal, literary \"have no choice but to/cannot avoid doing\" - circumstances leave no alternative."},{"id":"dbed7af32644c939","role":"label","field":"family","source":{"source":"gokan","ref":"inevitable"},"match":"id","status":"reviewed","value":"Inevitable (Cannot Help But)","of":{"kind":"family","id":"inevitable"}}]},"n1-117#19791cdef2e4":{"renderings":[{"id":"dbe1b937a1794b35","role":"translation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"If you hate this job, you have no choice but to quit."}]},"n1-117#2b269e1b3586":{"renderings":[{"id":"3da6fd8325c01080","role":"translation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"The exam is near, so I have no choice but to study late into the night."}]},"n1-117#1538263667f6":{"renderings":[{"id":"466427a5bdb3d039","role":"translation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"My tears won't stop. I can't help but cry."}]},"n1-117#814739eb856d":{"renderings":[{"id":"0c518774e888c1fd","role":"translation","source":{"source":"hanabira","ref":"n1-117"},"match":"id","status":"imported","value":"It's the teacher's order, so I have no choice but to comply."}]}}}