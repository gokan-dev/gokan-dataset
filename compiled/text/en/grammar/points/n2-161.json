{"kind":"grammar","lang":"en","entities":{"n2-161":{"renderings":[{"id":"087afe7ff70a8133","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"Express that there is no other choice; 'have no choice but', 'cannot do anything but'."},{"id":"f830371002dee932","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"The ～よりほかない grammar point is used to express that there is no other choice or alternative in a given situation. It can be translated as 'have no choice but to...', 'nothing but...', or 'cannot do anything but...'."},{"id":"f7c6bb8378bd262a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"Verb-dictionary form + よりほかない"},{"id":"27075c9765c26033","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-161"},"match":"id","status":"reviewed","value":"\"Have no other choice but X\" - names the one remaining option explicitly."},{"id":"dbed7af32644c939","role":"label","field":"family","source":{"source":"gokan","ref":"inevitable"},"match":"id","status":"reviewed","value":"Inevitable (Cannot Help But)","of":{"kind":"family","id":"inevitable"}}]},"n2-161#67be2799d6ea":{"renderings":[{"id":"8246f43cbc95cfaa","role":"translation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"Since the exam is near, there is no choice but to study."}]},"n2-161#edc5ea59a631":{"renderings":[{"id":"0533b1cb1b6bb11c","role":"translation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"My cold is severe, so I have no choice but to go to bed early."}]},"n2-161#4ea9be3cc94c":{"renderings":[{"id":"fef001179fbade7e","role":"translation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"Since the bus isn't coming, I have no choice but to walk."}]},"n2-161#40f0a5f4cb93":{"renderings":[{"id":"d476f5d5ad1d24de","role":"translation","source":{"source":"hanabira","ref":"n2-161"},"match":"id","status":"imported","value":"Since I have no money, I have no choice but to buy cheap things."}]}}}