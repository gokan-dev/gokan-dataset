{"kind":"grammar","lang":"en","entities":{"n5-056":{"renderings":[{"id":"1a7758f968af7354","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"An invitation or suggestion; 'won't you', 'why don't you', 'shall we'."},{"id":"8a93475e9aad006b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"The ませんか grammar point is used for making invitations or suggestions in a polite manner. The verb is conjugated to its ます form and replaced with ませんか. This can be translated as 'won't you', 'why don't you', or 'shall we' in English."},{"id":"78026c216922bb18","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"Verb (ます-form) + ませんか"},{"id":"d449c3aaacbb5b56","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-056"},"match":"id","status":"reviewed","value":"Slightly more polite/deferential \"won't you...\" - invites without presuming agreement."},{"id":"9f9ca2025be456fc","role":"label","field":"family","source":{"source":"gokan","ref":"invitation"},"match":"id","status":"reviewed","value":"Invitation (Let's / Shall We)","of":{"kind":"family","id":"invitation"}}]},"n5-056#41be9d15ebc1":{"renderings":[{"id":"8619b87e0147076c","role":"translation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"Won't you watch a movie together with me?"}]},"n5-056#a60720e69c19":{"renderings":[{"id":"343a3a9d962a57d0","role":"translation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"Why don't you join tomorrow's party?"}]},"n5-056#0f03143e5f6d":{"renderings":[{"id":"5c0be4877a6886cc","role":"translation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"Shall we go for a picnic on the weekend?"}]},"n5-056#4d2419e642cc":{"renderings":[{"id":"8446473464df0ea9","role":"translation","source":{"source":"hanabira","ref":"n5-056"},"match":"id","status":"imported","value":"How about studying together?"}]}}}