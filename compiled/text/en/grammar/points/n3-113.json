{"kind":"grammar","lang":"en","entities":{"n3-113":{"renderings":[{"id":"c6787c41837eebe0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"Used to express a purpose, a way, or a natural tendency."},{"id":"bfd1bb2097b4d984","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"The ～ように grammar point is used to express a purpose, a way or a method, or a natural tendency. It can be used with verbs, い-adjectives, な-adjectives, or nouns. It is frequently used with the verb する (to do) to express the purpose or method."},{"id":"d8a2d949ef0f56a6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"Verb-casual + ように, い-Adjective + ように, な-Adjective + だように, Noun + のように"},{"id":"4313231df9f7d478","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-113"},"match":"id","status":"reviewed","value":"ように: so that (a result you can't directly control), or 'like'."},{"id":"45dc062868902f1c","role":"label","field":"family","source":{"source":"gokan","ref":"purpose"},"match":"id","status":"reviewed","value":"Purpose (In Order To / So That)","of":{"kind":"family","id":"purpose"}}]},"n3-113#bac40d672169":{"renderings":[{"id":"49ff42f61b8b4014","role":"translation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"I will organize the inside of the house so that the children can spend time safely."}]},"n3-113#2cf73a082579":{"renderings":[{"id":"8dfb55e2d1a19737","role":"translation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"Like a beautiful flower, her smile is lovely."}]},"n3-113#b666c3bbd4c3":{"renderings":[{"id":"a6a26e64cb524da0","role":"translation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"I practice every day to be able to speak English naturally."}]},"n3-113#16892e0bd61c":{"renderings":[{"id":"b8127693b8453529","role":"translation","source":{"source":"hanabira","ref":"n3-113"},"match":"id","status":"imported","value":"Let's make a plan to succeed."}]}}}