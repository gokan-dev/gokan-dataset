{"kind":"grammar","lang":"en","entities":{"n5-921":{"renderings":[{"id":"7b753125286b3ad2","role":"label","field":"name","source":{"source":"gokan","ref":"n5-921"},"match":"id","status":"reviewed","value":"Negative て-form"},{"id":"a251704eec559505","role":"prose","field":"shortExplanation","source":{"source":"gokan","ref":"n5-921"},"match":"id","status":"reviewed","value":"The negative て-form of the copula, for joining and correcting."},{"id":"436ad62350f7e001","role":"prose","field":"longExplanation","source":{"source":"gokan","ref":"n5-921"},"match":"id","status":"reviewed","value":"じゃなくて is the て-form of the negative copula じゃない, used to join clauses and to correct: 'A じゃなくて B' means 'not A, but B'."},{"id":"e8f796c56a18b141","role":"prose","field":"formation","source":{"source":"gokan","ref":"n5-921"},"match":"id","status":"reviewed","value":"な-Adjective / Noun + じゃなくて (formal: ではなくて)."},{"id":"838adb5d5f2db296","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-921"},"match":"id","status":"reviewed","value":"negative て-form (じゃなくて)"}]}}}