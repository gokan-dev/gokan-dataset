{"kind":"grammar","lang":"en","entities":{"n2-017":{"renderings":[{"id":"cf2ff47023daf0b4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"Express contrast between two situations; 'although', 'but', 'however'."},{"id":"50c16fe74094bec6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"The ただ grammar point is used to express contrast between two situations or facts. It can often be translated as 'although', 'but', or 'however' in English. It is used to show a contradiction or a different aspect of a situation."},{"id":"4d849e6adef81e10","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"Sentence A + ただ + Sentence B"},{"id":"f658038c9c87aab9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-017"},"match":"id","status":"reviewed","value":"Adds a minor reservation or exception to what was just said - \"that said...\"; softer than a full contrast."},{"id":"a13bf53f446f3f0d","role":"label","field":"family","source":{"source":"gokan","ref":"contradiction"},"match":"id","status":"reviewed","value":"Contradiction (But / However)","of":{"kind":"family","id":"contradiction"}}]},"n2-017#1be21f23a8d1":{"renderings":[{"id":"b07de763b1c001ea","role":"translation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"He is smart; however, he doesn't make much effort."}]},"n2-017#a25f7e53df53":{"renderings":[{"id":"723dce80d19c0481","role":"translation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"It's raining outside, but I'm bored at home."}]},"n2-017#a116c4f9bf90":{"renderings":[{"id":"081a6b2d51a0acd9","role":"translation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"That restaurant is expensive; however, the service is good."}]},"n2-017#4c7b6720a274":{"renderings":[{"id":"032b69b1ca1e3592","role":"translation","source":{"source":"hanabira","ref":"n2-017"},"match":"id","status":"imported","value":"The test results were not good, but there's a chance to retake it."}]}}}