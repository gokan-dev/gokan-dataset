{"kind":"grammar","lang":"en","entities":{"n5-027":{"renderings":[{"id":"6b71435662978792","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"Express an approximate amount or degree; 'about', 'approximately'."},{"id":"3f943cce822383ea","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"The ぐらい grammar point is used with nouns to express an approximate amount or degree. It is often translated as 'about', 'approximately', or 'around' in English. This can be used for time, quantity, or other measurements."},{"id":"f624b6671c486c1d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"Noun + ぐらい"},{"id":"d2e4562bb12ded4e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-027"},"match":"id","status":"reviewed","value":"Slightly more colloquial than くらい for the same approximate quantity (rendaku softening) - interchangeable in casual speech."}]},"n5-027#851d903b4e02":{"renderings":[{"id":"083263f9a0bf715d","role":"translation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"I studied all day, so I studied for about 10 hours."}]},"n5-027#22296b6b755d":{"renderings":[{"id":"caac02eae220d7b7","role":"translation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"This book has about 100 pages."}]},"n5-027#e66d7744da4d":{"renderings":[{"id":"792d7ce19fa15f72","role":"translation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"He ate about 5 pieces of fruit."}]},"n5-027#3de72ffa222f":{"renderings":[{"id":"fb46df6fbf8952ec","role":"translation","source":{"source":"hanabira","ref":"n5-027"},"match":"id","status":"imported","value":"It takes about 20 minutes to walk from the station to my house."}]}}}