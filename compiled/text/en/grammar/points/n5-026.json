{"kind":"grammar","lang":"en","entities":{"n5-026":{"renderings":[{"id":"4772552284b86d6e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"Express the extent or degree of something; 'about', 'approximately', 'at least'."},{"id":"23e29921087a9f2a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"The くらい grammar point is used with a noun to express the extent or degree of something, meaning 'about', 'approximately', or 'at least' in English. It helps to provide a rough estimate or minimum standard to the noun it is attached to."},{"id":"6d49092c8d1f447d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"Noun + くらい"},{"id":"6a3da55b4ee74534","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-026"},"match":"id","status":"reviewed","value":"Neutral, standard way to express an approximate quantity or degree. (Near-duplicate of n3-012 - same word, taught at both N3 and N5.)"},{"id":"cfc4dfbd28a9df99","role":"label","field":"family","source":{"source":"gokan","ref":"approximation"},"match":"id","status":"reviewed","value":"Approximation (About / Approximately)","of":{"kind":"family","id":"approximation"}}]},"n5-026#bf1076cb8ca8":{"renderings":[{"id":"915af9e743c6cd32","role":"translation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"This book has about 300 pages."}]},"n5-026#971faf711dbc":{"renderings":[{"id":"580f0a630d5e73d9","role":"translation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"It takes about 20 minutes to walk to his house."}]},"n5-026#18a6768373ec":{"renderings":[{"id":"fc5dc7820f6fc843","role":"translation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"Tomorrow will be hot, about 30 degrees."}]},"n5-026#aff34e5d2213":{"renderings":[{"id":"7cae02609369e89d","role":"translation","source":{"source":"hanabira","ref":"n5-026"},"match":"id","status":"imported","value":"You need about 500 yen worth of ingredients to make this dish."}]}}}