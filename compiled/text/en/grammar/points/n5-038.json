{"kind":"grammar","lang":"en","entities":{"n5-038":{"renderings":[{"id":"93225ad8762a343d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"Expresses the order of events; 'after', 'later than'."},{"id":"e6923f95934eb92d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"The の あとで grammar point is used to express the order of events, specifying that an action occurs after or later than the noun mentioned. It translates to 'after' or 'later than' in English. This structure is simply formed by attaching の あとで to the noun."},{"id":"55574e07395079b6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"Noun + の + あとで"},{"id":"4bdef30d4de07d4c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-038"},"match":"id","status":"reviewed","value":"The everyday, plain \"after X\" - simple sequencing."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n5-038#39e02b8e29f2":{"renderings":[{"id":"5e1de5c9613d6563","role":"translation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"After breakfast, I brush my teeth."}]},"n5-038#750da8fbb22d":{"renderings":[{"id":"c2dc55bb7a0bc49b","role":"translation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"After the movie, we ate dinner at a restaurant."}]},"n5-038#827d08e7a9b2":{"renderings":[{"id":"eb5abbb187bf0463","role":"translation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"I will discuss with my boss after the meeting."}]},"n5-038#be25b2e142f5":{"renderings":[{"id":"9cab4d6276d7b7a4","role":"translation","source":{"source":"hanabira","ref":"n5-038"},"match":"id","status":"imported","value":"After dinner, I went for a walk."}]}}}