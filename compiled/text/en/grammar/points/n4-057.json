{"kind":"grammar","lang":"en","entities":{"n4-057":{"renderings":[{"id":"be7d7bad77d3d5ff","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"Indicates that something is easy to do; 'easy to', 'easy for'."},{"id":"4b2d60d76cc931c3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"The やすい grammar point is used to express that something is easy to do or easy for someone. It is attached to the verb stem and can be translated as 'easy to' or 'easy for' in English. This formation is used with verbs only."},{"id":"9d784fa314b3e1fa","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"Verb-stem + やすい"},{"id":"a629bac4440fd3fe","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-057"},"match":"id","status":"reviewed","value":"ます stem + やすい: easy to do (読みやすい). Hard to do: にくい."},{"id":"6b1e4cc3700c0626","role":"label","field":"family","source":{"source":"gokan","ref":"ease"},"match":"id","status":"reviewed","value":"Ease (Easy To / Hard To)","of":{"kind":"family","id":"ease"}}]},"n4-057#a2f9da08250d":{"renderings":[{"id":"e642154e95d2433a","role":"translation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"This book is easy to read."}]},"n4-057#d9e7ac731019":{"renderings":[{"id":"e87449fb81dfc7f1","role":"translation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"This shirt is easy to wear."}]},"n4-057#04c2ce786882":{"renderings":[{"id":"399ca93bc0aaeff3","role":"translation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"He is an easy person to talk to."}]},"n4-057#c7ed5c604653":{"renderings":[{"id":"f89b8e6527a98002","role":"translation","source":{"source":"hanabira","ref":"n4-057"},"match":"id","status":"imported","value":"This dish is easy to make."}]}}}