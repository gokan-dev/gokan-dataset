{"kind":"grammar","lang":"en","entities":{"n1-038":{"renderings":[{"id":"891d23ffb749944c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-038"},"match":"id","status":"imported","value":"Means 'it's approximately...' or 'it's about...'. Used to show approximation or a general assessment."},{"id":"0d510cbcad08c7f0","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-038"},"match":"id","status":"imported","value":"The というところだ grammar point is used to show an approximation or general assessment of something. It is often translated as 'it's approximately...', 'around...', or 'it's about...'."},{"id":"a4f365e9d3f28dba","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-038"},"match":"id","status":"imported","value":"Noun + というところだ"},{"id":"78185239ea2a744b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-038"},"match":"id","status":"reviewed","value":"というところだ: at most about, a modest estimate (7割というところだ)."},{"id":"cfc4dfbd28a9df99","role":"label","field":"family","source":{"source":"gokan","ref":"approximation"},"match":"id","status":"reviewed","value":"Approximation (About / Approximately)","of":{"kind":"family","id":"approximation"}}]},"n1-038#9f010379534c":{"renderings":[{"id":"f045f9e33228f641","role":"translation","source":{"source":"hanabira","ref":"n1-038"},"match":"id","status":"imported","value":"The passers in this exam would be approximately half."}]},"n1-038#1967be8f31a2":{"renderings":[{"id":"c83278e7fdcc26ac","role":"translation","source":{"source":"hanabira","ref":"n1-038"},"match":"id","status":"imported","value":"His strength is about 80%."}]},"n1-038#a7800a32ed04":{"renderings":[{"id":"8d831a14517b14ff","role":"translation","source":{"source":"hanabira","ref":"n1-038"},"match":"id","status":"imported","value":"About 70% of people agree with this plan."}]},"n1-038#4b4da57a374a":{"renderings":[{"id":"74268e0de85e1fe4","role":"translation","source