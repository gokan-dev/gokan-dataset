{"kind":"grammar","lang":"en","entities":{"n5-100":{"renderings":[{"id":"f01dac7e46118601","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"Used to indicate the frequency of an event; 'sometimes', 'occasionally', 'now and then'."},{"id":"9849abaa1b596dc9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"The grammar point ときどき is an adverb used to describe an event or action that occurs occasionally or at irregular intervals. It can be translated as 'sometimes', 'occasionally', or 'now and then' in English. It is often used to indicate that the speaker cannot predict the exact time when a certain event occurs."},{"id":"8a82885a6ee4346c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"ときどき + Verb/Adjective/Noun"},{"id":"e2986e2a551ffdb7","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-100"},"match":"id","status":"reviewed","value":"'Sometimes': less often than よく."},{"id":"d78d4d222abb81b2","role":"label","field":"family","source":{"source":"gokan","ref":"frequency"},"match":"id","status":"reviewed","value":"Frequency (Usually / Often / Sometimes)","of":{"kind":"family","id":"frequency"}}]},"n5-100#ec61d4627490":{"renderings":[{"id":"8d3e5a86bdd7efc1","role":"translation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"He sometimes makes cakes."}]},"n5-100#71aff2c4d2c8":{"renderings":[{"id":"a8e972412fe383b7","role":"translation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"It occasionally rains, so it's better to bring an umbrella."}]},"n5-100#3bf5426b8727":{"renderings":[{"id":"b42fe6c5c546b8d6","role":"translation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"I shop at this store now and then."}]},"n5-100#158555d3a8db":{"renderings":[{"id":"08b2a758213234fd","role":"translation","source":{"source":"hanabira","ref":"n5-100"},"match":"id","status":"imported","value":"She is sometimes late."}]}}}