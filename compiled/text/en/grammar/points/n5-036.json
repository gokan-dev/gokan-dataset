{"kind":"grammar","lang":"en","entities":{"n5-036":{"renderings":[{"id":"944864f84f304bb1","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"Used to express coming to a place."},{"id":"0edebadacbe2c3ed","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"The grammar point Noun に 来ます is used to indicate that someone or something comes to a specific place. The noun before に indicates the destination or place, while the verb 来ます expresses the action of coming. (Similarly, 'Noun に 行きます' means 'go to [Noun],' and 'Noun に 帰ります' means 'return to [Noun].')"},{"id":"03435f64675c174b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"Noun + に + 来ます (kimasu)"},{"id":"607d7137dab5fe1e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-036"},"match":"id","status":"reviewed","value":"来る: move toward the speaker's place (友達が家に来る). The に differs in role: Noun + に + 来ます marks the destination (家に来ます, 'come to the house'), Verb-ますstem + に + 来ます marks the purpose (会いに来ます, 'come in order to meet')."},{"id":"9952d59dae38a7d4","role":"label","field":"family","source":{"source":"gokan","ref":"returning"},"match":"id","status":"reviewed","value":"Going And Coming (Go / Come / Go Back)","of":{"kind":"family","id":"returning"}}]},"n5-036#74e091bcc9ee":{"renderings":[{"id":"a3404f4cee9f5b57","role":"translation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"My friend will come to my house."}]},"n5-036#7f18f09874aa":{"renderings":[{"id":"340fb6ad690047ab","role":"translation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"Tonight, my father will come to pick me up at the station."}]},"n5-036#1cc91c1927ba":{"renderings":[{"id":"287fbb70adf90476","role":"translation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"Tomorrow, the teacher will come to school."}]},"n5-036#291c35bc0016":{"renderings":[{"id":"ae805da8c5fdb02a","role":"translation","source":{"source":"hanabira","ref":"n5-036"},"match":"id","status":"imported","value":"A famous singer will come to this town."}]},"n5-036#679ec0931b96":{"renderings":[{"id":"5f27ff9013e4d5b2","role":"translation","source":{"source":"hanabira","ref":"n5-052"},"match":"id","status":"imported","value":"I came to meet my friend."}]},"n5-036#65dd2da0fbf4":{"renderings":[{"id":"9338128e08a14295","role":"translation","source":{"source":"hanabira","ref":"n5-052"},"match":"id","status":"imported","value":"I came to watch a movie."}]},"n5-036#e87d862feac2":{"renderings":[{"id":"49710b2db851ca53","role":"translation","source":{"source":"hanabira","ref":"n5-052"},"match":"id","status":"imported","value":"I came to ask the teacher a question."}]},"n5-036#0ffda0586062":{"renderings":[{"id":"95a1ed3380cfb5c7","role":"translation","source":{"source":"hanabira","ref":"n5-052"},"match":"id","status":"imported","value":"I came to go shopping."}]}}}