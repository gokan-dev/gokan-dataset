{"kind":"grammar","lang":"en","entities":{"n3-073":{"renderings":[{"id":"541f5c745a67d8f4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"Indicates a non-exhaustive list of examples; 'such as', 'things like', 'among others'."},{"id":"f4e3d95f6a80f9ad","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"The ～など grammar point is used to give a non-exhaustive list of examples, meaning the mentioned items are only some of many possibilities. It can be translated as 'such as', 'things like', or 'among others' in English. This grammar point can be used with nouns."},{"id":"c6cb4c15840a5b84","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"Noun + など"},{"id":"ca131fecdeab5477","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-073"},"match":"id","status":"reviewed","value":"The standard, everyday non-exhaustive list marker - \"such as/etc.\"."},{"id":"af190fe17e925fca","role":"label","field":"family","source":{"source":"gokan","ref":"listing"},"match":"id","status":"reviewed","value":"Listing (Such As / Etc.)","of":{"kind":"family","id":"listing"}}]},"n3-073#cd9bc7d0bc42":{"renderings":[{"id":"7624d6e9f472a5b8","role":"translation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"I bought fish, fruits, and such at the market."}]},"n3-073#5dbd722cef37":{"renderings":[{"id":"15cd56f3f36337b9","role":"translation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"He can speak languages such as Japanese, English, and Chinese."}]},"n3-073#9d55a5a6ef3e":{"renderings":[{"id":"8afbd9837f5bed4c","role":"translation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"At the art museum, I saw works like paintings, sculptures, and others."}]},"n3-073#127408d44742":{"renderings":[{"id":"a3b80380af834229","role":"translation","source":{"source":"hanabira","ref":"n3-073"},"match":"id","status":"imported","value":"This store sells sweets such as bread, cakes, and so on."}]}}}