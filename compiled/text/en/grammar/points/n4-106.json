{"kind":"grammar","lang":"en","entities":{"n4-106":{"renderings":[{"id":"861f81a2af1b875f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"Expresses the necessity or obligation; 'must', 'have to'."},{"id":"aaca5e1d42fe706a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"The ～なくてはいけない grammar point is used to express the necessity or obligation to do something. It can be translated as 'must' or 'have to' in English. The formation requires the negative form of a verb and is followed by いけない (cannot go/progress). It indicates that if something is not done, it will be a problem or inappropriate."},{"id":"5f82e58dfdc1dd94","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"Verb-negative form + なくてはいけない"},{"id":"eddb8975b501040b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-106"},"match":"id","status":"reviewed","value":"Slightly less stiff than なければならない, still fine in most polite contexts."},{"id":"9a9ffc62f2cd4f3f","role":"label","field":"family","source":{"source":"gokan","ref":"obligation"},"match":"id","status":"reviewed","value":"Obligation (Must / Have to)","of":{"kind":"family","id":"obligation"}}]},"n4-106#bda28fba3be4":{"renderings":[{"id":"6f28ab67c4d74f14","role":"translation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"I have to do my homework."}]},"n4-106#6dfe10f3c701":{"renderings":[{"id":"95336eb3b21e6456","role":"translation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"I must send this letter by tomorrow."}]},"n4-106#c6eac0e8d94b":{"renderings":[{"id":"101a79a9020955e2","role":"translation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"We must not waste food."}]},"n4-106#e3ab5113d006":{"renderings":[{"id":"31520563e3dd7464","role":"translation","source":{"source":"hanabira","ref":"n4-106"},"match":"id","status":"imported","value":"I want to leave early, but I have to wait until the class finishes."}]}}}