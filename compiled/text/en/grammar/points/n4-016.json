{"kind":"grammar","lang":"en","entities":{"n4-016":{"renderings":[{"id":"f005c837f1271405","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"Expresses that someone gives a thing to the speaker or someone close to the speaker."},{"id":"070fb638700f59c0","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"The grammar point Noun を くれる is used to express when someone (other than the speaker) gives something to the speaker or someone close to the speaker. The giver is the subject, and the receiver is the speaker or someone close to the speaker. くれる indicates that the action of giving 'favors' the speaker or someone close to the speaker."},{"id":"381f19daae5bb89c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"Giver + が + Receiver + に + Noun + を + くれる"},{"id":"fff9986036540428","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-016"},"match":"id","status":"reviewed","value":"Neutral - someone giving TO the speaker (or the speaker's in-group), equal/lower status giver."},{"id":"aabe59494c91ee24","role":"label","field":"family","source":{"source":"gokan","ref":"giving"},"match":"id","status":"reviewed","value":"Giving (Benefactive Register)","of":{"kind":"family","id":"giving"}}]},"n4-016#6dd544493fef":{"renderings":[{"id":"d8621c8de1e3cd12","role":"translation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"My friend gave me a present."}]},"n4-016#71341827df02":{"renderings":[{"id":"e95391c4f56f19fb","role":"translation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"He gave me flowers."}]},"n4-016#2e164eeaffe3":{"renderings":[{"id":"c433d0610a481f79","role":"translation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"The teacher gave me a book."}]},"n4-016#916281a2ab40":{"renderings":[{"id":"4b8beaf404ca608f","role":"translation","source":{"source":"hanabira","ref":"n4-016"},"match":"id","status":"imported","value":"Mom gave my little brother some sweets."}]}}}