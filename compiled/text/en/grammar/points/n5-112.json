{"kind":"grammar","lang":"en","entities":{"n5-112":{"renderings":[{"id":"19d2033a0648ed59","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"Expresses 'which'; used to ask about specific items within a group."},{"id":"13e5f9d20d76ebb2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"The どの Noun grammar point is used to ask about specific items or objects within a group. It is the combination of the question word ど (which) and the particle の to connect to a noun. In English, it can be translated as 'which' depending on the context."},{"id":"cd8376f02605494d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"どの + Noun"},{"id":"e4e6afbd42aa24ae","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-112"},"match":"id","status":"reviewed","value":"'Which' among three or more, always before a noun (どの本). Of two, どちら."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n5-112#0323af571f8c":{"renderings":[{"id":"3ece10031acf9e83","role":"translation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"Which book is the most interesting?"}]},"n5-112#7c1267f2b6a5":{"renderings":[{"id":"2f4ede846c2fd14e","role":"translation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"Which clothes do you want to wear?"}]},"n5-112#406b6e8edf2a":{"renderings":[{"id":"f71e498a0df15b35","role":"translation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"Which color do you like?"}]},"n5-112#18ce2ec01a1a":{"renderings":[{"id":"1a6278e42252bff7","role":"translation","source":{"source":"hanabira","ref":"n5-112"},"match":"id","status":"imported","value":"Which restaurant do you want to go to?"}]}}}