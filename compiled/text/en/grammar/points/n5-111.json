{"kind":"grammar","lang":"en","entities":{"n5-111":{"renderings":[{"id":"63d719d3426e0aac","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"A polite way to ask 'who', used for asking about someone's identity or when seeking information about an unknown person."},{"id":"ae90969401bd8f63","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"The word どなた is a polite version of the question word だれ (who). It is used when asking about someone's identity or when seeking information about an unknown person in a polite or formal context. It can be used in questions and sometimes with も to express 'no matter who'."},{"id":"a5a9babec9f5ce1d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"どなた"},{"id":"e65dcfea1836e797","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-111"},"match":"id","status":"reviewed","value":"Polite 'who': strangers, customers, superiors, on the phone or at the door (どなたですか)."},{"id":"51a79d989bbdb41e","role":"label","field":"family","source":{"source":"gokan","ref":"who"},"match":"id","status":"reviewed","value":"Who (Someone / Anyone / No One)","of":{"kind":"family","id":"who"}}]},"n5-111#ac028e9c286f":{"renderings":[{"id":"1303331615b3afb8","role":"translation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"Excuse me, who is Mr. Yamada?"}]},"n5-111#4e7724409e2e":{"renderings":[{"id":"95cdfe6a280fc36f","role":"translation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"He is a famous actor whom everyone knows."}]},"n5-111#003851c5e24e":{"renderings":[{"id":"84b4e0b54c8cb514","role":"translation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"Who is coming to the party tomorrow?"}]},"n5-111#5368830efb6d":{"renderings":[{"id":"de40374a28855f99","role":"translation","source":{"source":"hanabira","ref":"n5-111"},"match":"id","status":"imported","value":"Could someone please help me?"}]}}}