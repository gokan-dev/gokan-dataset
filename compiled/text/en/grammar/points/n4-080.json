{"kind":"grammar","lang":"en","entities":{"n4-080":{"renderings":[{"id":"cc7f34445d299426","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-080"},"match":"id","status":"imported","value":"Express a polite request to allow or permit someone to do something."},{"id":"a6af19826f5d5429","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-080"},"match":"id","status":"imported","value":"The ～させてください grammar point is used to make a polite request to allow or permit someone to do something. It can be translated as 'please let me' or 'please allow me to' in English. It is formed by taking the causative form of a verb and adding ください."},{"id":"810efb3db4554367","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-080"},"match":"id","status":"imported","value":"Verb-causative form + ください"},{"id":"371b7d1372acfa3f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-080"},"match":"id","status":"reviewed","value":"'Please let ME do it': asks permission for your own action (行かせてください)."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-080#dbc674c210e5":{"renderings":[{"id":"dc864ea9322c70e2","role":"translation","source":{"source":"hanabira","ref":"n4-080"},"match":"id","status":"imported","value":"Please let me think a little more."}]},"n4-080#0c13ee21008a":{"renderings":[{"id":"6332bf53201324f9","role":"translation","source":{"source":"hanabira","ref":"n4-080"},"match":"id","status":"imported","value":"Please let me take a photo."}]},"n4-080#6210d923a993":{"renderings":[{"id":"c1bceb9e90d65235","role":"translation","source":{"source":"hanabira","ref":"n4-080"},"match":"id","status":"imported","value":"Please let me practice a little more."}]},"n4-080#3003ece14b92":{"renderings":[{"id":