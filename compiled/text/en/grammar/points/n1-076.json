{"kind":"grammar","lang":"en","entities":{"n1-076":{"renderings":[{"id":"315d683a77298fe6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"It depends on the Noun"},{"id":"1b3b66cb802fbb79","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"The のいかんでは grammar point is used when you want to express that the outcome or decision hinges on the condition described in the noun preceding this phrase. It can be translated as 'depending on ___' or 'it depends on ___' in English."},{"id":"1260c84eb2ff0cb5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"Noun + のいかんでは"},{"id":"650786c844939785","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-076"},"match":"id","status":"reviewed","value":"Noun のいかんでは: depending on how X turns out."},{"id":"9c243c5bc319e188","role":"label","field":"family","source":{"source":"gokan","ref":"depending-on"},"match":"id","status":"reviewed","value":"Depending On (Varies With)","of":{"kind":"family","id":"depending-on"}}]},"n1-076#4b3cb1e637dd":{"renderings":[{"id":"132278f4470ccc41","role":"translation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"Whether you can get permission to enter university depends on the result of the exam."}]},"n1-076#3db334ef414b":{"renderings":[{"id":"7b4b66e2a43f9524","role":"translation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"Depending on the weather, we might delay the picnic."}]},"n1-076#25307fcc93d0":{"renderings":[{"id":"5809d5a37991d063","role":"translation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"Depending on the traffic conditions, I might be late."}]},"n1-076#3f2358058a9a":{"renderings":[{"id":"ff03ed26094a2799","role":"translation","source":{"source":"hanabira","ref":"n1-076"},"match":"id","status":"imported","value":"Depending on the state of the economy, the company's future is determined."}]}}}