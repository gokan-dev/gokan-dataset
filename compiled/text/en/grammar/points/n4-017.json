{"kind":"grammar","lang":"en","entities":{"n4-017":{"renderings":[{"id":"1d5be9b6467c930f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"A polite way of expressing to give something."},{"id":"fd41869ac24efb65","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"The grammar point Noun を さしあげる is used to say that you are giving something to someone in a polite way. When offering something to a person of higher status, this expression is used. It is used in conjunction with a noun and replaces the regular verb あげる (ageru) to give."},{"id":"a764c4d39ea4a0e9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"Noun + を + さしあげる"},{"id":"0f6d8ac8164a1b80","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-017"},"match":"id","status":"reviewed","value":"Humble - the speaker giving to someone of higher status."},{"id":"aabe59494c91ee24","role":"label","field":"family","source":{"source":"gokan","ref":"giving"},"match":"id","status":"reviewed","value":"Giving (Benefactive Register)","of":{"kind":"family","id":"giving"}}]},"n4-017#d5caddf11efc":{"renderings":[{"id":"4dd4a13e18de84ab","role":"translation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"I will give a book to the teacher."}]},"n4-017#c3f0725afc5e":{"renderings":[{"id":"eaf20ed2ebf869c3","role":"translation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"I want to give flowers to my mother."}]},"n4-017#4becc0dd93db":{"renderings":[{"id":"f62954c493eee3d1","role":"translation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"Let's offer tea to the guest."}]},"n4-017#e5480c2e7083":{"renderings":[{"id":"d79ad9fa192a8bba","role":"translation","source":{"source":"hanabira","ref":"n4-017"},"match":"id","status":"imported","value":"When I gave a present to my senior, they were delighted."}]}}}