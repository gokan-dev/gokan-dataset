{"kind":"grammar","lang":"en","entities":{"n2-144":{"renderings":[{"id":"32c204153d91d296","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"Leaving aside, excluding."},{"id":"f1f179895f7e0f78","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"The ～は抜きにして grammar point is used to express the idea of 'leaving aside' or 'excluding' a certain aspect. It is often used to focus the discussion or judgment on something else by disregarding the omitted point."},{"id":"043f3a6dac357e4e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"Noun + は抜きにして"},{"id":"f553f74da14675a3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-144"},"match":"id","status":"reviewed","value":"は抜きにして: leaving X out of it (冗談は抜きにして)."},{"id":"276bd004f9ddd9b1","role":"label","field":"family","source":{"source":"gokan","ref":"one-thing-but-another"},"match":"id","status":"reviewed","value":"Setting Aside (X Aside / X Is One Thing, But)","of":{"kind":"family","id":"one-thing-but-another"}}]},"n2-144#b2cb486058d8":{"renderings":[{"id":"9e400987568227ad","role":"translation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"Leaving aside the price, the taste is delicious."}]},"n2-144#79d83e6ae1e5":{"renderings":[{"id":"fb01e43440adf88e","role":"translation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"Putting aside his personality, I have to acknowledge his ability."}]},"n2-144#8bacec13bf15":{"renderings":[{"id":"d8ef7face460ed70","role":"translation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"Leaving aside the design, this phone’s features are excellent."}]},"n2-144#cf268d9d80bf":{"renderings":[{"id":"f643224d7de350ce","role":"translation","source":{"source":"hanabira","ref":"n2-144"},"match":"id","status":"imported","value":"Leaving aside her driving speed, she's a kind and trustworthy driver."}]}}}