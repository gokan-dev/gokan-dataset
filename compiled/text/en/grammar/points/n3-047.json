{"kind":"grammar","lang":"en","entities":{"n3-047":{"renderings":[{"id":"23406d6ca2fb6281","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"Quote someone's request (telling someone to do something)."},{"id":"288f526641a05427","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"The ～てくれと grammar point is used when quoting a request or command made by someone else. It literally means 'someone said “please do …”'. Typically used as 「～てくれと頼む/言う」 to indicate being asked or told to do something."},{"id":"4cc8f9093013344b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"Verb-て form + くれと (言う / 頼む / 伝える, etc.)"},{"id":"942403c05384c3b8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-047"},"match":"id","status":"reviewed","value":"てくれと言う: quotes a direct request, 'told me to' (来てくれと言われた)."},{"id":"b3e707337e2047da","role":"label","field":"family","source":{"source":"gokan","ref":"reported-request"},"match":"id","status":"reviewed","value":"Reported Requests (Told To Do)","of":{"kind":"family","id":"reported-request"}}]},"n3-047#d6902a684e6e":{"renderings":[{"id":"60468aef0401d6f9","role":"translation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"I was told to make a phone call."}]},"n3-047#a68b48f82029":{"renderings":[{"id":"f37cf6c743ea8e35","role":"translation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"I was asked to carry this luggage."}]},"n3-047#21310341271c":{"renderings":[{"id":"93b3934aae9870ec","role":"translation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"I was asked to wait until the end."}]},"n3-047#7c270a467b76":{"renderings":[{"id":"a66662a26ee7cd2f","role":"translation","source":{"source":"hanabira","ref":"n3-047"},"match":"id","status":"imported","value":"I was told to please take a rest."}]}}}