{"kind":"grammar","lang":"en","entities":{"n5-042":{"renderings":[{"id":"16a8c037045fa42e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"Lists items or examples but not exhaustively; 'such as', 'like', 'and so on'."},{"id":"d6fe41d98e25da8b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"The や...など grammar point is used to list a few items or examples that belong to a similar category or context, but it is not exhaustive. It can be translated as 'such as', 'like', or 'and so on' in English. This grammar pattern is used with nouns."},{"id":"fe3271fc4ea02dbf","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"Noun1 + や + Noun2 + など"},{"id":"eb5bc54e36aa81e9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-042"},"match":"id","status":"reviewed","value":"\"And, such as\" - pairs や (partial \"and\") with など (etc.)."},{"id":"af190fe17e925fca","role":"label","field":"family","source":{"source":"gokan","ref":"listing"},"match":"id","status":"reviewed","value":"Listing (Such As / Etc.)","of":{"kind":"family","id":"listing"}}]},"n5-042#4a1d292ed48b":{"renderings":[{"id":"639672e6cf538263","role":"translation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"He likes to eat things like vegetables and fruits."}]},"n5-042#899796992254":{"renderings":[{"id":"8ef4e515d5d91606","role":"translation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"I want to go to Japanese cities such as Tokyo, Osaka, and so on."}]},"n5-042#e75a1137de93":{"renderings":[{"id":"21ddfc428cd3fc9c","role":"translation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"She likes animals like cats, dogs, and so on."}]},"n5-042#481f941b9016":{"renderings":[{"id":"d315510c92f0a85b","role":"translation","source":{"source":"hanabira","ref":"n5-042"},"match":"id","status":"imported","value":"In this bookstore, many books such as manga and novels are sold."}]}}}