{"kind":"grammar","lang":"en","entities":{"n4-052":{"renderings":[{"id":"8b0428f1109c168e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"Expresses a result; 'end up not', 'it will become that', 'it would mean that'."},{"id":"11274137e92a2ab4","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"The Verb ない ことになる grammar point is used to express a result or consequence. It translates to 'end up not', 'it will become that', or 'it would mean that' in English. It is formed by using the negative form (ない) of a verb followed by ことになる."},{"id":"9178f1b7e25cf8f7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"Verb-negative (ない) + ことになる"},{"id":"5e18841fe17fc5c0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-052"},"match":"id","status":"reviewed","value":"'It has been decided that ~ not', by others or by circumstance."},{"id":"bd97fcb92a4cb49c","role":"label","field":"family","source":{"source":"gokan","ref":"decisions"},"match":"id","status":"reviewed","value":"Decisions (Decide To / It Was Decided)","of":{"kind":"family","id":"decisions"}}]},"n4-052#23e4d9f7789e":{"renderings":[{"id":"011c7a3b0dff99e9","role":"translation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"If he doesn't come today, our plans will be canceled."}]},"n4-052#ecc3c978c8b2":{"renderings":[{"id":"da6497872eb42f89","role":"translation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"If this project doesn't progress, it would mean that revenue will decrease."}]},"n4-052#7551455867a8":{"renderings":[{"id":"47a2336d23fe4c35","role":"translation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"If she ends up not passing the exam, her graduation will be delayed."}]},"n4-052#7b99a9629c66":{"renderings":[{"id":"28587f4ac0661e7b","role":"translation","source":{"source":"hanabira","ref":"n4-052"},"match":"id","status":"imported","value":"If it rains, it will become that the picnic doesn't take place."}]}}}