{"kind":"grammar","lang":"en","entities":{"n1-026":{"renderings":[{"id":"cce9cbf621751ba5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"Means 'like a...', 'as if...', expressing a simile or metaphor."},{"id":"a76bcffd1d9d1281","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"「〜ごとき／〜ごとく」conveys similarity, as if comparing one thing to another. ごとき often modifies nouns, while ごとく can modify verbs or adjectives as well. It's more formal and literary in tone than simple expressions like みたい or よう."},{"id":"d7b383ce1fbbcbe4","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"Noun + ごとき, Noun + ごとく, Verb-casual + ごとく, い-Adjective + ごとく"},{"id":"c960a4ec4b331fbf","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-026"},"match":"id","status":"reviewed","value":"のごとき / のごとく: like, as if (written) (夢のごとく)."},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n1-026#b5864210c9c0":{"renderings":[{"id":"2bb81cfc30bb3166","role":"translation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"He is as pure as an angel."}]},"n1-026#63adee1de11a":{"renderings":[{"id":"69599f249c413ff6","role":"translation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"Don't engage in acts like those of a devil."}]},"n1-026#6c4e2cec4134":{"renderings":[{"id":"bd8d0e8c02acb2b5","role":"translation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"She has skin as white as snow."}]},"n1-026#a699d1c45244":{"renderings":[{"id":"1848eaaee700c8a3","role":"translation","source":{"source":"hanabira","ref":"n1-026"},"match":"id","status":"imported","value":"He left like the wind."}]}}}