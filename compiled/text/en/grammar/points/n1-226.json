{"kind":"grammar","lang":"en","entities":{"n1-226":{"renderings":[{"id":"5ad497843643f53d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"Conveys that 'only (Noun) is the case' or 'nothing but (Noun)'."},{"id":"7a5488eb888f0347","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"The ～のは Noun ぐらいのものだ pattern indicates that something is exclusively or solely that particular Noun, conveying the sense of 'That's the only thing...' or 'There's nothing but...' about a situation."},{"id":"42532e063ffb3216","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"Verb-casual + のは + Noun + ぐらいのものだ, い-Adjective + のは + Noun + ぐらいのものだ, etc."},{"id":"f165ea15746db88e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-226"},"match":"id","status":"reviewed","value":"のは Noun ぐらいのものだ: only X would (そんなことするのは彼ぐらいのものだ)."},{"id":"0a7eb6991316e0ea","role":"label","field":"family","source":{"source":"gokan","ref":"exclusivity"},"match":"id","status":"reviewed","value":"Exclusivity (Only / Nothing But)","of":{"kind":"family","id":"exclusivity"}}]},"n1-226#7d59371c4b50":{"renderings":[{"id":"33844cb376290588","role":"translation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"Reading this novel is nothing but a way to kill time."}]},"n1-226#2e866da0d499":{"renderings":[{"id":"d7f6814f779cc646","role":"translation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"About the only good thing at tonight's dinner was the pizza."}]},"n1-226#444f6301d7f4":{"renderings":[{"id":"0f1cb1fbae8946ab","role":"translation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"Watching this movie is nothing but a waste of time."}]},"n1-226#03c6875dd18e":{"renderings":[{"id":"441629a9e017477b","role":"translation","source":{"source":"hanabira","ref":"n1-226"},"match":"id","status":"imported","value":"Talking to him is nothing but stressful."}]}}}