{"kind":"grammar","lang":"en","entities":{"n5-044":{"renderings":[{"id":"dfe523a282b61169","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"Indicates an action that takes place after another action."},{"id":"02dde29eb424219b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"The たあとで grammar point is used to indicate that one action takes place after another action is completed. It means 'after' or 'after doing' in English. The formation is created with the た form (past tense) of a verb, followed by あとで (ato de)."},{"id":"fb04cdc3cbfa999c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"Verb-た form + あとで"},{"id":"81ab9eb7516d06e9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-044"},"match":"id","status":"reviewed","value":"Verb た + あとで: after doing (食べたあとで). With a noun: のあとで."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n5-044#3a65301fa496":{"renderings":[{"id":"15b13a948b5a264c","role":"translation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"After doing my homework, I watched TV."}]},"n5-044#2f325a10fc3a":{"renderings":[{"id":"6317e2740e684188","role":"translation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"After eating breakfast, I brush my teeth."}]},"n5-044#76ffc27474ef":{"renderings":[{"id":"e5f294e7b6db1dca","role":"translation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"After finishing work, I plan to go to the gym."}]},"n5-044#6f8d011ae0f7":{"renderings":[{"id":"ef8eda2d5c970eaf","role":"translation","source":{"source":"hanabira","ref":"n5-044"},"match":"id","status":"imported","value":"After watching the movie, I drank coffee at a cafe."}]}}}