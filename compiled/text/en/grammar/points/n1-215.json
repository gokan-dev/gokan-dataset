{"kind":"grammar","lang":"en","entities":{"n1-215":{"renderings":[{"id":"f44e21d68bede984","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"Means 'even though' or 'despite'."},{"id":"62442f0cf1ce4941","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"The ～ながらも grammar point is used to express contrast, highlighting the difference between what is usually expected from a situation and what actually happens. It can be translated as 'even though' or 'despite.'"},{"id":"da472f940ad2d501","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"Verb stem + ながらも, い-Adjective + ながらも, な-Adjective/Noun + ながらも"},{"id":"9ac5809087f3e8e2","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-215"},"match":"id","status":"reviewed","value":"Literary \"even though/despite\", pairs a state with a contrasting action taken anyway; more literary than にもかかわらず."},{"id":"e7484b401cb1f08c","role":"label","field":"family","source":{"source":"gokan","ref":"concession"},"match":"id","status":"reviewed","value":"Concession (Even Though / Although / Despite)","of":{"kind":"family","id":"concession"}}]},"n1-215#d882995210f1":{"renderings":[{"id":"90562cc19cb42c37","role":"translation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"Despite being poor, he leads a happy life."}]},"n1-215#2451dd145929":{"renderings":[{"id":"bacc20e52f2e1ed0","role":"translation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"Even though I am busy, I exercise every day."}]},"n1-215#d9d573aa3039":{"renderings":[{"id":"5a9f22604d7265f8","role":"translation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"Despite being sick, he continued working."}]},"n1-215#83b524c611cb":{"renderings":[{"id":"092703da21cbaca3","role":"translation","source":{"source":"hanabira","ref":"n1-215"},"match":"id","status":"imported","value":"Even though it was raining, he went for a walk."}]}}}