{"kind":"grammar","lang":"en","entities":{"n3-044":{"renderings":[{"id":"0bd398d098c2f252","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"Indicate a state where an action is left as is (unchanged or unfinished)."},{"id":"8845dc6b3276391b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"The ～っぱなし grammar point is used to express that an action happened and was left in that state, unattended or unchanged. It is formed by taking the ます-stem of a verb and adding ～っぱなし."},{"id":"4e64dc10ae4e7ec2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"Verb-ますstem + っぱなし"},{"id":"2b8f39fbac530f62","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-044"},"match":"id","status":"reviewed","value":"ます stem + っぱなし: left that way, carelessly not undone (開けっぱなし)."},{"id":"bcfb47c8138f64c6","role":"label","field":"family","source":{"source":"gokan","ref":"left-as-is"},"match":"id","status":"reviewed","value":"Left As It Is (As Is / Left Undone)","of":{"kind":"family","id":"left-as-is"}}]},"n3-044#f08954df69b5":{"renderings":[{"id":"b844a2eeaa49639d","role":"translation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"If you leave the window open, bugs will come in."}]},"n3-044#995aedcc5f3d":{"renderings":[{"id":"33a1fff0d426047b","role":"translation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"I left the laundry hanging out, and it got wet in the rain."}]},"n3-044#e283494a8395":{"renderings":[{"id":"b2c6a9a3f1c3165a","role":"translation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"He went out leaving the door open."}]},"n3-044#e42b88f0957f":{"renderings":[{"id":"8c4d7cb93b07db82","role":"translation","source":{"source":"hanabira","ref":"n3-044"},"match":"id","status":"imported","value":"I fell asleep with the TV left on."}]}}}