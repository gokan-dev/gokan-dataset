{"kind":"grammar","lang":"en","entities":{"n5-091":{"renderings":[{"id":"ffac3aa404983a1e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"Indicates 'someone' or something done or possessed by 'someone'."},{"id":"9a573976c9de1f97","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"The grammar point だれか〜 is used to suggest that something is done by, possessed by, or related to 'someone', usually when the actual person is unidentified or not important. It can be used with verbs, adjectives, or nouns."},{"id":"5010121034d4301c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"だれか + Verb, だれか + Adjective, だれか + Noun"},{"id":"276d0edc02217edd","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-091"},"match":"id","status":"reviewed","value":"'Someone': a person you do not name (だれか来ました). A statement, not a question."},{"id":"51a79d989bbdb41e","role":"label","field":"family","source":{"source":"gokan","ref":"who"},"match":"id","status":"reviewed","value":"Who (Someone / Anyone / No One)","of":{"kind":"family","id":"who"}}]},"n5-091#b5711094f2ba":{"renderings":[{"id":"35b1a66ddb29b196","role":"translation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"Someone knocked on the door."}]},"n5-091#1af325e15e58":{"renderings":[{"id":"789fcf8a0e4ff762","role":"translation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"Someone stole my umbrella."}]},"n5-091#747b43c78e66":{"renderings":[{"id":"14461197be9fcb11","role":"translation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"Someone, please help."}]},"n5-091#6d35eb23a54b":{"renderings":[{"id":"e46ed6373825e6d1","role":"translation","source":{"source":"hanabira","ref":"n5-091"},"match":"id","status":"imported","value":"Because of someone, the electricity went out."}]}}}