{"kind":"grammar","lang":"en","entities":{"n4-116":{"renderings":[{"id":"fe2b9cad13945edf","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-116"},"match":"id","status":"imported","value":"Express 'as it is', 'while' or 'unchanged state'."},{"id":"d3721bfec9caac78","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-116"},"match":"id","status":"imported","value":"The ～まま grammar point is used to express a state or condition that remains unchanged or continues, often translated as 'as it is', 'while', or 'unchanged'. It can be used with verbs and adjectives to show that something remains in a certain state or condition."},{"id":"25379d0dfc310e69","role":"prose","field":"formation","source":{"source":"gokan","ref":"n4-116"},"match":"id","status":"reviewed","value":"Verb-た form + まま, Adjective (い & な) + まま, Noun + のまま"},{"id":"e9703d09f9c597c5","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-116"},"match":"id","status":"reviewed","value":"まま: in an unchanged state (靴のまま入る, ドアを開けたまま)."},{"id":"bcfb47c8138f64c6","role":"label","field":"family","source":{"source":"gokan","ref":"left-as-is"},"match":"id","status":"reviewed","value":"Left As It Is (As Is / Left Undone)","of":{"kind":"family","id":"left-as-is"}}]},"n4-116#a46559d131f8":{"renderings":[{"id":"46f3f76e54d9ffc7","role":"translation","source":{"source":"hanabira","ref":"n4-116"},"match":"id","status":"imported","value":"I accidentally left with the door open."}]},"n4-116#3135432d47db":{"renderings":[{"id":"7873d88e2e1a024d","role":"translation","source":{"source":"hanabira","ref":"n4-116"},"match":"id","status":"imported","value":"He fell asleep with the alarm clock stopped."}]},"n4-116#accb6cdc48be":{"renderings":[{"id":"0c5bf1fa10334886","role":"translation","source":{"source":"hanabira","ref":"n4-116"},"match":"id","status":"imported","value":"Please keep the room clean."}]},"n4-116#0789f131b8bb":{"renderings":[{"id":"fe2f477b83e7990d","role":"translation","source":{"source":"hanabira","ref":"n4-116"},"match":"id","status":"imported","value":"She has the heart of a child."}]}}}