{"kind":"grammar","lang":"en","entities":{"n5-118":{"renderings":[{"id":"62c628c6a4c0c57e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"Used to express 'not anything', 'nothing'."},{"id":"3c6c71443deb7e80","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"The grammar point なにも～ません is used to express the idea of 'not anything' or 'nothing' in negative sentences. It is placed before the verb in its negative form (～ません)."},{"id":"59d3aa88e53d422d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"なにも + Verb-ます form + ません"},{"id":"fbbe2fd149dc3243","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-118"},"match":"id","status":"reviewed","value":"'Nothing': なにも needs a negative verb (なにも食べませんでした). With an affirmative, なんでも."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-118#eb5b158e7694":{"renderings":[{"id":"483bd52d471c96b3","role":"translation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"I didn't eat anything yesterday."}]},"n5-118#af561300402d":{"renderings":[{"id":"a2287ee2b89fa913","role":"translation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"He doesn't say anything."}]},"n5-118#de22a9162448":{"renderings":[{"id":"401bc4bb91efec44","role":"translation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"I cannot see anything in this room."}]},"n5-118#6ce2d4bb5768":{"renderings":[{"id":"93ef9906a40a93d2","role":"translation","source":{"source":"hanabira","ref":"n5-118"},"match":"id","status":"imported","value":"She didn't buy anything."}]}}}