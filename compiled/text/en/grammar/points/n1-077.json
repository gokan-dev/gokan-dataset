{"kind":"grammar","lang":"en","entities":{"n1-077":{"renderings":[{"id":"04c3658bb35585b5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"Regardless of, irrespective of."},{"id":"4e3323a77bf0d0a8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"The phrase 'Noun のいかんにかかわらず' is used to express that something is the case irrespective of a certain condition. It can be translated as 'regardless of' or 'irrespective of' in English. This phrase is used with nouns."},{"id":"50bf97fea02cbf8f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"Noun + のいかんにかかわらず"},{"id":"b400cfe0cb1ed05b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-077"},"match":"id","status":"reviewed","value":"Formal, literary \"regardless of/irrespective of\" - a noun-suffix variant using のいかん."},{"id":"a50efe0caa0d07a3","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-of"},"match":"id","status":"reviewed","value":"Regardless Of (No Matter)","of":{"kind":"family","id":"regardless-of"}}]},"n1-077#444fdf87ca8e":{"renderings":[{"id":"11b81f71c673c6b8","role":"translation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"Regardless of the outcome, he didn't regret his decision."}]},"n1-077#f4cb5df68b82":{"renderings":[{"id":"d4fba22d90206876","role":"translation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"Regardless of age, anyone can learn."}]},"n1-077#3499344cc1f2":{"renderings":[{"id":"bdea4184447b334f","role":"translation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"Regardless of experience, it's important to start."}]},"n1-077#50b83b929c7a":{"renderings":[{"id":"9d1cd9a0cae65907","role":"translation","source":{"source":"hanabira","ref":"n1-077"},"match":"id","status":"imported","value":"Regardless of the weather, the hiking will take place as scheduled."}]}}}