{"kind":"grammar","lang":"en","entities":{"n3-024":{"renderings":[{"id":"6dd39b32d4637127","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-024"},"match":"id","status":"imported","value":"Express a negative state or action; 'not at all', 'none whatsoever'."},{"id":"922f9e5ed0497bd1","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-024"},"match":"id","status":"imported","value":"The すこしも〜ない grammar point is used to emphasize a negative state or action, indicating that something does not exist or happen even a little bit. It can be translated as 'not at all', 'none whatsoever', or 'not one bit' in English. This expression is used with negative verbs."},{"id":"e45694f0834d4542","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-024"},"match":"id","status":"imported","value":"すこしも + Verb-negative"},{"id":"bd93888ec004cf62","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-024"},"match":"id","status":"reviewed","value":"\"Not even a little\" - a slightly more deliberate way to deny completely."},{"id":"515717669db2afa2","role":"label","field":"family","source":{"source":"gokan","ref":"negation-intensity"},"match":"id","status":"reviewed","value":"Negation Intensity (Not Very / Not At All)","of":{"kind":"family","id":"negation-intensity"}}]},"n3-024#ef0b338a9a77":{"renderings":[{"id":"03aef7d276944dc8","role":"translation","source":{"source":"hanabira","ref":"n3-024"},"match":"id","status":"imported","value":"He doesn't look sad at all."}]},"n3-024#78dbac1b853a":{"renderings":[{"id":"348e2601c9243117","role":"translation","source":{"source":"hanabira","ref":"n3-024"},"match":"id","status":"imported","value":"This room is not cold at all."}]},"n3-024#d6f1f863fa5b":{"renderings":[{"id":"6da069fda6736006","role":"translation","source":{"source":"hanabira","ref":"n3-024"},"match":"id","status":"imported","value":"She is not worried at all."}]}}}