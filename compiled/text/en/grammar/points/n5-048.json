{"kind":"grammar","lang":"en","entities":{"n5-048":{"renderings":[{"id":"93dfc9f2bac668f8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"Express a sequence of actions or events; 'after', 'since', 'once'."},{"id":"b78eb39f298fde79","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"The ～てから grammar point is used to indicate the sequence of actions or events, meaning that one action or event occurs after another. It can be translated as 'after', 'since', or 'once' in English. The て-form indicates the first action and から shows the sequence."},{"id":"806380d6565ec6b6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"Verb-て形 + から"},{"id":"7ccaf61ba75aa28f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-048"},"match":"id","status":"reviewed","value":"The everyday \"after doing X, then...\" - simple sequencing, doubles as \"since\" for a state that began at that point."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n5-048#57c316bd37fb":{"renderings":[{"id":"44d2c98f02f783e1","role":"translation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"I watched TV after doing my homework."}]},"n5-048#65e8c8704e78":{"renderings":[{"id":"416a7489d532c9f3","role":"translation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"Let's brush our teeth after eating."}]},"n5-048#69754d2c9d7d":{"renderings":[{"id":"32f815fd36796818","role":"translation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"I will go drinking with my friends after work is done."}]},"n5-048#5e9e4b860eab":{"renderings":[{"id":"1dad02890305926c","role":"translation","source":{"source":"hanabira","ref":"n5-048"},"match":"id","status":"imported","value":"I will study in the library after school is over."}]}}}