{"kind":"grammar","lang":"en","entities":{"n3-066":{"renderings":[{"id":"7d9a4e6b96572cda","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"Express a hypothetical situation; 'if', 'suppose', 'assuming'."},{"id":"60392d0fb5ad3e4e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"The ～としたら grammar point is used to express a hypothetical situation or assumption. It can be translated as 'if', 'suppose', or 'assuming' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"3c0574533f11f3a2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"Verb-casual + としたら, い-Adjective + としたら, な-Adjective + だとしたら, Noun + だとしたら"},{"id":"502e0964c1d208a3","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-066"},"match":"id","status":"reviewed","value":"The everyday hypothetical \"assuming/if\". (Near-duplicate of n2-098 - same word, taught at both N2 and N3.)"},{"id":"8e6f86a85e24b03e","role":"label","field":"family","source":{"source":"gokan","ref":"assuming"},"match":"id","status":"reviewed","value":"Assuming (Under That Premise)","of":{"kind":"family","id":"assuming"}}]},"n3-066#9d119a76b3c2":{"renderings":[{"id":"4fbe2146edafa56d","role":"translation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"If it rains tomorrow, let's bring an umbrella."}]},"n3-066#5452ca7d1fb2":{"renderings":[{"id":"8346a6d640eca4fa","role":"translation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"If this cake is not delicious, nobody will eat it."}]},"n3-066#0e3121674557":{"renderings":[{"id":"544109761a82306d","role":"translation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"If he is sick, please take him to the hospital right away."}]},"n3-066#31ac81fe264d":{"renderings":[{"id":"489225f6df67d417","role":"translation","source":{"source":"hanabira","ref":"n3-066"},"match":"id","status":"imported","value":"If she is a student, there will be a discount at this restaurant."}]}}}