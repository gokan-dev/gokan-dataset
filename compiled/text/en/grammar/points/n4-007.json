{"kind":"grammar","lang":"en","entities":{"n4-007":{"renderings":[{"id":"7fac7cdf778572fe","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"Expresses 'only', 'nothing but', or 'no other'."},{"id":"a843e0a7c9f029c3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"The grammar point Noun しか～ない is used to emphasize the small quantity or exclusiveness of something. It can be translated as 'only', 'nothing but', or 'no other' in English. It is used with a negative verb to convey the meaning."},{"id":"275ab7925b62d00d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"Noun + しか + Negative Verb"},{"id":"730196b1bcc303ef","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-007"},"match":"id","status":"reviewed","value":"Paired with a negative verb for emphasis - \"nothing but/only\", stronger than だけ."},{"id":"0a7eb6991316e0ea","role":"label","field":"family","source":{"source":"gokan","ref":"exclusivity"},"match":"id","status":"reviewed","value":"Exclusivity (Only / Nothing But)","of":{"kind":"family","id":"exclusivity"}}]},"n4-007#02898a9566ad":{"renderings":[{"id":"624be5c5656220d2","role":"translation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"I eat only apples."}]},"n4-007#9dfb8991309e":{"renderings":[{"id":"439180d41e328ef5","role":"translation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"There is no other way but to go by train."}]},"n4-007#f851264db9a5":{"renderings":[{"id":"ecb12433718d9ca6","role":"translation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"He has only one book."}]},"n4-007#10474b47660c":{"renderings":[{"id":"c7bc7674d901fede","role":"translation","source":{"source":"hanabira","ref":"n4-007"},"match":"id","status":"imported","value":"There is nothing but beer in this store."}]}}}