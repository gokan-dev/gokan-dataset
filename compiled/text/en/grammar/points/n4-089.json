{"kind":"grammar","lang":"en","entities":{"n4-089":{"renderings":[{"id":"390cffe5226f1c3f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"Express a suggestion or advice; 'what if', 'how about', 'why don't you'."},{"id":"4fca32396e158aa4","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"The ～たら どうですか grammar point is used to make a suggestion or give advice to someone. It can be translated as 'what if', 'how about', or 'why don't you' in English. This structure is used with the た-form of verbs to make a gentle, polite suggestion."},{"id":"eb19069f5ee2cc1a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"Verb-た form + ら どうですか"},{"id":"770696cba573392e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-089"},"match":"id","status":"reviewed","value":"Neutral suggestion, 'why don't you' (聞いたらどうですか). Polite: たらいかがですか."},{"id":"6b4d498c02a32dcd","role":"label","field":"family","source":{"source":"gokan","ref":"should"},"match":"id","status":"reviewed","value":"Should (Advice / Expectation)","of":{"kind":"family","id":"should"}}]},"n4-089#20e2b0c76b0b":{"renderings":[{"id":"ab5638cde5ec4f7a","role":"translation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"How about going skiing?"}]},"n4-089#deeed0e83f7c":{"renderings":[{"id":"cbbf6f6f0bd85267","role":"translation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"What if you take a little break?"}]},"n4-089#91036c3819f2":{"renderings":[{"id":"e7b89275e8d76ae9","role":"translation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"Why don't you read this book?"}]},"n4-089#637fbb580202":{"renderings":[{"id":"6237162f86d57c8e","role":"translation","source":{"source":"hanabira","ref":"n4-089"},"match":"id","status":"imported","value":"How about going home by taxi?"}]}}}