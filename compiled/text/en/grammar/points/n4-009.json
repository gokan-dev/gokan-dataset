{"kind":"grammar","lang":"en","entities":{"n4-009":{"renderings":[{"id":"6b3a3dd07fb90b67","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"To become; to change into; to turn into."},{"id":"2db789077dcd7d5b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"The 'Noun に なる' grammar point is used to show a change or a transformation from one state or form into another. In English, it can be translated as 'to become', 'to change into', or 'to turn into'. It is often used with nouns that indicate profession, status, or condition."},{"id":"b813fa452d7624fa","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"Noun + に + なる"}]},"n4-009#f70e13686fbf":{"renderings":[{"id":"f9eb7dfe1beed5cd","role":"translation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"He became a doctor."}]},"n4-009#b8a03f663d86":{"renderings":[{"id":"e6033bf873d3f86a","role":"translation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"When I was a child, I wanted to become a teacher."}]},"n4-009#4939903b7dea":{"renderings":[{"id":"cc61f76bf1785056","role":"translation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"She got nervous, and her face turned red."}]},"n4-009#dbc0199e0224":{"renderings":[{"id":"70550c676ed44cfb","role":"translation","source":{"source":"hanabira","ref":"n4-009"},"match":"id","status":"imported","value":"When it becomes spring, cherry blossoms bloom."}]}}}