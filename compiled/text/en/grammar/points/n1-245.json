{"kind":"grammar","lang":"en","entities":{"n1-245":{"renderings":[{"id":"ef21723f341b7d36","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"Expresses an extreme degree of emotion or reaction; 'I feel so ~', 'as ~ as can be'."},{"id":"2d9ff62894d2dd53","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"The ～限りだ structure is often used with adjectives describing the speaker's emotion, highlighting how strongly the speaker feels. Translations often include 'I’m as ~ as can be,' 'I feel so ~.'"},{"id":"8bdd195a2d6bcc4b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"い-Adjective + 限りだ, な-Adjective + な/である + 限りだ, Noun + の + 限りだ"},{"id":"27d6160cf67059b6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-245"},"match":"id","status":"reviewed","value":"限りだ: I feel so very (嬉しい限りだ), the speaker's own feeling."},{"id":"56792fe4e4b22dce","role":"label","field":"family","source":{"source":"gokan","ref":"extremity"},"match":"id","status":"reviewed","value":"Extremity (Extremely / Utterly)","of":{"kind":"family","id":"extremity"}}]},"n1-245#12f95091a544":{"renderings":[{"id":"218f623aa3b56219","role":"translation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"She suddenly quit. I'm as shocked as can be."}]},"n1-245#fc508170e2c5":{"renderings":[{"id":"1a126636beea4a70","role":"translation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"My son succeeded. I'm so happy."}]},"n1-245#59668b1cf44a":{"renderings":[{"id":"bff34c91c9a2cd95","role":"translation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"I'm as happy as can be to see such beautiful flowers."}]},"n1-245#4c6c32a4a1a0":{"renderings":[{"id":"a3953a68e0c22d53","role":"translation","source":{"source":"hanabira","ref":"n1-245"},"match":"id","status":"imported","value":"I passed the exam—what a relief!"}]}}}