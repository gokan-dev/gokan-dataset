{"kind":"grammar","lang":"en","entities":{"n1-060":{"renderings":[{"id":"032f0c2e948093b8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"Expresses the concept of 'even'; 'even in', 'even as', 'even to'."},{"id":"de98e5e20381c2a9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"The 〜にすら grammar point is used to show surprise that an action or situation applies even to the noun in question. It can be translated into English as 'even in', 'even as', or 'even to'. It's often used with negative or unexpected statements, emphasizing that 'even' in this particular case something can't or doesn't happen."},{"id":"3fd75927f821ba66","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"Noun + にすら"},{"id":"0be29e07d5e0611c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-060"},"match":"id","status":"reviewed","value":"Formal emphasis \"even\" - a variant of ですら for a different grammatical slot."},{"id":"f576172f87098943","role":"label","field":"family","source":{"source":"gokan","ref":"emphasis-even"},"match":"id","status":"reviewed","value":"Emphasis (Even)","of":{"kind":"family","id":"emphasis-even"}}]},"n1-060#c8badefa960e":{"renderings":[{"id":"9b446184302fcd50","role":"translation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"Even he could not solve that problem."}]},"n1-060#36fea09637eb":{"renderings":[{"id":"a7dfba9541ed7ee6","role":"translation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"She did not even pass the test."}]},"n1-060#b6ab3e7b33a6":{"renderings":[{"id":"f6a2162c6ef683e9","role":"translation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"This dog doesn't even respond to its own name."}]},"n1-060#ac1467d06416":{"renderings":[{"id":"42b6c24c516cabd6","role":"translation","source":{"source":"hanabira","ref":"n1-060"},"match":"id","status":"imported","value":"I didn't even have the time to talk to him."}]}}}