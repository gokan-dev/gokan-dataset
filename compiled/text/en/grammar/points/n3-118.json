{"kind":"grammar","lang":"en","entities":{"n3-118":{"renderings":[{"id":"a18ccf5ac8526f23","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"Expresses hearsay; 'I heard', 'it seems', 'apparently'."},{"id":"932810ecaa984cc9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"The ～らしい grammar point is used to indicate that the information provided is based on hearsay or an indirect source. In English, this can be translated as 'I heard', 'it seems', or 'apparently'. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"622c92d5ea2a0035","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"Verb-casual + らしい, い-Adjective + らしい, な-Adjective + だらしい, Noun + だらしい"},{"id":"c2b6a7a8205a5f06","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-118"},"match":"id","status":"reviewed","value":"Hearsay-based - \"I heard that/apparently\", based on external information rather than personal judgment."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n3-118#441fafb680c8":{"renderings":[{"id":"80080b77b58a0a38","role":"translation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"Apparently, he has the flu."}]},"n3-118#ce4e02a73136":{"renderings":[{"id":"0e9d3660d2758db8","role":"translation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"I heard it will snow tomorrow."}]},"n3-118#1e86c3c89ffe":{"renderings":[{"id":"0ae6efc5e7028dd1","role":"translation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"I heard that this restaurant is delicious."}]},"n3-118#7df3f474dc58":{"renderings":[{"id":"c9cd0af71d1dfa35","role":"translation","source":{"source":"hanabira","ref":"n3-118"},"match":"id","status":"imported","value":"It seems that she is a doctor."}]}}}