{"kind":"grammar","lang":"en","entities":{"n4-098":{"renderings":[{"id":"c47bf4305cc733f2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"Express a wish or hope; 'I hope', 'it would be good if'."},{"id":"7b2d48d194de7a98","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"The ～といい grammar point is used to express a wish or hope for a certain situation or outcome. It can be translated as 'I hope', 'it would be good if', or 'it would be nice if' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"b223f6776b6b3359","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"Verb-casual + といい, い-Adjective + といい, な-Adjective + だといい, Noun + だといい"},{"id":"6ace254561d7f783","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-098"},"match":"id","status":"reviewed","value":"Casual \"I hope.../it'd be nice if...\" - similar register to たらいい/ばいい."},{"id":"6b4d498c02a32dcd","role":"label","field":"family","source":{"source":"gokan","ref":"should"},"match":"id","status":"reviewed","value":"Should (Advice / Expectation)","of":{"kind":"family","id":"should"}}]},"n4-098#9e14b2a45837":{"renderings":[{"id":"a188590c6a76981b","role":"translation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"I hope it will be sunny tomorrow."}]},"n4-098#5157e0f1250a":{"renderings":[{"id":"45ca1682ba35d5e7","role":"translation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"I hope to pass this exam."}]},"n4-098#37ba684e2681":{"renderings":[{"id":"405a0410c21dce68","role":"translation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"I hope he is doing well."}]},"n4-098#2237bd625476":{"renderings":[{"id":"8f682da62122b454","role":"translation","source":{"source":"hanabira","ref":"n4-098"},"match":"id","status":"imported","value":"It would be nice if that restaurant is delicious."}]}}}