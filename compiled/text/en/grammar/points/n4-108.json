{"kind":"grammar","lang":"en","entities":{"n4-108":{"renderings":[{"id":"1cd462647f290b2b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"Express obligation or necessity; 'must', 'have to', 'need to'."},{"id":"eaa509a7ae1d9c66","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"The ～なければ ならない grammar point is used to express obligation or necessity. In English, it can be translated as 'must', 'have to', or 'need to'. The formation differs depending on whether it is used with a verb. It cannot be used with い-adjectives, な-adjectives or nouns."},{"id":"0d72c90ea5bdd26a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"Verb-ない form + なければ ならない"},{"id":"c03688113f96db3c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-108"},"match":"id","status":"reviewed","value":"The full, uncontracted form; safe in writing and formal speech."},{"id":"9a9ffc62f2cd4f3f","role":"label","field":"family","source":{"source":"gokan","ref":"obligation"},"match":"id","status":"reviewed","value":"Obligation (Must / Have to)","of":{"kind":"family","id":"obligation"}}]},"n4-108#b71973574b60":{"renderings":[{"id":"c2e76da1405ce075","role":"translation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"I have to do my homework."}]},"n4-108#a2988bd58ffc":{"renderings":[{"id":"d48257eb7604ad84","role":"translation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"I have to read this book by tomorrow."}]},"n4-108#ebcd82727258":{"renderings":[{"id":"a1eb43fb465c3ab8","role":"translation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"I have to wake up early so I don't be late for class."}]},"n4-108#e777b81c769b":{"renderings":[{"id":"95cae83d2191bb2a","role":"translation","source":{"source":"hanabira","ref":"n4-108"},"match":"id","status":"imported","value":"I have to buy a ticket before going on a trip."}]}}}