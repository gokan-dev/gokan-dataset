{"kind":"grammar","lang":"en","entities":{"n3-116":{"renderings":[{"id":"0a64a2e57ebb6c31","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"Express an event or state that became possible; 'became able to', 'started to', 'now can'."},{"id":"038edba02d9e7ee4","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"The ～ようになった grammar point is used to express that an event, ability, or state has become possible or started to occur. It can be translated as 'became able to', 'started to', or 'now can' in English. Usually this is used with verbs in their dictionary or potential form (e.g., 食べられるようになった)."},{"id":"29eb0227ddb195c5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"Verb-casual + ようになった"},{"id":"109ce98b4b51dbdb","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-116"},"match":"id","status":"reviewed","value":"ようになった: the change is complete now (読めるようになった)."},{"id":"7bb6071bba353496","role":"label","field":"family","source":{"source":"gokan","ref":"effort-change"},"match":"id","status":"reviewed","value":"Effort And Change (Try To / Come To)","of":{"kind":"family","id":"effort-change"}}]},"n3-116#bfd8ceb05961":{"renderings":[{"id":"2a1a66d88ab4c3a5","role":"translation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"He became able to cook."}]},"n3-116#863e5825d0dd":{"renderings":[{"id":"6a891aa16c04944e","role":"translation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"That child started to be able to read."}]},"n3-116#b9abbe4b7d5f":{"renderings":[{"id":"9429c9c162e187d2","role":"translation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"The meeting started to be held once a week."}]},"n3-116#89053f9e2d83":{"renderings":[{"id":"d99f93889ae15f14","role":"translation","source":{"source":"hanabira","ref":"n3-116"},"match":"id","status":"imported","value":"I became able to understand Japanese."}]}}}