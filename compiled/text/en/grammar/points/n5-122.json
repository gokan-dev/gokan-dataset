{"kind":"grammar","lang":"en","entities":{"n5-122":{"renderings":[{"id":"31cc98bc6f7ca798","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"Asking how something is called or referred to; 'how do you say'"},{"id":"f4c34a2b4c231192","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"The ～なんと言いますか grammar point is used to ask how something is called, expressed, or referred to in a polite manner. It can be translated as 'how do you say' or 'what do you call' in English. The formation is used with a noun or a topic where you would like to know the proper expression or name for something."},{"id":"ecc2b3f0c33a438d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"Noun + は/が + なんと言いますか"},{"id":"f775dd88252afdee","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-122"},"match":"id","status":"reviewed","value":"Asks what something is called, its name (この花はなんと言いますか)."},{"id":"1913a979bbabcd87","role":"label","field":"family","source":{"source":"gokan","ref":"how"},"match":"id","status":"reviewed","value":"How (By What Means / How Do You Say It)","of":{"kind":"family","id":"how"}}]},"n5-122#b8af7404956c":{"renderings":[{"id":"5ac0038578fd8aa0","role":"translation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"How do you say this flower?"}]},"n5-122#28bcdacd2566":{"renderings":[{"id":"55a679e9ada536a6","role":"translation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"What do you call this dish?"}]},"n5-122#162c5aa4f7f6":{"renderings":[{"id":"dcbf8f3eeb964495","role":"translation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"How do you say this in Japanese?"}]},"n5-122#d58806d0a4bc":{"renderings":[{"id":"53e097dd48684806","role":"translation","source":{"source":"hanabira","ref":"n5-122"},"match":"id","status":"imported","value":"What is the name of that movie?"}]}}}