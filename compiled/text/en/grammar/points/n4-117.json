{"kind":"grammar","lang":"en","entities":{"n4-117":{"renderings":[{"id":"1126667dfa83d298","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"Indicates similarity, resemblance or 'like'; 'it seems', 'appears', 'looks like'."},{"id":"9817137f7e3cfe74","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"The ～みたいだ grammar point is used to express that something appears, seems or resembles something else. It can be used with nouns, verbs, い-adjectives, and な-adjectives. It can be translated as 'it seems', 'appears', or 'looks like' in English."},{"id":"4d935b33660782ea","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"Verb-casual + みたいだ, い-Adjective + みたいだ, な-Adjective + みたいだ, Noun + みたいだ"},{"id":"327ace907c0fb70d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-117"},"match":"id","status":"reviewed","value":"Casual, spoken \"seems like/looks like\" - the everyday default for resemblance. (Near-duplicate of n3-103 - same word, taught at both N3 and N4.)"},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n4-117#b4535192fb65":{"renderings":[{"id":"2deeafa19dc912a0","role":"translation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"She seems to be sick."}]},"n4-117#b629e3463d08":{"renderings":[{"id":"6a27bcfa4f16ef0d","role":"translation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"This dress seems to be expensive."}]},"n4-117#1eb1c6bdc2e1":{"renderings":[{"id":"e5b0797e8323e932","role":"translation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"That person looks like a celebrity."}]},"n4-117#3c7c24a6aca9":{"renderings":[{"id":"5dde46c9f6b87c4d","role":"translation","source":{"source":"hanabira","ref":"n4-117"},"match":"id","status":"imported","value":"It seems he is busy right now."}]}}}