{"kind":"grammar","lang":"en","entities":{"n4-100":{"renderings":[{"id":"5a7c17019a202caa","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"Asking for clarification or more information about a noun; 'what kind of', 'what sort of'."},{"id":"4e8039d41bfd6694","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"The どういう Noun grammar point is used to ask for more information or clarification about a specific noun. It can be translated as 'what kind of' or 'what sort of' in English. The formation is simply using どういう followed by the noun in question."},{"id":"3bfd48f845ed0d1a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"どういう + Noun"},{"id":"e2108e83c5bc2dd6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-100"},"match":"id","status":"reviewed","value":"'What kind of, what sort': often asks for an explanation (どういう意味ですか)."},{"id":"8d93baa5b27fa5f4","role":"label","field":"family","source":{"source":"gokan","ref":"what-kind"},"match":"id","status":"reviewed","value":"What Kind (What Kind Of / That Kind Of)","of":{"kind":"family","id":"what-kind"}}]},"n4-100#570bb8ab23ee":{"renderings":[{"id":"f57f9ef9d284db45","role":"translation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"What kind of work do you do?"}]},"n4-100#69125f2f325a":{"renderings":[{"id":"f358f6c342ec083c","role":"translation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"What kind of movies do you like?"}]},"n4-100#5e5ca644e71e":{"renderings":[{"id":"292dba9d07188fb0","role":"translation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"What kind of clothes do you want to wear?"}]},"n4-100#91cb1ca9a32e":{"renderings":[{"id":"cab16167ac95ef9e","role":"translation","source":{"source":"hanabira","ref":"n4-100"},"match":"id","status":"imported","value":"What sort of reason caused you to be late?"}]}}}