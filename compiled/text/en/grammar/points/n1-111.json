{"kind":"grammar","lang":"en","entities":{"n1-111":{"renderings":[{"id":"d0c1bd89c2e4603d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"Indicates 'like' or 'as' something or someone; 'equivalent to', 'around'."},{"id":"7ba4f7f96fd00f2f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"The Noun 並み grammar point is used to show a comparison, often translated as 'like' or 'equivalent to'. It can also indicate approximate quantity or extent, similar to 'around'."},{"id":"cca099ba7c89f563","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"Noun + 並み"},{"id":"34037a607157ee98","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-111"},"match":"id","status":"reviewed","value":"Noun 並み: on a par with, as much as (プロ並み)."},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n1-111#c2ed227f4691":{"renderings":[{"id":"3b6f61e4a9508933","role":"translation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"He has power equivalent to a professional boxer."}]},"n1-111#8e7afac34d5c":{"renderings":[{"id":"6d467ffd724ff20e","role":"translation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"Her cooking skills are like those of a restaurant."}]},"n1-111#00ecdb47b1fd":{"renderings":[{"id":"352f47fa3f74a569","role":"translation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"The summer heat in this area is like a desert."}]},"n1-111#543965cfcd9a":{"renderings":[{"id":"f712035cffccd4ee","role":"translation","source":{"source":"hanabira","ref":"n1-111"},"match":"id","status":"imported","value":"Today's work was as busy as a president's."}]}}}