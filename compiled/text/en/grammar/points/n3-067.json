{"kind":"grammar","lang":"en","entities":{"n3-067":{"renderings":[{"id":"b2f2bcba57bc86a7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"Indicates a role, capacity, or identity; 'as', 'in the capacity of'."},{"id":"3787a3c816cfab8c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"The ～として grammar point is used to express a role, capacity, or identity in which someone or something functions. It can be translated as 'as' or 'in the capacity of' in English. The formation differs depending on whether it is used with a verb, い-adjective, な-adjective, or noun."},{"id":"4a30d7742cafaf6a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"Verb-casual + として, い-Adjective + として, な-Adjective + だとして, Noun + だとして"},{"id":"a4d99435a03b9979","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-067"},"match":"id","status":"reviewed","value":"The everyday \"as/in the capacity of\"."},{"id":"86fce6792629d2d8","role":"label","field":"family","source":{"source":"gokan","ref":"capacity"},"match":"id","status":"reviewed","value":"Capacity (As / In The Role Of)","of":{"kind":"family","id":"capacity"}}]},"n3-067#31af39e9b3b5":{"renderings":[{"id":"19e36eeb5285a8ef","role":"translation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"He is working as a lawyer."}]},"n3-067#d83326e36cbf":{"renderings":[{"id":"44f3eec6a585c23b","role":"translation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"This dish can be eaten as a snack."}]},"n3-067#61c3fafe3730":{"renderings":[{"id":"54ed03e2b5938a62","role":"translation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"She is respected as a leader."}]},"n3-067#ef7d4840650e":{"renderings":[{"id":"8cb15b8a9f9b9dcc","role":"translation","source":{"source":"hanabira","ref":"n3-067"},"match":"id","status":"imported","value":"This book is used as a reference."}]}}}