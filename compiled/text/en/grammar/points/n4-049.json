{"kind":"grammar","lang":"en","entities":{"n4-049":{"renderings":[{"id":"f7a9d00cd7ae6d5e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"A polite way to ask for a favor or request someone to do something."},{"id":"ee006bc1ee66cd55","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"The ～てもらえませんか grammar point is a polite and indirect way of asking someone to do something for you or asking for a favor. It is formed by conjugating the verb into the て-form and adding もらえませんか. This form is used in conversations to show politeness and humility."},{"id":"0edf63821ad4405c","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"Verb-て form + もらえませんか"},{"id":"73842f3525c96e31","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-049"},"match":"id","status":"reviewed","value":"Neutral \"could you...\" - similar register to てくれませんか, slightly softer."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-049#21cecbf6cbc5":{"renderings":[{"id":"79549e85f6e15253","role":"translation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"Could you take a look at this letter for me?"}]},"n4-049#74624b9aa5b7":{"renderings":[{"id":"46a7092144543acc","role":"translation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"Could you carry this luggage for me?"}]},"n4-049#76e5964766c4":{"renderings":[{"id":"de618267d3ae0ad3","role":"translation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"Could you clean the room for me?"}]},"n4-049#e6df73bfd40a":{"renderings":[{"id":"6890e7dfdd348114","role":"translation","source":{"source":"hanabira","ref":"n4-049"},"match":"id","status":"imported","value":"Could you attend tomorrow's meeting for me?"}]}}}