{"kind":"grammar","lang":"en","entities":{"n4-019":{"renderings":[{"id":"d3535ea555ca17c7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"Express 'in the middle of', 'during', or 'in the process of'."},{"id":"9d8ca850cb00ccaa","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"The 中 (ちゅう) grammar point is used to express that something is in the middle of, during, or in the process of happening. It is attached to a noun to convey this meaning (e.g., 勉強中, 仕事中, 会議中). It is also sometimes read as じゅう depending on the word (e.g., 授業中)."},{"id":"9b286637e56ced09","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"Noun + 中 (ちゅう)"},{"id":"8100107c0d4f446c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-019"},"match":"id","status":"reviewed","value":"Attaches directly to a noun (e.g. 食事中 \"during a meal\") - \"in the middle of/during\"."},{"id":"f23b094c4a6b95fd","role":"label","field":"family","source":{"source":"gokan","ref":"in-progress"},"match":"id","status":"reviewed","value":"Stage Of An Action (About To / In The Middle Of / Just Did)","of":{"kind":"family","id":"in-progress"}}]},"n4-019#f56984c9552e":{"renderings":[{"id":"75f913b4d15d98a5","role":"translation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"He is in the middle of work."}]},"n4-019#e858040f5230":{"renderings":[{"id":"aa9fed90e5bdf8a9","role":"translation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"During the exam, you must not use your mobile phone."}]},"n4-019#91379e92954e":{"renderings":[{"id":"857bcefb5f74f55a","role":"translation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"In the middle of watching the movie, he started to cry."}]},"n4-019#a34ffeca5d9e":{"renderings":[{"id":"203ba7f303447cc7","role":"translation","source":{"source":"hanabira","ref":"n4-019"},"match":"id","status":"imported","value":"She is currently studying."}]}}}