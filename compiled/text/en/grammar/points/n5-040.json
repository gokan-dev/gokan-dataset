{"kind":"grammar","lang":"en","entities":{"n5-040":{"renderings":[{"id":"145d8a19bdd1e576","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"Used to mark the topic of a sentence; 'as for', 'speaking of'."},{"id":"2873e85e40a5429d","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"The は (wa) particle is used to indicate the topic of a sentence. It is usually translated as 'as for', 'speaking of', or it simply marks what the sentence is about. This is different from が (ga), which marks the subject of a verb."},{"id":"25227c6e318adf93","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"Noun + は"},{"id":"a6df9d1c2b486046","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-040"},"match":"id","status":"reviewed","value":"は marks the topic, what the sentence is about (私は学生です)."},{"id":"3e0de9e8a7012e84","role":"label","field":"family","source":{"source":"gokan","ref":"topic"},"match":"id","status":"reviewed","value":"Topic (As For / A Has B)","of":{"kind":"family","id":"topic"}}]},"n5-040#7dbc3bc0a8c8":{"renderings":[{"id":"bbcf76bee96662a3","role":"translation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"As for me, I like Japanese cuisine."}]},"n5-040#d4a9cb2e2b69":{"renderings":[{"id":"0a1467cab092eedb","role":"translation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"As for him, he is good at English."}]},"n5-040#f0cb38230f43":{"renderings":[{"id":"2c326bf0c569bea3","role":"translation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"As for this book, it's interesting."}]},"n5-040#5ff71a727cc3":{"renderings":[{"id":"06fc375d2ae29045","role":"translation","source":{"source":"hanabira","ref":"n5-040"},"match":"id","status":"imported","value":"Speaking of today, it's hot, isn't it?"}]}}}