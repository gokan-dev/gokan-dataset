{"kind":"grammar","lang":"en","entities":{"n3-080":{"renderings":[{"id":"a7073eed92fbafcc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-080"},"match":"id","status":"imported","value":"Express the meaning 'for', 'to', 'from the perspective of'."},{"id":"e4b85a1875f4faa6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-080"},"match":"id","status":"imported","value":"The ～にとって grammar point is used to express the meaning 'for', 'to', or 'from the perspective of' when describing someone or something's point of view, feelings, benefits, or importance. It is used with all types of words, such as verbs, adjectives, and nouns."},{"id":"c1d0e15868c01a00","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-080"},"match":"id","status":"imported","value":"Noun (person or thing) + にとって + Verb/Adjective/Noun"},{"id":"ae1991e715c60354","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-080"},"match":"id","status":"reviewed","value":"The everyday \"for (someone)/from (someone)'s perspective\"."},{"id":"251569c15f31ac19","role":"label","field":"family","source":{"source":"gokan","ref":"perspective"},"match":"id","status":"reviewed","value":"Perspective (From The Standpoint Of)","of":{"kind":"family","id":"perspective"}}]},"n3-080#a79c438601e6":{"renderings":[{"id":"11e61947416fc9eb","role":"translation","source":{"source":"hanabira","ref":"n3-080"},"match":"id","status":"imported","value":"For me, health is the most important thing."}]},"n3-080#d29e57dad9c0":{"renderings":[{"id":"e2c7e1e2b2160e67","role":"translation","source":{"source":"hanabira","ref":"n3-080"},"match":"id","status":"imported","value":"For that company, this project has significant meaning."}]},"n3-080#fc4cc3d57516":{"renderings":[{"id":"4c5b21a8b035e0b0","role":"translation","source":{"source":"hanabira","ref":"n3-080"},"match":"id","status":"imported","value":"For children, toys are fun things."}]},"