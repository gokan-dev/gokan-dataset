{"kind":"grammar","lang":"en","entities":{"n5-032":{"renderings":[{"id":"9a6e1bcf2b454bed","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"Express a specific direction, target or purpose; 'to', 'toward', 'for'."},{"id":"6e00bb27cb164c80","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"The 'Noun に' grammar point is used to express a specific direction, target, or purpose in relation to a noun. It can be translated as 'to', 'toward', or 'for' in English. The に particle is added directly after the noun which indicates direction, target or purpose."},{"id":"bf54c95f9bd203b1","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"Noun + に"},{"id":"2a3a5b5992fa4e72","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-032"},"match":"id","status":"reviewed","value":"に: a destination, a time, where something exists, or a recipient (日本に行く)."},{"id":"50cc4031e27cad12","role":"label","field":"family","source":{"source":"gokan","ref":"place-particles"},"match":"id","status":"reviewed","value":"Place Particles (At / In / To)","of":{"kind":"family","id":"place-particles"}}]},"n5-032#649efccb0d86":{"renderings":[{"id":"f735c02422ec3138","role":"translation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"I gave a present to her."}]},"n5-032#3efbf34abad4":{"renderings":[{"id":"2dc1a55cf2a09404","role":"translation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"I am going to Japan."}]},"n5-032#8b0bd171ba63":{"renderings":[{"id":"c36668e82a47d828","role":"translation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"Let's meet at 6 o'clock."}]},"n5-032#32538fca9505":{"renderings":[{"id":"0a9fc22779694482","role":"translation","source":{"source":"hanabira","ref":"n5-032"},"match":"id","status":"imported","value":"I will write a letter to my friend."}]}}}