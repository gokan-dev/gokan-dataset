{"kind":"grammar","lang":"en","entities":{"n5-021":{"renderings":[{"id":"50d3dd68c7b6dac6","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-021"},"match":"id","status":"imported","value":"Express a change or transformation into a state described by the な-adjective."},{"id":"1aadc8a0b23b311a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-021"},"match":"id","status":"imported","value":"The な-Adjective + に + なります grammar point is used to express a change or transformation into the state described by the な-adjective. It translates to 'become' or 'turn into' along with the meaning of the な-adjective."},{"id":"95a16b8381a524d9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-021"},"match":"id","status":"imported","value":"な-Adjective (remove な) + に + なります"},{"id":"134e7b9e85a80fac","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-021"},"match":"id","status":"reviewed","value":"になる: it becomes so, by itself or over time (元気になる). にする: you make it so."},{"id":"f48a13546b42cc1e","role":"label","field":"family","source":{"source":"gokan","ref":"change-of-state"},"match":"id","status":"reviewed","value":"Change (Become / Make / Decide On)","of":{"kind":"family","id":"change-of-state"}}]},"n5-021#c8aa3fd26018":{"renderings":[{"id":"9ee0c0763a35a54e","role":"translation","source":{"source":"hanabira","ref":"n5-021"},"match":"id","status":"imported","value":"This room becomes quiet."}]},"n5-021#fa7d2f052c98":{"renderings":[{"id":"edbf68af185963de","role":"translation","source":{"source":"hanabira","ref":"n5-021"},"match":"id","status":"imported","value":"She becomes beautiful."}]},"n5-021#20617ae90955":{"renderings":[{"id":"51d4648cb0fe5eca","role":"translation","source":{"source":"hanabira","ref":"n5-021"},"match":"id","status":"imported","value":"He becomes energetic."}]},"n5-021#d5ab9853b254":{"renderings":[{"id":"e4f7f8868e2822e7","role":"translation","source":