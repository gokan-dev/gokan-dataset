{"kind":"grammar","lang":"en","entities":{"n1-146":{"renderings":[{"id":"f442d15ca8138a07","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"Expresses a strong denial or refusal: 'I would never...', 'No way I would...'."},{"id":"ae7a08221c40a8f1","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"This grammar adds a nuance of strong denial or dismissal of the idea that the speaker (or someone) would do the action. Formed by adding やしない to the verb's stem, it often appears in casual or spoken language."},{"id":"0e0422c0dd4b1670","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"Verb (masu stem) + やしない"},{"id":"a2933319a3583100","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-146"},"match":"id","status":"reviewed","value":"やしない: absolutely won't (分かりやしない)."},{"id":"6a9ffa925908f457","role":"label","field":"family","source":{"source":"gokan","ref":"unlikely-impossible"},"match":"id","status":"reviewed","value":"Unlikely / Impossible","of":{"kind":"family","id":"unlikely-impossible"}}]},"n1-146#0067e36caa67":{"renderings":[{"id":"ba3582e146e49658","role":"translation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"I would never cry at a time like this."}]},"n1-146#f28a41c47926":{"renderings":[{"id":"f91d97ecb94a67da","role":"translation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"There's no way I'd help him."}]},"n1-146#9b4935750840":{"renderings":[{"id":"f4b96c36a872b9f6","role":"translation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"He would never say such a thing."}]},"n1-146#c60040fc6fb0":{"renderings":[{"id":"15a7e3a9fa54a349","role":"translation","source":{"source":"hanabira","ref":"n1-146"},"match":"id","status":"imported","value":"There's no way I'd buy something so expensive."}]}}}