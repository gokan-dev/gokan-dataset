{"kind":"grammar","lang":"en","entities":{"n5-910":{"renderings":[{"id":"bc0a85fd9a4ec82a","role":"label","field":"name","source":{"source":"gokan","ref":"n5-910"},"match":"id","status":"reviewed","value":"Past negative"},{"id":"86c17395f63bc130","role":"prose","field":"shortExplanation","source":{"source":"gokan","ref":"n5-910"},"match":"id","status":"reviewed","value":"The plain past negative of an い-adjective."},{"id":"0bf85e0a49a1a2a2","role":"prose","field":"longExplanation","source":{"source":"gokan","ref":"n5-910"},"match":"id","status":"reviewed","value":"The negative くない conjugates like an い-adjective itself, so its past is くなかった."},{"id":"2dcae502ed923e9d","role":"prose","field":"formation","source":{"source":"gokan","ref":"n5-910"},"match":"id","status":"reviewed","value":"Drop the final い and add くなかった: 高い -> 高くなかった."},{"id":"0aa82f35957c97a5","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-910"},"match":"id","status":"reviewed","value":"past negative (くなかった)"}]}}}