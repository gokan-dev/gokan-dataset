{"kind":"grammar","lang":"en","entities":{"n3-031":{"renderings":[{"id":"5784877268e156f2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"Presents two alternatives or choices; 'or', 'either...or'."},{"id":"20ae0d404e234d47","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"The ～？それとも～？ grammar point is used to present two alternatives or choices in a single sentence. It is similar to 'or' or 'either...or' in English. It can be used with verbs, adjectives, or nouns."},{"id":"53480e8d50069c81","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"Verb-casual + ？それとも + Verb-casual + ？, etc."},{"id":"adb3ca526d60768b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-031"},"match":"id","status":"reviewed","value":"\"Or (alternatively)\" - used between two full question options."},{"id":"bef7a3b562a0b387","role":"label","field":"family","source":{"source":"gokan","ref":"or-choice"},"match":"id","status":"reviewed","value":"Or (Alternatively)","of":{"kind":"family","id":"or-choice"}}]},"n3-031#53d70ddcdd06":{"renderings":[{"id":"5d68fc65153fd71d","role":"translation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"Do you want to drink coffee? Or tea?"}]},"n3-031#3378682c79a1":{"renderings":[{"id":"5b5a2567d77a3fb0","role":"translation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"Is this movie interesting? Or is it boring?"}]},"n3-031#5171025a5b04":{"renderings":[{"id":"e2fa743e1ea734dd","role":"translation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"Is he Japanese? Or is he a foreigner?"}]},"n3-031#77a6466db003":{"renderings":[{"id":"8989b31026361465","role":"translation","source":{"source":"hanabira","ref":"n3-031"},"match":"id","status":"imported","value":"Are we going to eat sushi? Or are we going to eat ramen?"}]}}}