{"kind":"grammar","lang":"en","entities":{"n1-094":{"renderings":[{"id":"c80ab5211ad80536","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"Used to express 'as well as', 'also', or 'at the same time'."},{"id":"2412555b52bca9b7","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"The も兼ねて grammar point indicates that two actions or purposes are being served simultaneously. The noun before も兼ねて tells what the additional action or purpose is."},{"id":"8846511b86c18c4f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"Noun + も兼ねて"},{"id":"7ff59e3daa3c2414","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-094"},"match":"id","status":"reviewed","value":"Formal, literary \"doubling as/also serving as\" - describes one action serving two purposes."},{"id":"e65e0d1190f99736","role":"label","field":"family","source":{"source":"gokan","ref":"also"},"match":"id","status":"reviewed","value":"Also (In Addition, Too)","of":{"kind":"family","id":"also"}}]},"n1-094#56e477b0ccb3":{"renderings":[{"id":"d386e33790fce3d9","role":"translation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"I went to the park, also for a walk."}]},"n1-094#31d882e12e3a":{"renderings":[{"id":"f01118e0d08b3f01","role":"translation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"Today, I will watch a Japanese movie, also to study Japanese."}]},"n1-094#655226c9f044":{"renderings":[{"id":"2ff04ab29311cec1","role":"translation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"I plan to go abroad, also for work."}]},"n1-094#1e408ad28dcd":{"renderings":[{"id":"8345854bd29dcc5f","role":"translation","source":{"source":"hanabira","ref":"n1-094"},"match":"id","status":"imported","value":"I will attend a friend's wedding, also as a trip."}]}}}