{"kind":"grammar","lang":"en","entities":{"n1-052":{"renderings":[{"id":"aa1fef90a584147d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-052"},"match":"id","status":"imported","value":"Expresses something unique or characteristic only of that noun; 'only found in', 'only possible with'."},{"id":"0a83b65806308853","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-052"},"match":"id","status":"imported","value":"The pattern Noun + ならでは highlights something that is unique or distinctive to that noun, suggesting that only this place, person, or thing could possess or create it."},{"id":"906ae416370356c2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-052"},"match":"id","status":"imported","value":"Noun + ならでは"},{"id":"b3e92990cf293f75","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-052"},"match":"id","status":"reviewed","value":"ならでは: only possible for X (京都ならではの景色)."},{"id":"98641544bada2a98","role":"label","field":"family","source":{"source":"gokan","ref":"befitting"},"match":"id","status":"reviewed","value":"Befitting (As Expected Of / Unbecoming Of)","of":{"kind":"family","id":"befitting"}}]},"n1-052#adf1b809edd1":{"renderings":[{"id":"550b3f935275b208","role":"translation","source":{"source":"hanabira","ref":"n1-052"},"match":"id","status":"imported","value":"This is a landscape you can only find in Japan."}]},"n1-052#3ed643b77f95":{"renderings":[{"id":"b7c23ea0c57df6b8","role":"translation","source":{"source":"hanabira","ref":"n1-052"},"match":"id","status":"imported","value":"Fresh fish is a specialty unique to this town."}]},"n1-052#e7b6177ca7e7":{"renderings":[{"id":"fecbfa2a9d0a2f63","role":"translation","source":{"source":"hanabira","ref":"n1-052"},"match":"id","status":"imported","value":"His skills are unique to him."}]},"n1-052#04ffaeb101d4":{"renderings":[{"id":"d5a7ee34774e3a96","role":"translation","source":{"source":"hanabira","ref":"n