{"kind":"grammar","lang":"en","entities":{"n1-023":{"renderings":[{"id":"1841889dbb9e4e58","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"Expresses 'though there is ... (some negative or burdensome aspect), still ...'."},{"id":"87efd85825ae39b2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"「Noun こそあれ」is a somewhat formal expression meaning 'Though there is X, (still) Y'. It acknowledges one (often negative) aspect while asserting that it does not prevent or change another fact or outcome."},{"id":"37889871a92b802b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"Noun + こそあれ + (result/continuation)"},{"id":"d8a9be6e880ad3ee","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-023"},"match":"id","status":"reviewed","value":"こそあれ: there may be X, but not Y (差こそあれ)."},{"id":"d9af84a42d98e34b","role":"label","field":"family","source":{"source":"gokan","ref":"koso"},"match":"id","status":"reviewed","value":"Emphasis With こそ (Precisely / Only By)","of":{"kind":"family","id":"koso"}}]},"n1-023#024988a30818":{"renderings":[{"id":"86b7c946919f7daa","role":"translation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"Though there are problems, the project is progressing smoothly."}]},"n1-023#6721d4a244b2":{"renderings":[{"id":"51c28509b7063d5b","role":"translation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"Though there is some risk, it's worth taking on the challenge."}]},"n1-023#160ab949a7de":{"renderings":[{"id":"820d22e93676121c","role":"translation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"Though it has flaws, his proposal is intriguing."}]},"n1-023#977cfa195eaf":{"renderings":[{"id":"bac0b7ece7ff691d","role":"translation","source":{"source":"hanabira","ref":"n1-023"},"match":"id","status":"imported","value":"Though there is anxiety, now is the time to act."}]}}}