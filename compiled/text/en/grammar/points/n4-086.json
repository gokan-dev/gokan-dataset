{"kind":"grammar","lang":"en","entities":{"n4-086":{"renderings":[{"id":"4243425431053509","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"Expresses 'not so much', 'not that', or 'not so ~'."},{"id":"2862413f5f788165","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"The grammar point そんなに is an adverb used to express that something is not as extreme as described or not to that extent. It is often translated as 'not so much', 'not that', or 'not so ~'. It is commonly followed by a negative form of a verb or adjective."},{"id":"81b20cac30a4bef0","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"そんなに + Verb-negation, そんなに + Adjective-negation"},{"id":"2d860a47b6bd3a42","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-086"},"match":"id","status":"reviewed","value":"'Not that much': negates a degree someone expected (そんなに高くない)."},{"id":"515717669db2afa2","role":"label","field":"family","source":{"source":"gokan","ref":"negation-intensity"},"match":"id","status":"reviewed","value":"Negation Intensity (Not Very / Not At All)","of":{"kind":"family","id":"negation-intensity"}}]},"n4-086#222d515279c6":{"renderings":[{"id":"983c7ff331b34242","role":"translation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"You don't have to hurry that much."}]},"n4-086#2471b41d3803":{"renderings":[{"id":"26170fe4a9b1deec","role":"translation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"I don't think the problem is that difficult."}]},"n4-086#570bdc352385":{"renderings":[{"id":"d2b0cc841d485f64","role":"translation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"She is not that tall."}]},"n4-086#05cad26ef5f7":{"renderings":[{"id":"2d1652273fa9453b","role":"translation","source":{"source":"hanabira","ref":"n4-086"},"match":"id","status":"imported","value":"I don't think there's a need to eat so much."}]}}}