{"kind":"grammar","lang":"en","entities":{"n1-221":{"renderings":[{"id":"d2dbbbe6f7e2378c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"Used to say that something is 'worth doing' or 'can stand up to' something (the positive counterpart of ～に堪えない)."},{"id":"7d5882a77f9109db","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"The ～に堪える grammar point indicates that something is good enough or worthy enough to do (read, see, listen to, etc.). Common examples include 読むに堪える, 見るに堪える, 聞くに堪える, etc., meaning 'worth reading/watching/listening to.'"},{"id":"10c41cb483a136b9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"Verb-dictionary form + に堪える, Noun + に堪える"},{"id":"79604bbceac1eb9f","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-221"},"match":"id","status":"reviewed","value":"に堪える: worth, able to stand (鑑賞に堪える)."},{"id":"2e4e09ff35069847","role":"label","field":"family","source":{"source":"gokan","ref":"worth"},"match":"id","status":"reviewed","value":"Worth (Worth Doing / In Vain / Bearable)","of":{"kind":"family","id":"worth"}}]},"n1-221#7e4463d28939":{"renderings":[{"id":"afee8ef9c57d82b8","role":"translation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"His singing voice is worth listening to."}]},"n1-221#2f9ce874e614":{"renderings":[{"id":"9cea93f8cd4d93e9","role":"translation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"This novel is worth reading."}]},"n1-221#51c3c4aa4042":{"renderings":[{"id":"a34eb86fe6abfbfd","role":"translation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"That movie is a masterpiece worth watching."}]},"n1-221#06b7df12d12e":{"renderings":[{"id":"5ab1ddffdbe89845","role":"translation","source":{"source":"hanabira","ref":"n1-221"},"match":"id","status":"imported","value":"His opinion is definitely worth considering."}]}}}