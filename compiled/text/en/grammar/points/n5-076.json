{"kind":"grammar","lang":"en","entities":{"n5-076":{"renderings":[{"id":"f4b75e08ad8dc258","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"Used to express that someone gives a gift or favor to 'me'; 'someone gives me'."},{"id":"ada2135111d9a017","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"The ～が私にくれます grammar point is used to express that someone gives 'me' something or does something for me. It can be translated as 'someone gives me' or 'someone does something for me' in English. Typically, the giver is marked by が, and the receiver is 私に (to me)."},{"id":"e86c0cb848c6b348","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"Person + が + (Thing or Action) + 私に + くれます"},{"id":"e859c3f49197f856","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-076"},"match":"id","status":"reviewed","value":"Neutral - someone giving TO the speaker. (Polite ます-form of n4-016's くれる.)"},{"id":"aabe59494c91ee24","role":"label","field":"family","source":{"source":"gokan","ref":"giving"},"match":"id","status":"reviewed","value":"Giving (Benefactive Register)","of":{"kind":"family","id":"giving"}}]},"n5-076#ceb6fffe0077":{"renderings":[{"id":"64f07afb5c2e7413","role":"translation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"He gave me a present."}]},"n5-076#6a010cb8fbe3":{"renderings":[{"id":"5ea853eb3b6c6618","role":"translation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"My friend helped me with my homework."}]},"n5-076#13e4aaf17d99":{"renderings":[{"id":"6dffdd2bf0b11923","role":"translation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"My mom made me a lunch box."}]},"n5-076#478b6328b86b":{"renderings":[{"id":"307c80b120900d62","role":"translation","source":{"source":"hanabira","ref":"n5-076"},"match":"id","status":"imported","value":"The teacher gave me advice."}]}}}