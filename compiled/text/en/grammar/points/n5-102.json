{"kind":"grammar","lang":"en","entities":{"n5-102":{"renderings":[{"id":"e0deacfeea286145","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"Expresses 'somewhere', used when the specific location is unknown or uncertain."},{"id":"ddb88f7040651b85","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"The grammar point どこか is used when the speaker wants to express that something is happening or located 'somewhere', but the exact location is either unknown or uncertain. It can be used by itself or combined with other words."},{"id":"e9b7fb786f1e1a7b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"どこか + (Particle, if needed) + Verb/Noun/Adjective"},{"id":"a9ee8db5a125dcb0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-102"},"match":"id","status":"reviewed","value":"'Somewhere': a place you do not name (どこかに行きたい). A statement, not a question."},{"id":"7fa850bc8a152d1f","role":"label","field":"family","source":{"source":"gokan","ref":"nowhere"},"match":"id","status":"reviewed","value":"Where (Somewhere / Anywhere / Nowhere)","of":{"kind":"family","id":"nowhere"}}]},"n5-102#64334192652d":{"renderings":[{"id":"0851f832defdb116","role":"translation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"I lost my wallet somewhere."}]},"n5-102#4de2f08ef88e":{"renderings":[{"id":"227975d4dd6fe7cf","role":"translation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"I want to go somewhere today."}]},"n5-102#5eabf4f0d2db":{"renderings":[{"id":"d52b012169420cab","role":"translation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"Is there a cheap restaurant somewhere?"}]},"n5-102#598adff86791":{"renderings":[{"id":"b056b0be8790747e","role":"translation","source":{"source":"hanabira","ref":"n5-102"},"match":"id","status":"imported","value":"I want to study in a quiet place somewhere."}]}}}