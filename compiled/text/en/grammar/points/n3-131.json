{"kind":"grammar","lang":"en","entities":{"n3-131":{"renderings":[{"id":"ce9b98ae63961b1c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"In the middle of / while doing something."},{"id":"39b58ab288d09888","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"The ～最中に grammar point is used to indicate that something happens during the middle of an action or situation. It can be translated as 'in the middle of' or 'while' in English. It often involves appending 最中に to a verb in 〜ている form or a noun plus の."},{"id":"ea491212407e5bb7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"Verb-て form + いる + 最中に, Noun + の + 最中に"},{"id":"62a51e1fd974be6a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-131"},"match":"id","status":"reviewed","value":"ている + 最中に: right in the middle of, usually when interrupted."},{"id":"f23b094c4a6b95fd","role":"label","field":"family","source":{"source":"gokan","ref":"in-progress"},"match":"id","status":"reviewed","value":"Stage Of An Action (About To / In The Middle Of / Just Did)","of":{"kind":"family","id":"in-progress"}}]},"n3-131#44b7886ae13e":{"renderings":[{"id":"94955e7e151a617f","role":"translation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"The phone rang while I was taking a nap."}]},"n3-131#f959702d14ad":{"renderings":[{"id":"ca2aff402c2a938e","role":"translation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"A fire broke out in the middle of cooking."}]},"n3-131#0d9d200aaf8f":{"renderings":[{"id":"ce751d37fbbb8ec3","role":"translation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"I had to leave during the meeting because of an urgent matter."}]},"n3-131#f5ecfd18c508":{"renderings":[{"id":"27704387ec10e675","role":"translation","source":{"source":"hanabira","ref":"n3-131"},"match":"id","status":"imported","value":"An earthquake occurred during the exam."}]}}}