{"kind":"grammar","lang":"en","entities":{"n2-009":{"renderings":[{"id":"337d8485590215a5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"Expresses 'therefore' or 'because of that'."},{"id":"ce9fed9c0038075c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"The A。そこで B。grammar point is used to describe the reason for an action or situation in the A part and the result or decision made in the B part. It can be translated as 'therefore' or 'because of that' in English."},{"id":"44fdbaf7324f17a4","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"A + そこで + B"},{"id":"b0fed634ddcf4c29","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-009"},"match":"id","status":"reviewed","value":"\"So, at that point\" - narrative, marks the next logical step in a story."},{"id":"a369fa147f888d6d","role":"label","field":"family","source":{"source":"gokan","ref":"therefore"},"match":"id","status":"reviewed","value":"Therefore (Formal Cause-Result)","of":{"kind":"family","id":"therefore"}}]},"n2-009#b63e31c1b3b8":{"renderings":[{"id":"c9ce8f4c7fb933fb","role":"translation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"There is an exam tomorrow. Therefore, I plan to study tonight."}]},"n2-009#4eba9e007bf8":{"renderings":[{"id":"5ecbd0bbeb1fd21f","role":"translation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"This restaurant is crowded. Therefore, let's eat lunch at a different place."}]},"n2-009#4d97e1b6243a":{"renderings":[{"id":"34065b884ba57cac","role":"translation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"She has an allergy. Therefore, I'll cook a different dish for her."}]},"n2-009#16cfee445ebc":{"renderings":[{"id":"8cbe85146a7af01a","role":"translation","source":{"source":"hanabira","ref":"n2-009"},"match":"id","status":"imported","value":"I don't have an umbrella. Therefore, I'll wait until the rain stops."}]}}}