{"kind":"grammar","lang":"en","entities":{"n3-085":{"renderings":[{"id":"83d7922f3f431fc9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-085"},"match":"id","status":"imported","value":"Regarding, concerning, about, with respect to."},{"id":"178f72199d533f6b","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-085"},"match":"id","status":"imported","value":"The ～に関して grammar point is used to express the topic or subject matter one is talking about. It can be translated as 'regarding', 'concerning', 'about', or 'with respect to' in English. The formation is simple and remains the same regardless of it being used with a verb, い-adjective, な-adjective, or noun."},{"id":"70370bba1dc2fcf4","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-085"},"match":"id","status":"imported","value":"Noun + に関して"},{"id":"3818f6a365bbc129","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-085"},"match":"id","status":"reviewed","value":"に関して: regarding, a little more formal than について."},{"id":"183867b469d74a86","role":"label","field":"family","source":{"source":"gokan","ref":"regarding"},"match":"id","status":"reviewed","value":"Regarding (Concerning)","of":{"kind":"family","id":"regarding"}}]},"n3-085#2888d0fd305f":{"renderings":[{"id":"1e977e769a83dc67","role":"translation","source":{"source":"hanabira","ref":"n3-085"},"match":"id","status":"imported","value":"It is important to be careful regarding health."}]},"n3-085#4b7e23472887":{"renderings":[{"id":"a23d2460c48d3d1d","role":"translation","source":{"source":"hanabira","ref":"n3-085"},"match":"id","status":"imported","value":"Regarding this project, he knows all the details."}]},"n3-085#a7c1d37565b1":{"renderings":[{"id":"686f08d903dc6eb0","role":"translation","source":{"source":"hanabira","ref":"n3-085"},"match":"id","status":"imported","value":"Concerning environmental issues, we must take more responsibility."}]},"n3-085