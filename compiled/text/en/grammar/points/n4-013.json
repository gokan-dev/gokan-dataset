{"kind":"grammar","lang":"en","entities":{"n4-013":{"renderings":[{"id":"b9330bf7d2b8c6a4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-013"},"match":"id","status":"imported","value":"To give something to someone; 'give', 'offer', 'present'."},{"id":"eab7b9b9fef2ce4c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-013"},"match":"id","status":"imported","value":"The を あげる grammar point is used to express giving something to someone. It can be translated as 'give', 'offer', or 'present' in English. This construction is commonly used with nouns to indicate giving or offering a tangible item, action, or favor to someone else."},{"id":"8117d344f245119a","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-013"},"match":"id","status":"imported","value":"Noun + を + あげる"},{"id":"6301f20171438e15","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-013"},"match":"id","status":"reviewed","value":"The plain \"give\" - speaker giving to someone at equal/lower status."},{"id":"aabe59494c91ee24","role":"label","field":"family","source":{"source":"gokan","ref":"giving"},"match":"id","status":"reviewed","value":"Giving (Benefactive Register)","of":{"kind":"family","id":"giving"}}]},"n4-013#ec2b64eaf518":{"renderings":[{"id":"c6ee435af23ea881","role":"translation","source":{"source":"hanabira","ref":"n4-013"},"match":"id","status":"imported","value":"I give a present."}]},"n4-013#3a728c398393":{"renderings":[{"id":"44d679944254cc57","role":"translation","source":{"source":"hanabira","ref":"n4-013"},"match":"id","status":"imported","value":"I gave flowers to my friend."}]},"n4-013#f4fdfff38e52":{"renderings":[{"id":"8c549a3fa1184f68","role":"translation","source":{"source":"hanabira","ref":"n4-013"},"match":"id","status":"imported","value":"I will give a watch to my father."}]},"n4-013#faea72a67224":{"renderings":[{"id":"35249890f304d82c","role":"translation","source":{"so