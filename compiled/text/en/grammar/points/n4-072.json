{"kind":"grammar","lang":"en","entities":{"n4-072":{"renderings":[{"id":"f68a81e35a735be4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-072"},"match":"id","status":"imported","value":"Verbal action is completed; 'to finish', 'to end'."},{"id":"5cbb03eb1b5cdf81","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-072"},"match":"id","status":"imported","value":"The verb 終わる (owaru) is used to express that an action has been completed or something has come to an end. Despite ending in る, 終わる is a godan (u-verb), so it does not follow the typical ichidan (る-verb) conjugation. It is translated as 'to finish', 'to end' or 'to be over' in English."},{"id":"13a2790be57a85ef","role":"prose","field":"formation","source":{"source":"gokan","ref":"n4-072"},"match":"id","status":"reviewed","value":"Verb-ます stem + 終わる"},{"id":"a17d25008fa28814","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-072"},"match":"id","status":"reviewed","value":"ます stem + 終わる: finish doing (読み終わる)."},{"id":"346651d354f1ea02","role":"label","field":"family","source":{"source":"gokan","ref":"aspect-verbs"},"match":"id","status":"reviewed","value":"Start, Continue, Finish (Start To / Keep / Finish / Do To The End)","of":{"kind":"family","id":"aspect-verbs"}}]},"n4-072#3f2190b13074":{"renderings":[{"id":"8d32c0c2d59d92b2","role":"translation","source":{"source":"gokan","ref":"n4-072"},"match":"id","status":"reviewed","value":"When you finish reading the book, please give it back."}]},"n4-072#cd542d7206e7":{"renderings":[{"id":"1d7b9ff15efc6ddf","role":"translation","source":{"source":"gokan","ref":"n4-072"},"match":"id","status":"reviewed","value":"I finally finished writing my homework."}]},"n4-072#4cb8528f42ac":{"renderings":[{"id":"7f3d880c053aa2d6","role":"translation","source":{"source":"gokan","ref":"n4-072"},"match":"id","status":"reviewed","value":"After I finish eating dinner, I watch TV."}]},"n4-072#9106c70ec7b5":{"renderings":[{"id":"d4249dbdd022fc12","role":"translation","source":{"source":"gokan","ref":"n4-072"},"match":"id","status":"reviewed","value":"Have you finished watching that movie already?"}]}}}