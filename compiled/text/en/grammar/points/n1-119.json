{"kind":"grammar","lang":"en","entities":{"n1-119":{"renderings":[{"id":"239d8b4ab29e2568","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-119"},"match":"id","status":"imported","value":"Means 'Even without doing (X), (Y) can still happen'."},{"id":"887611317156dfc3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-119"},"match":"id","status":"imported","value":"The ～ずとも grammar point is used to express that, even if something isn't done, the desired result can still be achieved or the situation remains unaffected. It can be translated as 'even without' or 'even if not'."},{"id":"0c4b4ab9b5bc7d67","role":"prose","field":"formation","source":{"source":"gokan","ref":"n1-119"},"match":"id","status":"reviewed","value":"Verb-negative stem + ずとも, Verb-ない stem + なくとも"},{"id":"53b54db480ed01ec","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-119"},"match":"id","status":"reviewed","value":"ずとも: even without doing, it is fine (言わずとも分かる)."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n1-119#55f8b046ac51":{"renderings":[{"id":"8b8dfd7a8398ac45","role":"translation","source":{"source":"hanabira","ref":"n1-119"},"match":"id","status":"imported","value":"Even without eating breakfast, I can work."}]},"n1-119#b0cce9e79801":{"renderings":[{"id":"3c8ec0ffc8e3a84e","role":"translation","source":{"source":"hanabira","ref":"n1-119"},"match":"id","status":"imported","value":"Even without a car, you can go by bus."}]},"n1-119#4ff9f06aa5f8":{"renderings":[{"id":"184df2d4cd6d402a","role":"translation","source":{"source":"hanabira","ref":"n1-119"},"match":"id","status":"imported","value":"Even without money, one can be happy."}]},"n1-119#c45b4c191360":{"renderings":[{"id":"7d49dd12c3853833","role":"translation","source":{"source":"hanabira","ref":"n1-119"},"match":"id","status":"imported","value":"Even without the internet, there are several ways to obtain information."}]}}}