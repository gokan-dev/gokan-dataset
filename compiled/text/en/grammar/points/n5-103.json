{"kind":"grammar","lang":"en","entities":{"n5-103":{"renderings":[{"id":"7e96c2d19ad8f108","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"Express 'anywhere' or 'everywhere' in Japanese."},{"id":"c2860c0ccadf8178","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"The grammar point どこでも is used to express 'anywhere' or 'everywhere' in Japanese. It is usually used in sentences to indicate that an action or situation could happen or exist in any location."},{"id":"1e0312508e6b03ec","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"Simply use the word どこでも in the sentence as an adverb to indicate 'anywhere' or 'everywhere'."},{"id":"8c36a034b7816b02","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-103"},"match":"id","status":"reviewed","value":"'Anywhere at all', wherever it is, with an affirmative verb (どこでも寝られます)."},{"id":"7fa850bc8a152d1f","role":"label","field":"family","source":{"source":"gokan","ref":"nowhere"},"match":"id","status":"reviewed","value":"Where (Somewhere / Anywhere / Nowhere)","of":{"kind":"family","id":"nowhere"}}]},"n5-103#01a45e68c528":{"renderings":[{"id":"de860ef2c64ce4ec","role":"translation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"You can study anywhere you like."}]},"n5-103#cc611e925de3":{"renderings":[{"id":"7ff73c28cff5de85","role":"translation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"This laptop is convenient, so you can use the internet anywhere."}]},"n5-103#24dfc09639b8":{"renderings":[{"id":"b7aaede88fd06fd9","role":"translation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"He can sleep anywhere."}]},"n5-103#98635282b245":{"renderings":[{"id":"f97ad85836e01bb9","role":"translation","source":{"source":"hanabira","ref":"n5-103"},"match":"id","status":"imported","value":"She loves singing anywhere."}]}}}