{"kind":"grammar","lang":"en","entities":{"n4-087":{"renderings":[{"id":"15254fbf1140ced7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"Expressing a desire or suggestion for a particular outcome; 'it would be good if', 'should', 'I hope'."},{"id":"4001552bc6508645","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"The ～たらいい grammar point is used to express a desire, suggestion, or hope for a particular outcome. It can be translated as 'it would be good if', 'should', or 'I hope' in English. The formation is simple, and it is used with verbs in their casual past tense form."},{"id":"27da7ec1a65bc858","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"Verb-casual-past + たらいい"},{"id":"29a54cccfd4d60a6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-087"},"match":"id","status":"reviewed","value":"Casual, softer suggestion - \"it'd be good if.../I hope...\"."},{"id":"6b4d498c02a32dcd","role":"label","field":"family","source":{"source":"gokan","ref":"should"},"match":"id","status":"reviewed","value":"Should (Advice / Expectation)","of":{"kind":"family","id":"should"}}]},"n4-087#3680eae7c8fa":{"renderings":[{"id":"2e1b4c3a6f94d8a5","role":"translation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"It would be good if you studied more."}]},"n4-087#b220e2450c50":{"renderings":[{"id":"fd1e4bb9c3bd9adb","role":"translation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"I hope the rain stops."}]},"n4-087#644694a63c96":{"renderings":[{"id":"83b44a6f6e978f28","role":"translation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"It would be good if you got well soon."}]},"n4-087#cf1a2883d32c":{"renderings":[{"id":"4dce6ea1366857b1","role":"translation","source":{"source":"hanabira","ref":"n4-087"},"match":"id","status":"imported","value":"I think it would be good if you contacted him."}]}}}