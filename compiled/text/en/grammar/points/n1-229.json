{"kind":"grammar","lang":"en","entities":{"n1-229":{"renderings":[{"id":"5fc8cf22632385f4","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"A suffix meaning “to appear/to become ~,” often used with certain adjectives or nouns."},{"id":"546cd15c362e5533","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"The suffix ～びる is used to form verbs meaning 'to become like' or 'to seem like.' Typical examples include 大人びる (to become or behave like an adult), 古びる (to become old or look old), 田舎びる (to become rustic/countrified)."},{"id":"fd762736f6b780df","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"Adjective/Noun + びる (to form a verb)"},{"id":"7f3bc8bf032a48a6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-229"},"match":"id","status":"reviewed","value":"びる: take on the look of (大人びる, 古びる)."},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n1-229#9a383272a0c2":{"renderings":[{"id":"905551aaca46f984","role":"translation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"She seems older than her actual age."}]},"n1-229#eced913b3adf":{"renderings":[{"id":"167ac28738e47005","role":"translation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"This building has become completely old and worn."}]},"n1-229#e294b9d35c17":{"renderings":[{"id":"37137a55cbe521f9","role":"translation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"Even though he grew up in the city, he speaks in a somewhat country-like way."}]},"n1-229#738a43088356":{"renderings":[{"id":"a729090d7ddbbb86","role":"translation","source":{"source":"hanabira","ref":"n1-229"},"match":"id","status":"imported","value":"It’s surprising when you see a child suddenly act grown-up."}]}}}