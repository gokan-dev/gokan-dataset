{"kind":"grammar","lang":"en","entities":{"n5-015":{"renderings":[{"id":"b082ea23dc96d29b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"Use an い-adjective to express 'to make' or 'to become'."},{"id":"082cd1bd7830a18e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"By adding くします to an い-adjective, you express making something (or causing something to become) the quality of that adjective. In English, this often corresponds to phrases like 'make something more ADJECTIVE.'"},{"id":"a5c95367068fb5a2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"い-Adjective (remove い, add く) + します"},{"id":"16c8725710a1524d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-015"},"match":"id","status":"reviewed","value":"くする: you MAKE it so (部屋を明るくする). くなる: it BECOMES so."},{"id":"f48a13546b42cc1e","role":"label","field":"family","source":{"source":"gokan","ref":"change-of-state"},"match":"id","status":"reviewed","value":"Change (Become / Make / Decide On)","of":{"kind":"family","id":"change-of-state"}}]},"n5-015#5bb9d70c18b3":{"renderings":[{"id":"38d935688fa575ea","role":"translation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"I will make the room brighter."}]},"n5-015#60fb45bd5c09":{"renderings":[{"id":"6d51319cb98c63b7","role":"translation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"I will make my friend’s mood more pleasant."}]},"n5-015#efd9fbc7acac":{"renderings":[{"id":"3af14af663733455","role":"translation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"I will make the way of doing things faster so that the work becomes easier."}]},"n5-015#1fc1902fc75b":{"renderings":[{"id":"c07bfe745bd2d1a9","role":"translation","source":{"source":"hanabira","ref":"n5-015"},"match":"id","status":"imported","value":"I will make the food delicious."}]}}}