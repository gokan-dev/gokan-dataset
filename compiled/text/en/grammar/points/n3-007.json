{"kind":"grammar","lang":"en","entities":{"n3-007":{"renderings":[{"id":"1653342a4fb9718e","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"Express 'without doing ~' or 'without ~ing'."},{"id":"410681aa4cecaacc","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"The ～ないで grammar point is used to express the idea of 'without doing something' or 'without ~ing' in English. It is formed by attaching the ない-form of the verb and adding で (de). This is used for expressing when an action is not taken or avoided, without interfering with the main action."},{"id":"bed97a36e69e5c17","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"Verb-ない-form + で"},{"id":"25f9841c952145c8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-007"},"match":"id","status":"reviewed","value":"ないで: without doing (朝ご飯を食べないで出かけた). Not a reason: なくて."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n3-007#0b8dca3e9876":{"renderings":[{"id":"741ae2a6c287edd8","role":"translation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"I made the phone call without meeting them."}]},"n3-007#7f3f9a6fb6f9":{"renderings":[{"id":"17561642a3d092bd","role":"translation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"I left the house without waiting for it to rain."}]},"n3-007#a21ba579e02d":{"renderings":[{"id":"d54eafd193762b4c","role":"translation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"I found out the secret without asking anyone."}]},"n3-007#ae547d70287c":{"renderings":[{"id":"4098c0ccd5b5d5f9","role":"translation","source":{"source":"hanabira","ref":"n3-007"},"match":"id","status":"imported","value":"I headed to the station without knowing I was late."}]}}}