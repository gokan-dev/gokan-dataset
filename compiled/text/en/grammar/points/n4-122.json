{"kind":"grammar","lang":"en","entities":{"n4-122":{"renderings":[{"id":"ba76017391278d12","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"Used to connect two sentences; 'So', 'That's why', 'Therefore'."},{"id":"13628a5988998c38","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"The grammar point 文A。それで 文B is used to connect two sentences and show that the second sentence (文B) is a result or consequence of the first sentence (文A). It can be translated as 'so', 'that's why', or 'therefore' in English."},{"id":"5686bf5e587206a7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"Sentence A。それで Sentence B。"},{"id":"eec30e2bc219cd62","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-122"},"match":"id","status":"reviewed","value":"Casual \"and then/so\" - conversational, often prompts the listener for what happened next. (Near-duplicate of n2-011's それで, sentence-initial form.)"},{"id":"566fb9e865e4f92a","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-then"},"match":"id","status":"reviewed","value":"Sequence (And Then)","of":{"kind":"family","id":"sequence-then"}}]},"n4-122#0e08d1bac22e":{"renderings":[{"id":"693f5bde2ff55211","role":"translation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"It is hot today. So, I turned on the air conditioner."}]},"n4-122#ee96e7a66c2c":{"renderings":[{"id":"e853910a362478d4","role":"translation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"The train was delayed. That's why I was late for work."}]},"n4-122#37a3117cb911":{"renderings":[{"id":"693f9731c04f22d1","role":"translation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"He is tired. Therefore, he decided to go to bed early."}]},"n4-122#bb2dd1783c6a":{"renderings":[{"id":"e4d5efc93f5d16c2","role":"translation","source":{"source":"hanabira","ref":"n4-122"},"match":"id","status":"imported","value":"I passed the exam. So, I held a celebration party with friends."}]}}}