{"kind":"grammar","lang":"en","entities":{"n4-032":{"renderings":[{"id":"887a98a873b9b409","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"Used to express receiving someone's favor or help; 'to kindly do'."},{"id":"8a014a64755a4838","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"The ～ていただく grammar point is used to express that someone has kindly done a favor or provided help. It is a more polite and humble way of saying that you received someone's help. The formation is created by attaching the て-form of the verb + いただく."},{"id":"dca42188427705ca","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"Verb-て form + いただく"},{"id":"f644eef84da080af","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-032"},"match":"id","status":"reviewed","value":"Humble - receiving the favor of someone (usually higher-status) doing something."},{"id":"2b7438ef385ec096","role":"label","field":"family","source":{"source":"gokan","ref":"benefactive-action"},"match":"id","status":"reviewed","value":"Benefactive Action (Doing X As A Favor)","of":{"kind":"family","id":"benefactive-action"}}]},"n4-032#b6db30130961":{"renderings":[{"id":"2fd539c21d58c98e","role":"translation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"Thank you for kindly sending the email."}]},"n4-032#65ba750e24a4":{"renderings":[{"id":"ea2ce877beae4458","role":"translation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"You really helped me by carrying the luggage."}]},"n4-032#9642da7a6b56":{"renderings":[{"id":"1d29df0a3991ccf4","role":"translation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"I would like you to kindly check the documents."}]},"n4-032#68583db51848":{"renderings":[{"id":"43500f1401830eb7","role":"translation","source":{"source":"hanabira","ref":"n4-032"},"match":"id","status":"imported","value":"The teacher kindly gave me advice."}]}}}