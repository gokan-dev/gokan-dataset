{"kind":"grammar","lang":"en","entities":{"n5-023":{"renderings":[{"id":"68b30aef9ad23190","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"Express the ability to do something."},{"id":"d9d7bc1797e5a5b4","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"The Noun が できます grammar point is used to express the ability to do something. In this grammar pattern, the noun is the activity that the speaker or subject can do. It translates as 'can do' or 'able to do' in English."},{"id":"a69511efb0a04695","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"Noun + が + できます"},{"id":"2211a4f81b53c479","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-023"},"match":"id","status":"reviewed","value":"Noun + ができる: can do an activity or skill (日本語ができる)."},{"id":"8f10599b8cd5e8b5","role":"label","field":"family","source":{"source":"gokan","ref":"ability"},"match":"id","status":"reviewed","value":"Ability (Can / Able To)","of":{"kind":"family","id":"ability"}}]},"n5-023#f28addc82e37":{"renderings":[{"id":"b093507b1f87314e","role":"translation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"I can speak English."}]},"n5-023#c524d214186e":{"renderings":[{"id":"ce7e18643d237307","role":"translation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"I can cook."}]},"n5-023#7924c2f0cbd6":{"renderings":[{"id":"b62d177b5fd73fd3","role":"translation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"He can swim."}]},"n5-023#2acce585ddcb":{"renderings":[{"id":"e202340898618d5a","role":"translation","source":{"source":"hanabira","ref":"n5-023"},"match":"id","status":"imported","value":"She can play the piano."}]}}}