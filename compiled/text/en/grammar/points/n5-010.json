{"kind":"grammar","lang":"en","entities":{"n5-010":{"renderings":[{"id":"4dc76e2676c65c68","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-010"},"match":"id","status":"imported","value":"Asking which one; 'which', 'A or B'."},{"id":"14a8c998889e0012","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-010"},"match":"id","status":"imported","value":"The AとBと どっち〜 grammar point is used to ask which one to choose between two options, A and B. It can be translated as 'which', 'A or B' in English. This is often used in casual speech and can be shortened to AかBか どっち〜."},{"id":"72d492a566df7aa9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-010"},"match":"id","status":"imported","value":"AとBと どっち + Verb, AかBか どっち + Verb"},{"id":"8ab0470ba480f321","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-010"},"match":"id","status":"reviewed","value":"Casual どちら, with friends and family (AとBとどっちが好き？)."},{"id":"15abdcbb2d0f64a8","role":"label","field":"family","source":{"source":"gokan","ref":"comparison"},"match":"id","status":"reviewed","value":"Comparison (More Than / Which / The Most)","of":{"kind":"family","id":"comparison"}}]},"n5-010#ac0e1ce64306":{"renderings":[{"id":"2bf29a4c72990970","role":"translation","source":{"source":"hanabira","ref":"n5-010"},"match":"id","status":"imported","value":"Which do you like, coffee or tea?"}]},"n5-010#c4c8c9e94e4a":{"renderings":[{"id":"f4d1aa1f9213b554","role":"translation","source":{"source":"hanabira","ref":"n5-010"},"match":"id","status":"imported","value":"Which do you enjoy, movies or music?"}]},"n5-010#db79d1f84145":{"renderings":[{"id":"aadab4645d85ca6f","role":"translation","source":{"source":"hanabira","ref":"n5-010"},"match":"id","status":"imported","value":"Which one will you buy, the red shirt or the blue shirt?"}]},"n5-010#c0c265a5dfb4":{"renderings":[{"id":"0b399763c886db57","role":"translation","source":{"sourc