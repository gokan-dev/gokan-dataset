{"kind":"grammar","lang":"en","entities":{"n1-160":{"renderings":[{"id":"4624f21f3d830389","role":"label","field":"romaji","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"verb-ru to kiri ga nai"},{"id":"11f58806072927a3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"Used to indicate that something can go on endlessly or without limits."},{"id":"4104f479016526ec","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"The ～るときりがない grammar point is used to express that once you start doing the verb, there’s no end or limit. The phrase 'きりがない' means 'no end' or 'endless.'"},{"id":"738c3b240894855b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"Verb-casual + と + きりがない"},{"id":"15b4196c58a55ea6","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-160"},"match":"id","status":"reviewed","value":"ときりがない: once you start, there is no end. Same as たら / ば きりがない."},{"id":"35530e0c1b8521ee","role":"label","field":"family","source":{"source":"gokan","ref":"endless"},"match":"id","status":"reviewed","value":"Endless (There's No End To It)","of":{"kind":"family","id":"endless"}}]},"n1-160#d1907546545a":{"renderings":[{"id":"a440cd81ac2168b4","role":"translation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"If we start talking about his faults, there's no end."}]},"n1-160#5c5857e15a33":{"renderings":[{"id":"b898ee03ffee1c0f","role":"translation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"If you start thinking about that problem, there's no end."}]},"n1-160#0c8b6fa3c164":{"renderings":[{"id":"3b7b66aee41e53c4","role":"translation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"If you start listing her virtues, there would be no end."}]},"n1-160#e722b0a6f5d0":{"renderings":[{"id":"74e7229c78a1d89e","role":"translation","source":{"source":"hanabira","ref":"n1-160"},"match":"id","status":"imported","value":"If you start eating all the delicious things in this world, there's no end."}]}}}