{"kind":"grammar","lang":"en","entities":{"n3-095":{"renderings":[{"id":"9c5d0ddc21cbcfdc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"Express an obligation or something that should be done (mainly with verbs)."},{"id":"984dbcf6afb2d9d8","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"The ～べきだ grammar point is used to express a sense of obligation or to indicate something that should be done. In modern Japanese, it is almost always used with verbs in the dictionary form. In English, it can be translated as 'should' or 'ought to'."},{"id":"7ac611ee48a22cd3","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"Verb-dictionary form + べきだ"},{"id":"409f975026fafcee","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-095"},"match":"id","status":"reviewed","value":"べきだ: should, ought to; a firm duty or moral judgment (謝るべきだ)."},{"id":"6b4d498c02a32dcd","role":"label","field":"family","source":{"source":"gokan","ref":"should"},"match":"id","status":"reviewed","value":"Should (Advice / Expectation)","of":{"kind":"family","id":"should"}}]},"n3-095#f2901383d8e9":{"renderings":[{"id":"24de511cf814e309","role":"translation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"You should study."}]},"n3-095#08953c4c53e7":{"renderings":[{"id":"6e7fbc08c73a720d","role":"translation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"You should sleep early."}]},"n3-095#07d5566303c3":{"renderings":[{"id":"f1bd64376450cfb5","role":"translation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"You should be quiet."}]},"n3-095#623c03852895":{"renderings":[{"id":"9e674d63b23bc89d","role":"translation","source":{"source":"hanabira","ref":"n3-095"},"match":"id","status":"imported","value":"You should apologize to him."}]}}}