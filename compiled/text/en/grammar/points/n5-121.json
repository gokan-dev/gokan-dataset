{"kind":"grammar","lang":"en","entities":{"n5-121":{"renderings":[{"id":"23b0ff50a5efcb4d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"Means 'any', 'anything', 'anyone'."},{"id":"528fba51b1bb6c97","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"The なんでも grammar point is used to express the concept of 'any', 'anything', or 'anyone' in Japanese. It can be used with verbs, adjectives, and nouns. It is often used in the meaning of 'no matter what' or 'regardless of'."},{"id":"5a653704102a3bb2","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"なんでも + Verb / なんでも + Adjective / なんでも + Noun"},{"id":"8a5eb9a4973f551d","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-121"},"match":"id","status":"reviewed","value":"'Anything at all', whatever it is, with an affirmative verb (なんでも食べます)."},{"id":"21ff3ba4a64e69d6","role":"label","field":"family","source":{"source":"gokan","ref":"what"},"match":"id","status":"reviewed","value":"What (Something / Anything / Nothing / How Many)","of":{"kind":"family","id":"what"}}]},"n5-121#58d156363e67":{"renderings":[{"id":"8be154c32d9cea6c","role":"translation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"I can eat anything, so it's okay to order whatever you want."}]},"n5-121#22b74f751df5":{"renderings":[{"id":"59b486928a1ae064","role":"translation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"If you're okay with anything, I recommend this book."}]},"n5-121#6d5f5b12521d":{"renderings":[{"id":"e5cc20bf7e4923e7","role":"translation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"We are looking for a staff member who can do anything."}]},"n5-121#c3a0b05086c9":{"renderings":[{"id":"607639c1178ae360","role":"translation","source":{"source":"hanabira","ref":"n5-121"},"match":"id","status":"imported","value":"In this cafeteria, any dish served is delicious and inexpensive."}]}}}