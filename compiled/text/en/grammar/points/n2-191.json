{"kind":"grammar","lang":"en","entities":{"n2-191":{"renderings":[{"id":"16c03ef8fb6bb5bc","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"Means 'when', 'while', or 'on the occasion of' a certain event or situation."},{"id":"45da529dab947972","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"～際に is used to specify a time or occasion when something happens. It’s more formal than a simple 'とき' and often appears in announcements or polite instructions."},{"id":"ba87e4c470183728","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"Verb-casual + 際に, い-Adjective + 際に, な-Adjective + な際に, Noun + の際に"},{"id":"45bfaf5eaa117817","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-191"},"match":"id","status":"reviewed","value":"Neutral, the everyday marker for an occasion or event - \"on the occasion of/when\"."},{"id":"ad8e82d619954210","role":"label","field":"family","source":{"source":"gokan","ref":"occasion"},"match":"id","status":"reviewed","value":"Occasion (While Doing / On The Occasion Of)","of":{"kind":"family","id":"occasion"}}]},"n2-191#d9ed4ef65a2e":{"renderings":[{"id":"1f25e6cbb78f1fad","role":"translation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"When departing, please don't forget your passport."}]},"n2-191#b67663c07bf0":{"renderings":[{"id":"9eef85c53a0100a1","role":"translation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"When an earthquake occurs, please evacuate immediately."}]},"n2-191#b2cce799b654":{"renderings":[{"id":"bf3a2f9d04586d43","role":"translation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"When I come to Japan, I plan to buy lots of souvenirs."}]},"n2-191#58c83abf7341":{"renderings":[{"id":"be88edcbd771d362","role":"translation","source":{"source":"hanabira","ref":"n2-191"},"match":"id","status":"imported","value":"Please wear a suit when attending the interview."}]}}}