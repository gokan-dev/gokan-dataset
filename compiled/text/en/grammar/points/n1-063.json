{"kind":"grammar","lang":"en","entities":{"n1-063":{"renderings":[{"id":"314feeb4ea94daaa","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"This expresses 'Even more than; exceeding'."},{"id":"0ef2990c3977bf43","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"The Nounにもまして grammar point is used to express that something is even more or exceeds the noun that it’s being compared to. It translates to expressions like 'even more than' or 'exceeding' in English. It is used when making a comparison to emphasize the greater degree of something."},{"id":"c3cbfa8409e6cc3d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"Noun + にもまして"},{"id":"f82e07a2aca5fa83","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-063"},"match":"id","status":"reviewed","value":"Formal, literary \"even more than X\" - comparative emphasis."},{"id":"f576172f87098943","role":"label","field":"family","source":{"source":"gokan","ref":"emphasis-even"},"match":"id","status":"reviewed","value":"Emphasis (Even)","of":{"kind":"family","id":"emphasis-even"}}]},"n1-063#fda938901312":{"renderings":[{"id":"2368df28143510f7","role":"translation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"I love music even more than he does."}]},"n1-063#48fc90be7e42":{"renderings":[{"id":"92ca2880ab6e59fa","role":"translation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"She has even more experience than her age would suggest."}]},"n1-063#feb8b55da0f9":{"renderings":[{"id":"b065d15b9191296a","role":"translation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"It is even colder today than it was yesterday."}]},"n1-063#099d0c6b55ab":{"renderings":[{"id":"382634610cdafc84","role":"translation","source":{"source":"hanabira","ref":"n1-063"},"match":"id","status":"imported","value":"This building is famous for its beautiful design even more than its height."}]}}}