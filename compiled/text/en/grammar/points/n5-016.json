{"kind":"grammar","lang":"en","entities":{"n5-016":{"renderings":[{"id":"0793c3fde0898ab9","role":"label","field":"name","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"Negative Polite Form"},{"id":"5b133d51db45aa8d","role":"label","field":"title","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"い-Adjective: Negative Polite Form"},{"id":"b04ed35922bb7a75","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"Change an い-adjective into a polite negative form with ～くないです (or ～くありません)."},{"id":"d86e574e8b2149da","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"To make an い-adjective negative and polite, remove the final い and add くないです. An alternative more formal style is くありません. For example, 美味しい -> 美味しくないです / 美味しくありません。"},{"id":"ef0e0911f6509de5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"い-Adjective (remove い, add く) + ないです / ありません"},{"id":"44c473096aef9b4f","role":"label","field":"derives","source":{"source":"gokan","ref":"n5-016"},"match":"id","status":"reviewed","value":"i-adjective negative polite"}]},"n5-016#8a18f7a87987":{"renderings":[{"id":"17bce90ddb9b9987","role":"translation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"This pizza is not delicious."}]},"n5-016#ac1835dfc88a":{"renderings":[{"id":"dc8f1a4608af04b2","role":"translation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"This room is not spacious."}]},"n5-016#6e8a30b3a1ca":{"renderings":[{"id":"54d92f586be97d91","role":"translation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"His opinion is not interesting."}]},"n5-016#85e8dcaeec5c":{"renderings":[{"id":"23440e127334dbd6","role":"translation","source":{"source":"hanabira","ref":"n5-016"},"match":"id","status":"imported","value":"That movie is not enjoyable."}]}}}