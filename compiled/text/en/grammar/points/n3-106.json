{"kind":"grammar","lang":"en","entities":{"n3-106":{"renderings":[{"id":"ea6e47c473e68bb2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"Express the possibility of something; 'maybe', 'perhaps', 'might'."},{"id":"43cc1d9d5795296a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"The もしかすると〜かもしれない grammar point is used to indicate that there might be a possibility of a certain situation happening or someone feeling a certain way. This structure is often used to describe uncertain situations and can be translated into English as 'maybe', 'perhaps', or 'might'."},{"id":"651052bbb70b5bbf","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"もしかすると + Sentence + かもしれない"},{"id":"fcce1acb53871110","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-106"},"match":"id","status":"reviewed","value":"Slightly more deliberate/emphasized version of かもしれない, often introducing a surprising possibility."},{"id":"799cfeb9c0ff0bb0","role":"label","field":"family","source":{"source":"gokan","ref":"inference"},"match":"id","status":"reviewed","value":"Inference (It Seems / Probably)","of":{"kind":"family","id":"inference"}}]},"n3-106#f5ed0321f5de":{"renderings":[{"id":"f9f6bd3141180557","role":"translation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"Maybe he might be late."}]},"n3-106#0f4316b379c1":{"renderings":[{"id":"36eb70ff960cb67b","role":"translation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"Perhaps she might be tired."}]},"n3-106#7980600bd171":{"renderings":[{"id":"78f93e422cb71319","role":"translation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"It might rain, maybe."}]},"n3-106#d12a64f7ba39":{"renderings":[{"id":"33ef581b336dd0ba","role":"translation","source":{"source":"hanabira","ref":"n3-106"},"match":"id","status":"imported","value":"Maybe they might not like that movie."}]}}}