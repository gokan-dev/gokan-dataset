{"kind":"grammar","lang":"en","entities":{"n2-117":{"renderings":[{"id":"08e685da6ee3b312","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"Expresses 'despite', 'in spite of' or 'even though'."},{"id":"93118638af5674c3","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"The ～にもかかわらず grammar point is used to express that something occurs, or a situation exists, despite or in spite of a contrasting or unfavorable condition. It can be translated as 'despite', 'in spite of', or 'even though' in English."},{"id":"d025e14cc371fdf7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"Verb (any tense/form) + にもかかわらず, い-Adjective + にもかかわらず, な-Adjective (or Noun) + であるにもかかわらず"},{"id":"ec0b74162ec030c1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-117"},"match":"id","status":"reviewed","value":"Formal, neutral-toned \"despite/in spite of\"; safe in writing and polite speech, no built-in criticism."},{"id":"e7484b401cb1f08c","role":"label","field":"family","source":{"source":"gokan","ref":"concession"},"match":"id","status":"reviewed","value":"Concession (Even Though / Although / Despite)","of":{"kind":"family","id":"concession"}}]},"n2-117#65cc1166bf3c":{"renderings":[{"id":"58b4c2b4def948fd","role":"translation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"Despite being busy, he exercises every day."}]},"n2-117#a3392b53ca93":{"renderings":[{"id":"0eb952c4deba83ce","role":"translation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"Even though it was raining, she went for a walk."}]},"n2-117#af46f6cd2c49":{"renderings":[{"id":"bb97f30f1a99bf04","role":"translation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"In spite of the car being old, it still runs well."}]},"n2-117#17fc0f41ec76":{"renderings":[{"id":"26d0e2bb51487194","role":"translation","source":{"source":"hanabira","ref":"n2-117"},"match":"id","status":"imported","value":"Despite the results not being good, he continued to do his best."}]}}}