{"kind":"grammar","lang":"en","entities":{"n4-075":{"renderings":[{"id":"6bf52c04c8333e03","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"Used to express 'whether' or 'if' in indirect questions or statements."},{"id":"8e4e032e9fc23baf","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"The ～かどうか grammar point is used to express 'whether' or 'if' in indirect questions or statements. It is often used to express uncertainty or to inquire about information in a more polite form. ～かどうか can be used with verbs, い-adjectives, な-adjectives, and nouns."},{"id":"d4673627783cd3e7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"Verb-casual + かどうか, い-Adjective + かどうか, な-Adjective + (だ)かどうか, Noun + (だ)かどうか"},{"id":"0ef0d21a4f08dd1b","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-075"},"match":"id","status":"reviewed","value":"Embedded yes/no question, 'whether or not' (来るかどうか分からない)."},{"id":"30f05beb6988b79b","role":"label","field":"family","source":{"source":"gokan","ref":"whether-or-not"},"match":"id","status":"reviewed","value":"Whether Or Not (To Do X)","of":{"kind":"family","id":"whether-or-not"}}]},"n4-075#fb9e47427764":{"renderings":[{"id":"631d60176f7ecd69","role":"translation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"I don't know if he will come or not."}]},"n4-075#05ab03cff044":{"renderings":[{"id":"f91677f49c29ba02","role":"translation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"Please tell me if this book is interesting or not."}]},"n4-075#fa2b073cdfe7":{"renderings":[{"id":"8485d0b011de7f21","role":"translation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"I don't know whether she is beautiful or not."}]},"n4-075#a5a5f9d2d888":{"renderings":[{"id":"94f449710acfbe54","role":"translation","source":{"source":"hanabira","ref":"n4-075"},"match":"id","status":"imported","value":"I don't remember if he is a teacher or not."}]}}}