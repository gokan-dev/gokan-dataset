{"kind":"grammar","lang":"en","entities":{"n2-029":{"renderings":[{"id":"9c91c0f389dcf29d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"Meaning 'starting with', 'including', 'not only... but also'."},{"id":"6f2278b743acfa63","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"The grammar point Nounをはじめ is used to show that there are other things or people being included apart from the mentioned noun. It can be used to provide an example, indicate a representative or list items. This can be translated as 'starting with', 'including', or 'not only... but also...' in English."},{"id":"f7f4c2528f3d13ad","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"Noun + をはじめ"},{"id":"5083f9a41ce7fbe1","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-029"},"match":"id","status":"reviewed","value":"The common, everyday \"starting with/including\"."},{"id":"f9c6bef1ecb29c5a","role":"label","field":"family","source":{"source":"gokan","ref":"starting-with"},"match":"id","status":"reviewed","value":"Starting With (Including)","of":{"kind":"family","id":"starting-with"}}]},"n2-029#288062c92389":{"renderings":[{"id":"498e80faae039ac5","role":"translation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"You can enjoy various dishes in this restaurant, starting with Japanese cuisine."}]},"n2-029#4efd1443346f":{"renderings":[{"id":"9831e13aa90e5805","role":"translation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"He collects not only paintings but also sculptures and photographs."}]},"n2-029#0b307716f634":{"renderings":[{"id":"5c8ef61d20419c99","role":"translation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"Traditional festivals are held in several cities in Japan, including Kyoto."}]},"n2-029#eb7a465c1166":{"renderings":[{"id":"d7e795b629c63efc","role":"translation","source":{"source":"hanabira","ref":"n2-029"},"match":"id","status":"imported","value":"Not only the Sun, but also planets such as Earth and Mars are included in the solar system."}]}}}