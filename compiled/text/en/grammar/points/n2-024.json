{"kind":"grammar","lang":"en","entities":{"n2-024":{"renderings":[{"id":"aacbcda328fe0a7d","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"Express contrasting opinions or facts; 'although', 'but', 'however'."},{"id":"67f906d13f5cde07","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"The A。もっとも B。 grammar point is used to express contrasting opinions or facts. It can be translated as 'although', 'but', or 'however' in English. This structure connects two clauses and highlights the contrast between them."},{"id":"b67ad35c74e91e96","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"Clause A + もっとも + Clause B"},{"id":"3ca12499be5cec49","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-024"},"match":"id","status":"reviewed","value":"Concessive \"though, to be fair...\" - softens or qualifies a preceding statement rather than flatly contradicting it."},{"id":"a13bf53f446f3f0d","role":"label","field":"family","source":{"source":"gokan","ref":"contradiction"},"match":"id","status":"reviewed","value":"Contradiction (But / However)","of":{"kind":"family","id":"contradiction"}}]},"n2-024#084b0f0b14b0":{"renderings":[{"id":"7a5fd3eb14a20f66","role":"translation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"He is smart. However, studying is also important."}]},"n2-024#227e72958e8b":{"renderings":[{"id":"fc4a5aa5423c5868","role":"translation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"This restaurant is delicious. But, the prices are high."}]},"n2-024#83c828f97cff":{"renderings":[{"id":"7272587fe9a2ed37","role":"translation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"She is beautiful. Although, her personality is bad."}]},"n2-024#b75a9dab966c":{"renderings":[{"id":"142ea9c4b14f1a2d","role":"translation","source":{"source":"hanabira","ref":"n2-024"},"match":"id","status":"imported","value":"Japan is an interesting country. But, it seems difficult to live in."}]}}}