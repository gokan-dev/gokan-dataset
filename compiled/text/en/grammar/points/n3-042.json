{"kind":"grammar","lang":"en","entities":{"n3-042":{"renderings":[{"id":"d347d8ebfc17e754","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"Used to express that one is trying to recall some information."},{"id":"1fd8e87f4bd3c0ae","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"The ～っけ？ grammar point is added at the end of a sentence when the speaker is trying to recall something or confirm a memory. It can be used with verbs, adjectives, or nouns in casual form."},{"id":"7714e13aebc52c6e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"Verb-casual + っけ?, い-Adjective + かったっけ?, な-Adjective/Noun + だっけ?"},{"id":"e665bc56a3f81606","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-042"},"match":"id","status":"reviewed","value":"っけ: trying to remember something you once knew (何時だっけ？)."},{"id":"2876ead5ce935ea6","role":"label","field":"family","source":{"source":"gokan","ref":"i-wonder"},"match":"id","status":"reviewed","value":"I Wonder (Musing Uncertainty)","of":{"kind":"family","id":"i-wonder"}}]},"n3-042#f3c83b1166e5":{"renderings":[{"id":"45385ba046f25fce","role":"translation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"What time is he coming again?"}]},"n3-042#e44cc93d0c19":{"renderings":[{"id":"d2763ac819376cd9","role":"translation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"Was this movie interesting?"}]},"n3-042#bf6b52ac1a7b":{"renderings":[{"id":"62c3d2e52ab2ec5a","role":"translation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"She was a student, right?"}]},"n3-042#75d808c0393e":{"renderings":[{"id":"c1a52f6c2db5749c","role":"translation","source":{"source":"hanabira","ref":"n3-042"},"match":"id","status":"imported","value":"Where was the sushi place again?"}]}}}