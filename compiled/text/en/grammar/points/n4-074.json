{"kind":"grammar","lang":"en","entities":{"n4-074":{"renderings":[{"id":"2486952b41e4318c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"Indicates uncertainty or doubt; 'I wonder', 'I'm not sure'."},{"id":"08614dbea0572ffd","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"The ～かしら grammar point is used to express uncertainty or doubt about a situation. It can be translated as 'I wonder' or 'I'm not sure' in English. It is primarily used by females in casual conversations but can be used by males in some contexts as well. ～かしら is used with verbs, い-adjectives, な-adjectives, and nouns."},{"id":"6cf9f57cfdac8ef7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"Verb-casual + かしら, い-Adjective + かしら, な-Adjective + かしら, Noun + かしら"},{"id":"cab3b55f3edcb1d4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-074"},"match":"id","status":"reviewed","value":"Casual, traditionally feminine-coded \"I wonder\" - softer, more old-fashioned than かなあ."},{"id":"2876ead5ce935ea6","role":"label","field":"family","source":{"source":"gokan","ref":"i-wonder"},"match":"id","status":"reviewed","value":"I Wonder (Musing Uncertainty)","of":{"kind":"family","id":"i-wonder"}}]},"n4-074#3b2643648274":{"renderings":[{"id":"2dd2bb0d58f86792","role":"translation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"I wonder if it will rain today?"}]},"n4-074#0da8061566f7":{"renderings":[{"id":"123687848118c1fa","role":"translation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"I wonder if this cake is delicious?"}]},"n4-074#878dcf086e3e":{"renderings":[{"id":"dfe307c3b42debb7","role":"translation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"I wonder if he is sick?"}]},"n4-074#b6ad86e6641e":{"renderings":[{"id":"7ffb4d2117631a17","role":"translation","source":{"source":"hanabira","ref":"n4-074"},"match":"id","status":"imported","value":"I wonder if she is a student?"}]}}}