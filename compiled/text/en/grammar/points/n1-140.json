{"kind":"grammar","lang":"en","entities":{"n1-140":{"renderings":[{"id":"e4ef4da0acbb8058","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-140"},"match":"id","status":"imported","value":"'Even if not to the extent of...', 'although not completely...'."},{"id":"b2d23aafaea40933","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-140"},"match":"id","status":"imported","value":"The pattern ないまでも is used when acknowledging that something doesn’t reach a certain extreme, but at least some part or degree of it applies. Often translated as 'even if not entirely...' or 'though not as far as...'."},{"id":"b957c63f8a9d99fb","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-140"},"match":"id","status":"imported","value":"Verb-ない form + までも"},{"id":"d393c12e09617dd0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-140"},"match":"id","status":"reviewed","value":"Formal, literary \"even if not fully X, at least...\" - a partial concession."},{"id":"a3d1d81bf546c33e","role":"label","field":"family","source":{"source":"gokan","ref":"even-if"},"match":"id","status":"reviewed","value":"Even If (Hypothetical Concession)","of":{"kind":"family","id":"even-if"}}]},"n1-140#27340643d29e":{"renderings":[{"id":"9addeee82b7493f7","role":"translation","source":{"source":"hanabira","ref":"n1-140"},"match":"id","status":"imported","value":"Even if you don't understand everything, I'd like you at least to grasp the basics."}]},"n1-140#50952b315399":{"renderings":[{"id":"579f5054b67f09f6","role":"translation","source":{"source":"hanabira","ref":"n1-140"},"match":"id","status":"imported","value":"Even if we can’t meet, I still want to hear your voice over the phone."}]},"n1-140#d0a970d8d161":{"renderings":[{"id":"39706e24fabd0a1c","role":"translation","source":{"source":"hanabira","ref":"n1-140"},"match":"id","status":"imported","value":"Even if not everyone will like me, I still want to face them sincerely."}]}}}