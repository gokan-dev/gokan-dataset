{"kind":"grammar","lang":"en","entities":{"n1-128":{"renderings":[{"id":"8f98ce95c8f60487","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"Indicates an endless or unending cycle once an action is started; 'if one starts doing something, it will not stop.'"},{"id":"ca8b761aa2179c11","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"The たらきりがない grammar pattern is used when something negative or undesirable continues indefinitely once it begins. The implication is that you should avoid initiating the action because it’ll just go on and on."},{"id":"ceb73f0ed2a6d3c7","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"Verb-た form + ら + きりがない"},{"id":"e6fbafc317e3e8bd","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-128"},"match":"id","status":"reviewed","value":"たらきりがない: once you start, there is no end. Same as ば / と きりがない."},{"id":"35530e0c1b8521ee","role":"label","field":"family","source":{"source":"gokan","ref":"endless"},"match":"id","status":"reviewed","value":"Endless (There's No End To It)","of":{"kind":"family","id":"endless"}}]},"n1-128#39b13a990871":{"renderings":[{"id":"ddb892974628e41c","role":"translation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"If I fix this engine, it breaks again, and if I fix it again, it never ends."}]},"n1-128#bf6b174d62a5":{"renderings":[{"id":"98bdfd2b784238d1","role":"translation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"Once I start drinking, I never stop."}]},"n1-128#0fa9625cc128":{"renderings":[{"id":"6da6b22d6150c3a2","role":"translation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"If I lend her money, there will be no end to it."}]},"n1-128#4f822c8671a2":{"renderings":[{"id":"ac40db88bd2113cf","role":"translation","source":{"source":"hanabira","ref":"n1-128"},"match":"id","status":"imported","value":"Once you start listening to his stories, it never ends."}]}}}