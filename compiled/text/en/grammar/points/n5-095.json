{"kind":"grammar","lang":"en","entities":{"n5-095":{"renderings":[{"id":"96481cebbbc80cc8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"Asking for someone's opinion or decision; 'what will you do?', 'how will you handle it?'."},{"id":"d8f6debe2fa85a4e","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"The ～どうしますか grammar point is used to ask for someone's opinion, decision, or course of action in a specific situation. It can be translated as 'what will you do?' or 'how will you handle it?' in English. This grammar point is formed by attaching どうしますか to the end of a sentence."},{"id":"540f28a88cf68c77","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"Situation + どうしますか"},{"id":"7687926a945c6fc8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-095"},"match":"id","status":"reviewed","value":"'What will you do?': asks for a decision (どうしますか), not a method."},{"id":"1913a979bbabcd87","role":"label","field":"family","source":{"source":"gokan","ref":"how"},"match":"id","status":"reviewed","value":"How (By What Means / How Do You Say It)","of":{"kind":"family","id":"how"}}]},"n5-095#7e9ea0c37343":{"renderings":[{"id":"85e451d09036dec8","role":"translation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"It's raining, so what will you do?"}]},"n5-095#d8b6513e3e6e":{"renderings":[{"id":"99395f1d96b74a02","role":"translation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"What are you going to do about this issue?"}]},"n5-095#0f08bb74a1ed":{"renderings":[{"id":"76e9849eef3689be","role":"translation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"If he doesn't come, what will you do?"}]},"n5-095#dae1a0a6f7ef":{"renderings":[{"id":"222e6cae515173af","role":"translation","source":{"source":"hanabira","ref":"n5-095"},"match":"id","status":"imported","value":"What will you do when choosing your career path?"}]}}}