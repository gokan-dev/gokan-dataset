{"kind":"grammar","lang":"en","entities":{"n4-039":{"renderings":[{"id":"6cc29df76aedffb7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"Expresses gratitude for receiving someone's favor; 'to kindly do'."},{"id":"fd306cde3ffad94c","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"The て くださる grammar point is used to express gratitude for receiving a favor or action from someone else. It is an honorific way to say that someone kindly does something for the speaker or the listener. The verb is conjugated to its ～て form and followed by くださる."},{"id":"a7beccc4b8b1c7d6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"Verb て-form + くださる"},{"id":"7110937e83b74eeb","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-039"},"match":"id","status":"reviewed","value":"Honorific - someone of higher status doing something for the speaker, as a favor."},{"id":"2b7438ef385ec096","role":"label","field":"family","source":{"source":"gokan","ref":"benefactive-action"},"match":"id","status":"reviewed","value":"Benefactive Action (Doing X As A Favor)","of":{"kind":"family","id":"benefactive-action"}}]},"n4-039#baf14e4caf0d":{"renderings":[{"id":"12c2ec4a4c09ee73","role":"translation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"The teacher kindly helps."}]},"n4-039#26997e104da8":{"renderings":[{"id":"97c154173a578739","role":"translation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"My mother kindly cooks delicious meals."}]},"n4-039#1b0d913bee34":{"renderings":[{"id":"36ada365a8436149","role":"translation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"My friend kindly gives me a ride to the station."}]},"n4-039#80ca660faf2a":{"renderings":[{"id":"68022793241d65d7","role":"translation","source":{"source":"hanabira","ref":"n4-039"},"match":"id","status":"imported","value":"The manager kindly answers the questions immediately."}]}}}