{"kind":"grammar","lang":"en","entities":{"n1-170":{"renderings":[{"id":"aa97e2cf1321e037","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"Expresses the meaning of 'in order to', 'for the purpose of'."},{"id":"c1fd1d025fc47410","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"The 'Verbる べく' grammar point is used to indicate a strong intention or purpose of the speaker. It can be translated as 'in order to' or 'for the purpose of' in English. It is more common in written language or formal contexts."},{"id":"6946238cd429cb34","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"Verb-dictionary form + べく"},{"id":"c94947f9ae3d72bd","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-170"},"match":"id","status":"reviewed","value":"Formal, literary \"in order to\"; written language, formal speeches."},{"id":"45dc062868902f1c","role":"label","field":"family","source":{"source":"gokan","ref":"purpose"},"match":"id","status":"reviewed","value":"Purpose (In Order To / So That)","of":{"kind":"family","id":"purpose"}}]},"n1-170#6727afd2549c":{"renderings":[{"id":"9fd108522ceb6dea","role":"translation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"In order to succeed, I am working hard every day."}]},"n1-170#5184c77b82d3":{"renderings":[{"id":"ab74488ad2a50259","role":"translation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"In order to maintain my health, I exercise every day."}]},"n1-170#7611e2ab1fd0":{"renderings":[{"id":"1e3bfbcca6b72b21","role":"translation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"He studies every day in order to get a degree."}]},"n1-170#c92f51a7dd08":{"renderings":[{"id":"17d2d308c72bcc50","role":"translation","source":{"source":"hanabira","ref":"n1-170"},"match":"id","status":"imported","value":"I called a taxi in order to arrive at the destination quickly."}]}}}