{"kind":"grammar","lang":"en","entities":{"n4-055":{"renderings":[{"id":"d3c767cd7c9fe8b5","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-055"},"match":"id","status":"imported","value":"A command form used to give orders or instructions; 'Please do', 'Do this'."},{"id":"1dddcf7a93de1438","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-055"},"match":"id","status":"imported","value":"The なさい grammar point is used to give orders or instructions, often used by teachers, parents, or other authority figures when addressing someone younger or of lower status. It is formed by attaching なさい to the stem of a verb. This form sounds polite, but can be considered strong and direct."},{"id":"ca1111698f9b7ffe","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-055"},"match":"id","status":"imported","value":"Verb-stem + なさい"},{"id":"921fd2807bb252b9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-055"},"match":"id","status":"reviewed","value":"A command from a parent, teacher or exam: too bossy for a request to an equal."},{"id":"c008cd8bab0d5af4","role":"label","field":"family","source":{"source":"gokan","ref":"polite-request"},"match":"id","status":"reviewed","value":"Requests (Please Do / Could You Please)","of":{"kind":"family","id":"polite-request"}}]},"n4-055#e1244f59f2ed":{"renderings":[{"id":"c549843065db7c4c","role":"translation","source":{"source":"hanabira","ref":"n4-055"},"match":"id","status":"imported","value":"Clean your room."}]},"n4-055#54637601683b":{"renderings":[{"id":"1078e614773cf2d7","role":"translation","source":{"source":"hanabira","ref":"n4-055"},"match":"id","status":"imported","value":"Study."}]},"n4-055#11796ea3022a":{"renderings":[{"id":"bc054cc5bf6ca1e6","role":"translation","source":{"source":"hanabira","ref":"n4-055"},"match":"id","status":"imported","value":"Wake up early."}]},"n4-055#ffb89cb485a5":{"renderings":[{"id":"178eda3bbede9