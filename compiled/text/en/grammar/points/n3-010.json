{"kind":"grammar","lang":"en","entities":{"n3-010":{"renderings":[{"id":"cfe5453705ee021c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"Expresses the idea of 'only', 'since', or 'after'."},{"id":"b4521f58146ce528","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"The ～きり grammar point is used to express the idea of 'only', 'since', or 'after'. It indicates that a certain action or state continues without any change since a specific point in time or after a certain event. It is commonly used with verbs in the past tense, but can also be used with other forms."},{"id":"2f11e7f1b7472bd6","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"Verb-past + きり, Verb-てform + きり (less common), Noun + きり"},{"id":"34307238e61892d0","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-010"},"match":"id","status":"reviewed","value":"\"Only/since then\" - a one-time event with a lasting effect, similar to たきり but broader (also means \"only\")."},{"id":"6a6e1e49dd5d23e5","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-after"},"match":"id","status":"reviewed","value":"Sequence (After / As A Result)","of":{"kind":"family","id":"sequence-after"}}]},"n3-010#1df1dc4e4486":{"renderings":[{"id":"deabb5aae63c81f4","role":"translation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"He went out and hasn't come back since."}]},"n3-010#61c1915cebe3":{"renderings":[{"id":"a7d646ba1145dde3","role":"translation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"I haven't had anything to drink since the coffee I had yesterday."}]},"n3-010#3739dfbb016b":{"renderings":[{"id":"d248f1eeb6731718","role":"translation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"I haven't seen her since we graduated."}]},"n3-010#fa8600286868":{"renderings":[{"id":"3fe7c4645e3aef08","role":"translation","source":{"source":"hanabira","ref":"n3-010"},"match":"id","status":"imported","value":"I've wanted to watch that movie again ever since I saw it."}]}}}