{"kind":"grammar","lang":"en","entities":{"n1-048":{"renderings":[{"id":"22d1193453fdb9af","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"Expresses 'without ~, there can't be ~'; 'can't do ~ without first doing ~'."},{"id":"33c75bfb798c3183","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"The なくして grammar point is used to indicate that something is indispensable or necessary for something else to occur. 'Without' the first noun, the second part 'cannot exist/occur'. It demonstrates the principle of causality or necessity."},{"id":"542de725af6e8be5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"Noun + なくして + Sentence ～はない"},{"id":"44a865a983afae6a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-048"},"match":"id","status":"reviewed","value":"Formal, literary \"without X, there can be no Y\" - abstract/conceptual necessity."},{"id":"793129fb5ee02978","role":"label","field":"family","source":{"source":"gokan","ref":"without-x"},"match":"id","status":"reviewed","value":"Without X (Cannot Do Without)","of":{"kind":"family","id":"without-x"}}]},"n1-048#c8b32f6f2ade":{"renderings":[{"id":"be7b1571db8429a8","role":"translation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"There is no success without effort."}]},"n1-048#e36bd6e4e410":{"renderings":[{"id":"476e199f9d26868f","role":"translation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"You cannot create a perfect work without time."}]},"n1-048#88d4bb57d8ef":{"renderings":[{"id":"acc12069968bc24b","role":"translation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"There is no growth without experience."}]},"n1-048#cc154cb7b712":{"renderings":[{"id":"81be4e71e2b7713b","role":"translation","source":{"source":"hanabira","ref":"n1-048"},"match":"id","status":"imported","value":"Without leadership, there can be no success for the group."}]}}}