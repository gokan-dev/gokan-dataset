{"kind":"grammar","lang":"en","entities":{"n5-062":{"renderings":[{"id":"6090b233233f4313","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-062"},"match":"id","status":"imported","value":"Express 'not very', 'not much', or 'not really' when describing a negative state or situation."},{"id":"8c61bd8dd7640007","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-062"},"match":"id","status":"imported","value":"The grammar point あまり～ありません is used to describe a negative state or condition and indicate that it's not very, not much, or not really. It is commonly used with verbs in the negative form and can be used with い-adjectives, な-adjectives, and nouns."},{"id":"5fafb6732bc0a891","role":"prose","field":"formation","source":{"source":"gokan","ref":"n5-062"},"match":"id","status":"reviewed","value":"あまり + Verb-ないform + ありません / あまり + い-Adjective-く ありません / あまり + な-Adjective・Noun じゃありません, あまり + Verb-negative, あまり + い-Adjective-negative"},{"id":"54ff40749a7bfa92","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-062"},"match":"id","status":"reviewed","value":"'Not very, not much': a partial negative. 'Not at all' is ぜんぜん."},{"id":"515717669db2afa2","role":"label","field":"family","source":{"source":"gokan","ref":"negation-intensity"},"match":"id","status":"reviewed","value":"Negation Intensity (Not Very / Not At All)","of":{"kind":"family","id":"negation-intensity"}}]},"n5-062#36d1f452d9bc":{"renderings":[{"id":"a9c6aa715f2c6e66","role":"translation","source":{"source":"hanabira","ref":"n5-062"},"match":"id","status":"imported","value":"He is not really tired."}]},"n5-062#96d82ed355fd":{"renderings":[{"id":"06a6c02d3eac0b02","role":"translation","source":{"source":"hanabira","ref":"n5-062"},"match":"id","status":"imported","value":"She is not very fast."}]},"n5-062#11432aea5278":{"renderings":[{"id":"4403c98c2dec0502","role":"translation","source":{"source":"hanabira","ref":"n5-062"},"match":"id","status":"imported","value":"I don't study very much."}]},"n5-062#8ac3427d4d2e":{"renderings":[{"id":"d3edfe1b629f920b","role":"translation","source":{"source":"hanabira","ref":"n5-062"},"match":"id","status":"imported","value":"I don't have much money."}]}}}