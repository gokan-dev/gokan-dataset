{"kind":"grammar","lang":"en","entities":{"n5-039":{"renderings":[{"id":"c3f98bfa581ea7c9","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"Used to describe a location or position 'in front of' a noun."},{"id":"e0053c6d8928f334","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"The grammar point Noun の 前に is used to describe a location or position 'in front of' a noun. It is formed by adding の 前に after the noun it refers to. (Note that 'Noun の 前に' can also mean 'before [Noun]' in time contexts, but these examples focus on physical location.)"},{"id":"077005e24c056ddb","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"Noun + の + 前に"},{"id":"d8ded6a8ceef6673","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-039"},"match":"id","status":"reviewed","value":"Noun の前に: in front of a place (駅の前に), or before an event (食事の前に)."},{"id":"5890bdada9401857","role":"label","field":"family","source":{"source":"gokan","ref":"before"},"match":"id","status":"reviewed","value":"Before (Prior To)","of":{"kind":"family","id":"before"}}]},"n5-039#cc73b6548a35":{"renderings":[{"id":"9b9ac8fd56cacf49","role":"translation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"There is a convenience store in front of the station."}]},"n5-039#5dbb5ff3f5e9":{"renderings":[{"id":"37bcdaaf3bc70f95","role":"translation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"Please park the car in front of the house."}]},"n5-039#7e7282f01db0":{"renderings":[{"id":"6d54424293063853","role":"translation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"He was standing in front of me."}]},"n5-039#d5fbe56c6430":{"renderings":[{"id":"ef01db731315becd","role":"translation","source":{"source":"hanabira","ref":"n5-039"},"match":"id","status":"imported","value":"A taxi came in front of the hotel."}]}}}