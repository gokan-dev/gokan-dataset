{"kind":"grammar","lang":"en","entities":{"n2-007":{"renderings":[{"id":"c194e5940831da7a","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"Indicates that when action A is done, action or event B follows; 'then', 'when', 'if'."},{"id":"eb6ef0862c248712","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"The A。すると B。grammar point is used to express that when action A is done or takes place, action or event B follows. It can be translated as 'then', 'when', or 'if' in English. It is used to show a natural consequence or result of action A."},{"id":"7b85b96bab13978e","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"Verb (dictionary form) + と + Result"},{"id":"c227e756306f98af","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-007"},"match":"id","status":"reviewed","value":"Neutral, everyday \"then/if\" - describes what naturally follows from an action."},{"id":"fa19f1c414ee3570","role":"label","field":"family","source":{"source":"gokan","ref":"conditional"},"match":"id","status":"reviewed","value":"Conditional (If / Assuming That)","of":{"kind":"family","id":"conditional"}}]},"n2-007#7f60592c744d":{"renderings":[{"id":"05a26945c96eccc5","role":"translation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"When I made the phone call, she answered."}]},"n2-007#3557c91447a5":{"renderings":[{"id":"90415e5803a64eac","role":"translation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"If you press this button, the door will open."}]},"n2-007#b3b1e92f9243":{"renderings":[{"id":"2e75135ffaab991b","role":"translation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"When I went to the convenience store, I happened to meet my friend."}]},"n2-007#14b72f2b6b71":{"renderings":[{"id":"4892b7f39bfb6476","role":"translation","source":{"source":"hanabira","ref":"n2-007"},"match":"id","status":"imported","value":"As soon as he left the house, it started to rain."}]}}}