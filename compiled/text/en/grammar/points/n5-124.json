{"kind":"grammar","lang":"en","entities":{"n5-124":{"renderings":[{"id":"8b5f061b34d1b9cb","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"To receive something or some action from someone; 'to get', 'to receive'."},{"id":"44429658539f557f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"The ～に もらいます grammar point is used to express receiving something or some action from someone. It can be translated as 'to get' or 'to receive' in English. The formation involves placing に after the giver and もらいます to show the act of receiving."},{"id":"4cc3c5ee0bdc0572","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"Giver + に + Verb-te form + もらいます / Giver + に + Object + を + もらいます"},{"id":"f4b56f218b2911b9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-124"},"match":"id","status":"reviewed","value":"Neutral, polite (ます) form - the standard textbook way to say \"receive\"."},{"id":"ac234185b47edc8a","role":"label","field":"family","source":{"source":"gokan","ref":"receiving"},"match":"id","status":"reviewed","value":"Receiving (Benefactive Register)","of":{"kind":"family","id":"receiving"}}]},"n5-124#60d6105880da":{"renderings":[{"id":"c532eb257d57812c","role":"translation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"I received a gift from my friend."}]},"n5-124#3c374f0df1a7":{"renderings":[{"id":"5d25c7f8ec0401a5","role":"translation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"I got advice from my teacher."}]},"n5-124#b78f626934fa":{"renderings":[{"id":"c3372d5d2a8b9004","role":"translation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"I had my grandmother write a letter for me."}]},"n5-124#921cf003c3d4":{"renderings":[{"id":"b7b1a30b2d11f631","role":"translation","source":{"source":"hanabira","ref":"n5-124"},"match":"id","status":"imported","value":"I got help from my younger brother with my homework."}]}}}