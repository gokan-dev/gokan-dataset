{"kind":"grammar","lang":"en","entities":{"n3-098":{"renderings":[{"id":"5f97d7830078a2d7","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"Completely not; not at all."},{"id":"ed7885bc06e807b6","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"The まったく～ない grammar point is used to express that something is not the case at all, or to emphasize the negativity of a situation or action. It is used with negative forms of verbs, い-adjectives, and な-adjectives. It can be translated as 'completely not' or 'not at all' in English."},{"id":"f54dffe41bbf5c8d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"まったく + Verb-negative, まったく + い-Adjective-negative, まったく + な-Adjective-negative"},{"id":"ff3e0c2e03bae54c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-098"},"match":"id","status":"reviewed","value":"まったく～ない: not at all; less casual than ぜんぜん."},{"id":"515717669db2afa2","role":"label","field":"family","source":{"source":"gokan","ref":"negation-intensity"},"match":"id","status":"reviewed","value":"Negation Intensity (Not Very / Not At All)","of":{"kind":"family","id":"negation-intensity"}}]},"n3-098#d82f4a64c281":{"renderings":[{"id":"553aa91a3075878d","role":"translation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"He doesn't remember at all."}]},"n3-098#778968472ff8":{"renderings":[{"id":"04027dea04f46875","role":"translation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"This room is not warm at all."}]},"n3-098#f190e8608e98":{"renderings":[{"id":"c87581667244044d","role":"translation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"She is not late at all."}]},"n3-098#8b8effb1f4a0":{"renderings":[{"id":"019f8c0dceb42725","role":"translation","source":{"source":"hanabira","ref":"n3-098"},"match":"id","status":"imported","value":"This is not convenient at all."}]}}}