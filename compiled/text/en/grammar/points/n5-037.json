{"kind":"grammar","lang":"en","entities":{"n5-037":{"renderings":[{"id":"e48416ae644f083c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"Used to express going to a location."},{"id":"78f4e831ca7f67ca","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"The Noun に 行きます grammar point is used to express going to a specific location. This structure requires a noun (indicating the destination) followed by に and the verb 行きます, which means 'to go'."},{"id":"e2353de94317c66f","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"Noun + に + 行きます"},{"id":"2907249e0094b18c","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-037"},"match":"id","status":"reviewed","value":"行く: move toward somewhere away from where you are now (学校に行く). The に differs in role: Noun + に + 行きます marks the destination (駅に行きます, 'go to the station'), Verb-ますstem + に + 行きます marks the purpose (見に行きます, 'go in order to watch')."},{"id":"9952d59dae38a7d4","role":"label","field":"family","source":{"source":"gokan","ref":"returning"},"match":"id","status":"reviewed","value":"Going And Coming (Go / Come / Go Back)","of":{"kind":"family","id":"returning"}}]},"n5-037#cbbf12a7e60b":{"renderings":[{"id":"0ce6d9a61bd021ff","role":"translation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"I will go to school."}]},"n5-037#bf59bf45f407":{"renderings":[{"id":"99c1efd2335ba7f8","role":"translation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"I will go to the supermarket tomorrow."}]},"n5-037#d5ce62a5fe22":{"renderings":[{"id":"eb6adabc4341808f","role":"translation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"I will go to the movie theater on the weekend."}]},"n5-037#38e5cd369bdd":{"renderings":[{"id":"766c309f7e1ac056","role":"translation","source":{"source":"hanabira","ref":"n5-037"},"match":"id","status":"imported","value":"I will go to the sea during the summer vacation."}]},"n5-037#eae08a0b4589":{"renderings":[{"id":"be45effb5297fadd","role":"translation","source":{"source":"hanabira","ref":"n5-053"},"match":"id","status":"imported","value":"I will go to the park to play."}]},"n5-037#48370bcdacf5":{"renderings":[{"id":"1775e6f264a89aa9","role":"translation","source":{"source":"hanabira","ref":"n5-053"},"match":"id","status":"imported","value":"I will go to the library to study."}]},"n5-037#ef673dd718df":{"renderings":[{"id":"45ed8cc74ba69737","role":"translation","source":{"source":"hanabira","ref":"n5-053"},"match":"id","status":"imported","value":"I will go to the supermarket to do some shopping."}]},"n5-037#837990e7e9a0":{"renderings":[{"id":"26fc8d9d67c7fd45","role":"translation","source":{"source":"hanabira","ref":"n5-053"},"match":"id","status":"imported","value":"I will go to the movie theater to watch a movie."}]}}}