{"kind":"grammar","lang":"en","entities":{"n4-023":{"renderings":[{"id":"89f65e4b6ae7d114","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"Express an action or event that occurred at a specific time in the past; 'when', 'at the time'."},{"id":"2f7b1721a7e8679f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"The たときに grammar point is used to express an action that happened at a specific time in the past, usually with a focus on a specific event or moment. It can be translated as 'when' or 'at the time' in English. This grammar point requires a verb in its た-form followed by ときに to indicate the time at which the action occurred."},{"id":"7df2e4cafcaff42b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"Verb-た + ときに"},{"id":"42f30371053b6557","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-023"},"match":"id","status":"reviewed","value":"Past-tense form of とき - not a different register, just a different verb tense."},{"id":"56016b0b240964ae","role":"label","field":"family","source":{"source":"gokan","ref":"temporal-when"},"match":"id","status":"reviewed","value":"Temporal When (Verb Tense Variants)","of":{"kind":"family","id":"temporal-when"}}]},"n4-023#a44f6a49901e":{"renderings":[{"id":"871bb124c71152f8","role":"translation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"When I watched the movie, I cried."}]},"n4-023#e4943fc82b1c":{"renderings":[{"id":"da22cc2868b00b41","role":"translation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"When I first met him, he was late."}]},"n4-023#ac2589e4274e":{"renderings":[{"id":"ec781c24d5f2273c","role":"translation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"When I went to Japan, I took a lot of photos."}]},"n4-023#1fddcd35d7fd":{"renderings":[{"id":"f2a0752802581b3a","role":"translation","source":{"source":"hanabira","ref":"n4-023"},"match":"id","status":"imported","value":"When my friend came to my house, we played games."}]}}}