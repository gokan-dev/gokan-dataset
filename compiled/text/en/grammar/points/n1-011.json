{"kind":"grammar","lang":"en","entities":{"n1-011":{"renderings":[{"id":"94362eb019007da3","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"Expresses 'whether... or...', 'both... and...', 'in either case'."},{"id":"deb245e883831a3a","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"The ～AにつけBにつけ pattern is used to show that some state or action applies in both situation A and situation B. It often pairs contrasting or related conditions and can be translated as 'whether A or B', 'in either case', etc."},{"id":"5cf039d04bf4fcc4","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"Phrase A (dictionary/adjective form) + につけ、Phrase B (dictionary/adjective form) + につけ"},{"id":"76f4ca17e47e04ee","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-011"},"match":"id","status":"reviewed","value":"Formal, literary - one of several near-interchangeable \"whether A or B\" constructions; stylistic choice more than a formality ladder."},{"id":"c0501e0b255eb50d","role":"label","field":"family","source":{"source":"gokan","ref":"regardless-a-or-b"},"match":"id","status":"reviewed","value":"Regardless (Whether A Or B)","of":{"kind":"family","id":"regardless-a-or-b"}}]},"n1-011#5b1bbba3d266":{"renderings":[{"id":"21a0a442164d86a1","role":"translation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"He is very charming whether he’s laughing or crying."}]},"n1-011#dc6d209fa6cb":{"renderings":[{"id":"4e0fa4f2436750e7","role":"translation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"Whether he's happy or sad, he's always listening to music."}]},"n1-011#0c5bb6e2f044":{"renderings":[{"id":"e948c7a874f4c8c9","role":"translation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"This view is beautiful whether it's daytime or nighttime."}]},"n1-011#68999a2735ef":{"renderings":[{"id":"812c467ad0cf0924","role":"translation","source":{"source":"hanabira","ref":"n1-011"},"match":"id","status":"imported","value":"Whether I’m joyful or sorrowful, she always supports me."}]}}}