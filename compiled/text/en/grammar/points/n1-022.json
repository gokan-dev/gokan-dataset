{"kind":"grammar","lang":"en","entities":{"n1-022":{"renderings":[{"id":"b3d2ff91b8dc0713","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-022"},"match":"id","status":"imported","value":"Describes 'entirely', 'all together', or 'as a whole group'."},{"id":"bd306cb8b3494502","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-022"},"match":"id","status":"imported","value":"「Noun + ぐるみ」emphasizes that an action or state involves the entire group or everything related to that noun. It can mean 'altogether', 'as a whole', or 'with everyone/everything included.'"},{"id":"8f7246a7903eff89","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-022"},"match":"id","status":"imported","value":"Noun + ぐるみ"},{"id":"8a76902a1e91a0d9","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-022"},"match":"id","status":"reviewed","value":"ぐるみ: the whole group together (家族ぐるみ)."},{"id":"d4a432b40b291048","role":"label","field":"family","source":{"source":"gokan","ref":"totality"},"match":"id","status":"reviewed","value":"Totality (Entirely / Full Of / Covered In)","of":{"kind":"family","id":"totality"}}]},"n1-022#e9dbc4dc40c0":{"renderings":[{"id":"8082e4bc7a865fca","role":"translation","source":{"source":"hanabira","ref":"n1-022"},"match":"id","status":"imported","value":"We went on a trip with the whole family."}]},"n1-022#7ff423a8aed3":{"renderings":[{"id":"24005e86e1e597c3","role":"translation","source":{"source":"hanabira","ref":"n1-022"},"match":"id","status":"imported","value":"The entire class went on an excursion."}]},"n1-022#03687879357e":{"renderings":[{"id":"3e8ca21e713241ca","role":"translation","source":{"source":"hanabira","ref":"n1-022"},"match":"id","status":"imported","value":"The entire population of the country supports that bill."}]},"n1-022#0ee7c2308ea3":{"renderings":[{"id":"cc3eb37d5277d782","role":"translation","source":{"source":"hanabira","ref":"n1-022"},"ma