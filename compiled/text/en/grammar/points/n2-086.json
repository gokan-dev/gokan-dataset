{"kind":"grammar","lang":"en","entities":{"n2-086":{"renderings":[{"id":"86531018ad7ef749","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-086"},"match":"id","status":"imported","value":"Cannot afford to only do something; cannot always rely on it."},{"id":"c005ccddb78f547f","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-086"},"match":"id","status":"imported","value":"The ～でばかりはいられない grammar point is used when one realizes they cannot keep doing only that one thing or cannot always rely on a certain situation. It implies the need to take other actions or responsibilities."},{"id":"39878c95e7d78fe8","role":"prose","field":"formation","source":{"source":"gokan","ref":"n2-086"},"match":"id","status":"reviewed","value":"Verb-て form + ばかりはいられない, Noun + ばかりはいられない, Noun + ばかり + Verb-て form + はいられない"},{"id":"aaaaa7f2c41c3270","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-086"},"match":"id","status":"reviewed","value":"てばかりはいられない: can't just keep doing (泣いてばかりはいられない)."},{"id":"d9cd7e2173e4e036","role":"label","field":"family","source":{"source":"gokan","ref":"obligation-cannot"},"match":"id","status":"reviewed","value":"Cannot (Due To Obligation)","of":{"kind":"family","id":"obligation-cannot"}}]},"n2-086#8dc3573c7fcc":{"renderings":[{"id":"c73d6981cf0d0ed6","role":"translation","source":{"source":"hanabira","ref":"n2-086"},"match":"id","status":"imported","value":"I can’t just keep letting people help me all the time."}]},"n2-086#7b56044c3e34":{"renderings":[{"id":"580ccf560549e22c","role":"translation","source":{"source":"hanabira","ref":"n2-086"},"match":"id","status":"imported","value":"I can’t afford to only do the work I love."}]},"n2-086#a39ad871afa1":{"renderings":[{"id":"f8e4f70ed069db69","role":"translation","source":{"source":"hanabira","ref":"n2-086"},"match":"id","status":"imported","value":"I can’t keep depending on my parents forever."}]},"n2-086#2014a6bf500b":{"renderings":[{"id":"17f8ac80db3f8287","role":"translation","source":{"source":"hanabira","ref":"n2-086"},"match":"id","status":"imported","value":"I can’t just keep taking breaks; I have work to do as well."}]}}}