{"kind":"grammar","lang":"en","entities":{"n5-085":{"renderings":[{"id":"e856f3a1809c4b8f","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"Meaning 'after that', 'and then' or 'then', indicating sequence of events."},{"id":"36076c7a192c9e91","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"The それから grammar point is used to describe the sequence of events or actions, indicating that one action or event takes place after another. It can be translated as 'after that', 'and then', or 'then' in English. It can be used with verbs, adjectives, and nouns but should be placed between two clauses."},{"id":"c0984ca1e2cf9745","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"Clause 1 + それから + Clause 2"},{"id":"8b8d257f31628683","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-085"},"match":"id","status":"reviewed","value":"Casual, everyday \"after that/and then\" - simple narrative sequencing."},{"id":"566fb9e865e4f92a","role":"label","field":"family","source":{"source":"gokan","ref":"sequence-then"},"match":"id","status":"reviewed","value":"Sequence (And Then)","of":{"kind":"family","id":"sequence-then"}}]},"n5-085#3c2907edf8f0":{"renderings":[{"id":"701a37f2747b25a5","role":"translation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"I drank coffee, and then I left the house."}]},"n5-085#2e0c2915d2b5":{"renderings":[{"id":"a72dbcd6887ee7bb","role":"translation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"I went shopping, and then I went to watch a movie."}]},"n5-085#23f0763f9624":{"renderings":[{"id":"9f1f10a4b1428aac","role":"translation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"She studied, and then she went to sleep."}]},"n5-085#bc6623945c87":{"renderings":[{"id":"0381a7454035be5b","role":"translation","source":{"source":"hanabira","ref":"n5-085"},"match":"id","status":"imported","value":"I went to the party, and then I talked with my friends."}]}}}