{"kind":"grammar","lang":"en","entities":{"n2-174":{"renderings":[{"id":"7627e75ede1e3334","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"Expresses that a situation or condition is continuing to increase or decrease in one direction."},{"id":"0df2647aee4c9928","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"The ～一方だ grammar point is used when something is trending in a single direction over time, often increasing or worsening. It emphasizes that the tendency keeps going in one direction."},{"id":"7dea82bcebdd67f5","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"Verb-dictionary form + 一方だ"},{"id":"d031928bae28a480","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-174"},"match":"id","status":"reviewed","value":"一方だ: keeps going one way, usually worse (悪くなる一方だ)."},{"id":"28e0e6e1e644a507","role":"label","field":"family","source":{"source":"gokan","ref":"direction-of-change"},"match":"id","status":"reviewed","value":"Direction Of Change (From Now On / Up To Now)","of":{"kind":"family","id":"direction-of-change"}}]},"n2-174#4eda232e0590":{"renderings":[{"id":"5719258659fa4a57","role":"translation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"The world's population continues to increase."}]},"n2-174#59744c600d1f":{"renderings":[{"id":"e9bb483b2629de45","role":"translation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"Public safety in this town is getting worse and worse."}]},"n2-174#dfc04fce8ca5":{"renderings":[{"id":"63519fc011661a7d","role":"translation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"My Japanese keeps improving."}]},"n2-174#4fa8d1fe5352":{"renderings":[{"id":"cf2ea23946b4c83d","role":"translation","source":{"source":"hanabira","ref":"n2-174"},"match":"id","status":"imported","value":"As summer arrives, it just keeps getting hotter."}]}}}