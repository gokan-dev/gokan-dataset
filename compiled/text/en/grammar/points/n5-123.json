{"kind":"grammar","lang":"en","entities":{"n5-123":{"renderings":[{"id":"648e4650ad87eecf","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"Used to express giving something to someone; 'give', 'offer'."},{"id":"b669cb279fd350a0","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"The ～に あげます grammar point is used when the speaker offers or gives something to someone. It emphasizes that the action is performed for the benefit of the receiver. The formation involves using the particle 'に' after the person receiving the item, followed by the verb あげます."},{"id":"e2b84285ad82fb7d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"Receiver + に + Object + を + あげます"},{"id":"62599cfeae732433","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-123"},"match":"id","status":"reviewed","value":"The plain \"give\". (Polite ます-form of n4-013's あげる.)"},{"id":"aabe59494c91ee24","role":"label","field":"family","source":{"source":"gokan","ref":"giving"},"match":"id","status":"reviewed","value":"Giving (Benefactive Register)","of":{"kind":"family","id":"giving"}}]},"n5-123#3dcb516eb2d7":{"renderings":[{"id":"18325fc3651d8b0b","role":"translation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"I gave a book to my friend."}]},"n5-123#f9725a33a966":{"renderings":[{"id":"b1896a6d8e644cb0","role":"translation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"Let's give him a present."}]},"n5-123#397b0bcafdac":{"renderings":[{"id":"0c3d9624b0bdbd4f","role":"translation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"I will give flowers to the teacher."}]},"n5-123#9afcafeb2232":{"renderings":[{"id":"07579d59525aeed7","role":"translation","source":{"source":"hanabira","ref":"n5-123"},"match":"id","status":"imported","value":"I want to give chocolate to my mom."}]}}}