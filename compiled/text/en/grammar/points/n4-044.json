{"kind":"grammar","lang":"en","entities":{"n4-044":{"renderings":[{"id":"b9d58e09f30b1f2c","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"Expresses unintentional actions or actions with regrettable outcomes; 'to end up doing', 'to accidentally do'."},{"id":"187ad30fee68b017","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"The ～てしまう grammar point is used to indicate unintentional actions or actions with regrettable outcomes. It can often be translated as 'to end up doing' or 'to accidentally do' in English. The formation requires adding しまう to the て-form of a verb."},{"id":"c69be40d2b348ba9","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"Verb-te form + しまう"},{"id":"6131e5e019a57447","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-044"},"match":"id","status":"reviewed","value":"て + しまう: done completely, or done with regret (忘れてしまった)."}]},"n4-044#273f9560cc91":{"renderings":[{"id":"7bdf5a3707c7528c","role":"translation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"I ended up eating the whole cake."}]},"n4-044#91680a0d00e3":{"renderings":[{"id":"1e1770dee0d46186","role":"translation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"I accidentally forgot my homework."}]},"n4-044#1069e7c02f52":{"renderings":[{"id":"b8b15aac564129de","role":"translation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"I accidentally told him the secret."}]},"n4-044#bae053bc6908":{"renderings":[{"id":"ccdf768e9375237f","role":"translation","source":{"source":"hanabira","ref":"n4-044"},"match":"id","status":"imported","value":"I ended up buying expensive clothes without looking at the price tag."}]}}}