{"kind":"grammar","lang":"en","entities":{"n2-092":{"renderings":[{"id":"0c17cade92a4fa3b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"Express a strong desire or wish for something to be possible."},{"id":"587a3e35e79f72ec","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"どうにか～ないものか is used to express a strong desire or wish for something to be resolved or made possible. It translates roughly as 'isn't there some way...?', 'can't we somehow...?', or 'is there no way...?'"},{"id":"860ca1e602a5a170","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"どうにか + Verb-negative form + ないものか"},{"id":"d9c35d1a33e09b7a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n2-092"},"match":"id","status":"reviewed","value":"どうにか～ないものか: isn't there some way to (どうにかならないものか)."},{"id":"d6e1d43571c480f1","role":"label","field":"family","source":{"source":"gokan","ref":"wish"},"match":"id","status":"reviewed","value":"Wish And Hope (I Hope / If Only)","of":{"kind":"family","id":"wish"}}]},"n2-092#c46447bbf738":{"renderings":[{"id":"8e3a885b22491c6c","role":"translation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"Isn't there some way to finish this job?"}]},"n2-092#b19eef36aec7":{"renderings":[{"id":"8e0f328e2d98e3c8","role":"translation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"Can't we somehow pass the next exam?"}]},"n2-092#2fadfea228cc":{"renderings":[{"id":"95150929a3d588a8","role":"translation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"Is there no way to get on the crowded train somehow?"}]},"n2-092#f5baa7d39765":{"renderings":[{"id":"4913fd1cec23e5ba","role":"translation","source":{"source":"hanabira","ref":"n2-092"},"match":"id","status":"imported","value":"Isn't there some way to make up with her?"}]}}}