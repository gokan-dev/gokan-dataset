{"kind":"grammar","lang":"en","entities":{"n1-080":{"renderings":[{"id":"801af08ff9386e4b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"Expresses 'like' or 'as if'; something/someone resembles something else strongly."},{"id":"6bb56c4975e09319","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"The のごとき pattern is used to convey the concept of 'just like' or 'as if'. The comparison here is strong, indicating that the thing/person is very similar to or almost the same as the thing/person compared to. It is a bit archaic and thus is more often found in writings than in everyday conversation."},{"id":"3aed4a353cdd176d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"Noun1 + のごとき + Noun2"},{"id":"62692d1f695862a8","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-080"},"match":"id","status":"reviewed","value":"Very formal, literary \"like/as if\" - echoes classical Japanese; rare outside formal writing."},{"id":"394371aa4ed82f54","role":"label","field":"family","source":{"source":"gokan","ref":"resemblance"},"match":"id","status":"reviewed","value":"Resemblance (Like / As If)","of":{"kind":"family","id":"resemblance"}}]},"n1-080#7e9d3b52b404":{"renderings":[{"id":"4ffd19137a1c9a39","role":"translation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"He is an existence like a god."}]},"n1-080#6d42941f4acf":{"renderings":[{"id":"631d19671b116899","role":"translation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"Her beauty is like a flower."}]},"n1-080#bf10bd122e54":{"renderings":[{"id":"55294b76363ec139","role":"translation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"He acted like a devil."}]},"n1-080#1b007676fec5":{"renderings":[{"id":"9df12cb99bb40d7d","role":"translation","source":{"source":"hanabira","ref":"n1-080"},"match":"id","status":"imported","value":"This region has a climate like spring."}]}}}