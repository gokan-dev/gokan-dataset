{"kind":"grammar","lang":"en","entities":{"n4-058":{"renderings":[{"id":"ad480197e2eb1817","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"Express intention or plan to do something; 'I think I will', 'I plan to', 'I intend to'."},{"id":"e7d20c4a77e68191","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"The ようと思う grammar point is used to express the intention or plan to do something in the future. It can be translated as 'I think I will', 'I plan to', or 'I intend to' in English. The formation involves using the volitional form of the verb followed by と思う."},{"id":"d15b6603d79e86e8","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"Verb-volitional + と思う"},{"id":"b7d2c85888faf80a","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-058"},"match":"id","status":"reviewed","value":"\"I think I will.../I plan to\" - a slightly softer statement of intention than つもりだ."},{"id":"1f8c8930edf8789a","role":"label","field":"family","source":{"source":"gokan","ref":"intention"},"match":"id","status":"reviewed","value":"Intention (Plan To)","of":{"kind":"family","id":"intention"}}]},"n4-058#1ac3246a8855":{"renderings":[{"id":"09f59c77f62834ec","role":"translation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"I think I will watch a movie tomorrow."}]},"n4-058#3a19cc4bb72a":{"renderings":[{"id":"4dc4932532c21bd9","role":"translation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"I plan to hang out with friends on the weekend."}]},"n4-058#58b657169fe5":{"renderings":[{"id":"ec0d15e814d5c9cf","role":"translation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"I intend to study harder."}]},"n4-058#408c83094de6":{"renderings":[{"id":"79fc4339c6a6b740","role":"translation","source":{"source":"hanabira","ref":"n4-058"},"match":"id","status":"imported","value":"I plan to go on an overseas trip next year."}]}}}