{"kind":"grammar","lang":"en","entities":{"n5-060":{"renderings":[{"id":"e39ddf87352e6b84","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"Used to express the purpose or reason in casual speech, or nominalize the verb with の."},{"id":"712da9b38ba4a4a2","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"The る の～ grammar point is a casual spoken pattern that can nominalize a verb or explain a purpose/reason by adding の. It's often seen in everyday conversation, and can be used for nuance such as giving an explanation. It's similar to ること, but is more colloquial or explanatory in tone."},{"id":"ca32c7c392b6e48b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"Verb (dictionary form) + の (casual)"},{"id":"ac73924205efe679","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-060"},"match":"id","status":"reviewed","value":"Casual sentence-final の: explains, or asks for an explanation. Polite: のです / んです."},{"id":"8930c0345232d655","role":"label","field":"family","source":{"source":"gokan","ref":"explanation"},"match":"id","status":"reviewed","value":"Explanation (The Reason Is)","of":{"kind":"family","id":"explanation"}}]},"n5-060#023333b5d04d":{"renderings":[{"id":"320892a695adc63e","role":"translation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"I'm withdrawing money at the bank so I can go shopping."}]},"n5-060#e990bf58e70c":{"renderings":[{"id":"b1de83c14fa9ca86","role":"translation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"I'm baking a cake because I'm giving my friend a present."}]},"n5-060#89d6030c5995":{"renderings":[{"id":"1cfcf93b25413f63","role":"translation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"I’m joining a gym since I'm starting a diet."}]},"n5-060#0b0436d35451":{"renderings":[{"id":"d1f209a0de2fbee2","role":"translation","source":{"source":"hanabira","ref":"n5-060"},"match":"id","status":"imported","value":"I'm making a salad because I want a light meal."}]}}}