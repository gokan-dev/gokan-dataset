{"kind":"grammar","lang":"en","entities":{"n1-219":{"renderings":[{"id":"3b7e21323f00d3d0","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"Means 'no need to go that far' or 'not necessary'."},{"id":"5acb0cf1e0d190f1","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"The ～には及ばない grammar point is used to show that an action or degree of effort is unnecessary or excessive. It often translates to 'there’s no need to...' or 'it doesn’t warrant...' in English."},{"id":"25c871ff3fb9c47b","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"Verb-dictionary form + には及ばない"},{"id":"f1ae51b0cddaf33e","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-219"},"match":"id","status":"reviewed","value":"Formal, literary \"no need to go that far\"."},{"id":"620e2cd778f51c48","role":"label","field":"family","source":{"source":"gokan","ref":"no-need-to"},"match":"id","status":"reviewed","value":"No Need To","of":{"kind":"family","id":"no-need-to"}}]},"n1-219#e3352ae3514b":{"renderings":[{"id":"719dcb2f04a25ce2","role":"translation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"There’s no need to go as far as flying first class; economy is enough."}]},"n1-219#341eaa5bbea6":{"renderings":[{"id":"e240e4fd7b6c431e","role":"translation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"There’s no need to bring a gift every time you meet her."}]},"n1-219#18128361c463":{"renderings":[{"id":"3a32585c66c8734b","role":"translation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"That issue doesn’t warrant asking the teacher; you can solve it yourself."}]},"n1-219#54a296af3d5f":{"renderings":[{"id":"36f0139ee7a08b20","role":"translation","source":{"source":"hanabira","ref":"n1-219"},"match":"id","status":"imported","value":"For such a small mistake, there’s no need to use such harsh words."}]}}}