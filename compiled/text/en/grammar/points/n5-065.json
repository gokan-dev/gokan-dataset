{"kind":"grammar","lang":"en","entities":{"n5-065":{"renderings":[{"id":"a4ce8f5e091d8a99","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"A polite way to ask someone's thoughts, opinions, or preferences; 'how about', 'how is'."},{"id":"76fc664e9c485b00","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"The ～いかがですか grammar point is used to politely ask someone's thoughts, opinions, or preferences. It can be translated as 'how about' or 'how is' in English. The formation is quite straightforward when used with verbs or nouns."},{"id":"f5abab97bb5dc11d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"Noun + は + いかがですか / (Verb-て form + は) いかがですか"},{"id":"325d35a99626b6a4","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n5-065"},"match":"id","status":"reviewed","value":"Polite \"how about...\" - asks for a preference/opinion rather than proposing an action directly."},{"id":"9f9ca2025be456fc","role":"label","field":"family","source":{"source":"gokan","ref":"invitation"},"match":"id","status":"reviewed","value":"Invitation (Let's / Shall We)","of":{"kind":"family","id":"invitation"}}]},"n5-065#b93abb95f4f0":{"renderings":[{"id":"7bb795f0acfaafa8","role":"translation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"How about some tea?"}]},"n5-065#a12d76591e47":{"renderings":[{"id":"284ad3cf40e8d356","role":"translation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"How about this dress?"}]},"n5-065#351933d48f8b":{"renderings":[{"id":"8e32323063347140","role":"translation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"How about eating some cake?"}]},"n5-065#1aae8436edc5":{"renderings":[{"id":"6d90dc3d314eb94a","role":"translation","source":{"source":"hanabira","ref":"n5-065"},"match":"id","status":"imported","value":"How about watching a movie?"}]}}}