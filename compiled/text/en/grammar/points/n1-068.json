{"kind":"grammar","lang":"en","entities":{"n1-068":{"renderings":[{"id":"2bb169d9cbfc01b8","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"Expresses 'according to', 'if you ask', 'in the opinion of'."},{"id":"3b5e61f8f79584ca","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"The に言わせれば grammar point is used when we want to express someone's opinion or viewpoint. It can be translated as 'according to', 'if you ask', or 'in the opinion of'. This form is mostly used in formal or written language."},{"id":"906519756c909a1d","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"Noun + に言わせれば"},{"id":"8ae15473a5f6c445","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-068"},"match":"id","status":"reviewed","value":"に言わせれば: if you ask X, in X's view. Same as から言わせれば."},{"id":"3ce38c8d2bd06579","role":"label","field":"family","source":{"source":"gokan","ref":"according-to"},"match":"id","status":"reviewed","value":"According To (As Instructed)","of":{"kind":"family","id":"according-to"}}]},"n1-068#df5de665dfaf":{"renderings":[{"id":"474b905b44e86698","role":"translation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"According to the teacher, it's important to study every day."}]},"n1-068#c0b5fdd3157e":{"renderings":[{"id":"1b230ee515e88481","role":"translation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"If you ask him, he thinks it's better to get married early."}]},"n1-068#dc13254d1f08":{"renderings":[{"id":"4336f5488d2fc187","role":"translation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"According to the critic, this movie is the best of the year."}]},"n1-068#5f22383b5c90":{"renderings":[{"id":"4bc0dddcf51c6e89","role":"translation","source":{"source":"hanabira","ref":"n1-068"},"match":"id","status":"imported","value":"In my father's opinion, the experience of working overseas is very valuable."}]}}}