{"kind":"grammar","lang":"en","entities":{"n4-103":{"renderings":[{"id":"590ec22754e5f0e2","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"Express a necessity; 'must', 'have to', 'need to'."},{"id":"7093e46a9faac8e5","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"The ～ないといけない grammar point is used to express a sense of necessity or obligation, similar to 'must', 'have to', or 'need to' in English. This structure is formed by using the negative form of the verb (ending in ない) followed by といけない."},{"id":"f60d8ac417e6bb83","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"Verb-negative + といけない"},{"id":"04fa36d8b457cd01","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n4-103"},"match":"id","status":"reviewed","value":"Conversational but not as casual as なきゃ/なくちゃ; common in everyday polite speech."},{"id":"9a9ffc62f2cd4f3f","role":"label","field":"family","source":{"source":"gokan","ref":"obligation"},"match":"id","status":"reviewed","value":"Obligation (Must / Have to)","of":{"kind":"family","id":"obligation"}}]},"n4-103#d9a43e8c4572":{"renderings":[{"id":"14cdda111853d9a9","role":"translation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"I have an exam tomorrow, so I have to study tonight."}]},"n4-103#616d8b5e88a0":{"renderings":[{"id":"dab0d4f85190dbe1","role":"translation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"We must leave at 9 o'clock."}]},"n4-103#6280e2a74841":{"renderings":[{"id":"64e06edb47ce08be","role":"translation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"To avoid catching a cold, we have to wash our hands well."}]},"n4-103#a02a189ea209":{"renderings":[{"id":"5e86f5308646c4e8","role":"translation","source":{"source":"hanabira","ref":"n4-103"},"match":"id","status":"imported","value":"This work must be finished by tomorrow."}]}}}