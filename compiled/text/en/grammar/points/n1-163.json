{"kind":"grammar","lang":"en","entities":{"n1-163":{"renderings":[{"id":"ba73f824d236f82b","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n1-163"},"match":"id","status":"imported","value":"Expresses 'as soon as' or 'the moment'."},{"id":"408ec6b2f4419505","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n1-163"},"match":"id","status":"imported","value":"Verbるなり indicates that the following action happens immediately after the verb action. It can be translated as 'no sooner than...', 'as soon as...', or 'the moment...'."},{"id":"a18792dfa92ff803","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n1-163"},"match":"id","status":"imported","value":"Verb-dictionary form + なり"},{"id":"143119fa81010a38","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n1-163"},"match":"id","status":"reviewed","value":"Formal, literary \"the moment X, immediately Y\" - written narrative style."},{"id":"f993e5eecc2b6f19","role":"label","field":"family","source":{"source":"gokan","ref":"as-soon-as"},"match":"id","status":"reviewed","value":"As Soon As (The Moment That)","of":{"kind":"family","id":"as-soon-as"}}]},"n1-163#976228f4b9ff":{"renderings":[{"id":"a568046173c17116","role":"translation","source":{"source":"hanabira","ref":"n1-163"},"match":"id","status":"imported","value":"As soon as I got home, I went to sleep."}]},"n1-163#ae60f045a47f":{"renderings":[{"id":"13473f74550733ba","role":"translation","source":{"source":"hanabira","ref":"n1-163"},"match":"id","status":"imported","value":"He called me the moment he arrived at the station."}]},"n1-163#3d6c514a4d7a":{"renderings":[{"id":"0201f8116bfa376d","role":"translation","source":{"source":"hanabira","ref":"n1-163"},"match":"id","status":"imported","value":"As soon as I opened the door, the dog started barking."}]},"n1-163#e2984ef406b7":{"renderings":[{"id":"36a0dc77273c3318","role":"translation","source":{"source":"hanabira","ref":"n1