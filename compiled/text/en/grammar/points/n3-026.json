{"kind":"grammar","lang":"en","entities":{"n3-026":{"renderings":[{"id":"6abb19ad013f9220","role":"prose","field":"shortExplanation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"Indicates that something or someone caused an unfortunate result."},{"id":"4f8b0b37961387d9","role":"prose","field":"longExplanation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"The ～せいで grammar point is used to express that something or someone is the reason or cause of an unfortunate result or situation. It can be translated as 'because of' or 'due to' in English."},{"id":"6b133d2bc6485e94","role":"prose","field":"formation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"Verb-casual + せいで, い-Adjective + せいで, な-Adjective + なせいで, Noun + のせいで"},{"id":"ca521ab0ce8055ba","role":"prose","field":"usageNote","source":{"source":"gokan","ref":"n3-026"},"match":"id","status":"reviewed","value":"せいで: because of, blaming the cause for a bad result. Good result: おかげで."},{"id":"d295acbaf3aeb59b","role":"label","field":"family","source":{"source":"gokan","ref":"causality"},"match":"id","status":"reviewed","value":"Causality (Because / Since / Due to)","of":{"kind":"family","id":"causality"}}]},"n3-026#256bb1c54093":{"renderings":[{"id":"dea524e493bdd4c2","role":"translation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"The game was cancelled because of the rain."}]},"n3-026#017bd3f75359":{"renderings":[{"id":"202ae5eb66da3dff","role":"translation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"Everyone had to wait because of his lateness."}]},"n3-026#f58d9dfaa2ee":{"renderings":[{"id":"649cc06ca1bcec04","role":"translation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"My holiday was ruined due to illness."}]},"n3-026#c9da32785196":{"renderings":[{"id":"bc88ad684efcc54f","role":"translation","source":{"source":"hanabira","ref":"n3-026"},"match":"id","status":"imported","value":"I can't concentrate because I'm sleep-deprived due to busy work."}]}}}