{"kind":"sentence","lang":"en","entities":{"401949":{"renderings":[{"id":"dafa978d589485c0","role":"translation","source":{"source":"tatoeba","ref":"401953"},"match":"id","status":"imported","value":"Kareishu is a special smell that comes as old people age. Popular expressions such as: \"Ossan kusai\" or \"Oyaji kusai\" (smelly old man) refer to this smell."}]},"10171396":{"renderings":[{"id":"bc555f4a7eb1f1a8","role":"translation","source":{"source":"tatoeba","ref":"2004539"},"match":"id","status":"imported","value":"As he gets older, he's getting more and more stubborn."}]},"10188191":{"renderings":[{"id":"ffef9c18861c20a7","role":"translation","source":{"source":"tatoeba","ref":"10260852"},"match":"id","status":"imported","value":"It is the case that when the years stack up, you come to see things."},{"id":"4deae0b785127195","role":"translation","source":{"source":"tatoeba","ref":"10260856"},"match":"id","status":"imported","value":"When the years pile up, the more things you see."},{"id":"90a9fb0c970c2b98","role":"translation","source":{"source":"tatoeba","ref":"10313764"},"match":"id","status":"imported","value":"It's true that, as the years stack up, you come to see things."},{"id":"0812d6e84a9e34fe","role":"translation","source":{"source":"tatoeba","ref":"10313770"},"match":"id","status":"imported","value":"As the years go by, you see more things."},{"id":"b97bd7109ce231c0","role":"translation","source":{"source":"tatoeba","ref":"10495885"},"match":"id","status":"imported","value":"As time passes, your perspective widens."}]},"10611814":{"renderings":[{"id":"71715ddf148ec99e","role":"translation","source":{"source":"tatoeba","ref":"9696178"},"match":"id","status":"imported","value":"She became more beautiful as she got older."}]},"11196190":{"renderings":[{"id":"76126374c69b684d","role":"translation","source":{"source":"tatoeba","ref":"282171"},"match":"id","status":"imported","value":"As I grew older, my health declined."}]}}}