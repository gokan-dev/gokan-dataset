{"kind":"sentence","lang":"en","entities":{"82813":{"renderings":[{"id":"de3a659da0181825","role":"translation","source":{"source":"tatoeba","ref":"320903"},"match":"id","status":"imported","value":"She inherited her mother's blue eyes."}]},"92535":{"renderings":[{"id":"48de394c7301da24","role":"translation","source":{"source":"tatoeba","ref":"311175"},"match":"id","status":"imported","value":"She derives her temper from her grandfather."}]},"94221":{"renderings":[{"id":"0456a9f4f906fbfb","role":"translation","source":{"source":"tatoeba","ref":"309484"},"match":"id","status":"imported","value":"She derives her character from her mother."}]},"100345":{"renderings":[{"id":"5571af4534a7af4a","role":"translation","source":{"source":"tatoeba","ref":"303352"},"match":"id","status":"imported","value":"He must succeed to his father's business."}]},"100388":{"renderings":[{"id":"f3da4e2ab7fa0394","role":"translation","source":{"source":"tatoeba","ref":"303310"},"match":"id","status":"imported","value":"He has some share of his father's genius."}]},"101183":{"renderings":[{"id":"d83185419a7e0fef","role":"translation","source":{"source":"tatoeba","ref":"302513"},"match":"id","status":"imported","value":"He succeeded to his father's estate."}]},"101260":{"renderings":[{"id":"b7720eb37b7e7b37","role":"translation","source":{"source":"tatoeba","ref":"302436"},"match":"id","status":"imported","value":"He inherited a great fortune."}]},"112873":{"renderings":[{"id":"ec1f3e2f8ae63aee","role":"translation","source":{"source":"tatoeba","ref":"290803"},"match":"id","status":"imported","value":"He has no claim to the property."}]},"115386":{"renderings":[{"id":"7655aa4569fd0bb4","role":"translation","source":{"source":"tatoeba","ref":"288285"},"match":"id","status":"imported","value":"He came into a fortune when his father died."}]},"152054":{"renderings":[{"id":"df2fe2c867a27606","role":"translation","source":{"source":"tatoeba","ref":"262499"},"match":"id","status":"imported","value":