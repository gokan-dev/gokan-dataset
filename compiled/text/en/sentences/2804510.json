{"kind":"sentence","lang":"en","entities":{"1179081":{"renderings":[{"id":"6458dd5b6045c753","role":"translation","source":{"source":"tatoeba","ref":"1487719"},"match":"id","status":"imported","value":"\"Looks like Maki's a twin!\" Ken said. \"Really now,\" I replied, totally uninterested. Maki was a member of a ukulele club that ran beside our club in the school lounge. She looked lovely in Ken's eyes, but to me she was just the sixth cutest girl in class - average, in my opinion."}]},"1643655":{"renderings":[{"id":"27e5fe2546aa3521","role":"translation","source":{"source":"tatoeba","ref":"1697328"},"match":"id","status":"imported","value":"Just say you don't know."}]},"9640885":{"renderings":[{"id":"b5cb98b4fe9f5495","role":"translation","source":{"source":"tatoeba","ref":"25498"},"match":"id","status":"imported","value":"How should I know?"},{"id":"59b7a865cc16a784","role":"translation","source":{"source":"tatoeba","ref":"349064"},"match":"id","status":"imported","value":"I don't know."}]}}}