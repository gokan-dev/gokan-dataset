{"kind":"sentence","lang":"en","entities":{"75332":{"renderings":[{"id":"f0859342d037d136","role":"translation","source":{"source":"tatoeba","ref":"328387"},"match":"id","status":"imported","value":"I arrived home, thoroughly worn out, after getting lost in the mountain paths."}]},"76686":{"renderings":[{"id":"560ece5fcb8d7811","role":"translation","source":{"source":"tatoeba","ref":"327034"},"match":"id","status":"imported","value":"However, when I finally reached the castle I was thrown into this prison by the commander of the imperial guard."}]},"78120":{"renderings":[{"id":"d941592d7809679e","role":"translation","source":{"source":"tatoeba","ref":"325598"},"match":"id","status":"imported","value":"The traveler reached his destination at last."}]},"79745":{"renderings":[{"id":"424d38070ab27838","role":"translation","source":{"source":"tatoeba","ref":"323972"},"match":"id","status":"imported","value":"Late in the evening we found our way to the foot of the mountain at last."}]},"97358":{"renderings":[{"id":"536a17119f6ec679","role":"translation","source":{"source":"tatoeba","ref":"306344"},"match":"id","status":"imported","value":"They got to a village under a hill."}]},"104340":{"renderings":[{"id":"1389777abe2cb7fb","role":"translation","source":{"source":"tatoeba","ref":"299351"},"match":"id","status":"imported","value":"Though seriously injured, he managed to get to a telephone."}]},"110941":{"renderings":[{"id":"e882fbbabf7b22a2","role":"translation","source":{"source":"tatoeba","ref":"292745"},"match":"id","status":"imported","value":"He had difficulty in finding his way to the hotel."},{"id":"a8e1cfa9590460d6","role":"translation","source":{"source":"tatoeba","ref":"5187140"},"match":"id","status":"imported","value":"He had trouble finding his way to the hotel."}]},"151744":{"renderings":[{"id":"1ede7b0d2ff2edd5","role":"translation","source":{"source":"tatoeba","ref":"262811"},"match":"id","status":"imported","value":"At last, we reached the summit."}]},"1