{"kind":"sentence","lang":"en","entities":{"139153":{"renderings":[{"id":"c63849f1ec6ccfad","role":"translation","source":{"source":"tatoeba","ref":"274578"},"match":"id","status":"imported","value":"It is a long way to the village."}]},"149684":{"renderings":[{"id":"783d4e523b267698","role":"translation","source":{"source":"tatoeba","ref":"264874"},"match":"id","status":"imported","value":"The road to freedom: hard to climb."}]},"179801":{"renderings":[{"id":"aeb5d73ea9479989","role":"translation","source":{"source":"tatoeba","ref":"18660"},"match":"id","status":"imported","value":"The advancement of modern medicine was a long process."}]},"188939":{"renderings":[{"id":"0cc7e512582c8e74","role":"translation","source":{"source":"tatoeba","ref":"26086"},"match":"id","status":"imported","value":"Although it was a long way back to the station, little by little the old wagon drew near."}]},"195880":{"renderings":[{"id":"4bb2973021b5da30","role":"translation","source":{"source":"tatoeba","ref":"33055"},"match":"id","status":"imported","value":"It's only a short way, so you can walk there in a few minutes."}]},"196856":{"renderings":[{"id":"cdca7e2e457a4a41","role":"translation","source":{"source":"tatoeba","ref":"34035"},"match":"id","status":"imported","value":"In the same way as Hegel, Panovsky's notion of the dialectic makes history follow a predetermined course."}]},"213573":{"renderings":[{"id":"e6f7255ed70f2d2c","role":"translation","source":{"source":"tatoeba","ref":"50860"},"match":"id","status":"imported","value":"You have to walk a long way to get there."}]},"215130":{"renderings":[{"id":"00bc0c12508d3d36","role":"translation","source":{"source":"tatoeba","ref":"52427"},"match":"id","status":"imported","value":"Excuse me, could you tell me the way to the post office?"}]},"224736":{"renderings":[{"id":"4bbe5b2d6f97b857","role":"translation","source":{"source":"tatoeba","ref":"62071"},"match":"id","status":"imported","value":"How far is it from here to Tokyo?"}]}