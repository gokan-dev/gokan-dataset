{"kind":"sentence","lang":"en","entities":{"74279":{"renderings":[{"id":"84d9f215afe2377f","role":"translation","source":{"source":"tatoeba","ref":"329441"},"match":"id","status":"imported","value":"God is the creator. Heaven and Earth and people and everything apart from God are created."}]},"75716":{"renderings":[{"id":"2d79b7d9b2c2b92b","role":"translation","source":{"source":"tatoeba","ref":"328002"},"match":"id","status":"imported","value":"What Alice, waiting for a reply, was faced with was a sudden howl. It was a resounding noise, sharp as to burst her ear drums, loud as to reach unto the heavens."}]},"84749":{"renderings":[{"id":"8f3541234db1e1f6","role":"translation","source":{"source":"tatoeba","ref":"318965"},"match":"id","status":"imported","value":"My father always said that heaven helps those who help themselves."}]},"84933":{"renderings":[{"id":"6a24c8733918a48b","role":"translation","source":{"source":"tatoeba","ref":"318780"},"match":"id","status":"imported","value":"Mt. Fuji soars heavenward."}]},"101942":{"renderings":[{"id":"2625b4ab335eba0d","role":"translation","source":{"source":"tatoeba","ref":"295588"},"match":"id","status":"imported","value":"He looked up at the sky."}]},"125218":{"renderings":[{"id":"3831a01654455987","role":"translation","source":{"source":"tatoeba","ref":"278775"},"match":"id","status":"imported","value":"Heaven is under our feet as well as over our heads."}]},"125220":{"renderings":[{"id":"789ff13463e2812c","role":"translation","source":{"source":"tatoeba","ref":"278773"},"match":"id","status":"imported","value":"I'm so happy, I feel like I could fly."}]},"125221":{"renderings":[{"id":"d4e23d3a31a38603","role":"translation","source":{"source":"tatoeba","ref":"278772"},"match":"id","status":"imported","value":"God above helped us."}]},"136057":{"renderings":[{"id":"1291b03f794508c4","role":"translation","source":{"source":"tatoeba","ref":"276652"},"match":"id","status":"imported","value":"No one has ever gone into heaven