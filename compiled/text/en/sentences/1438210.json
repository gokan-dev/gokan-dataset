","status":"imported","value":"The moon is in the sky."},{"id":"9dd59753dbcee6ef","role":"translation","source":{"source":"tatoeba","ref":"2971718"},"match":"id","status":"imported","value":"The moon is in the heavens."}]},"6465477":{"renderings":[{"id":"6adeaea60fd71cc6","role":"translation","source":{"source":"tatoeba","ref":"6468631"},"match":"id","status":"imported","value":"Our Father in the heavens, your name shall be holy. Thy kingdom come. May your will be done on earth as it is done in heaven. Please give us our daily bread today as well. Please forgive us our sins. We also forgive men. Please do not tempt us, Please save us from evil. The country, power and glory are yours forever. Amen."}]},"6779183":{"renderings":[{"id":"145f7d0b8c8d0308","role":"translation","source":{"source":"tatoeba","ref":"12016236"},"match":"id","status":"imported","value":"Whatever it is that he experienced is between him and God."},{"id":"2c63ba0c6e5cb3e3","role":"translation","source":{"source":"tatoeba","ref":"12016237"},"match":"id","status":"imported","value":"Only he and the heavens know what he experienced."}]},"10505948":{"renderings":[{"id":"f303e025d537ea38","role":"translation","source":{"source":"tatoeba","ref":"3239486"},"match":"id","status":"imported","value":"I'm over the moon."}]},"10505951":{"renderings":[{"id":"9a2b6307ea727b30","role":"translation","source":{"source":"tatoeba","ref":"8672718"},"match":"id","status":"imported","value":"Tom was over the moon."},{"id":"0f74f41ac1a9b6ab","role":"translation","source":{"source":"tatoeba","ref":"3170567"},"match":"id","status":"imported","value":"Tom was tickled pink."}]},"11153071":{"renderings":[{"id":"3b848274f34a3d12","role":"translation","source":{"source":"tatoeba","ref":"8672720"},"match":"id","status":"imported","value":"The astronaut was over the moon."}]},"11571924":{"renderings":[{"id":"0be7a66fc91c0628","role":"translation","source":{"source":"tatoeba","ref":"8169665"},"match":"id","status":"imported","va