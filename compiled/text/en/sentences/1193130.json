{"kind":"sentence","lang":"en","entities":{"177586":{"renderings":[{"id":"330273261fe0f319","role":"translation","source":{"source":"tatoeba","ref":"16438"},"match":"id","status":"imported","value":"You say Nessie is an imaginary being, but I think she exists."}]},"219942":{"renderings":[{"id":"b4a8290eb1f8d6ed","role":"translation","source":{"source":"tatoeba","ref":"57262"},"match":"id","status":"imported","value":"All the events described in this story are imaginary."}]},"223453":{"renderings":[{"id":"b4feccd0c5678a78","role":"translation","source":{"source":"tatoeba","ref":"60788"},"match":"id","status":"imported","value":"All the characters in this drama are fictitious."}]},"231563":{"renderings":[{"id":"d3b4e5b58e0a56d8","role":"translation","source":{"source":"tatoeba","ref":"68930"},"match":"id","status":"imported","value":"You didn't really see a ghost—it was only imaginary."}]},"1125131":{"renderings":[{"id":"bfe939381243b29a","role":"translation","source":{"source":"tatoeba","ref":"325506"},"match":"id","status":"imported","value":"A dragon is a creature of fancy."}]},"4216091":{"renderings":[{"id":"05a23d92e53e97de","role":"translation","source":{"source":"tatoeba","ref":"10239002"},"match":"id","status":"imported","value":"To lie is to deceive oneself. The impression you give to others is not really you, but a person who doesn't really exist."}]},"9519454":{"renderings":[{"id":"76a44282b1b2be8f","role":"translation","source":{"source":"tatoeba","ref":"9301151"},"match":"id","status":"imported","value":"Tom is my imaginary friend."}]},"11198626":{"renderings":[{"id":"a732f99b97a2feef","role":"translation","source":{"source":"tatoeba","ref":"57077"},"match":"id","status":"imported","value":"All the characters in this book are imaginary."}]}}}