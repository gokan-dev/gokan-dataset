{"kind":"sentence","lang":"en","entities":{"4920":{"renderings":[{"id":"6da8e4a5635c22ad","role":"translation","source":{"source":"tatoeba","ref":"1509"},"match":"id","status":"imported","value":"We must learn to live together as brothers, or we will perish together as fools."}]},"80223":{"renderings":[{"id":"8cddcba8b330f978","role":"translation","source":{"source":"tatoeba","ref":"323494"},"match":"id","status":"imported","value":"For the gate is wide and the way is easy, that leads to destruction."}]},"122975":{"renderings":[{"id":"afc75f3dd072d272","role":"translation","source":{"source":"tatoeba","ref":"281027"},"match":"id","status":"imported","value":"A man's body dies, but his soul is immortal."}]},"175425":{"renderings":[{"id":"93d6e18c3c916662","role":"translation","source":{"source":"tatoeba","ref":"239040"},"match":"id","status":"imported","value":"All who take up the sword will perish by the sword."}]},"192237":{"renderings":[{"id":"f0a03f51db774468","role":"translation","source":{"source":"tatoeba","ref":"29400"},"match":"id","status":"imported","value":"Romans did not want their empire to decline; but it did."}]},"205218":{"renderings":[{"id":"781e7f10a4ebd73b","role":"translation","source":{"source":"tatoeba","ref":"42460"},"match":"id","status":"imported","value":"That whoever believes in him shall not perish but have eternal life."}]},"774544":{"renderings":[{"id":"e0e63fda6c1081dc","role":"translation","source":{"source":"tatoeba","ref":"792808"},"match":"id","status":"imported","value":"As things are, not one person will be spared from eternal destruction."}]}}}