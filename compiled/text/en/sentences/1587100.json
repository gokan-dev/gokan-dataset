{"kind":"sentence","lang":"en","entities":{"86809":{"renderings":[{"id":"ca91b75e0124a0b3","role":"translation","source":{"source":"tatoeba","ref":"316901"},"match":"id","status":"imported","value":"Her dream is to lead a life full of variety."}]},"92821":{"renderings":[{"id":"9a1b8b717e1bcecf","role":"translation","source":{"source":"tatoeba","ref":"310888"},"match":"id","status":"imported","value":"She soon adjusted to his way of life."}]},"100884":{"renderings":[{"id":"7bd52bf0688cbb38","role":"translation","source":{"source":"tatoeba","ref":"302815"},"match":"id","status":"imported","value":"He was envious of her way of living."}]},"103258":{"renderings":[{"id":"de7ef9a5e053abff","role":"translation","source":{"source":"tatoeba","ref":"300435"},"match":"id","status":"imported","value":"He amended his way of living."}]},"104892":{"renderings":[{"id":"b7d2715017d0c95d","role":"translation","source":{"source":"tatoeba","ref":"298797"},"match":"id","status":"imported","value":"He could not adapt his way of life to the company."}]},"142994":{"renderings":[{"id":"83391264e6b81896","role":"translation","source":{"source":"tatoeba","ref":"271574"},"match":"id","status":"imported","value":"I sometimes wish I could live a quiet retired sort of life but I doubt I could stand it for more than a few days."}]},"144165":{"renderings":[{"id":"c98b509197acf300","role":"translation","source":{"source":"tatoeba","ref":"270401"},"match":"id","status":"imported","value":"Some people are apt to think of their own way of life as the normal one and to look down on life-styles that differ from it."}]},"144313":{"renderings":[{"id":"cacfc714594a8af8","role":"translation","source":{"source":"tatoeba","ref":"270252"},"match":"id","status":"imported","value":"It matters not how long we live, but how."}]},"144372":{"renderings":[{"id":"42afd09b23b10b45","role":"translation","source":{"source":"tatoeba","ref":"411124"},"match":"id","status":"imported","value":"It matters not how a man dies, b