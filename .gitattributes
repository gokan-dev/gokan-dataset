# Force LF everywhere by default. The build scripts write compiled JSON via
# Node/Bun's fs writes (always LF), bypassing git's own checkout smudge filter -
# without this, a Windows checkout with core.autocrlf=true converts the
# *committed* blob to CRLF for comparison, so freshly-regenerated (LF) output
# shows as "modified" even when the JSON content is byte-for-byte identical.
* text=auto eol=lf

data/raw/** filter=lfs diff=lfs merge=lfs -text
