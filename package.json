{
  "name": "gokan-dataset",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rimraf ./build && bun run build:data && bun run build:grammar && bun run build:layout && bun run build:schemas && bun run build:datapackage && bun run build:benchmark",
    "build:data": "rimraf ./build/assembled/vocab && rimraf ./build/assembled/sentences && bun run build:kanji && bun scripts/build-data.ts && bun run build:jlpt && bun run build:jlpt-coverage && bun run build:synonyms && bun run build:media && bun run attach:audio && bun run build:text",
    "build:text": "bun scripts/build-text.ts",
    "build:kanji": "bun scripts/build-kanji.ts",
    "build:jlpt": "bun scripts/build-jlpt-index.ts",
    "build:jlpt-coverage": "bun scripts/build-jlpt-coverage.ts",
    "build:grammar": "bun scripts/build-grammar.ts && bun run build:curriculum && bun run build:conjugations && bun run build:browse && bun run build:curriculum-doc && bun run build:grammar-sentences && bun run attach:audio",
    "build:grammar-sentences": "bun scripts/build-grammar-sentences.ts",
    "build:jpdb": "node scripts/jpdb-v2.2-tsv-to-json.js",
    "test": "vitest run",
    "build:layout": "bun scripts/build-layout.ts",
    "build:schemas": "bun scripts/build-schemas.ts",
    "build:datapackage": "bun scripts/build-datapackage.ts",
    "check:layout": "bun scripts/check-layout.ts",
    "check:english": "bun scripts/check-english.ts",
    "check:text": "bun scripts/check-text.ts",
    "check:schemas": "bun scripts/check-schemas.ts",
    "check:determinism": "bun scripts/check-determinism.ts",
    "build:benchmark": "bun scripts/benchmark.ts",
    "check:benchmark": "bun scripts/benchmark.ts --check",
    "build:curriculum": "bun scripts/build-curriculum.ts",
    "build:conjugations": "bun scripts/build-conjugations.ts",
    "build:browse": "bun scripts/build-browse-index.ts",
    "build:curriculum-doc": "bun scripts/build-curriculum-doc.ts",
    "build:synonyms": "bun scripts/build-synonyms.ts",
    "build:media": "bun scripts/build-media.ts",
    "fetch:media": "bun scripts/fetch-jiten.ts",
    "fetch:covers": "bun scripts/fetch-anilist-covers.ts",
    "select:media": "bun scripts/select-easiest-anime.ts",
    "attach:audio": "bun scripts/attach-audio.ts",
    "build:audio": "bun scripts/build-audio.ts",
    "upload:audio": "bun scripts/upload-audio.ts",
    "sample:audio": "bun scripts/audio-sample.ts",
    "measure:audio": "bun scripts/measure-audio.ts"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.10.1",
    "ajv": "^8.20.0",
    "ffmpeg-static": "^5.3.0",
    "kuromoji": "^0.1.2",
    "rimraf": "^6.1.2",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.17"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
